table DH_SundaySummary
	lineageTag: 39c49fb4-79ea-4e2c-93da-258c530c27dc

	measure DHP5W =
			
			var checkins = CALCULATE(sum(DH_SundaySummary[Check Ins]),filter(DH_SundaySummary,DH_SundaySummary[AOOccurrenceDate]>=now()-(35+WEEKDAY(now()))))
			var campuses = CALCULATE(DISTINCTCOUNT(DH_SundaySummary[ACampusId]),filter(DH_SundaySummary,DH_SundaySummary[AOOccurrenceDate]>=now()-(35+WEEKDAY(now()))))
			var numweeks = CALCULATE(DISTINCTCOUNT(DH_SundaySummary[AOOccurrenceDate]),filter(DH_SundaySummary,DH_SundaySummary[AOOccurrenceDate]>=now()-(35+WEEKDAY(now()))))
			var numsundays = CALCULATE(DISTINCTCOUNT(DH_SundaySummary[AOOccurrenceDate]),filter(DH_SundaySummary,DH_SundaySummary[AOOccurrenceDate]>=now()-(35+WEEKDAY(now())) && WEEKDAY(DH_SundaySummary[AOOccurrenceDate], 1) = 1 ))
			return COALESCE(roundup(checkins/(numsundays),0),"-")
		formatString: #,0
		lineageTag: c128c343-a783-443c-9e44-2109b5d7b855

		annotation PBI_FormatHint = {"isDecimal":true}

	measure NonDHP5W = if([DHP5W]="-","-",if([ActiveDH]-DH_SundaySummary[DHP5W]<0,0,ROUNDDOWN([ActiveDH]-[DHP5W],0)))
		formatString: 0
		lineageTag: 433bc7e4-d8d5-44b7-a0fd-49aa51e9f77b

	measure NewDHP5W = COALESCE(CALCULATE(sum(DH_SundaySummary[First Time]),filter(DH_SundaySummary,DH_SundaySummary[AOOccurrenceDate]>=now()-(35+WEEKDAY(now())))),"-")
		formatString: #,0
		lineageTag: c2bca7c8-33d6-4ce8-b005-3ce60c1025c5

		annotation PBI_FormatHint = {"isDecimal":true}

	measure NewDHYTD = COALESCE(CALCULATE(sum(DH_SundaySummary[First Time]),filter(DH_SundaySummary,year(DH_SundaySummary[AOOccurrenceDate])=year(now()))),"-")
		formatString: #,0
		lineageTag: ed5d9051-7d07-4c19-bcc4-b5d67558ecdf

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'DH Last Sunday Date' =
			
			CALCULATE (
			    MAX ( DH_SundaySummary[AOOccurrenceDate] ),
			    ALL ( DH_SundaySummary ),
			    WEEKDAY ( DH_SundaySummary[AOOccurrenceDate], 1 ) = 1,
			    DH_SundaySummary[AOOccurrenceDate] <= TODAY ()
			)
		formatString: General Date
		lineageTag: ab813ee9-baa6-4be7-aacd-245bf8fb761c

	measure 'FM Last Sunday Date' =
			
			CALCULATE (
			    MAX ( fact_checkin[AOOccurrenceDate] ),
			    ALL ( fact_checkin ),
			    fact_checkin[Sunday] = 1,
			    fact_checkin[ADidAttend] = TRUE (),
			    fact_checkin[GTId] IN { 19, 20, 60, 68, 69, 85, 128 },
			    fact_checkin[AOOccurrenceDate] <= TODAY ()
			)
		formatString: General Date
		lineageTag: bcb7e684-9e7d-4e12-87af-a77b822ae814

	measure 'DH Last Sunday Serving' =
			
			VAR d = [DH Last Sunday Date]
			RETURN COALESCE ( CALCULATE ( SUM ( DH_SundaySummary[Check Ins] ), DH_SundaySummary[AOOccurrenceDate] = d ), 0 )
		lineageTag: 4c04d916-2f72-4aaa-850b-847a4c24fed9

	measure 'DH Last Sunday First Timers' =
			
			VAR d = [DH Last Sunday Date]
			RETURN COALESCE ( CALCULATE ( SUM ( DH_SundaySummary[First Time] ), DH_SundaySummary[AOOccurrenceDate] = d ), 0 )
		formatString: 0
		lineageTag: d08e8515-2eb2-46ca-9a8f-c613c7577a0f

	measure 'FM Last Sunday Check Ins' = ```
			
			VAR d = [FM Last Sunday Date]
			RETURN
			    COUNTROWS (
			        FILTER ( fact_checkin,
			            fact_checkin[AOOccurrenceDate] = d
			                && fact_checkin[ADidAttend] = TRUE ()
			                && fact_checkin[GTId] IN { 19, 20, 60, 68, 69, 85, 128 } ) ) 
			```
		formatString: 0
		lineageTag: aaf62d29-d7be-402d-a0b3-f4e68bd0b432

	measure 'FM Last Sunday New Check Ins' = ```
			
			VAR d = [FM Last Sunday Date]
			RETURN
			    COUNTROWS (
			        FILTER ( fact_checkin,
			            fact_checkin[AOOccurrenceDate] = d
			                && fact_checkin[ADidAttend] = TRUE ()
			                && fact_checkin[AIsFirstTime] = TRUE ()
			                && fact_checkin[GTId] IN { 19, 20, 60, 68, 69, 85, 128 } ) ) 
			```
		formatString: 0
		lineageTag: eb2bb75d-1371-47ab-aa11-362faac71da3

	measure 'FM Check Ins 5 Wk Trend' =
			
			VAR axisDate = MAX ( fact_checkin[AOSundayDate] )
			VAR Last5 =
			    TOPN (
			        5,
			        CALCULATETABLE (
			            VALUES ( fact_checkin[AOSundayDate] ),
			            ALL ( fact_checkin ),
			            fact_checkin[Sunday] = 1,
			            fact_checkin[ADidAttend] = TRUE (),
			            fact_checkin[GTId] IN { 19, 20, 60, 68, 69, 85, 128 },
			            fact_checkin[AOSundayDate] <= TODAY ()
			        ),
			        fact_checkin[AOSundayDate], DESC
			    )
			RETURN
			    IF (
			        axisDate IN Last5,
			        CALCULATE (
			            COUNTROWS ( fact_checkin ),
			            fact_checkin[ADidAttend] = TRUE (),
			            fact_checkin[GTId] IN { 19, 20, 60, 68, 69, 85, 128 }
			        )
			    )
		formatString: 0
		lineageTag: b0532736-a8c0-4632-98e8-dbc49da6d58a

	measure 'Last Sunday Label' =
			
			"Last Sunday · " & FORMAT ( [DH Last Sunday Date], "MM/dd" )
		lineageTag: 2fca4fe9-e1e0-497a-af8f-159dc8a0aa50

	measure 'DH Last Sunday Label' =
			
			"Last Sunday Check-ins · " & FORMAT ( [DH Last Sunday Date], "MM/dd" )
		lineageTag: 71623805-c81f-492e-8f1e-1908ab48dddf

	measure 'FM Last Sunday Label' =
			
			"Last Sunday · " & FORMAT ( [FM Last Sunday Date], "MM/dd" )
		lineageTag: fea9c362-a424-4ed7-8e63-5192696eb5bd

	measure 'DH In 5 Sunday Window' =
			
			VAR x = MAX ( DH_SundaySummary[AOOccurrenceDate] )
			VAR Last5 =
			    TOPN (
			        5,
			        CALCULATETABLE (
			            VALUES ( DH_SundaySummary[AOOccurrenceDate] ),
			            ALL ( DH_SundaySummary ),
			            WEEKDAY ( DH_SundaySummary[AOOccurrenceDate], 1 ) = 1,
			            DH_SundaySummary[AOOccurrenceDate] <= TODAY ()
			        ),
			        DH_SundaySummary[AOOccurrenceDate], DESC
			    )
			RETURN IF ( x IN Last5, 1 )
		formatString: 0
		lineageTag: 194feea6-30e4-412b-bdd7-9387b7de66bb

	measure 'Demographics Title' =
			
			"Who Are Our " &
			SWITCH ( SELECTEDVALUE ( 'Crossover Lens'[Lens], "DH" ),
			    "DH", "Door Holders?",
			    "CG", "CG Members?",
			    "Giving", "Givers?" )
		lineageTag: 0359b03f-74cc-49da-8094-6ec6e2e4de30

	column ACampusId
		formatString: 0
		lineageTag: 0486e59a-70d2-4256-800d-db27bfcb2c76
		summarizeBy: none
		isNameInferred
		sourceColumn: fact_checkin[ACampusId]

		annotation SummarizationSetBy = Automatic

	column AOOccurrenceDate
		formatString: mmmm d\, yyyy
		lineageTag: 079cb5fd-79c4-4360-9968-d75019f1a474
		summarizeBy: none
		isNameInferred
		sourceColumn: fact_checkin[AOOccurrenceDate]

		variation Variation
			isDefault
			relationship: 5a4c851a-d486-4916-834b-7816cc36255f
			defaultHierarchy: LocalDateTable_1a1dd851-272d-457f-bf61-249de5739120.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column 'Check Ins'
		formatString: 0
		lineageTag: d4606e67-e639-4e77-8fd8-9a8686e9a8d2
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Check Ins]

		annotation SummarizationSetBy = Automatic

	column 'First Time'
		formatString: 0
		lineageTag: 67beca12-37ce-4a3b-b4a0-710276ebc5f5
		summarizeBy: sum
		isNameInferred
		sourceColumn: [First Time]

		annotation SummarizationSetBy = Automatic

	partition DH_SundaySummary = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    SUMMARIZE(
				        FILTER(fact_checkin, and(OR(fact_checkin[GTId] = 102, fact_checkin[GTId] = 110),fact_checkin[Sunday] = 1)),
				        fact_checkin[ACampusId],
				        fact_checkin[AOOccurrenceDate]
				    ),
				    "Check Ins", CALCULATE(
				        DISTINCTCOUNT(fact_checkin[PersonId])+0,
				        FILTER(
				            ALLEXCEPT(fact_checkin, fact_checkin[ACampusId], fact_checkin[AOOccurrenceDate]),
				            fact_checkin[ADidAttend] = TRUE() && and(OR(fact_checkin[GTId] = 102, fact_checkin[GTId] = 110),fact_checkin[Sunday] = 1)
				        )
				    ),
				    "First Time", CALCULATE(
				        DISTINCTCOUNT(fact_checkin[PersonId])+0,
				        FILTER(
				            ALLEXCEPT(fact_checkin, fact_checkin[ACampusId], fact_checkin[AOOccurrenceDate]),
				            fact_checkin[AIsFirstTime] = TRUE() && and(OR(fact_checkin[GTId] = 102, fact_checkin[GTId] = 110),fact_checkin[Sunday] = 1)
				        )
				    )
				)

	annotation PBI_Id = 1dc11e09a96943688f680bf45376727f

