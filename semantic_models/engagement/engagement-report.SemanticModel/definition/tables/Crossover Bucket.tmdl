		isNameInferred
		sourceColumn: [Order]

		annotation SummarizationSetBy = Automatic

	partition 'Crossover Bucket' = calculated
		mode: import
		source =
				
				DATATABLE (
				    "Label", STRING,
				    "Type", STRING,
				    "Group", STRING,
				    "Order", INTEGER,
				    {
				        { "All Door Holders", "Total", "DH", 0 },
				        { "All CG Members", "Total", "CG", 0 },
				        { "All Givers", "Total", "Giving", 0 },
				        { "Also serving (DH) only", "Also", "DH", 1 },
				        { "Also in a CG only", "Also", "CG", 2 },
				        { "Also giving only", "Also", "Giving", 3 },
				        { "All three", "All", "", 4 },
				        { "Only DH", "Only", "DH", 5 },
				        { "Only CG", "Only", "CG", 6 },
				        { "Only giving", "Only", "Giving", 7 }
				    }
				)

	annotation PBI_Id = 75c9424b570940898ea3162a0ea3b756

