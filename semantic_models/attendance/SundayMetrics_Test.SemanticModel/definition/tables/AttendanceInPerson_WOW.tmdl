	measure '5WeekAverage N' = ```
			
			Var currdate=MINX(VALUES('Calendar'[Date]),'Calendar'[Date])
			var sundays = CALCULATE(DISTINCTCOUNT(AttendanceInPerson_WOW[MetricValueDateTime]),DATESINPERIOD(AttendanceInPerson_WOW[MetricValueDateTime].[Date],currdate,-35,DAY))
			return
			 if(sundays = 5,CALCULATE(SUM(AttendanceInPerson_WOW[Count]),DATESINPERIOD(AttendanceInPerson_WOW[MetricValueDateTime].[Date],currdate,-35,DAY))/5+0,CALCULATE(SUM(AttendanceInPerson_WOW[Count]),DATESINPERIOD(AttendanceInPerson_WOW[MetricValueDateTime].[Date],currdate,-49,DAY))/5+0)
			
			```
		lineageTag: 954111cc-d603-4d95-8385-95219dfa7fc1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure YOYMeasure = COALESCE(Divide([CurrWeekAtt]-[PrevYearAttCount],[PrevYearAttCount],0),"-")
