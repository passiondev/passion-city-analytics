	column YearMonthNumber = ```
			
			CONVERT (
			CONCATENATE (
			RIGHT ( YEAR ( AttendanceInPerson_WOW[MetricValueDateTime].[Date] ), 2 ),
			IF (
			MONTH ( AttendanceInPerson_WOW[MetricValueDateTime].[Date]  ) < 10,
			CONCATENATE ( 0, MONTH ( AttendanceInPerson_WOW[MetricValueDateTime].[Date]  ) ),
			MONTH ( AttendanceInPerson_WOW[MetricValueDateTime].[Date]  )
			)
			),
			INTEGER
