	measure Avg_PastYear_Global =
			
			VAR SelectedDate = MINX(VALUES('Calendar'[Date]), 'Calendar'[Date])
			VAR StartDate = DATE(YEAR(SelectedDate) - 1, MONTH(SelectedDate), DAY(SelectedDate))
			VAR HolidayDates =
			    CALCULATETABLE(
			        VALUES(SplSundayAttInPerson_WOW[MetricValueDateTime]),
			        SplSundayAttInPerson_WOW[EventName] IN {"Easter", "Christmas"}
			    )
			VAR Total =
			    CALCULATE(
			        SUM(AttendanceInPerson_WOW[Count]),
			        KEEPFILTERS(
			            AttendanceInPerson_WOW[Count] <> BLANK()
			        ),
			        AttendanceInPerson_WOW[MetricValueDateTime] >= StartDate &&
			        AttendanceInPerson_WOW[MetricValueDateTime] <= SelectedDate,
			        NOT(AttendanceInPerson_WOW[MetricValueDateTime] IN HolidayDates)
			    )
			VAR Sundays =
			    CALCULATE(
			        DISTINCTCOUNT(AttendanceInPerson_WOW[MetricValueDateTime]),
			        KEEPFILTERS(
			            AttendanceInPerson_WOW[Count] <> BLANK()
			        ),
			        AttendanceInPerson_WOW[MetricValueDateTime] >= StartDate &&
			        AttendanceInPerson_WOW[MetricValueDateTime] <= SelectedDate,
			        NOT(AttendanceInPerson_WOW[MetricValueDateTime] IN HolidayDates)
			    )
			RETURN DIVIDE(Total, Sundays)
		lineageTag: d4819aa5-a048-42ce-be83-6027791fdac2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Avg_PastYear_Global_Display = COALESCE(FORMAT([Avg_PastYear_Global], "0"), "-")
		lineageTag: 6b5f92c6-4383-404f-8f45-22bbfddf4920

