	measure PrevYearAttCount = ```
			
			VAR prevyeardate=DATE( Year('Calendar'[MaxselectedDate])-1, MONTH('Calendar'[MaxselectedDate]),DAY('Calendar'[MaxselectedDate]))
			VAR closestSunday=
			SWITCH(
			    WEEKDAY(prevyeardate,2),
			1, prevyeardate,
			2,prevyeardate-1,
			3,prevyeardate-2,
			4,prevyeardate-3,
			5,prevyeardate+2,
			6,prevyeardate+1,
			7,prevyeardate
			)
			Return 
			CALCULATE(AttendanceInPerson_WOW[CountNew],AttendanceInPerson_WOW[MetricValueDateTime]=closestSunday
			)
			
			```
		lineageTag: 47139973-9e58-40fe-978d-e540a74613e3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

