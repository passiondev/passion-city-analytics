	measure CurrWeekAtt = Calculate([CountNew],AttendanceInPerson_WOW[MetricValueDateTime]= MINX(VALUES('Calendar'[Date]),'Calendar'[Date]))+0
		lineageTag: 5821c7f1-2f27-4f00-884e-fb14a7ffd255

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PrevWeekAtt = ```
			VAR SelectedDate =
			    MIN ( 'Calendar'[selecteddate] )
			
			VAR LastSundayWithAttendance =
			    MAXX (
			        FILTER (
			            ALL ( 'Calendar'[Date] ),
			            VAR SundayDate = 'Calendar'[Date]
			            RETURN
			                SundayDate < SelectedDate
			                    && WEEKDAY ( SundayDate, 2 ) = 7
			                    && CALCULATE (
			                        [CountNew],
			                        AttendanceInPerson_WOW[MetricValueDateTime] = SundayDate
			                    ) <> 0
			        ),
			        'Calendar'[Date]
			    )
			
			RETURN Calculate([CountNew],AttendanceInPerson_WOW[MetricValueDateTime]=LastSundayWithAttendance)
			
			
			```
		lineageTag: d9cb4e63-1778-4dd2-85bf-f6a3e144e44c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure WOWMeasure = COALESCE( Divide([CurrWeekAtt]-[PrevWeekAtt],[PrevWeekAtt],0),"-")
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 7090a945-c9c7-4de5-896e-b52f8df49943

	measure Att = COALESCE(CALCULATE([CountNew],AttendanceInPerson_WOW[MetricValueDateTime]=MINX(VALUES('Calendar'[Date]),'Calendar'[Date])),0)
