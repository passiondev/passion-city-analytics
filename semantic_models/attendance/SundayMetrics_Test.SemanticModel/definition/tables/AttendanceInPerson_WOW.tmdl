table AttendanceInPerson_WOW
	lineageTag: 432344a5-92e1-43d5-a3c9-e848dcc1b173

	measure 5WeekAverage = ```
			
			VAR tab =
			    FILTER (
			        ALL ( 'AttendanceInPerson_WOW'),
			        'AttendanceInPerson_WOW'[Week of Year]
			            > MAX ( 'AttendanceInPerson_WOW'[Week of Year] ) - 5
			            && 'AttendanceInPerson_WOW'[Week of Year] <= MAX ( 'AttendanceInPerson_WOW'[Week of Year] )
			    )
			VAR Ave_Sum =
			    AVERAGEX (
			        SUMMARIZE ( tab, 'AttendanceInPerson_WOW'[Week of Year] ),
			        CALCULATE ( SUM ( 'AttendanceInPerson_WOW'[Count] ) )
			    )
			VAR Ave_Count =
			    AVERAGEX (
			        SUMMARIZE ( tab, 'AttendanceInPerson_WOW'[Week of Year] ),
			        CALCULATE ( COUNT ( 'AttendanceInPerson_WOW'[Count] ) )
			    )
			RETURN
			    DIVIDE ( Ave_Sum, Ave_Count )
			
			```
		formatString: 0
		lineageTag: f05fd5e2-a0e9-4e86-930a-094fc744ad6f

		changedProperty = FormatString

