table AttendanceInPerson_Online_WOW
	lineageTag: 1ce7e8b5-a3d3-4e02-9563-277279b0dc17

	measure 'ATL Online' = COALESCE(CALCULATE([CountNewonline],AttendanceInPerson_Online_WOW[MetricValueDateTime]=MINX(VALUES('Calendar'[Date]),'Calendar'[Date]),AttendanceInPerson_Online_WOW[CityName]="Atlanta"),0)
		lineageTag: ca73403f-4e53-4f38-8e7f-6f245383518b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DC Online' = COALESCE(CALCULATE([CountNewonline],AttendanceInPerson_Online_WOW[MetricValueDateTime]=MINX(VALUES('Calendar'[Date]),'Calendar'[Date]),AttendanceInPerson_Online_WOW[CityName]="DC"),"-")
		lineageTag: 0cd8f47a-0ed5-4cb3-8d61-3165821ac978

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CountNewonline = sum(AttendanceInPerson_Online_WOW[Count])
		lineageTag: 9b57c1e7-d0ec-4b9d-bcf7-3db53c3220ee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AttOnline = COALESCE(CALCULATE([CountNewonline],AttendanceInPerson_Online_WOW[MetricValueDateTime]=MINX(VALUES('Calendar'[Date]),'Calendar'[Date])),0)
		lineageTag: 3720d488-cd7b-4117-a37b-ba76dfa4abe4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure OnlineCurrWeekAtt =
			
			CALCULATE(
			    [CountNewonline],
			    AttendanceInPerson_Online_WOW[MetricValueDateTime] = MINX(VALUES('Calendar'[Date]), 'Calendar'[Date])
			) + 0
		lineageTag: faddc690-67ec-484e-bac0-885cdd474595

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure OnlinePrevWeekAtt =
			
			VAR SelectedDate = MIN('Calendar'[selecteddate])
			VAR LastSundayWithAttendance =
			    MAXX(
			        FILTER(
			            ALL('Calendar'[Date]),
			            VAR SundayDate = 'Calendar'[Date]
			            RETURN
			                SundayDate < SelectedDate
			                    && WEEKDAY(SundayDate, 2) = 7
			                    && CALCULATE(
			                        [CountNewonline],
			                        AttendanceInPerson_Online_WOW[MetricValueDateTime] = SundayDate
			                    ) <> 0
			        ),
			        'Calendar'[Date]
			    )
			RETURN
			CALCULATE(
			    [CountNewonline],
			    AttendanceInPerson_Online_WOW[MetricValueDateTime] = LastSundayWithAttendance
			)
		lineageTag: 8a81e1ad-6ade-4dd9-9a36-51fdd1c31d47

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure OnlineWOWMeasure =
			
			COALESCE(
			    DIVIDE(
			        [OnlineCurrWeekAtt] - [OnlinePrevWeekAtt],
			        [OnlinePrevWeekAtt],
			        0
			    ),
			    "-"
			)
		formatString: 0%;-0%;0%
		lineageTag: 741472dc-a2b3-461d-8b8e-f7cce3d4ab9d

	measure OnlineArrowsWOW =
			
			SWITCH(
			    TRUE(),
			    [OnlineWOWMeasure] >= 0, UNICHAR(9650),
			    [OnlineWOWMeasure] < 0, UNICHAR(9660),
			    BLANK()
			)
		lineageTag: 58154873-39b5-4bea-861d-601b20901679

	measure OnlinePrevYearAtt =
			
			VAR SelectedDate = MINX(VALUES('Calendar'[Date]), 'Calendar'[Date])
			VAR PrevYearDate = DATE(YEAR(SelectedDate) - 1, MONTH(SelectedDate), DAY(SelectedDate))
			VAR ClosestSunday =
			    SWITCH(
			        WEEKDAY(PrevYearDate, 2),
			        1, PrevYearDate,
			        2, PrevYearDate - 1,
			        3, PrevYearDate - 2,
			        4, PrevYearDate - 3,
			        5, PrevYearDate + 2,
			        6, PrevYearDate + 1,
			        7, PrevYearDate
			    )
			RETURN
			CALCULATE(
			    [CountNewonline],
			    AttendanceInPerson_Online_WOW[MetricValueDateTime] = ClosestSunday
			)
		lineageTag: 9576b924-8aed-4658-a1bb-a29d210ad7ce

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure OnlineYOYMeasure =
			
			COALESCE(
			    DIVIDE(
			        [OnlineCurrWeekAtt] - [OnlinePrevYearAtt],
			        [OnlinePrevYearAtt],
			        0
			    ),
			    "-"
			)
		formatString: 0%;-0%;0%
		lineageTag: 9187b4f8-b2fc-4781-bb9e-4869527f917d

	measure OnlineArrowsYOY =
			
			SWITCH(
			    TRUE(),
			    [OnlineYOYMeasure] >= 0, UNICHAR(9650),
			    [OnlineYOYMeasure] < 0, UNICHAR(9660),
			    BLANK()
			)
		lineageTag: 5937bdab-beb7-4447-b192-009e0a14927d

