	measure GivingStage =
			
			VAR _fam = SELECTEDVALUE(fact_checkin[PrimaryFamilyId])
			VAR _selectedDate = MIN('Calendar'[Date])
			
			-- Step 1: Get all PersonIds in this family from dim_person
			VAR _personIds =
			    CALCULATETABLE(
			        VALUES(dim_person[PersonId]),
			        FILTER(
			            ALL(dim_person),
			            dim_person[PrimaryFamilyId] = _fam
			                && dim_person[CurrentRowIndicator] = TRUE()
			        )
			    )
			
			-- Step 2: Look up their giving stage AS OF the selected Sunday
			VAR _members =
			    CALCULATETABLE(
			        VALUES('AnalyticsDimPersonHistorical'[CurrentJourneyGivingStage]),
			        FILTER(
			            ALL('AnalyticsDimPersonHistorical'),
			            'AnalyticsDimPersonHistorical'[PersonId] IN _personIds
			                && 'AnalyticsDimPersonHistorical'[EffectiveDate] <= _selectedDate
			                && 'AnalyticsDimPersonHistorical'[ExpireDate] > _selectedDate
			        )
			    )
			
			-- Step 3: Pick the most engaged stage (same tiebreak logic as before)
			VAR _ranked =
			    ADDCOLUMNS(
			        _members,
			        "Rank",
			            SWITCH('AnalyticsDimPersonHistorical'[CurrentJourneyGivingStage],
			                "Consistent Giver", 1,
			                "New Giver",        2,
			                "Occasional Giver", 3,
			                "Lapsed Giver",     4,
			                "Former Giver",     5,
			                "Non-Giver",        6,
			                7),
			        "Code",
			            SWITCH('AnalyticsDimPersonHistorical'[CurrentJourneyGivingStage],
			                "New Giver",        1,
			                "Consistent Giver", 2,
			                "Occasional Giver", 3,
			                "Lapsed Giver",     4,
			                "Former Giver",     5,
			                "Non-Giver",        0,
			                0)
			    )
			
			VAR _bestRank = MINX(_ranked, [Rank])
			VAR _code = MINX(FILTER(_ranked, [Rank] = _bestRank), [Code])
			
			RETURN
			    IF(ISBLANK(_code), 0, _code)
		formatString: 0
		lineageTag: 07bdb038-4709-4633-848a-7b7835c87284

	measure WeatherIcon = ```
			
			VAR SelectedDate = MIN('Calendar'[selecteddate])
			VAR WeatherCondition = 
			    LOOKUPVALUE(
			        'v_sunday_context'[weather_condition],
			        'v_sunday_context'[service_date], SelectedDate,
