	measure HTML_Card_Online =
			
			VAR _CurAtt = [OnlineAttendance]
			VAR _PrevAtt = [PrevWeekOnlineAttendance]
			VAR _WoW = DIVIDE(_CurAtt - _PrevAtt, _PrevAtt, 0)
			VAR _AttFmt = FORMAT(_CurAtt, "#,0")
			VAR _PrevFmt = FORMAT(_PrevAtt, "#,0")
			VAR _Thumb = [SermonThumbnailUrl]
			VAR _IsDark = [SelectedTheme] = "Dark"
			VAR _Bg = [CardBackground]
			VAR _Txt = [CardTextColor]
			VAR _Sec = [CardSecondaryText]
			VAR _BorderColor = IF(_IsDark, "#2A2A2A", "#E5E7EB")
			VAR _WoWColor = IF(_WoW >= 0, IF(_IsDark, "#4ADE80", "#166634"), IF(_IsDark, "#F87171", "#991B1B"))
			VAR _WoWArrow = IF(_WoW >= 0, "▲", "▼")
			VAR _WoWPct = FORMAT(ABS(_WoW), "0.0%")
			VAR _NoData = ISBLANK([SermonVideoId]) || _CurAtt = 0
			VAR _PlaceholderBg = IF(_IsDark, "#1A1A1A", "#F3F4F6")
			RETURN
			IF(
			    _NoData,
			    "<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap');
			.online-card-nd { background:" & _Bg & "; border:1px solid " & _BorderColor & "; border-radius:14px; overflow:hidden; font-family:Inter,sans-serif; width:100%; box-sizing:border-box; }
			.thumb-wrap-nd { position:relative; width:100%; height:330px; background:" & _PlaceholderBg & "; overflow:hidden; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:8px; }
			.nd-icon { font-size:28px; opacity:0.3; }
			.nd-text { font-size:12px; font-weight:600; color:" & _Sec & "; opacity:0.6; letter-spacing:0.04em; text-transform:uppercase; }
			.stat-row-nd { display:flex; align-items:center; justify-content:center; padding:18px 18px 20px; }
			.nd-label { font-size:11px; font-weight:700; color:" & _Sec & "; opacity:0.5; text-transform:uppercase; letter-spacing:0.06em; }
			</style>
			<div class='online-card-nd'>
			<div class='thumb-wrap-nd'>
			<div class='nd-icon'>📡</div>
			<div class='nd-text'>No data for this week</div>
			</div>
			<div class='stat-row-nd'>
			<div class='nd-label'>Online attendance</div>
			</div>
			</div>",
			
			    "<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap');
			.online-card { background:" & _Bg & "; border:1px solid " & _BorderColor & "; border-radius:14px; overflow:hidden; font-family:Inter,sans-serif; width:100%; box-sizing:border-box; }
			.thumb-wrap { position:relative; width:100%; height:330px; background:#000; overflow:hidden; }
			.thumb-wrap img { width:100%; height:100%; object-fit:cover; display:block; }
			.play-chip { position:absolute; top:12px; left:12px; background:rgba(0,0,0,0.55); color:#fff; font-size:11px; font-weight:700; padding:4px 10px; border-radius:6px; letter-spacing:0.02em; }
			.stat-row { display:flex; align-items:flex-end; justify-content:space-between; padding:18px 18px 20px; }
			.stat-label-d { font-size:11px; font-weight:700; color:" & _Sec & "; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:6px; }
			.stat-num-d { font-size:38px; font-weight:900; color:" & _Txt & "; line-height:1; animation:fadeSlideIn 0.8s ease-out; }
			.wow-chip { display:flex; flex-direction:column; align-items:flex-end; gap:3px; }
			.wow-pct { font-size:13px; font-weight:800; color:" & _WoWColor & "; display:flex; align-items:center; gap:3px; }
			.wow-prev { font-size:11px; color:" & _Sec & "; font-weight:600; }
			@keyframes fadeSlideIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
			</style>
			<div class='online-card'>
			<div class='thumb-wrap'>
			<img src='" & _Thumb & "' />
			<div class='play-chip'>SERMON</div>
			</div>
			<div class='stat-row'>
			<div>
			<div class='stat-label-d'>Online attendance</div>
			<div class='stat-num-d'>" & _AttFmt & "</div>
			</div>
			<div class='wow-chip'>
			<div class='wow-pct'>" & _WoWArrow & " " & _WoWPct & "</div>
			<div class='wow-prev'>Prev wk " & _PrevFmt & "</div>
			</div>
			</div>
			</div>"
			)
		lineageTag: f9701b41-ab78-459e-b3bc-f403ecdbf72f

	measure FTG_5WeekChartData = ```
			
			VAR _WeekEnd0 = [MaxselectedDate]
			VAR _5Weeks = ADDCOLUMNS(
			    GENERATESERIES(0, 4, 1),
			    "__WeekEnd", _WeekEnd0 - (4 - [Value]) * 7,
			    "__WeekStart", _WeekEnd0 - (4 - [Value]) * 7 - 6
			)
			VAR _Labels = CONCATENATEX(
			    _5Weeks,
			    VAR _we = [__WeekEnd]
			    RETURN FORMAT(_we, "MMM D~YYYY"),
			    ",",
			    [__WeekEnd], ASC
			)
			VAR _Vals = CONCATENATEX(
			    _5Weeks,
			    VAR _ws = [__WeekStart]
			    VAR _we = [__WeekEnd]
			    VAR _cnt = 
			        COALESCE(
			            CALCULATE(
			                DISTINCTCOUNT('AnalyticsGivingSignals'[PersonId]),
			                'AnalyticsGivingSignals'[FirstGiftDate] >= _ws,
			                'AnalyticsGivingSignals'[FirstGiftDate] <= _we
			            ),
			            0
			        )
			    RETURN FORMAT(_cnt, "0"),
			    ",",
			    [__WeekEnd], ASC
			)
			RETURN
			    _Labels & "|" & _Vals
			```
		lineageTag: fe8841dc-a07a-4dee-8c03-169473cf1a99

	measure 'First Time Givers (Selected Week)' =
			
			VAR _WeekEnd = [MaxselectedDate]
			VAR _WeekStart = _WeekEnd - 6
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('AnalyticsGivingSignals'[PersonId]),
			    'AnalyticsGivingSignals'[FirstGiftDate] >= _WeekStart,
			    'AnalyticsGivingSignals'[FirstGiftDate] <= _WeekEnd
			)
		formatString: 0
		lineageTag: c9196185-2845-4f6f-906a-4045f9b02b20

	measure 'First Time Givers (Previous Week)' =
			
			VAR _WeekEnd = [MaxselectedDate] - 7
			VAR _WeekStart = _WeekEnd - 6
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('AnalyticsGivingSignals'[PersonId]),
			    'AnalyticsGivingSignals'[FirstGiftDate] >= _WeekStart,
			    'AnalyticsGivingSignals'[FirstGiftDate] <= _WeekEnd
			)
		formatString: 0
		lineageTag: 67893253-d7b5-4f35-a4d6-a342e1f44fa1

	measure HTML_Card_FirstTimeGivers =
			
			VAR _CurFTG = [First Time Givers (Selected Week)]
			VAR _CurFmt = FORMAT(_CurFTG, "#,0")
			VAR _IsDark = [SelectedTheme] = "Dark"
			VAR _Bg = [CardBackground]
			VAR _Txt = [CardTextColor]
			VAR _Sec = [CardSecondaryText]
			VAR _BorderColor = IF(_IsDark, "#2A2A2A", "#E5E7EB")
			VAR _GridColor = IF(_IsDark, "rgba(255,255,255,0.06)", "rgba(0,0,0,0.08)")
			VAR _LineColor = IF(_IsDark, "#FFFFFF", "#111111")
			VAR _ChartData = [FTG_5WeekChartData]
			RETURN
			"<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap');
			html,body{height:100%;margin:0;padding:0;}
			.ftg-card{background:" & _Bg & ";border:1px solid " & _BorderColor & ";border-radius:14px;overflow:hidden;font-family:Inter,sans-serif;width:100%;height:100vh;box-sizing:border-box;display:flex;flex-direction:column;}
			.ftg-stat-row{display:flex;align-items:flex-start;justify-content:space-between;padding:20px 22px 8px;flex-shrink:0;}
			.ftg-note{font-size:10px;font-weight:600;color:" & _Sec & ";text-align:right;line-height:1.2;white-space:nowrap;}
			.ftg-label{font-size:12px;font-weight:700;color:" & _Sec & ";text-transform:uppercase;letter-spacing:0.06em;margin-bottom:8px;}
			.ftg-num{font-size:46px;font-weight:900;color:" & _Txt & ";line-height:1;animation:ftgFadeIn 0.8s ease-out;}
			.ftg-chart-wrap{padding:0 22px 0;position:relative;flex:1 1 auto;min-height:0;}
			.ftg-chart-wrap canvas{position:absolute;top:0;left:0;width:100%;height:100%;display:block;}
			.ftg-labels-row{position:relative;height:28px;flex-shrink:0;margin:4px 22px 16px;}
			@keyframes ftgFadeIn{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}
			</style>
			<div class='ftg-card'>
			<div class='ftg-stat-row'>
			<div>
			<div class='ftg-label'>ATL First Time Givers</div>
			<div class='ftg-num'>" & _CurFmt & "</div>
			</div>
			<div class='ftg-note'> Reporting period: Monday to Sunday
			</div>
			</div>
			<div class='ftg-chart-wrap'><canvas id='ftg-canvas'></canvas></div>
			<div class='ftg-labels-row' id='ftg-labels'></div>
			</div>
			<script>
			(function(){
			try{
			var RAW=""" & _ChartData & """;
			var COLOR=""" & _LineColor & """;
			var GRID=""" & _GridColor & """;
			var LBLCOL=""" & _Sec & """;
			var parts=RAW.split(""|"");
			var labels=parts[0]?parts[0].split("",""):[];
			var vals=parts[1]?parts[1].split("","").map(function(v){return parseInt(v)||0;}):[];
			if(vals.length===0){return;}
			var n=vals.length;
			function setupAndDraw(){
			var canvas=document.getElementById(""ftg-canvas"");
			var wrap=canvas.parentNode;
			var W=wrap.offsetWidth;
			var H=wrap.offsetHeight;
			if(W<10||H<10){setTimeout(setupAndDraw,50);return;}
			canvas.width=W*2;canvas.height=H*2;
			canvas.style.width=W+""px"";canvas.style.height=H+""px"";
			var ctx=canvas.getContext(""2d"");ctx.scale(2,2);
			var max=Math.max.apply(null,vals);var min=Math.min.apply(null,vals);
			var pad=Math.round((max-min)*0.3)||3;
			var yMax=max+pad;var yMin=Math.max(0,min-pad);
			var PT=30,PB=10,PL=30,PR=30;
			var cW=W-PL-PR,cH=H-PT-PB;
			function xp(i){return PL+i*(cW/(n-1));}
			function yp(v){return PT+cH-(((v-yMin)/(yMax-yMin))*cH);}
			var pts=vals.map(function(v,i){return{x:xp(i),y:yp(v),v:v};});
			var labelsEl=document.getElementById(""ftg-labels"");
			var prevYr="""";
			var lHtml="""";
			labels.forEach(function(l,i){
			var sp=l.split(""~"");
			var dateStr=sp[0];
			var yr=sp[1]||"""";
			var display=dateStr+(yr!==prevYr?"" ""+yr:"""");
			prevYr=yr;
			var xPct=(pts[i].x/W)*100;
			lHtml+=""<div style='position:absolute;left:""+xPct+""%;transform:translateX(-50%);font-size:9px;color:""+LBLCOL+"";white-space:nowrap;'>""+display+""</div>"";
			});
			labelsEl.innerHTML=lHtml;
			function eio(t){return t<0.5?2*t*t:1-Math.pow(-2*t+2,2)/2;}
			function bounce(t){var nn=7.5625,d=2.75;if(t<1/d)return nn*t*t;else if(t<2/d)return nn*(t-=1.5/d)*t+0.75;else if(t<2.5/d)return nn*(t-=2.25/d)*t+0.9375;return nn*(t-=2.625/d)*t+0.984375;}
			function drawGrid(){
			ctx.strokeStyle=GRID;ctx.lineWidth=1;
			for(var g=0;g<=3;g++){
			var gy=PT+g*(cH/3);
			ctx.beginPath();ctx.moveTo(PL,gy);ctx.lineTo(W-PR,gy);ctx.stroke();
			}
			}
			var LINE_DUR=600,LABEL_DUR=400,TOTAL=LINE_DUR+LABEL_DUR+200;
			var startT=null;
			function frame(ts){
			if(!startT)startT=ts;
			var elapsed=ts-startT;
			ctx.clearRect(0,0,W,H);drawGrid();
			var lp=Math.min(elapsed/LINE_DUR,1);var lep=eio(lp);var maxIdx=lep*(n-1);
			var lastX=pts[0].x,lastY=pts[0].y;
			ctx.beginPath();ctx.strokeStyle=COLOR;ctx.lineWidth=2.5;ctx.lineJoin=""round"";ctx.lineCap=""round"";
			pts.forEach(function(p,idx){
			if(idx===0){ctx.moveTo(p.x,p.y);return;}
			if(idx<=maxIdx){ctx.lineTo(p.x,p.y);lastX=p.x;lastY=p.y;}
			else if(idx-1<maxIdx){
			var frac=maxIdx-(idx-1);
			lastX=pts[idx-1].x+(p.x-pts[idx-1].x)*frac;
			lastY=pts[idx-1].y+(p.y-pts[idx-1].y)*frac;
			ctx.lineTo(lastX,lastY);
			}
			});
			ctx.stroke();
			if(lp>=0.999){
			ctx.beginPath();ctx.fillStyle=COLOR;
			ctx.globalAlpha=0.2*(1+Math.sin(elapsed/220))*0.5+0.1;
			ctx.arc(lastX,lastY,9,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;
			}
			pts.forEach(function(p,idx){
			if(idx<=maxIdx){ctx.beginPath();ctx.fillStyle=COLOR;ctx.arc(p.x,p.y,3.5,0,Math.PI*2);ctx.fill();}
			});
			if(elapsed>LINE_DUR){
			var la=(elapsed-LINE_DUR)/LABEL_DUR;
			pts.forEach(function(p,idx){
			var delay=idx/n;var pt=Math.max(0,(la-delay)/0.4);var ep=bounce(Math.min(pt,1));
			if(ep>0){
			ctx.globalAlpha=Math.min(ep*2,1);ctx.fillStyle=COLOR;ctx.font=""bold 12px Inter,sans-serif"";
			ctx.textAlign=""center"";
			ctx.fillText(p.v.toLocaleString(),p.x,Math.max(p.y-12,16));
			ctx.globalAlpha=1;
			}
			});
			}
			if(elapsed<TOTAL||lp>=0.999)requestAnimationFrame(frame);
			}
			requestAnimationFrame(frame);
			}
			setupAndDraw();
			}catch(e){
			document.getElementById(""ftg-labels"").innerHTML=""<div style='color:#F87171;font-size:9px'>""+e.message+""</div>"";
			}
			})();
			</script>"
		lineageTag: 73532cb8-9666-46c1-9cfc-7ca6bd484a39

	measure SchoolBreakLine_Cumberland = ```
			
			VAR SelectedDate = MIN('Calendar'[selecteddate])
			VAR IsBreak = 
			    LOOKUPVALUE(
			        'v_sunday_context'[is_school_break],
			        'v_sunday_context'[service_date], SelectedDate,
			        'v_sunday_context'[campus], "Cumberland"
			    )
			VAR BreakName = 
			    LOOKUPVALUE(
			        'v_sunday_context'[break_name],
			        'v_sunday_context'[service_date], SelectedDate,
			        'v_sunday_context'[campus], "Cumberland"
			    )
			VAR ShareOnBreak = 
			    LOOKUPVALUE(
			        'v_sunday_context'[share_on_break],
			        'v_sunday_context'[service_date], SelectedDate,
			        'v_sunday_context'[campus], "Cumberland"
			    )
			VAR IsDark = [SelectedTheme] = "Dark"
			VAR AccentColor = IF(IsDark, "#60A5FA", "#2563EB")
			VAR TextColor = IF(IsDark, "#60A5FA", "#2563EB")
			VAR SharePct = FORMAT(ShareOnBreak, "0%")
			
			RETURN
			IF(
			    IsBreak = TRUE() && BreakName <> BLANK(),
			    "<div style='display:flex; align-items:center; gap:8px; margin-top:8px;'>
			        <div style='width:3px; height:14px; background:" & AccentColor & "; border-radius:2px;'></div>
			        <span style='font-size:11px; font-weight:600; color:" & TextColor & "; font-family:Inter,sans-serif;'>" & BreakName & " · " & SharePct & " on break</span>
			    </div>",
			    ""
			)
			```
		lineageTag: 26ee0a1d-1679-4782-9efc-b8c2c9103543

	measure HTML_SundayGuide =
			
			VAR _IsDark = [SelectedTheme] = "Dark"
			
			VAR _RootBg =        IF(_IsDark, "#0d0d0d", "#E2E3DA")
			VAR _PillBg =        IF(_IsDark, "rgba(255,255,255,0.06)", "rgba(0,0,0,0.06)")
			VAR _PillBorder =    IF(_IsDark, "rgba(255,255,255,0.14)", "rgba(0,0,0,0.13)")
			VAR _PillBgHover =   IF(_IsDark, "rgba(255,255,255,0.11)", "rgba(0,0,0,0.1)")
			VAR _PillBorderHov = IF(_IsDark, "rgba(255,255,255,0.22)", "rgba(0,0,0,0.2)")
			VAR _PillText =      IF(_IsDark, "rgba(255,255,255,0.5)", "rgba(0,0,0,0.4)")
			VAR _CrossColor =    IF(_IsDark, "white", "black")
			VAR _CrossOpacity =  IF(_IsDark, "0.45", "0.3")
			VAR _PccColor = IF(_IsDark, "rgba(255,255,255,0.35)", "rgba(255,255,255,0.80)")
			VAR _ChatCardBg =    IF(_IsDark, "#141414", "#F5F5F2")
			VAR _ChatCardBrd =   IF(_IsDark, "#282828", "#d4d5cc")
			VAR _ChatHdrBrd =    IF(_IsDark, "#1e1e1e", "#d4d5cc")
			VAR _ChatNameCol =   IF(_IsDark, "#666", "#888")
			VAR _CloseBg =       IF(_IsDark, "#1a1a1a", "#E2E3DA")
			VAR _CloseBrd =      IF(_IsDark, "#252525", "#c8c9c0")
			VAR _CloseStroke =   IF(_IsDark, "#555", "#888")
			VAR _ScrollThumb =   IF(_IsDark, "#2a2a2a", "#c8c9c0")
			VAR _BotBg =         IF(_IsDark, "#1c1c1c", "#EAEAE6")
			VAR _BotText =       IF(_IsDark, "#888", "#555")
			VAR _UserBg =        IF(_IsDark, "#1e3a5f", "#d4e4f5")
			VAR _UserText =      IF(_IsDark, "#7eb8f7", "#1a4f7a")
			VAR _TypingDot =     IF(_IsDark, "#555", "#aaa")
			VAR _InpBg =         IF(_IsDark, "#1c1c1c", "#EAEAE6")
			VAR _InpBrd =        IF(_IsDark, "#282828", "#c8c9c0")
			VAR _InpText =       IF(_IsDark, "#ccc", "#333")
			VAR _InpPH =         IF(_IsDark, "#444", "#aaa")
			VAR _SendBg =        IF(_IsDark, "#1c1c1c", "#EAEAE6")
			VAR _SendBrd =       IF(_IsDark, "#282828", "#c8c9c0")
			VAR _SendArrow =     IF(_IsDark, "#666", "#888")
			VAR _ErrColor =      IF(_IsDark, "#F87171", "#991B1B")
			VAR _DotColor =      "#639922"
			
			RETURN
			"<style>
			*{box-sizing:border-box;margin:0;padding:0;}
			html,body{width:100%;height:100%;overflow:hidden;background:" & _RootBg & ";font-family:'Helvetica Neue',Arial,sans-serif;}
			#sg-root{position:relative;width:100%;height:400px;background:" & _RootBg & ";overflow:hidden;}
			#sg-bar{position:absolute;bottom:0;left:0;right:0;}
			#sg-pill-wrap{display:flex;justify-content:center;padding:14px 0 8px;}
			#sg-pill{display:inline-flex;align-items:center;gap:8px;background:" & _PillBg & ";border:0.5px solid " & _PillBorder & ";border-radius:20px;padding:7px 20px;cursor:pointer;transition:background 0.2s,border-color 0.2s,opacity 0.35s ease;}
			#sg-pill:hover{background:" & _PillBgHover & ";border-color:" & _PillBorderHov & ";}
			#sg-pill-label{font-size:12px;font-weight:700;color:" & _PillText & ";letter-spacing:0.04em;}
			#sg-pcc{
			  width:100%;
			  display:block;
			  opacity:1;
			  transition:transform 0.65s cubic-bezier(0.4,0,0.2,1),opacity 0.55s ease;
			  pointer-events:none;
			  padding-bottom:6px;
			  transform-origin:left center;
			}
			#sg-chat-area{position:absolute;bottom:0;left:0;right:0;padding:12px 14px 14px;opacity:0;transform:translateY(20px);transition:opacity 0.55s ease,transform 0.55s cubic-bezier(0.16,1,0.3,1);pointer-events:none;}
			#sg-chat-card{background:" & _ChatCardBg & ";border:0.5px solid " & _ChatCardBrd & ";border-radius:14px;overflow:hidden;}
			#sg-chat-header{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:0.5px solid " & _ChatHdrBrd & ";}
			#sg-chat-title{display:flex;align-items:center;gap:8px;}
			#sg-dot{width:7px;height:7px;border-radius:50%;background:" & _DotColor & ";}
			#sg-name{font-size:12px;font-weight:700;color:" & _ChatNameCol & ";}
			#sg-close{display:flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:6px;border:0.5px solid " & _CloseBrd & ";cursor:pointer;background:" & _CloseBg & ";transition:border-color 0.2s;flex-shrink:0;}
			#sg-close:hover{border-color:" & _CloseStroke & ";}
			#sg-msgs{padding:12px 14px;display:flex;flex-direction:column;gap:8px;height:210px;overflow-y:auto;scroll-behavior:smooth;}
			#sg-msgs::-webkit-scrollbar{width:3px;}
			#sg-msgs::-webkit-scrollbar-track{background:transparent;}
			#sg-msgs::-webkit-scrollbar-thumb{background:" & _ScrollThumb & ";border-radius:2px;}
			.msg-bot{align-self:flex-start;background:" & _BotBg & ";border-radius:10px 10px 10px 3px;padding:8px 12px;font-size:11px;color:" & _BotText & ";max-width:86%;line-height:1.6;}
			.msg-user{align-self:flex-end;background:" & _UserBg & ";border-radius:10px 10px 3px 10px;padding:8px 12px;font-size:11px;color:" & _UserText & ";max-width:72%;line-height:1.6;}
			.msg-typing{align-self:flex-start;background:" & _BotBg & ";border-radius:10px 10px 10px 3px;padding:10px 14px;display:flex;align-items:center;gap:4px;}
			.typing-dot{width:5px;height:5px;border-radius:50%;background:" & _TypingDot & ";animation:typingPulse 1.2s ease-in-out infinite;}
			.typing-dot:nth-child(2){animation-delay:0.2s;}
			.typing-dot:nth-child(3){animation-delay:0.4s;}
			@keyframes typingPulse{0%,80%,100%{opacity:0.3;transform:scale(0.85);}40%{opacity:1;transform:scale(1);}}
			#sg-inp-row{display:flex;align-items:center;gap:8px;padding:10px 14px 12px;border-top:0.5px solid " & _ChatHdrBrd & ";}
			#sg-inp{flex:1;background:" & _InpBg & ";border:0.5px solid " & _InpBrd & ";border-radius:8px;height:32px;font-size:11px;color:" & _InpText & ";padding:0 12px;outline:none;font-family:'Helvetica Neue',Arial,sans-serif;transition:border-color 0.2s;}
			#sg-inp::placeholder{color:" & _InpPH & ";}
			#sg-send{width:32px;height:32px;background:" & _SendBg & ";border:0.5px solid " & _SendBrd & ";border-radius:8px;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;transition:opacity 0.2s;}
			#sg-send:hover{opacity:0.7;}
			#sg-error{display:none;font-size:10px;color:" & _ErrColor & ";padding:4px 14px 8px;text-align:center;}
			</style>
			<div id='sg-root'>
			<div id='sg-bar'>
			<div id='sg-chat-area'>
			<div id='sg-chat-card'>
			<div id='sg-chat-header'>
			<div id='sg-chat-title'><div id='sg-dot'></div><span id='sg-name'>Sunday Guide</span></div>
			<div id='sg-close' onclick='sgClose()'>
			<svg width='9' height='9' viewBox='0 0 9 9' fill='none'>
			<line x1='1' y1='1' x2='8' y2='8' stroke='" & _CloseStroke & "' stroke-width='1.2' stroke-linecap='round'/>
			<line x1='8' y1='1' x2='1' y2='8' stroke='" & _CloseStroke & "' stroke-width='1.2' stroke-linecap='round'/>
			</svg>
			</div>
			</div>
			<div id='sg-msgs'>
			<div class='msg-bot'>Hey! I'm Sunday Guide, here to help make sense of any visual on this page. What are you curious about?</div>
			</div>
			<div id='sg-error'>Something went wrong. Please try again.</div>
			<div id='sg-inp-row'>
			<input id='sg-inp' type='text' placeholder='Ask about any visual...' onkeydown='if(event.key===""Enter"")sgSend()'/>
			<div id='sg-send' onclick='sgSend()'>
			<svg width='11' height='11' viewBox='0 0 11 11' fill='none'>
			<line x1='5.5' y1='10' x2='5.5' y2='1' stroke='" & _SendArrow & "' stroke-width='1.3' stroke-linecap='round'/>
			<polyline points='2,4 5.5,1 9,4' stroke='" & _SendArrow & "' stroke-width='1.3' stroke-linecap='round' stroke-linejoin='round' fill='none'/>
			</svg>
			</div>
			</div>
			</div>
			</div>
			<div id='sg-collapsed'>
			<div id='sg-pill-wrap'>
			<div id='sg-pill' onclick='sgOpen()'>
			<svg width='11' height='11' viewBox='0 0 11 11' fill='none' style='opacity:" & _CrossOpacity & ";flex-shrink:0;'>
			<line x1='5.5' y1='0' x2='5.5' y2='11' stroke='" & _CrossColor & "' stroke-width='1.2'/>
			<line x1='0' y1='4' x2='11' y2='4' stroke='" & _CrossColor & "' stroke-width='1.2'/>
			</svg>
			<span id='sg-pill-label'>Sunday Guide</span>
			</div>
			</div>
			<div id='sg-pcc'>
			<svg id='sg-pcc-svg' width='100%' height='155' style='display:block;overflow:visible;'>
			<text id='sg-pcc-text' y='165' font-family='Arial Black,Helvetica Neue,Impact,Arial,sans-serif' font-weight='600' font-size='130' letter-spacing='-5' fill='" & _PccColor & "' textLength='100%' lengthAdjust='spacingAndGlyphs'>passion city church</text>
			</svg>
			</div>
			</div>
			</div>
			</div>
			<script>
			var pccScale=1;
			var GEMINI_URL='https://geminiproxy-671259003063.us-east1.run.app';
			var SYSTEM_PROMPT='You are Sunday Guide, a friendly and warm assistant built into the Passion City Church Sunday Metrics Dashboard. Your only job is to help people understand what they are looking at on this dashboard. You explain visuals, describe data, and guide navigation. You never make recommendations, suggest decisions, or judge numbers as good or bad. You always use ministry language, never business language.\n\nLANGUAGE RULES:\nAlways say people or people of the House, never customers.\nAlways say gathering or Sunday gathering, never event.\nAlways say the House for the PCC community.\nAlways say estimated online reach, never online viewers or digital attendance.\nAlways say generosity or giving, never revenue.\nAlways say a step of faith for First Time Givers.\nAlways say lighter Sunday, never underperforming or below target.\nNever use KPI, target, benchmark, revenue, acquisition, or retention.\nTone: warm, clear, ministry-native, never prescriptive.\n\nABOUT PASSION CITY CHURCH:\nPassion City Church is a Jesus church. Mission: For God, For People, For the City, For the World. Founded by Louie Giglio. The community is called the House. Three Atlanta locations: 515 in Buckhead with Pastor Brad Jones, Cumberland also called CBL in Vinings and Smyrna with Pastor Jonathan Pickens, and Trilith also called TRL in Fayetteville with Pastor Dan Watson. Washington DC is a partner church operating independently and is NOT included in this dashboard. Rooms of the House include bloom for children 6 weeks through Pre-K, Passion Kids or PK for Kindergarten through 5th grade, Passion Students for Middle School and High School, Door Holders who are volunteers, and Adults who attend the main gathering.\n\nDASHBOARD STORY:\nThis dashboard tells the story of each Sunday gathering. It answers four questions: How did we gather this Sunday shown in the attendance cards. How far did we reach shown in the online card and First Time Givers. What is the trend over time shown in the rolling charts and table. Who are our people shown in the heatmap.\n\nVISUAL 1 - ATTENDANCE CARDS:\nThere are four cards: Global, 515, CBL, and TRL. Global equals 515 plus Cumberland plus Trilith combined. DC is not included. Each card shows the current attendance number, a WoW ring, a YoY ring, the previous week number, the past year average, and a percent of avg bar. WoW means Week over Week and compares this Sunday to the most recent previous Sunday with attendance data. YoY means Year over Year and compares this Sunday to the closest Sunday one year ago. Green rings mean more people than the comparison period. Red rings mean fewer people. Past year avg is the rolling 12-month average excluding Easter and Christmas because those are naturally higher Sundays. The percent of avg bar shows how this Sunday compares to that average: above 100 percent means stronger than average, 80 to 100 percent means slightly lighter, below 80 percent means notably lighter. Colors are: Global in white or grey, 515 in blue, CBL in orange, TRL in teal. Typical ranges are 515 around 2500 to 2800, Cumberland around 1400 to 1700, Trilith around 1100 to 1400. The date slicer at the top controls which Sunday is displayed.\n\nVISUAL 2 - ONLINE ATTENDANCE CARD:\nCRITICAL: This card shows TWO completely separate things that come from TWO different YouTube videos.\n\nFirst: the THUMBNAIL IMAGE. This is the photo or video preview shown on the card. It comes from the edited sermon clip video that is uploaded to YouTube after the gathering. The sermon clip is used ONLY for the thumbnail image. It has absolutely nothing to do with the attendance number.\n\nSecond: the ESTIMATED ONLINE REACH NUMBER. This number comes ONLY from the YouTube live stream videos of the Sunday gathering. It does NOT come from the sermon clip. The raw live stream views are multiplied by 1.94 to estimate total reach. The 1.94 multiplier accounts for people watching together on shared screens. The platform is YouTube only.\n\nIf someone asks which videos are counted for the number: the live stream videos, not the sermon clip.\nIf someone asks which platform: YouTube only.\nIf someone asks about the 1.94 multiplier: it estimates total reach from raw YouTube live stream views.\nIf someone asks why there is no data: either the sermon clip thumbnail has not been uploaded yet, or the data has not refreshed.\nThe card also shows a WoW percent comparing this week to last week.\nOnline reach complements in-person attendance but is not registered attendance.\n\nVISUAL 3 - FIRST TIME GIVERS CARD:\nShows how many people gave to Passion City Church for the very first time this week, with a 5-week trend line. This is a key indicator of new people taking a step of faith. Giving at PCC is worship, not a transaction. Typical range is 39 to 64 per week. There is no target. This is a spiritual indicator, never a business metric. Never say it is too low or needs to improve.\n\nVISUAL 4 - ROLLING LINE CHART:\nShows a long-term historical view of attendance trends. Navigate using tabs at the top: Global, 515, CBL, TRL. Global view shows two charts: rolling 12 months with monthly totals and rolling 52 weeks with weekly totals, each with one line per campus. Campus view shows one chart with rolling 52 weeks year over year, one line per year up to 5 years, current year highlighted. Click a year in the legend to highlight it.\n\nVISUAL 5 - CURRENT VS PREVIOUS BAR CHART:\nShows side-by-side comparison of this Sunday vs the previous Sunday broken down by ministry room. Navigate using campus tabs: Global, 515, CBL, TRL. And ministry tabs: Adults, Door Holder, bloom, PK, MS, HS. Each group shows two bars: previous week in muted color and current week in campus color. Numbers show on top of each bar.\n\nVISUAL 6 - 5 WEEK OVERVIEW CHART:\nShows short-term momentum: attendance for the last 5 Sundays as a line chart with data point labels. The 5 week average shows as a pill in the top right. Campus tabs: Global, 515, CBL, TRL. Shows whether the House is trending up, holding steady, or trending lighter recently.\n\nVISUAL 7 - REGULAR SUNDAY TABLE:\nThe most detailed breakdown in the dashboard. Shows attendance by campus, by service time, and by ministry room. Ministry tabs across the top: Adults, Door Holder, bloom, PK, MS, HS. Rows show 515, Cumberland, and Trilith each with 9:30am, 11:45am, and a Total row. Columns show: Att for current attendance, Prev for previous week, 5WK Avg, WoW percent, and YoY percent. This is the drill-down version of the attendance cards.\n\nVISUAL 8 - HOUSEHOLD HEATMAP:\nShows a map of Atlanta where each dot is one household plotted at their home address based on check-in data from this Sunday. Ministry filter tabs at the top: All, Door Holder, bloom, PK, MS, HS. These filter which households are shown. Campus pins on the map for 515, CBL, and TRL: click to filter to that campus, click again to reset. Dot size is larger for households with members in more ministry rooms. There is a Reset View button to return to default zoom.\n\nThere are two view modes toggled by a button. Check-in View is the default: blue dots for 515, orange for Cumberland, teal for Trilith, gold for multi-campus households. Giving View shows: gray for no gift ever, solid green for gave within 4 weeks, pulsing green for new or returning giver, pulsing amber for no gift in 5 to 12 weeks, pulsing red for quiet meaning no gift in 13 or more weeks. Pulsing dots mean something changed recently in giving pattern. Hover over any dot to see campus, household size, and ministries. Data comes from Rock RMS check-in records and home address coordinates.\n\nSunday Guide describes and helps navigate the heatmap only. Sunday Guide never makes recommendations, suggests outreach strategies, or interprets giving patterns as positive or concerning.\n\nTECHNICAL LAYER - only answer if someone explicitly asks how something is built or calculated:\nData pipeline: Attendance data flows from Rock RMS to SQL Server to GCP ODBC Gateway to Sunday Dashboard 2.0 Dataflow to Power BI Desktop. Online attendance flows from YouTube to BigQuery via YouTube Data Transfer to the video_titles table to the v_gathering_views view to Sunday Dashboard 2.0 Dataflow to Power BI Desktop. Heatmap data flows from Rock RMS to SQL Server to GCP ODBC Gateway to the Person and Check-in Dataflow to Power BI Desktop using dim_person and fact_checkin tables.\n\nAttendance cards technical: Source table AttendanceInPerson_WOW combines 9 Rock RMS metric tables via Power Query. Filters: CampusName not Online, EventName equals Sunday Gathering, CityName equals Atlanta, Christmas dates 2016 through 2024 excluded. DC excluded from Global in DAX by filtering CampusName in 515, Cumberland, Trilith. WoW DAX finds last Sunday before selected date where attendance is non-zero. YoY DAX finds closest Sunday one year ago using SWITCH WEEKDAY logic. Past year avg excludes Easter and Christmas from SplSundayAttInPerson_WOW. Rings use MIN of ABS value divided by 0.5 times 175.93 where 50 percent change equals a full ring, SVG circle radius 28. Cards are HTML strings from DAX measures with SVG rings, CSS animations, and JavaScript count-up.\n\nOnline attendance technical: TWO completely separate video sources. First the THUMBNAIL comes from v_sermon_clips BigQuery view which filters video_titles where title matches the pattern percent space dash space percent for Speaker Name format. SermonVideoId DAX finds the video published on the selected Sunday. Thumbnail URL is https://img.youtube.com/vi/video_id/maxresdefault.jpg. Second the REACH NUMBER comes from v_gathering_views BigQuery view which filters video_titles where title matches Sunday Gathering or FULL GATHERING patterns. These are live stream videos only. A sunday_date column was added to video_titles in BigQuery to assign each video to its correct Sunday regardless of publish day. OnlineAttendance DAX uses SUMX FILTER v_gathering_views where sunday_date equals the formatted selected date, multiplied by 1.94. The 1.94 multiplier was reverse-engineered from historical manual spreadsheet data. Live streams go private within 1 to 2 days after Sunday.\n\nFirst Time Givers technical: Source is AnalyticsGivingSignals. DAX uses DISTINCTCOUNT of PersonId where FirstGiftDate is within the 7-day window ending on the selected Sunday.\n\nHeatmap technical: Source is fact_checkin pre-aggregated in Power Query. Filters ATL campuses only with valid coordinates within Atlanta boundary lat 33.3 to 34.5 lng minus 85.2 to minus 83.8. Joins dim_person and AnalyticsGivingLastGiftByFamily. Groups by Sunday date and FamilyId giving approximately 210000 rows. Giving codes: n equals no gift ever, b equals new or returning meaning gave this week and previous gift was more than 28 days before, g equals gave within 28 days, a equals last gift 29 to 84 days ago, r equals last gift 84 or more days ago. Data format is lat comma lng comma campusList comma ministryList comma headcount comma givingCode separated by semicolons. Map uses Mapbox GL JS v3.6.0.\n\nCONVERSATION RULES:\nOnly answer questions about this dashboard and Passion City Church. If asked something unrelated say you are Sunday Guide and can only help with questions about the Sunday Metrics Dashboard. Never suggest decisions or recommendations. Never say a number is good, bad, concerning, or impressive. Never use business language. If asked about data not in this dashboard say that information is not available here. Remember the full conversation for follow-up questions. For the heatmap describe and navigate only, never prescribe. Keep answers concise, 2 to 4 sentences for simple questions. Be warm and helpful.\n';
			var conversationHistory=[];
			var isLoading=false;
			var isOpen=false;
			var pccScale=1;
			function sgOpen(){
			if(isOpen)return;
			isOpen=true;
			var pcc=document.getElementById('sg-pcc');
			var pill=document.getElementById('sg-pill');
			var chatArea=document.getElementById('sg-chat-area');
			pcc.style.transition='transform 0.65s cubic-bezier(0.4,0,0.2,1),opacity 0.55s ease';
			pcc.style.transform='translateY(100px) scaleX('+pccScale+')';
			pcc.style.opacity='0';
			pill.style.transition='opacity 0.3s ease';
			pill.style.opacity='0';
			pill.style.pointerEvents='none';
			setTimeout(function(){
			chatArea.style.pointerEvents='all';
			chatArea.style.opacity='1';
			chatArea.style.transform='translateY(0)';
			document.getElementById('sg-inp').focus();
			},520);
			}
			function sgClose(){
			if(!isOpen)return;
			var chatArea=document.getElementById('sg-chat-area');
			var pcc=document.getElementById('sg-pcc');
			var pill=document.getElementById('sg-pill');
			chatArea.style.opacity='0';
			chatArea.style.transform='translateY(20px)';
			chatArea.style.pointerEvents='none';
			setTimeout(function(){
			pcc.style.transition='none';
			pcc.style.transform='translateY(100px) scaleX('+pccScale+')';
			pcc.style.opacity='0';
			requestAnimationFrame(function(){requestAnimationFrame(function(){
			pcc.style.transition='transform 0.65s cubic-bezier(0.16,1,0.3,1),opacity 0.55s ease';
			pill.style.transition='opacity 0.5s ease 0.2s';
			pcc.style.transform='translateY(0) scaleX('+pccScale+')';
			pcc.style.opacity='1';
			pill.style.opacity='1';
			pill.style.pointerEvents='all';
			isOpen=false;
			setTimeout(fitPccText,50);
			});});
			},380);
			}
			function addMessage(text,role){
			var msgs=document.getElementById('sg-msgs');
			var div=document.createElement('div');
			div.className=role==='user'?'msg-user':'msg-bot';
			div.textContent=text;
			msgs.appendChild(div);
			msgs.scrollTop=msgs.scrollHeight;
			}
			function addTyping(){
			var msgs=document.getElementById('sg-msgs');
			var div=document.createElement('div');
			div.className='msg-typing';
			div.id='sg-typing';
			for(var i=0;i<3;i++){var dot=document.createElement('div');dot.className='typing-dot';div.appendChild(dot);}
			msgs.appendChild(div);
			msgs.scrollTop=msgs.scrollHeight;
			}
			function removeTyping(){var t=document.getElementById('sg-typing');if(t)t.remove();}
			function setError(show){document.getElementById('sg-error').style.display=show?'block':'none';}
			function setLoading(val){
			isLoading=val;
			document.getElementById('sg-send').style.opacity=val?'0.4':'1';
			document.getElementById('sg-inp').disabled=val;
			}
			async function sgSend(){
			if(isLoading)return;
			var inp=document.getElementById('sg-inp');
			var text=inp.value.trim();
			if(!text)return;
			inp.value='';
			setError(false);
			addMessage(text,'user');
			conversationHistory.push({role:'user',parts:[{text:text}]});
			setLoading(true);
			addTyping();
			var messages=[];
			var systemSet=false;
			for(var i=0;i<conversationHistory.length;i++){
			var msg=conversationHistory[i];
			if(!systemSet&&msg.role==='user'){
			messages.push({role:'user',parts:[{text:SYSTEM_PROMPT+'\n\nUser: '+msg.parts[0].text}]});
			systemSet=true;
			}else{messages.push(msg);}
			}
			var maxRetries=3;
			var attempt=0;
			var success=false;
			while(attempt<maxRetries&&!success){
			try{
			if(attempt>0){await new Promise(function(r){setTimeout(r,1500*attempt);});}
			var response=await fetch(GEMINI_URL,{
			method:'POST',
			headers:{'Content-Type':'application/json'},
			body:JSON.stringify({contents:messages,generationConfig:{temperature:0.7,maxOutputTokens:400}})
			});
			var data=await response.json();
			if(data.candidates&&data.candidates[0]&&data.candidates[0].content){
			var reply=data.candidates[0].content.parts[0].text;
			conversationHistory.push({role:'model',parts:[{text:reply}]});
			removeTyping();
			addMessage(reply,'bot');
			success=true;
			}else if(data.error&&data.error.code===503){
			attempt++;
			if(attempt>=maxRetries){
			removeTyping();
			setError(true);
			conversationHistory.pop();
			}
			}else{
			removeTyping();
			conversationHistory.pop();
			setError(true);
			success=true;
			}
			}catch(e){
			attempt++;
			if(attempt>=maxRetries){
			removeTyping();
			setError(true);
			conversationHistory.pop();
			}
			}
			}
			setLoading(false);}
			</script>"
