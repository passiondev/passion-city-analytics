	measure HTML_Card_CBL = ```
			
			VAR Att = [Cumberland]
			VAR PrevWk = CALCULATE([PrevWeekAtt], AttendanceInPerson_WOW[CampusName]="Cumberland")
			VAR WoW = [WOW_Numeric_Cumberland]
			VAR YoY = [YOY_Numeric_Cumberland]
			VAR PastYrAvg = [Avg_PastYear_Cumberland]
			VAR Ratio = DIVIDE([Cumberland], PastYrAvg, 0)
			VAR RatioPct = FORMAT(Ratio, "0%") & " of avg"
			VAR BarW = FORMAT(MIN(Ratio * 100, 150), "0")
			VAR Bg = [CardBackground]
			VAR Txt = [CardTextColor]
			VAR Sec = [CardSecondaryText]
			VAR IsDark = [SelectedTheme] = "Dark"
			VAR CampusColor = "#FF641C"
			VAR TrackColor = IF(IsDark, "#2A2A2A", "#E5E7EB")
			VAR BorderColor = IF(IsDark, "#2A2A2A", "#E5E7EB")
			VAR WoWColor = IF(WoW >= 0, IF(IsDark, "#4ADE80", "#166534"), IF(IsDark, "#F87171", "#991B1B"))
			VAR YoYColor = IF(YoY >= 0, IF(IsDark, "#4ADE80", "#166534"), IF(IsDark, "#F87171", "#991B1B"))
			VAR WoWArrow = IF(WoW >= 0, "▲", "▼")
			VAR YoYArrow = IF(YoY >= 0, "▲", "▼")
			VAR WoWPct = FORMAT(ABS(WoW), "0.0%")
			VAR YoYPct = FORMAT(ABS(YoY), "0.0%")
			VAR WoWLabel = WoWArrow & " " & WoWPct
			VAR YoYLabel = YoYArrow & " " & YoYPct
			VAR WoWDash = FORMAT(MIN(ABS(WoW) / 0.5, 1) * 175.93, "0.00")
			VAR WoWGap = FORMAT(175.93 - MIN(ABS(WoW) / 0.5, 1) * 175.93, "0.00")
			VAR YoYDash = FORMAT(MIN(ABS(YoY) / 0.5, 1) * 175.93, "0.00")
			VAR YoYGap = FORMAT(175.93 - MIN(ABS(YoY) / 0.5, 1) * 175.93, "0.00")
			VAR AttFmt = FORMAT(Att, "#,0")
			VAR PrevFmt = FORMAT(PrevWk, "#,0")
			VAR AvgFmt = FORMAT(PastYrAvg, "#,0")
			-- Add these VAR blocks before RETURN in HTML_Card_CBL
			
			VAR SelectedDate = MIN('Calendar'[selecteddate])
			VAR IsBreak = 
			    LOOKUPVALUE(
			        'v_sunday_context'[is_school_break],
			        'v_sunday_context'[service_date], SelectedDate,
			        'v_sunday_context'[campus], "Cumberland"
			    )
			VAR BreakName = 
			    LOOKUPVALUE(
			        'v_sunday_context'[break_name],
			        'v_sunday_context'[service_date], SelectedDate,
			        'v_sunday_context'[campus], "Cumberland"
			    )
			VAR ShareOnBreak = 
			    LOOKUPVALUE(
			        'v_sunday_context'[share_on_break],
			        'v_sunday_context'[service_date], SelectedDate,
			        'v_sunday_context'[campus], "Cumberland"
			    )
			VAR BreakAccent = "#60A5FA"
			VAR BreakTextColor = IF(IsDark, "#FFFFFF", "#FFFFFF")
			VAR SharePct = FORMAT(ShareOnBreak, "0%")
			
			VAR SchoolBreakLine = 
			    IF(
			        IsBreak = TRUE() && BreakName <> BLANK(),
			        "<div style='display:flex; align-items:center; gap:8px; margin-top:10px;'>
			            <div style='width:3px; align-self:stretch; background:" & BreakAccent & "; border-radius:2px; flex-shrink:0;'></div>
			            <span style='font-size:11px; font-weight:600; color:" & BreakTextColor & "; font-family:Inter,sans-serif; line-height:1.4;'>" & BreakName & " · " & SharePct & " on break</span>
			        </div>",
			        "<div style='display:flex; align-items:center; gap:8px; margin-top:10px;'>
			            <div style='width:3px; align-self:stretch; background:" & IF(IsDark, "#3A3A3A", "#E5E7EB") & "; border-radius:2px; flex-shrink:0;'></div>
			            <span style='font-size:11px; font-weight:500; color:" & IF(IsDark, "#4B5563", "#9CA3AF") & "; font-family:Inter,sans-serif;'>No school break this week</span>
			        </div>"
			    )
			RETURN
			"<!-- theme:" & [SelectedTheme] & " -->
			<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap');
			* { box-sizing:border-box; margin:0; padding:0; }
			.card-cbl { background:" & Bg & "; border:1px solid " & BorderColor & "; border-radius:12px; padding:20px; font-family:Inter,sans-serif; position:relative; overflow:hidden; width:100%; }
			.top-bar-cbl { position:absolute; top:0; left:0; right:0; height:10px; background:" & CampusColor & "; border-radius:12px 12px 0 0; }
			.badge-cbl { display:inline-block; background:" & CampusColor & "26; color:" & CampusColor & "; padding:4px 14px; border-radius:6px; font-size:13px; font-weight:700; margin-top:6px; }
			.att-label-cbl { font-size:12px; font-weight:700; color:" & Sec & "; margin-top:14px; margin-bottom:4px; }
			.att-num-cbl { font-size:46px; font-weight:900; color:" & Txt & "; margin:0; animation:fadeSlideIn 0.8s ease-out; }
			.circles-row-cbl { display:flex; justify-content:center; gap:40px; margin:16px 0; }
			.circle-item-cbl { display:flex; flex-direction:column; align-items:center; gap:4px; }
			.circle-label-cbl { font-size:11px; color:" & Sec & "; }
			.wow-ring-cbl { animation:pulsering 2s ease-in-out infinite; }
			.yoy-ring-cbl { animation:pulsering 2s ease-in-out infinite 0.5s; }
			.divider-cbl { border:none; border-top:0.5px solid " & BorderColor & "; margin:12px 0; }
			.data-row-cbl { display:flex; justify-content:space-between; align-items:baseline; }
			.data-label-cbl { font-size:12px; color:" & Sec & "; }
			.data-val-cbl { font-size:20px; font-weight:700; color:" & Txt & "; animation:fadeSlideIn 0.8s ease-out; }
			.bar-track-cbl { height:5px; border-radius:3px; background:" & TrackColor & "; margin-top:6px; margin-bottom:4px; }
			.bar-fill-cbl { height:5px; border-radius:3px; background:" & CampusColor & "; animation:barFillCBL 0.8s ease-out forwards; }
			.ratio-text-cbl { font-size:12px; font-weight:700; color:" & CampusColor & "; text-align:right; }
			@keyframes fadeSlideIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
			@keyframes barFillCBL { from { width:0%; } to { width:" & BarW & "%; } }
			@keyframes pulsering { 0%,100% { stroke-opacity:0.9; stroke-width:7; } 50% { stroke-opacity:0.3; stroke-width:5; } }
			</style>
			<div class='card-cbl'>
			<div class='top-bar-cbl'></div>
			<div class='badge-cbl'>CBL</div>
			<div class='att-label-cbl'>Attendance</div>
			<div class='att-num-cbl' id='att-cbl'>" & AttFmt & "</div>
			<div class='circles-row-cbl'>
			<div class='circle-item-cbl'>
			<svg width='64' height='64' overflow='visible'>
			<circle cx='32' cy='32' r='28' fill='none' stroke='" & TrackColor & "' stroke-width='7'/>
			<circle cx='32' cy='32' r='28' fill='none' stroke='" & WoWColor & "' stroke-width='7' stroke-dasharray='" & WoWDash & " " & WoWGap & "' stroke-dashoffset='-44' stroke-linecap='round' class='wow-ring-cbl'/>
			<text x='32' y='36' text-anchor='middle' font-size='10' font-weight='700' fill='" & WoWColor & "' font-family='Inter,sans-serif'>" & WoWLabel & "</text>
			</svg>
			<div class='circle-label-cbl'>WoW</div>
			</div>
			<div class='circle-item-cbl'>
			<svg width='64' height='64' overflow='visible'>
			<circle cx='32' cy='32' r='28' fill='none' stroke='" & TrackColor & "' stroke-width='7'/>
			<circle cx='32' cy='32' r='28' fill='none' stroke='" & YoYColor & "' stroke-width='7' stroke-dasharray='" & YoYDash & " " & YoYGap & "' stroke-dashoffset='-44' stroke-linecap='round' class='yoy-ring-cbl'/>
			<text x='32' y='36' text-anchor='middle' font-size='10' font-weight='700' fill='" & YoYColor & "' font-family='Inter,sans-serif'>" & YoYLabel & "</text>
			</svg>
			<div class='circle-label-cbl'>YoY</div>
			</div>
			</div>
			<hr class='divider-cbl'/>
			<div class='data-row-cbl'>
			<span class='data-label-cbl'>Previous week</span>
			<span class='data-val-cbl'>" & PrevFmt & "</span>
			</div>
			<hr class='divider-cbl'/>
			<div class='data-row-cbl'>
			<span class='data-label-cbl'>Past year avg</span>
			<span class='data-val-cbl'>" & AvgFmt & "</span>
			</div>
			<div class='bar-track-cbl'><div class='bar-fill-cbl'></div></div>
			<div class='ratio-text-cbl'>" & RatioPct & "</div>
			" & SchoolBreakLine & "
			</div>
			<script>
			(function(){
			var el=document.getElementById('att-cbl');
			var target=" & Att & ";
			var duration=1000;
			var startTime=null;
			function ease(t){return 1-Math.pow(1-t,3);}
			function animate(ts){
			if(!startTime)startTime=ts;
			var p=Math.min((ts-startTime)/duration,1);
			el.textContent=Math.floor(ease(p)*target).toLocaleString();
			if(p<1)requestAnimationFrame(animate);
			}
			requestAnimationFrame(animate);
			})();
			</script>"
			```
		lineageTag: 5f1bfaf5-073e-4f8b-b0c0-232127413855

	measure HTML_Card_TRL = ```
			
