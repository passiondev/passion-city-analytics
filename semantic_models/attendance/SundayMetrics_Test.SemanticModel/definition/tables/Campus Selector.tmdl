	measure SermonSpeaker =
			
			VAR _Raw = [SermonTitleRaw]
			VAR _Pos = IF(ISBLANK(_Raw), BLANK(), FIND(" - ", _Raw, 1, BLANK()))
			RETURN
			IF(
			    ISBLANK(_Raw) || ISBLANK(_Pos),
			    BLANK(),
			    TRIM(MID(_Raw, _Pos + 3, LEN(_Raw)))
			)
		lineageTag: 3ae85653-3b71-4b75-aaf5-1daecefe891d

