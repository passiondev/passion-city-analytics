	measure HTML_Card_Overall = ```
			
			VAR Att = [Att]
			VAR PrevWk = [PrevWeekAtt]
			VAR WoW = DIVIDE([CurrWeekAtt] - [PrevWeekAtt], [PrevWeekAtt], 0)
			VAR YoY = DIVIDE([CurrWeekAtt] - [PrevYearAttCount], [PrevYearAttCount], 0)
			VAR PastYrAvg = [Avg_PastYear_Global]
			VAR Ratio = DIVIDE([Att], PastYrAvg, 0)
			VAR RatioPct = FORMAT(Ratio, "0%") & " of avg"
			VAR BarW = FORMAT(MIN(Ratio * 100, 150), "0")
			VAR Bg = [CardBackground]
			VAR Txt = [CardTextColor]
			VAR Sec = [CardSecondaryText]
			VAR IsDark = [SelectedTheme] = "Dark"
			VAR CampusColor = IF(IsDark, "#ffffff", "#111111")
			VAR TrackColor = IF(IsDark, "#2A2A2A", "#E5E7EB")
			VAR BorderColor = IF(IsDark, "#2A2A2A", "#E5E7EB")
			VAR WoWColor = IF(WoW >= 0, IF(IsDark, "#4ADE80", "#166534"), IF(IsDark, "#F87171", "#991B1B"))
			VAR YoYColor = IF(YoY >= 0, IF(IsDark, "#4ADE80", "#166534"), IF(IsDark, "#F87171", "#991B1B"))
			VAR WoWArrow = IF(WoW >= 0, "▲", "▼")
			VAR YoYArrow = IF(YoY >= 0, "▲", "▼")
			VAR WoWPct = FORMAT(ABS(WoW), "0.0%")
			VAR YoYPct = FORMAT(ABS(YoY), "0.0%")
			VAR WoWLabel = WoWArrow & " " & WoWPct
			VAR YoYLabel = YoYArrow & " " & YoYPct
			VAR WoWDash = FORMAT(MIN(ABS(WoW) / 0.5, 1) * 175.93, "0.00")
			VAR WoWGap = FORMAT(175.93 - MIN(ABS(WoW) / 0.5, 1) * 175.93, "0.00")
			VAR YoYDash = FORMAT(MIN(ABS(YoY) / 0.5, 1) * 175.93, "0.00")
			VAR YoYGap = FORMAT(175.93 - MIN(ABS(YoY) / 0.5, 1) * 175.93, "0.00")
			VAR AttFmt = FORMAT(Att, "#,0")
			VAR PrevFmt = FORMAT(PrevWk, "#,0")
			VAR AvgFmt = FORMAT(PastYrAvg, "#,0")
			
			-- Weather icon + holiday line injected here
			VAR WeatherSVG = [WeatherIcon]
			
			
			VAR SelectedDate = MIN('Calendar'[selecteddate])
			VAR SundayHolidayName = 
			    LOOKUPVALUE(
			        'v_sunday_context'[sunday_holiday_names],
			        'v_sunday_context'[service_date], SelectedDate,
			        'v_sunday_context'[campus], "515"
			    )
			VAR AdjacentHolidayName = 
			    LOOKUPVALUE(
			        'v_sunday_context'[adjacent_holiday_names],
			        'v_sunday_context'[service_date], SelectedDate,
			        'v_sunday_context'[campus], "515"
			    )
			VAR IsHoliday = 
			    LOOKUPVALUE(
			        'v_sunday_context'[is_holiday_weekend],
			        'v_sunday_context'[service_date], SelectedDate,
			        'v_sunday_context'[campus], "515"
			    )
			VAR IsSundayHoliday = 
			    LOOKUPVALUE(
			        'v_sunday_context'[is_holiday_sunday],
			        'v_sunday_context'[service_date], SelectedDate,
			        'v_sunday_context'[campus], "515"
			    )
			
			-- Sunday holiday line (amber, white text, no prefix)
			VAR SundayHolidayLine =
			    IF(
			        IsSundayHoliday = TRUE() && SundayHolidayName <> BLANK(),
			        "<div style='display:flex; align-items:center; gap:8px; margin-top:10px;'>
			            <div style='width:3px; align-self:stretch; background:#F5A623; border-radius:2px; flex-shrink:0;'></div>
			            <span style='font-size:11px; font-weight:600; color:#FFFFFF; font-family:Inter,sans-serif; line-height:1.4;'>" & SundayHolidayName & "</span>
			        </div>",
			        ""
			    )
			
			-- Adjacent holiday line (gray, muted text, "Near:" prefix)
			VAR AdjacentHolidayLine =
			    IF(
			        AdjacentHolidayName <> BLANK(),
			        "<div style='display:flex; align-items:center; gap:8px; margin-top:6px;'>
			            <div style='width:3px; align-self:stretch; background:#6B7280; border-radius:2px; flex-shrink:0;'></div>
			            <span style='font-size:11px; font-weight:500; color:" & IF(IsDark, "#9CA3AF", "#6B7280") & "; font-family:Inter,sans-serif; line-height:1.4;'>Near: " & AdjacentHolidayName & "</span>
			        </div>",
			        ""
			    )
			
			-- No holiday fallback
			VAR HolidayLine =
			    IF(
			        IsHoliday = TRUE(),
			        SundayHolidayLine & AdjacentHolidayLine,
			        "<div style='display:flex; align-items:center; gap:8px; margin-top:10px;'>
			            <div style='width:3px; align-self:stretch; background:" & IF(IsDark, "#3A3A3A", "#E5E7EB") & "; border-radius:2px; flex-shrink:0;'></div>
			            <span style='font-size:11px; font-weight:500; color:" & IF(IsDark, "#4B5563", "#9CA3AF") & "; font-family:Inter,sans-serif;'>No holiday this week</span>
			        </div>"
			    )
			
			RETURN
			"<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap');
			.card-overall { background:" & Bg & "; border:1px solid " & BorderColor & "; border-radius:12px; padding:20px; font-family:Inter,sans-serif; position:relative; overflow:hidden; width:100%; box-sizing:border-box; }
			.top-bar-overall { position:absolute; top:0; left:0; right:0; height:10px; background:" & CampusColor & "; border-radius:12px 12px 0 0; }
			.badge-overall { display:inline-block; background:" & CampusColor & "26; color:" & CampusColor & "; padding:4px 14px; border-radius:6px; font-size:13px; font-weight:700; margin-top:6px; }
			.att-label { font-size:12px; font-weight:700; color:" & Sec & "; margin-top:14px; margin-bottom:4px; }
			.att-num { font-size:46px; font-weight:900; color:" & Txt & "; margin:0; animation:fadeSlideIn 0.8s ease-out; }
			.circles-row { display:flex; justify-content:center; gap:40px; margin:16px 0; }
			.circle-item { display:flex; flex-direction:column; align-items:center; gap:4px; }
			.circle-label { font-size:11px; color:" & Sec & "; }
			.divider { border:none; border-top:0.5px solid " & BorderColor & "; margin:12px 0; }
			.data-row { display:flex; justify-content:space-between; align-items:baseline; }
			.data-label { font-size:12px; color:" & Sec & "; }
			.data-val { font-size:20px; font-weight:700; color:" & Txt & "; animation:fadeSlideIn 0.8s ease-out; }
			.bar-track { height:5px; border-radius:3px; background:" & TrackColor & "; margin-top:6px; margin-bottom:4px; overflow:hidden; }
			.bar-fill { height:5px; border-radius:3px; background:" & CampusColor & "; animation:barFill 0.8s ease-out forwards; }
			.ratio-text { font-size:12px; font-weight:700; color:" & CampusColor & "; text-align:right; }
			@keyframes fadeSlideIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
			@keyframes barFill { from { width:0%; } to { width:" & BarW & "%; } }
			@keyframes pulsering { 
			  0%,100% { stroke-opacity:0.9; stroke-width:7; } 
			  50% { stroke-opacity:0.3; stroke-width:5; } 
			} </style>
			<div class='card-overall'>
			<div class='top-bar-overall'></div>
			
			<div style='display:flex; justify-content:space-between; align-items:center; margin-top:6px;'>
			    <div class='badge-overall' style='margin-top:0;'>Global</div>
			    <div style='line-height:0;'>" & WeatherSVG & "</div>
			</div>
			
			<div class='att-label'>Attendance</div>
			<div class='att-num' id='att-overall'>" & AttFmt & "</div>
			<div class='circles-row'>
			<div class='circle-item'>
			<svg width='64' height='64'>
			<circle cx='32' cy='32' r='28' fill='none' stroke='" & TrackColor & "' stroke-width='7'/>
			<circle cx='32' cy='32' r='28' fill='none' stroke='" & WoWColor & "' stroke-width='7' stroke-dasharray='" & WoWDash & " " & WoWGap & "' stroke-dashoffset='-44' stroke-linecap='round' style='animation:pulsering 2s ease-in-out infinite'/>
			<text x='32' y='36' text-anchor='middle' font-size='10' font-weight='700' fill='" & WoWColor & "' font-family='Inter,sans-serif'>" & WoWLabel & "</text>
			</svg>
			<div class='circle-label'>WoW</div>
			</div>
			<div class='circle-item'>
			<svg width='64' height='64'>
			<circle cx='32' cy='32' r='28' fill='none' stroke='" & TrackColor & "' stroke-width='7'/>
			<circle cx='32' cy='32' r='28' fill='none' stroke='" & YoYColor & "' stroke-width='7' stroke-dasharray='" & YoYDash & " " & YoYGap & "' stroke-dashoffset='-44' stroke-linecap='round' style='animation:pulsering 2s ease-in-out infinite 0.5s'/>
			<text x='32' y='36' text-anchor='middle' font-size='10' font-weight='700' fill='" & YoYColor & "' font-family='Inter,sans-serif'>" & YoYLabel & "</text>
			</svg>
			<div class='circle-label'>YoY</div>
			</div>
			</div>
			<hr class='divider'/>
			<div class='data-row'>
			<span class='data-label'>Previous week</span>
			<span class='data-val'>" & PrevFmt & "</span>
			</div>
			<hr class='divider'/>
			<div class='data-row'>
			<span class='data-label'>Past year avg</span>
			<span class='data-val'>" & AvgFmt & "</span>
			</div>
			<div class='bar-track'><div class='bar-fill'></div></div>
			<div class='ratio-text'>" & RatioPct & "</div>
			
			" & HolidayLine & "
			
			</div>
			<script>
			(function(){
			var el=document.getElementById('att-overall');
			var target=" & Att & ";
			var duration=1000;
			var startTime=null;
			function ease(t){return 1-Math.pow(1-t,3);}
			function animate(ts){
			if(!startTime)startTime=ts;
			var p=Math.min((ts-startTime)/duration,1);
			el.textContent=Math.floor(ease(p)*target).toLocaleString();
			if(p<1)requestAnimationFrame(animate);
			}
			requestAnimationFrame(animate);
			})();
			</script>"
			```
		lineageTag: bb9722ea-e62a-4590-a9a1-7167fa7feeae

	measure HTML_Card_515 = ```
			
			VAR Att = [515]
			VAR PrevWk = CALCULATE([PrevWeekAtt], AttendanceInPerson_WOW[CampusName]="515")
			VAR WoW = [WOW_Numeric_515]
			VAR YoY = [YOY_Numeric_515]
			VAR PastYrAvg = [Avg_PastYear_515]
			VAR Ratio = DIVIDE([515], PastYrAvg, 0)
			VAR RatioPct = FORMAT(Ratio, "0%") & " of avg"
			VAR BarW = FORMAT(MIN(Ratio * 100, 150), "0")
			VAR Bg = [CardBackground]
			VAR Txt = [CardTextColor]
			VAR Sec = [CardSecondaryText]
			VAR IsDark = [SelectedTheme] = "Dark"
			VAR CampusColor = "#00B8E4"
			VAR TrackColor = IF(IsDark, "#2A2A2A", "#E5E7EB")
			VAR BorderColor = IF(IsDark, "#2A2A2A", "#E5E7EB")
			VAR WoWColor = IF(WoW >= 0, IF(IsDark, "#4ADE80", "#166534"), IF(IsDark, "#F87171", "#991B1B"))
			VAR YoYColor = IF(YoY >= 0, IF(IsDark, "#4ADE80", "#166534"), IF(IsDark, "#F87171", "#991B1B"))
			VAR WoWArrow = IF(WoW >= 0, "▲", "▼")
			VAR YoYArrow = IF(YoY >= 0, "▲", "▼")
			VAR WoWPct = FORMAT(ABS(WoW), "0.0%")
			VAR YoYPct = FORMAT(ABS(YoY), "0.0%")
			VAR WoWLabel = WoWArrow & " " & WoWPct
			VAR YoYLabel = YoYArrow & " " & YoYPct
			VAR WoWDash = FORMAT(MIN(ABS(WoW) / 0.5, 1) * 175.93, "0.00")
			VAR WoWGap = FORMAT(175.93 - MIN(ABS(WoW) / 0.5, 1) * 175.93, "0.00")
			VAR YoYDash = FORMAT(MIN(ABS(YoY) / 0.5, 1) * 175.93, "0.00")
			VAR YoYGap = FORMAT(175.93 - MIN(ABS(YoY) / 0.5, 1) * 175.93, "0.00")
			VAR AttFmt = FORMAT(Att, "#,0")
			VAR PrevFmt = FORMAT(PrevWk, "#,0")
			VAR AvgFmt = FORMAT(PastYrAvg, "#,0")
			
			-- School break variables
			VAR SelectedDate = MIN('Calendar'[selecteddate])
			VAR IsBreak = 
			    LOOKUPVALUE(
			        'v_sunday_context'[is_school_break],
			        'v_sunday_context'[service_date], SelectedDate,
			        'v_sunday_context'[campus], "515"
			    )
			VAR BreakName = 
			    LOOKUPVALUE(
			        'v_sunday_context'[break_name],
			        'v_sunday_context'[service_date], SelectedDate,
			        'v_sunday_context'[campus], "515"
			    )
			VAR ShareOnBreak = 
			    LOOKUPVALUE(
			        'v_sunday_context'[share_on_break],
			        'v_sunday_context'[service_date], SelectedDate,
			        'v_sunday_context'[campus], "515"
			    )
			VAR BreakAccent = "#60A5FA"
			VAR BreakTextColor = IF(IsDark, "#FFFFFF", "#FFFFFF")
			VAR SharePct = FORMAT(ShareOnBreak, "0%")
			
			VAR SchoolBreakLine = 
			    IF(
			        IsBreak = TRUE() && BreakName <> BLANK(),
			        "<div style='display:flex; align-items:center; gap:8px; margin-top:10px;'>
			            <div style='width:3px; align-self:stretch; background:" & BreakAccent & "; border-radius:2px; flex-shrink:0;'></div>
			            <span style='font-size:11px; font-weight:600; color:" & BreakTextColor & "; font-family:Inter,sans-serif; line-height:1.4;'>" & BreakName & " · " & SharePct & " on break</span>
			        </div>",
			        "<div style='display:flex; align-items:center; gap:8px; margin-top:10px;'>
			            <div style='width:3px; align-self:stretch; background:" & IF(IsDark, "#3A3A3A", "#E5E7EB") & "; border-radius:2px; flex-shrink:0;'></div>
			            <span style='font-size:11px; font-weight:500; color:" & IF(IsDark, "#4B5563", "#9CA3AF") & "; font-family:Inter,sans-serif;'>No school break this week</span>
			        </div>"
			    )
			
			RETURN
			"<!-- theme:" & [SelectedTheme] & " -->
			<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap');
			* { box-sizing:border-box; margin:0; padding:0; }
			.card-515 { background:" & Bg & "; border:1px solid " & BorderColor & "; border-radius:12px; padding:20px; font-family:Inter,sans-serif; position:relative; overflow:hidden; width:100%; }
			.top-bar-515 { position:absolute; top:0; left:0; right:0; height:10px; background:" & CampusColor & "; border-radius:12px 12px 0 0; }
			.badge-515 { display:inline-block; background:" & CampusColor & "26; color:" & CampusColor & "; padding:4px 14px; border-radius:6px; font-size:13px; font-weight:700; margin-top:6px; }
			.att-label-515 { font-size:12px; font-weight:700; color:" & Sec & "; margin-top:14px; margin-bottom:4px; }
			.att-num-515 { font-size:46px; font-weight:900; color:" & Txt & "; margin:0; animation:fadeSlideIn 0.8s ease-out; }
			.circles-row-515 { display:flex; justify-content:center; gap:40px; margin:16px 0; }
			.circle-item-515 { display:flex; flex-direction:column; align-items:center; gap:4px; }
			.circle-label-515 { font-size:11px; color:" & Sec & "; }
			.wow-ring-515 { animation:pulsering 2s ease-in-out infinite; }
			.yoy-ring-515 { animation:pulsering 2s ease-in-out infinite 0.5s; }
			.divider-515 { border:none; border-top:0.5px solid " & BorderColor & "; margin:12px 0; }
			.data-row-515 { display:flex; justify-content:space-between; align-items:baseline; }
			.data-label-515 { font-size:12px; color:" & Sec & "; }
			.data-val-515 { font-size:20px; font-weight:700; color:" & Txt & "; animation:fadeSlideIn 0.8s ease-out; }
			.bar-track-515 { height:5px; border-radius:3px; background:" & TrackColor & "; margin-top:6px; margin-bottom:4px; }
			.bar-fill-515 { height:5px; border-radius:3px; background:" & CampusColor & "; animation:barFill515 0.8s ease-out forwards; }
			.ratio-text-515 { font-size:12px; font-weight:700; color:" & CampusColor & "; text-align:right; }
			@keyframes fadeSlideIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
			@keyframes barFill515 { from { width:0%; } to { width:" & BarW & "%; } }
			@keyframes pulsering { 0%,100% { stroke-opacity:0.9; stroke-width:7; } 50% { stroke-opacity:0.3; stroke-width:5; } }
			</style>
			<div class='card-515'>
			<div class='top-bar-515'></div>
			<div class='badge-515'>515</div>
			<div class='att-label-515'>Attendance</div>
			<div class='att-num-515' id='att-515'>" & AttFmt & "</div>
			<div class='circles-row-515'>
			<div class='circle-item-515'>
			<svg width='64' height='64' overflow='visible'>
			<circle cx='32' cy='32' r='28' fill='none' stroke='" & TrackColor & "' stroke-width='7'/>
			<circle cx='32' cy='32' r='28' fill='none' stroke='" & WoWColor & "' stroke-width='7' stroke-dasharray='" & WoWDash & " " & WoWGap & "' stroke-dashoffset='-44' stroke-linecap='round' class='wow-ring-515'/>
			<text x='32' y='36' text-anchor='middle' font-size='10' font-weight='700' fill='" & WoWColor & "' font-family='Inter,sans-serif'>" & WoWLabel & "</text>
			</svg>
			<div class='circle-label-515'>WoW</div>
			</div>
			<div class='circle-item-515'>
			<svg width='64' height='64' overflow='visible'>
			<circle cx='32' cy='32' r='28' fill='none' stroke='" & TrackColor & "' stroke-width='7'/>
			<circle cx='32' cy='32' r='28' fill='none' stroke='" & YoYColor & "' stroke-width='7' stroke-dasharray='" & YoYDash & " " & YoYGap & "' stroke-dashoffset='-44' stroke-linecap='round' class='yoy-ring-515'/>
			<text x='32' y='36' text-anchor='middle' font-size='10' font-weight='700' fill='" & YoYColor & "' font-family='Inter,sans-serif'>" & YoYLabel & "</text>
			</svg>
			<div class='circle-label-515'>YoY</div>
			</div>
			</div>
			<hr class='divider-515'/>
			<div class='data-row-515'>
			<span class='data-label-515'>Previous week</span>
			<span class='data-val-515'>" & PrevFmt & "</span>
			</div>
			<hr class='divider-515'/>
			<div class='data-row-515'>
			<span class='data-label-515'>Past year avg</span>
			<span class='data-val-515'>" & AvgFmt & "</span>
			</div>
			<div class='bar-track-515'><div class='bar-fill-515'></div></div>
			<div class='ratio-text-515'>" & RatioPct & "</div>
			
			" & SchoolBreakLine & "
			
			</div>
			<script>
			(function(){
			var el=document.getElementById('att-515');
			var target=" & Att & ";
			var duration=1000;
			var startTime=null;
			function ease(t){return 1-Math.pow(1-t,3);}
			function animate(ts){
			if(!startTime)startTime=ts;
			var p=Math.min((ts-startTime)/duration,1);
			el.textContent=Math.floor(ease(p)*target).toLocaleString();
			if(p<1)requestAnimationFrame(animate);
			}
			requestAnimationFrame(animate);
			})();
			</script>"
			```
		lineageTag: f1fbbd12-7455-4b93-a4ac-0ac25006fb88

	measure YOY_Numeric_Trilith = ```
			
			DIVIDE(
			    CALCULATE([CurrWeekAtt], AttendanceInPerson_WOW[CampusName]="Trilith") - 
			    CALCULATE([PrevYearAttCount], AttendanceInPerson_WOW[CampusName]="Trilith"),
			    CALCULATE([PrevYearAttCount], AttendanceInPerson_WOW[CampusName]="Trilith"),
			    0
			)
			```
