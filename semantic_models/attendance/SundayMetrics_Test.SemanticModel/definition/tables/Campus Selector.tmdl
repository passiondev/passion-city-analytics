	measure OnlineAttendance =
			
			VAR _calDate = MINX(VALUES('Calendar'[Date]), 'Calendar'[Date])
			VAR _maxDate = MAXX(ALL(v_gathering_views), DATEVALUE(v_gathering_views[sunday_date]))
			VAR _SelectedDate = IF(YEAR(_calDate) < 2020, _maxDate, _calDate)
			VAR _Sun = FORMAT(_SelectedDate, "YYYY-MM-DD")
			RETURN
			SUMX(
			    FILTER(
			        v_gathering_views,
			        v_gathering_views[sunday_date] = _Sun
			    ),
			    ROUND(v_gathering_views[total_views] * 1.94, 0)
			)
		lineageTag: 28260510-2b85-4459-bc7a-2afe9b4c5ae6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure SermonTitleRaw =
			
			VAR _Start = [MaxselectedDate]
			VAR _End = [MaxselectedDate] + 1
			RETURN
			CALCULATE(
			    SELECTEDVALUE(v_sermon_clips[title]),
			    FILTER(v_sermon_clips, DATEVALUE(v_sermon_clips[published_at]) >= _Start && DATEVALUE(v_sermon_clips[published_at]) <= _End)
			)
		lineageTag: 42eb2b76-7e90-4f81-ab14-4f7d8a8fcfea

	measure SermonTitle =
			
			VAR _Raw = [SermonTitleRaw]
			VAR _Pos = IF(ISBLANK(_Raw), BLANK(), FIND(" - ", _Raw, 1, BLANK()))
			RETURN
			IF(
			    ISBLANK(_Raw) || ISBLANK(_Pos),
			    _Raw,
			    TRIM(LEFT(_Raw, _Pos - 1))
			)
		lineageTag: 6b1003b2-e8eb-45ca-85ae-cd35b3d10913

	measure SermonViews =
			
			VAR _Start = [MaxselectedDate]
			VAR _End = [MaxselectedDate] + 1
			RETURN
			CALCULATE(
			    SUM(v_sermon_clips[total_views]),
			    FILTER(v_sermon_clips, DATEVALUE(v_sermon_clips[published_at]) >= _Start && DATEVALUE(v_sermon_clips[published_at]) <= _End)
			)
		formatString: 0
