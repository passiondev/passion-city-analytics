			        <path d='M8 18 Q4 18 4 13 Q4 8 9 7 Q9 2 16 2 Q22 2 23 7 Q28 7 28 13 Q28 18 24 18 Z' fill='" & CloudColor & "'/>
			        <line x1='10' y1='22' x2='9' y2='27' stroke='" & RainBlue & "' stroke-width='1.5' stroke-linecap='round'/>
