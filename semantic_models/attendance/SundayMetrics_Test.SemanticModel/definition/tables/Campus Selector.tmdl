			<rect x='15' y='1' width='2' height='4' rx='1' fill='" & SunYellow & "' transform='rotate(315 16 16)'/>
			</svg>",
			
			       "partly_cloudy",
			"<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'>
			<circle cx='11' cy='12' r='5' fill='" & SunYellow & "'/>
			<rect x='10' y='2' width='2' height='3' rx='1' fill='" & SunYellow & "'/>
			<rect x='10' y='18' width='2' height='3' rx='1' fill='" & SunYellow & "' transform='rotate(0 11 12)'/>
			<rect x='10' y='2' width='2' height='3' rx='1' fill='" & SunYellow & "' transform='rotate(45 11 12)'/>
			<rect x='10' y='2' width='2' height='3' rx='1' fill='" & SunYellow & "' transform='rotate(90 11 12)'/>
			<rect x='10' y='2' width='2' height='3' rx='1' fill='" & SunYellow & "' transform='rotate(135 11 12)'/>
			<rect x='10' y='2' width='2' height='3' rx='1' fill='" & SunYellow & "' transform='rotate(180 11 12)'/>
			<rect x='10' y='2' width='2' height='3' rx='1' fill='" & SunYellow & "' transform='rotate(225 11 12)'/>
			<rect x='10' y='2' width='2' height='3' rx='1' fill='" & SunYellow & "' transform='rotate(270 11 12)'/>
			<rect x='10' y='2' width='2' height='3' rx='1' fill='" & SunYellow & "' transform='rotate(315 11 12)'/>
			<path d='M9 20 Q5 20 5 24 Q3 24 3 27 Q3 30 7 30 L25 30 Q29 30 29 26 Q29 22 24 22 Q22 19 18 19 Q14 18 11 20 Q10 20 9 20 Z' fill='" & CloudColor & "'/>
			</svg>",
			
			        "cloudy",
			        "<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'>
			        <path d='M8 22 Q4 22 4 17 Q4 12 9 11 Q9 5 16 5 Q22 5 23 11 Q28 11 28 17 Q28 22 24 22 Z' fill='" & CloudColor & "'/>
