	measure HTML_Card1 =
			
			VAR _campus = [HTML_SelectedCampus]
			VAR _monthly = [HTML_MonthlyData]
			VAR _weekly = [HTML_WeeklyData]
			VAR _yoy = [HTML_YoYData]
			VAR _theme = [HTML_Theme]
			VAR _bg = IF(_theme = "Dark", "#0d0d0d", "#f8f8f8")
			VAR _tickc = IF(_theme = "Dark", "#aaaaaa", "#333333")
			VAR _grid = IF(_theme = "Dark", "rgba(255,255,255,0.06)", "rgba(0,0,0,0.08)")
			VAR _bb = IF(_theme = "Dark", "#161616", "#ffffff")
			VAR _tabBg = IF(_theme = "Dark", "#181818", "#eeeeee")
			VAR _tabColor = IF(_theme = "Dark", "#aaaaaa", "#333333")
			VAR _tabBorder = IF(_theme = "Dark", "#252525", "#dddddd")
			VAR _bdgBg = IF(_theme = "Dark", "#181818", "#eeeeee")
			VAR _bdgColor = IF(_theme = "Dark", "#aaaaaa", "#333333")
			VAR _bdgBorder = IF(_theme = "Dark", "#222", "#dddddd")
			VAR _labelColor = IF(_theme = "Dark", "#aaaaaa", "#333333")
			VAR _tooltipBg = IF(_theme = "Dark", "#1a1a1a", "#ffffff")
			VAR _tooltipBorder = IF(_theme = "Dark", "#2a2a2a", "#dddddd")
			VAR _tooltipTitle = IF(_theme = "Dark", "#888", "#999")
			VAR _tooltipBody = IF(_theme = "Dark", "#ffffff", "#111111")
			VAR _c = SUBSTITUTE(_campus, """", "")
			VAR _m = SUBSTITUTE(_monthly, """", "")
			VAR _w = SUBSTITUTE(_weekly, """", "")
			VAR _y = SUBSTITUTE(_yoy, """", "")
			
			VAR _html =
			"<style>*{box-sizing:border-box;margin:0;padding:0;}.w{background:" & _bg & ";border-radius:12px;padding:16px;font-family:sans-serif;width:100%;min-width:0;}.hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:8px;}.tabs{display:flex;gap:6px;flex-wrap:wrap;}.tab{padding:5px 16px;border-radius:20px;font-size:12px;font-weight:500;cursor:pointer;border:1.5px solid " & _tabBorder & ";color:" & _tabColor & ";background:" & _tabBg & ";transition:all 0.15s;}.tab.active{border-color:var(--tc);color:var(--tc);}.bdg{font-size:10px;padding:3px 9px;border-radius:10px;background:" & _bdgBg & ";color:" & _bdgColor & ";border:1px solid " & _bdgBorder & ";}.cb{background:" & _bb & ";border-radius:10px;padding:14px 16px;margin-bottom:10px;}.cb:last-child{margin-bottom:0;}.ct{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:12px;gap:8px;flex-wrap:wrap;}.cl{font-size:10px;color:" & _labelColor & ";text-transform:uppercase;letter-spacing:0.07em;}.lg{display:flex;gap:10px;flex-wrap:wrap;}.li{display:flex;align-items:center;gap:5px;font-size:11px;cursor:pointer;padding:2px 6px;border-radius:4px;border:1px solid transparent;transition:all 0.15s;}.li.hl{border-color:#aaa;}.ls{width:10px;height:3px;border-radius:1px;flex-shrink:0;}.cw{position:relative;width:100%;height:220px;}canvas{width:100%!important;height:100%!important;image-rendering:auto;}</style>" &
			"<div class=""w""><div class=""hdr""><div class=""tabs"">" &
			"<div class=""tab active"" data-c=""Overall"" style=""--tc:" & IF(_theme = "Dark", "#ffffff", "#111111") & ";"">Global</div>" &
			"<div class=""tab"" data-c=""515"" style=""--tc:#00B8E4;"">515</div>" &
			"<div class=""tab"" data-c=""Cumberland"" style=""--tc:#FF641C;"">CBL</div>" &
			"<div class=""tab"" data-c=""Trilith"" style=""--tc:#931EE7;"">Trilith</div>" &
			"</div><div class=""bdg"" id=""bdg"">All campuses</div></div>" &
			"<div id=""gv"">" &
			"<div class=""cb""><div class=""ct""><div class=""cl"">Rolling 12 months</div><div class=""lg"" id=""gl1""></div></div><div class=""cw""><canvas id=""gc1""></canvas></div></div>" &
			"<div class=""cb""><div class=""ct""><div class=""cl"">Rolling 52 weeks</div><div class=""lg"" id=""gl2""></div></div><div class=""cw""><canvas id=""gc2""></canvas></div></div>" &
			"</div>" &
			"<div id=""cv"" style=""display:none;""><div class=""cb""><div class=""ct""><div class=""cl"" id=""yoylbl"">Year over year</div><div class=""lg"" id=""yl""></div></div><div class=""cw""><canvas id=""yc""></canvas></div></div></div>" &
			"</div>" &
			"<script src=""https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js""></script>" &
			"<script>" &
			"var RAW_CAMPUS=""" & _c & """;" &
			"var RAW_MON=""" & _m & """;" &
			"var RAW_WK=""" & _w & """;" &
			"var RAW_YOY=""" & _y & """;" &
			"var GRID=""" & _grid & """;" &
			"var TICKC=""" & _tickc & """;" &
			"var TRBG=""" & _tooltipBg & """;" &
			"var TRBR=""" & _tooltipBorder & """;" &
			"var TRTC=""" & _tooltipTitle & """;" &
			"var TRBC=""" & _tooltipBody & """;" &
			"var IS_DARK=" & IF(_theme = "Dark", "true", "false") & ";" &
			"var C={Overall:{label:""ATL"",color:IS_DARK?""#ffffff"":""#111111"",fill:IS_DARK?""rgba(255,255,255,0.08)"":""rgba(0,0,0,0.06)""},""515"":{label:""515"",color:""#00B8E4"",fill:""rgba(0,184,228,0.12)""},Cumberland:{label:""CBL"",color:""#FF641C"",fill:""rgba(255,100,28,0.12)""},Trilith:{label:""Trilith"",color:""#931EE7"",fill:""rgba(30,231,184,0.10)""}};" &
			"var YR_LINE_DARK=[""#444444"",""#666666"",""#7c6fcd"",""#aaaaaa""];" &
			"var YR_LINE_LIGHT=[""#cccccc"",""#aaaaaa"",""#7c6fcd"",""#666666""];" &
			"var charts={};var activeYr=-1;var activeCampus=""515"";var currentYrs=[];var currentAccent="""";" &
			"function kill(id){if(charts[id]){charts[id].destroy();delete charts[id];}}" &
			"function parse(str){if(!str){return [];}return str.split("","").map(function(v){var n=parseFloat(v);return isNaN(n)?null:n;});}" &
			"function lineColor(yi,total){if(yi===total-1)return currentAccent;return IS_DARK?YR_LINE_DARK[Math.min(yi,YR_LINE_DARK.length-1)]:YR_LINE_LIGHT[Math.min(yi,YR_LINE_LIGHT.length-1)];}" &
			"function baseOpts(xMax){return{responsive:true,maintainAspectRatio:false,devicePixelRatio:2,interaction:{mode:""index"",intersect:false},plugins:{legend:{display:false},tooltip:{backgroundColor:TRBG,borderColor:TRBR,borderWidth:1,titleColor:TRTC,bodyColor:TRBC,padding:9,callbacks:{label:function(c){return "" ""+c.dataset.label+"": ""+(c.parsed.y?Math.round(c.parsed.y).toLocaleString():""—"");}}}},scales:{x:{grid:{color:GRID},ticks:{color:TICKC,font:{size:11},maxRotation:0,autoSkip:true,maxTicksLimit:xMax||8},border:{display:false}},y:{grid:{color:GRID},ticks:{color:TICKC,font:{size:11},callback:function(v){return v>=1000?(v/1000).toFixed(0)+""K"":v;}},border:{display:false}}}}}" &
			"function mkLegGlobal(id,items){var el=document.getElementById(id);if(!el)return;el.innerHTML="""";items.forEach(function(it){var s=document.createElement(""span"");s.className=""li"";s.style.color=it.color;var dot=document.createElement(""span"");dot.className=""ls"";dot.style.background=it.color;s.appendChild(dot);s.appendChild(document.createTextNode(it.label));el.appendChild(s);});}" &
			"function mkLegYoy(id){var el=document.getElementById(id);if(!el)return;el.innerHTML="""";currentYrs.forEach(function(yr,yi){var isSelected=yi===activeYr;var labelCol=isSelected?currentAccent:TICKC;var dotCol=lineColor(yi,currentYrs.length);var s=document.createElement(""span"");s.className=""li""+(isSelected?"" hl"":"""");s.dataset.yi=yi;s.style.color=labelCol;var dot=document.createElement(""span"");dot.className=""ls"";dot.style.background=dotCol;s.appendChild(dot);s.appendChild(document.createTextNode(yr));el.appendChild(s);});document.querySelectorAll(""#yl .li"").forEach(function(el){el.addEventListener(""click"",function(){updateYrHL(parseInt(el.dataset.yi));});});}" &
			"function updateYrHL(yi){var ch=charts.yc;if(!ch)return;if(activeYr===yi){activeYr=-1;}else{activeYr=yi;}var total=currentYrs.length;ch.data.datasets.forEach(function(ds,i){if(activeYr>=0){var isSelected=i===activeYr;ds.borderColor=isSelected?currentAccent:IS_DARK?""#333333"":""#cccccc"";ds.borderWidth=isSelected?3:1;ds.borderDash=isSelected?[]:[4,3];}else{var isLast=i===total-1;ds.borderColor=lineColor(i,total);ds.borderWidth=isLast?2.5:1;ds.borderDash=isLast?[]:[4,3];}});ch.update(""none"");mkLegYoy(""yl"");}" &
			"function setActiveTab(c){document.querySelectorAll("".tab"").forEach(function(x){x.classList.remove(""active"");if(x.dataset.c===c){x.classList.add(""active"");}});}" &
			"function renderGlobal(){setActiveTab(""Overall"");document.getElementById(""gv"").style.display=""block"";document.getElementById(""cv"").style.display=""none"";document.getElementById(""bdg"").textContent=""All campuses"";var mp=RAW_MON.split(""|"");var wp=RAW_WK.split(""|"");var ml=(mp[0]||"""").split("","");var wl=(wp[0]||"""").split("","");var keys=[""Overall"",""515"",""Cumberland"",""Trilith""];mkLegGlobal(""gl1"",keys.map(function(k){return{label:C[k].label,color:C[k].color};}));mkLegGlobal(""gl2"",keys.map(function(k){return{label:C[k].label,color:C[k].color};}));kill(""gc1"");kill(""gc2"");var ds1=keys.map(function(k,i){return{label:C[k].label,data:parse(mp[i+1]),borderColor:C[k].color,backgroundColor:C[k].fill,borderWidth:k===""Overall""?2:1.5,fill:true,tension:0.1,pointRadius:0,pointHoverRadius:4,spanGaps:true};});var ds2=keys.map(function(k,i){return{label:C[k].label,data:parse(wp[i+1]),borderColor:C[k].color,backgroundColor:C[k].fill,borderWidth:k===""Overall""?2:1.5,fill:true,tension:0.1,pointRadius:0,pointHoverRadius:4,spanGaps:true};});var o1=baseOpts(12);o1.scales.x.ticks.autoSkip=false;o1.scales.x.ticks.maxRotation=40;charts.gc1=new Chart(document.getElementById(""gc1""),{type:""line"",data:{labels:ml,datasets:ds1},options:o1});charts.gc2=new Chart(document.getElementById(""gc2""),{type:""line"",data:{labels:wl,datasets:ds2},options:baseOpts(8)});}" &
			"function renderCampus(c){if(!C[c]){renderGlobal();return;}setActiveTab(c);activeCampus=c;activeYr=-1;currentAccent=C[c].color;var lbl=C[c].label;document.getElementById(""gv"").style.display=""none"";document.getElementById(""cv"").style.display=""block"";document.getElementById(""bdg"").textContent=lbl+"" — year over year"";document.getElementById(""yoylbl"").textContent=""Rolling 52 weeks — ""+lbl+"" — year over year"";var sections=RAW_YOY.split(""||"");var wkLabels=(sections[0]||"""").split("","");currentYrs=(sections[1]||"""").split("","").filter(function(x){return x!=="""";});var yearDataParts=(sections[2]||"""").split(""|"");var total=currentYrs.length;kill(""yc"");var ds=currentYrs.map(function(yr,yi){var isLast=yi===total-1;return{label:yr,data:parse(yearDataParts[yi]),borderColor:lineColor(yi,total),backgroundColor:""transparent"",borderWidth:isLast?2.5:1,fill:false,tension:0.2,pointRadius:0,pointHoverRadius:4,borderDash:isLast?[]:[4,3],spanGaps:true};});charts.yc=new Chart(document.getElementById(""yc""),{type:""line"",data:{labels:wkLabels,datasets:ds},options:baseOpts(10)});mkLegYoy(""yl"");}" &
			"document.querySelectorAll("".tab"").forEach(function(t){t.addEventListener(""click"",function(){var c=t.dataset.c;if(c===""Overall""){renderGlobal();}else{renderCampus(c);}});});" &
			"function init(){if(typeof Chart===""undefined""){setTimeout(init,100);return;}if(!RAW_CAMPUS || RAW_CAMPUS===""Overall"" || RAW_CAMPUS===""Global""){renderGlobal();}else{renderCampus(RAW_CAMPUS);}}" &
			"setTimeout(init,100);" &
			"</script>"
			
			RETURN _html
		lineageTag: 2b821bbb-0641-4587-8f82-f696c709680f

	measure Current =
			
			VAR SelectedDate =
			    MINX(VALUES('Calendar'[selecteddate]), 'Calendar'[selecteddate])
			RETURN
			CALCULATE(
			    [CountNew],
			    AttendanceInPerson_WOW[MetricValueDateTime] = SelectedDate
			)
		lineageTag: dd2a68fa-f47e-404a-bd44-54c193078d06

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Previous =
			
			VAR SelectedDate =
			    MINX(VALUES('Calendar'[selecteddate]), 'Calendar'[selecteddate])
			
			VAR SundaysBefore =
			    FILTER(
			        ALL('Calendar'),
			        'Calendar'[Date] < SelectedDate
			            && WEEKDAY('Calendar'[Date], 2) = 7
			    )
			
			VAR PrevDate =
			    MAXX(
			        FILTER(
			            SundaysBefore,
			            VAR ThisDate = 'Calendar'[Date]
			            RETURN
			                CALCULATE(
			                    [CountNew],
			                    AttendanceInPerson_WOW[MetricValueDateTime] = ThisDate
			                ) <> 0
			        ),
			        'Calendar'[Date]
			    )
			
			RETURN
			CALCULATE(
			    [CountNew],
			    AttendanceInPerson_WOW[MetricValueDateTime] = PrevDate
			)
		lineageTag: ffdf81b3-f4ce-45e3-b03e-b94012a0bc15

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure HTML_BarData =
			
			VAR _Categories =
			    FILTER(
			        VALUES(AttendanceInPerson_WOW[Literal]),
			        NOT ISBLANK(AttendanceInPerson_WOW[Literal])
			    )
			RETURN
			CONCATENATEX(
			    _Categories,
			    AttendanceInPerson_WOW[Literal]
			        & "~" & FORMAT(COALESCE([Previous], 0), "0")
			        & "~" & FORMAT(COALESCE([Current], 0), "0"),
			    "|",
			    AttendanceInPerson_WOW[Literal],
			    ASC
			)
		lineageTag: d37f9041-5c13-47c8-8ce1-ffbbd54b40c1

	measure HTML_BarData_All = ```
			
			VAR _calDate = MINX(VALUES('Calendar'[selecteddate]), 'Calendar'[selecteddate])
			VAR _maxAttDate = 
			    MAXX(
			        FILTER(
			            ALL(AttendanceInPerson_WOW[MetricValueDateTime]),
			            WEEKDAY(AttendanceInPerson_WOW[MetricValueDateTime], 2) = 7
			        ),
			        AttendanceInPerson_WOW[MetricValueDateTime]
			    )
			VAR _SelectedDate = IF(YEAR(_calDate) < 2020, _maxAttDate, _calDate)
			
			VAR _PrevDate =
			    MAXX(
			        FILTER(
			            ALL(AttendanceInPerson_WOW[MetricValueDateTime]),
			            AttendanceInPerson_WOW[MetricValueDateTime] < _SelectedDate
			                && WEEKDAY(AttendanceInPerson_WOW[MetricValueDateTime], 2) = 7
			                && CALCULATE(
			                    SUM(AttendanceInPerson_WOW[Count]),
			                    AttendanceInPerson_WOW[CampusName] IN {"515","Cumberland","Trilith"},
			                    REMOVEFILTERS(AttendanceInPerson_WOW[Literal])
			                ) > 0
			        ),
			        AttendanceInPerson_WOW[MetricValueDateTime]
			    )
			
			VAR _Cats =
			    ADDCOLUMNS(
			        FILTER(
			            CALCULATETABLE(
			                VALUES(AttendanceInPerson_WOW[Literal]),
			                REMOVEFILTERS(AttendanceInPerson_WOW[CampusName])
			            ),
			            NOT ISBLANK(AttendanceInPerson_WOW[Literal])
			        ),
			        "__Sort",
			            SWITCH(
			                AttendanceInPerson_WOW[Literal],
			                "Adults", 1,
			                "Door Holder", 2,
			                "bloom", 3,
			                "PK", 4,
			                "MS", 5,
			                "HS", 6,
			                99
			            )
			    )
			
			VAR _Global =
			    CONCATENATEX(
			        _Cats,
			        VAR _lit = AttendanceInPerson_WOW[Literal]
			        RETURN
			            _lit
			            & "~" &
			            FORMAT(
			                COALESCE(
			                    CALCULATE(
			                        SUM(AttendanceInPerson_WOW[Count]),
			                        REMOVEFILTERS('Campus Selector'),
			                        REMOVEFILTERS(AttendanceInPerson_WOW[CampusName]),
			                        AttendanceInPerson_WOW[CampusName] IN {"515","Cumberland","Trilith"},
			                        AttendanceInPerson_WOW[Literal] = _lit,
			                        AttendanceInPerson_WOW[MetricValueDateTime] = _PrevDate
			                    ),
			                    0
			                ),
			                "0"
			            )
			            & "~" &
			            FORMAT(
			                COALESCE(
			                    CALCULATE(
			                        SUM(AttendanceInPerson_WOW[Count]),
			                        REMOVEFILTERS('Campus Selector'),
			                        REMOVEFILTERS(AttendanceInPerson_WOW[CampusName]),
			                        AttendanceInPerson_WOW[CampusName] IN {"515","Cumberland","Trilith"},
