			@keyframes pulsering { 0%,100% { stroke-opacity:0.9; stroke-width:7; } 50% { stroke-opacity:0.3; stroke-width:5; } }
			</style>
			<div class='card-trl'>
			<div class='top-bar-trl'></div>
			<div class='badge-trl'>TRL</div>
