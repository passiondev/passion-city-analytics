	measure HTML_CurrentVsPreviousBarChart =
			
			
			VAR _theme = [HTML_Theme]
			
			VAR _campus = [HTML_SelectedCampus]
			
			VAR _data = SUBSTITUTE([HTML_BarData_All], """", "")
			
			VAR _isDark = _theme = "Dark"
			
			VAR _bg = IF(_isDark, "#0d0d0d", "#f8f8f8")
			
			VAR _cardBg = IF(_isDark, "#161616", "#ffffff")
			
			VAR _txt = IF(_isDark, "#aaaaaa", "#333333")
			
			VAR _tabBg = IF(_isDark, "#181818", "#eeeeee")
			
			VAR _tabColor = IF(_isDark, "#aaaaaa", "#333333")
			
			VAR _tabBorder = IF(_isDark, "#252525", "#dddddd")
			
			VAR _bdgBg = IF(_isDark, "#181818", "#eeeeee")
			
			VAR _bdgColor = IF(_isDark, "#aaaaaa", "#333333")
			
			VAR _bdgBorder = IF(_isDark, "#222", "#dddddd")
			
			VAR _grid = IF(_isDark, "rgba(255,255,255,0.06)", "rgba(0,0,0,0.08)")
			
			VAR _axisColor = IF(_isDark, "#555555", "#cccccc")
			
			VAR _prevColor = IF(_isDark, "#444444", "#cccccc")
			
			VAR _calDate = MINX(VALUES('Calendar'[selecteddate]), 'Calendar'[selecteddate])
			
			VAR _maxAttDate = MAXX(
			
			FILTER(
			
			ALL(AttendanceInPerson_WOW[MetricValueDateTime]),
			
			WEEKDAY(AttendanceInPerson_WOW[MetricValueDateTime], 2) = 7
			
			),
			
			AttendanceInPerson_WOW[MetricValueDateTime]
			
			)
			
			VAR _SelectedDate = IF(YEAR(_calDate) < 2020, _maxAttDate, _calDate)
			
			VAR _PrevDate = MAXX(
			
			FILTER(
			
			ALL(AttendanceInPerson_WOW[MetricValueDateTime]),
			
			AttendanceInPerson_WOW[MetricValueDateTime] < _SelectedDate
			
			&& WEEKDAY(AttendanceInPerson_WOW[MetricValueDateTime], 2) = 7
			
			&& CALCULATE(
			
			SUM(AttendanceInPerson_WOW[Count]),
			
			AttendanceInPerson_WOW[CampusName] IN {"515","Cumberland","Trilith"},
			
			REMOVEFILTERS(AttendanceInPerson_WOW[Literal])
			
			) > 0
			
			),
			
			AttendanceInPerson_WOW[MetricValueDateTime]
			
			)
			
			VAR _prevDateFmt = FORMAT(_PrevDate, "M/D/YYYY")
			
			VAR _curDateFmt = FORMAT(_SelectedDate, "M/D/YYYY")
			
			RETURN
			
			"<style>*{box-sizing:border-box;margin:0;padding:0;}.w{background:" & _bg & ";border-radius:12px;padding:16px;font-family:sans-serif;width:630px;min-width:630px;}.hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:8px;}.tabs{display:flex;gap:6px;flex-wrap:wrap;}.tab{padding:5px 14px;border-radius:20px;font-size:12px;font-weight:500;cursor:pointer;border:1.5px solid " & _tabBorder & ";color:" & _tabColor & ";background:" & _tabBg & ";transition:all 0.15s;}.tab.active{border-color:var(--tc);color:var(--tc);}.bdg{font-size:10px;padding:3px 9px;border-radius:10px;background:" & _bdgBg & ";color:" & _bdgColor & ";border:1px solid " & _bdgBorder & ";}.cb{background:" & _cardBg & ";border-radius:10px;padding:14px 16px;}.top-row{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:22px;}.card-label{font-size:10px;color:" & _txt & ";text-transform:uppercase;letter-spacing:0.07em;}.legend-wrap{display:flex;flex-direction:column;align-items:flex-end;gap:3px;}.legend{display:flex;gap:12px;}.leg{display:flex;align-items:center;gap:5px;font-size:11px;color:" & _txt & ";}.leg-dot{width:8px;height:8px;border-radius:50%;}.dates{font-size:10px;color:" & _txt & ";opacity:0.6;display:flex;gap:12px;}.chart-wrap{display:flex;gap:6px;}.y-axis{width:36px;flex-shrink:0;display:flex;flex-direction:column;justify-content:space-between;height:200px;padding-top:2px;}.y-lbl{font-size:10px;color:" & _axisColor & ";text-align:right;}.chart-right{flex:1;display:flex;flex-direction:column;}.bars-outer{position:relative;height:200px;}.grid-lines{position:absolute;top:0;left:0;right:0;bottom:0;display:flex;flex-direction:column;justify-content:space-between;pointer-events:none;}.grid-line{width:100%;height:1px;background:" & _grid & ";}.bars-inner{position:absolute;top:0;left:0;right:0;bottom:0;display:flex;align-items:flex-end;gap:2px;}.grp{flex:1;height:100%;display:flex;align-items:flex-end;justify-content:center;gap:2px;}.barbox{position:relative;width:22px;height:100%;display:flex;align-items:flex-end;justify-content:center;}.val{position:absolute;font-size:9px;font-weight:600;color:" & _txt & ";opacity:0;animation:fadeIn 0.4s ease forwards;text-align:center;width:100%;white-space:nowrap;}.bar{width:22px;border-radius:3px 3px 0 0;height:0px;position:absolute;bottom:0;}.labels-row{display:flex;margin-top:6px;gap:2px;}.lbl-cell{flex:1;text-align:center;font-size:9px;color:" & _txt & ";white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}@keyframes fadeIn{from{opacity:0;}to{opacity:1;}}</style>" &
			
			"<div class=""w""><div class=""hdr""><div class=""tabs"">" &
			
			"<div class=""tab active"" data-i=""0"" style=""--tc:" & IF(_isDark, "#ffffff", "#111111") & ";"">Global</div>" &
			
			"<div class=""tab"" data-i=""1"" style=""--tc:#00B8E4;"">515</div>" &
			
			"<div class=""tab"" data-i=""2"" style=""--tc:#FF641C;"">CBL</div>" &
			
			"<div class=""tab"" data-i=""3"" style=""--tc:#931EE7;"">Trilith</div>" &
			
			"</div><div class=""bdg"" id=""bdg"">All campuses</div></div>" &
			
			"<div class=""cb"">" &
			
			"<div class=""top-row""><div class=""card-label"">Current vs previous week</div>" &
			
			"<div class=""legend-wrap""><div class=""legend"">" &
			
			"<span class=""leg""><span class=""leg-dot"" id=""prev-dot""></span>Previous</span>" &
			
			"<span class=""leg""><span class=""leg-dot"" id=""curr-dot""></span>Current</span>" &
			
			"</div><div class=""dates""><span>" & _prevDateFmt & "</span><span>" & _curDateFmt & "</span></div></div></div>" &
			
			"<div class=""chart-wrap"">" &
			
			"<div class=""y-axis"" id=""y-axis""></div>" &
			
			"<div class=""chart-right"">" &
			
			"<div class=""bars-outer"">" &
			
			"<div class=""grid-lines"" id=""grid-lines""></div>" &
			
			"<div class=""bars-inner"" id=""bars-inner""></div>" &
			
			"</div>" &
			
			"<div class=""labels-row"" id=""labels-row""></div>" &
			
			"</div></div></div></div>" &
			
			"<script>(function(){" &
			
			"var RAW=""" & _data & """;" &
			
			"var IS_DARK=" & IF(_isDark, "true", "false") & ";" &
			
			"var CAMPUS=[{name:""Global"",badge:""All campuses"",cur:IS_DARK?""#ffffff"":""#111111"",prev:""" & _prevColor & """},{name:""515"",badge:""515"",cur:""#00B8E4"",prev:""#005f77""},{name:""CBL"",badge:""CBL"",cur:""#FF641C"",prev:""#8a3410""},{name:""Trilith"",badge:""Trilith"",cur:""#931EE7"",prev:""#4c0f78""}];" &
			
			"function getInitialIndex(){var c=""" & SUBSTITUTE(_campus, """", "") & """;if(c===""515"")return 1;if(c===""Cumberland"")return 2;if(c===""Trilith"")return 3;return 0;}" &
			
			"function parseBlock(i){var block=RAW.split(""||"")[i]||"""";return block.split(""|"").map(function(r){var p=r.split(""~"");return{label:p[0],prev:Number(p[1])||0,cur:Number(p[2])||0};}).filter(function(x){return x.label;});}" &
			
			"function animateBars(){" &
			
			"var groups=document.querySelectorAll("".grp"");" &
			
			"var ease=function(t){return 1-Math.pow(1-t,3);};" &
			
			"groups.forEach(function(grp,gi){" &
			
			"var bars=grp.querySelectorAll("".bar"");" &
			
			"bars.forEach(function(b){" &
			
			"var target=parseInt(b.dataset.h)||0;" &
			
			"var valEl=b.parentNode.querySelector("".val"");" &
			
			"b.style.height=""0px"";" &
			
			"setTimeout(function(){" &
			
			"var start=null;" &
			
			"requestAnimationFrame(function run(ts){" &
			
			"if(!start)start=ts;" &
			
			"var p=Math.min((ts-start)/500,1);" &
			
			"var h=Math.round(ease(p)*target);" &
			
			"b.style.height=h+""px"";" &
			
			"if(valEl)valEl.style.bottom=(h+3)+""px"";" &
			
			"if(p<1)requestAnimationFrame(run);" &
			
			"});" &
			
			"},gi*80);" &
			
			"});});}" &
			
			"function render(i){" &
			
			"var c=CAMPUS[i];var rows=parseBlock(i);var max=1;" &
			
			"rows.forEach(function(r){max=Math.max(max,r.prev,r.cur);});" &
			
			"var steps=4;var raw=max/steps;var mag=Math.pow(10,Math.floor(Math.log10(raw)));var f=raw/mag;var e=1e-9;" &
			
			"var nf=f<=2?Math.ceil(f*10-e)/10:(f<=4?Math.ceil(f*5-e)/5:Math.ceil(f*2.5-e)/2.5);" &
			
			"var stepVal=Math.round(nf*10)*mag/10;" &
			
			"if(!stepVal||stepVal<=0)stepVal=1000;var yMax=stepVal*steps;var barH=200;" &
			
			"document.getElementById(""bdg"").textContent=c.badge;" &
			
			"document.getElementById(""prev-dot"").style.background=c.prev;" &
			
			"document.getElementById(""curr-dot"").style.background=c.cur;" &
			
			"var yHtml="""";for(var s=steps;s>=0;s--){var v=stepVal*s;var lbl;if(v>=1000&&v%100===0){var kv=v/1000;lbl=(kv%1===0?kv:kv.toFixed(1))+""K"";}else{lbl=v.toLocaleString();}yHtml+=""<div class='y-lbl'>""+lbl+""</div>"";}document.getElementById(""y-axis"").innerHTML=yHtml;" &
			
			"var glHtml="""";for(var g=0;g<=steps;g++){glHtml+=""<div class='grid-line'></div>"";}document.getElementById(""grid-lines"").innerHTML=glHtml;" &
			
			"var bHtml="""";var lHtml="""";rows.forEach(function(r,idx){" &
			
			"var ph=yMax>0?(r.prev/yMax)*100:0;" &
			
			"var ch=yMax>0?(r.cur/yMax)*100:0;" &
			
			"var ph_px=r.prev>0?Math.max(Math.round(ph*barH/100),3):3;" &
			
			"var ch_px=r.cur>0?Math.max(Math.round(ch*barH/100),3):3;" &
			
			"var valDelay=(idx*0.06+0.4).toFixed(2);" &
			
			"bHtml+=""<div class='grp'>"";" &
			
			"bHtml+=""<div class='barbox'><div class='val' style='bottom:5px;animation-delay:""+valDelay+""s'>""+r.prev.toLocaleString()+""</div><div class='bar' data-h='""+ph_px+""' style='background:""+c.prev+""'></div></div>"";" &
			
			"bHtml+=""<div class='barbox'><div class='val' style='bottom:5px;animation-delay:""+valDelay+""s'>""+r.cur.toLocaleString()+""</div><div class='bar' data-h='""+ch_px+""' style='background:""+c.cur+""'></div></div>"";" &
			
			"bHtml+=""</div>"";" &
			
			"lHtml+=""<div class='lbl-cell'>""+r.label+""</div>"";" &
			
			"});" &
			
			"document.getElementById(""bars-inner"").innerHTML=bHtml;" &
			
			"document.getElementById(""labels-row"").innerHTML=lHtml;" &
			
			"requestAnimationFrame(function(){requestAnimationFrame(function(){animateBars();});});" &
			
			"document.querySelectorAll("".tab"").forEach(function(t){t.classList.remove(""active"");if(Number(t.dataset.i)===i)t.classList.add(""active"");});}" &
			
			"document.querySelectorAll("".tab"").forEach(function(t){t.addEventListener(""click"",function(){render(Number(t.dataset.i));});});" &
			
			"render(getInitialIndex());" &
			
			"})();</script>"
		lineageTag: 4ec8af40-d247-4dde-a3a9-de7db15c905d

	measure HTML_5WeekData =
			
			VAR _calDate = MINX(VALUES('Calendar'[selecteddate]), 'Calendar'[selecteddate])
			VAR _maxAttDate = MAXX(
			    FILTER(
			        ALL(AttendanceInPerson_WOW[MetricValueDateTime]),
			        WEEKDAY(AttendanceInPerson_WOW[MetricValueDateTime], 2) = 7
			    ),
			    AttendanceInPerson_WOW[MetricValueDateTime]
			)
			VAR _SelectedDate = IF(YEAR(_calDate) < 2020, _maxAttDate, _calDate)
			VAR _5Weeks = TOPN(
			    5,
			    FILTER(
			        SUMMARIZE(
			            AttendanceInPerson_WOW,
			            AttendanceInPerson_WOW[MetricValueDateTime]
			        ),
			        AttendanceInPerson_WOW[MetricValueDateTime] <= _SelectedDate
			            && WEEKDAY(AttendanceInPerson_WOW[MetricValueDateTime], 2) = 7
			            && CALCULATE(
			                SUM(AttendanceInPerson_WOW[Count]),
			                AttendanceInPerson_WOW[CampusName] IN {"515","Cumberland","Trilith"},
			                REMOVEFILTERS(AttendanceInPerson_WOW[Literal])
			            ) > 0
			    ),
			    AttendanceInPerson_WOW[MetricValueDateTime], DESC
			)
			VAR _Sorted = ADDCOLUMNS(_5Weeks, "__d", AttendanceInPerson_WOW[MetricValueDateTime])
			VAR _Labels = CONCATENATEX(_Sorted, FORMAT(AttendanceInPerson_WOW[MetricValueDateTime], "MMM D~YYYY"), ",", [__d], ASC)
			VAR _ATL = CONCATENATEX(_Sorted,
			    FORMAT(COALESCE(CALCULATE(SUM(AttendanceInPerson_WOW[Count]), AttendanceInPerson_WOW[CampusName] IN {"515","Cumberland","Trilith"}, REMOVEFILTERS(AttendanceInPerson_WOW[Literal])), 0), "0"),
			    ",", [__d], ASC)
			VAR _515 = CONCATENATEX(_Sorted,
			    FORMAT(COALESCE(CALCULATE(SUM(AttendanceInPerson_WOW[Count]), AttendanceInPerson_WOW[CampusName] = "515", REMOVEFILTERS(AttendanceInPerson_WOW[Literal])), 0), "0"),
			    ",", [__d], ASC)
			VAR _CBL = CONCATENATEX(_Sorted,
			    FORMAT(COALESCE(CALCULATE(SUM(AttendanceInPerson_WOW[Count]), AttendanceInPerson_WOW[CampusName] = "Cumberland", REMOVEFILTERS(AttendanceInPerson_WOW[Literal])), 0), "0"),
			    ",", [__d], ASC)
			VAR _TRL = CONCATENATEX(_Sorted,
			    FORMAT(COALESCE(CALCULATE(SUM(AttendanceInPerson_WOW[Count]), AttendanceInPerson_WOW[CampusName] = "Trilith", REMOVEFILTERS(AttendanceInPerson_WOW[Literal])), 0), "0"),
			    ",", [__d], ASC)
			RETURN
			    _Labels & "|" & _ATL & "|" & _515 & "|" & _CBL & "|" & _TRL
		lineageTag: a6219606-0038-4f6e-96dc-45c0d6d098ad

	measure HTML_5WeekOverview =
			
			VAR _theme = [HTML_Theme]
			VAR _campus = [HTML_SelectedCampus]
			VAR _data = SUBSTITUTE([HTML_5WeekData], """", "")
			VAR _isDark = _theme = "Dark"
			VAR _bg = IF(_isDark, "#0d0d0d", "#f8f8f8")
			VAR _cardBg = IF(_isDark, "#161616", "#ffffff")
			VAR _txt = IF(_isDark, "#aaaaaa", "#333333")
			VAR _tabBg = IF(_isDark, "#181818", "#eeeeee")
			VAR _tabColor = IF(_isDark, "#aaaaaa", "#333333")
			VAR _tabBorder = IF(_isDark, "#252525", "#dddddd")
			VAR _grid = IF(_isDark, "rgba(255,255,255,0.06)", "rgba(0,0,0,0.08)")
			VAR _axisColor = IF(_isDark, "#555555", "#cccccc")
			VAR _avgBg = IF(_isDark, "#161616", "#ffffff")
			VAR _avgBorder = IF(_isDark, "#222222", "#dddddd")
			
			RETURN
			"<style>*{box-sizing:border-box;margin:0;padding:0;}.w{background:" & _bg & ";border-radius:12px;padding:16px;font-family:sans-serif;width:630px;min-width:630px;}.hdr{display:flex;align-items:center;gap:6px;margin-bottom:14px;flex-wrap:wrap;}.tabs{display:flex;gap:6px;flex-wrap:wrap;}.tab{padding:5px 14px;border-radius:20px;font-size:12px;font-weight:500;cursor:pointer;border:1.5px solid " & _tabBorder & ";color:" & _tabColor & ";background:" & _tabBg & ";transition:all 0.15s;}.tab.active{border-color:var(--tc);color:var(--tc);}.avg-pill{margin-left:auto;background:" & _avgBg & ";border-radius:8px;padding:5px 14px;border:1px solid " & _avgBorder & ";text-align:center;flex-shrink:0;}.avg-lbl{font-size:9px;color:" & _axisColor & ";text-transform:uppercase;letter-spacing:0.07em;}.avg-val{font-size:16px;font-weight:700;}.cb{background:" & _cardBg & ";border-radius:10px;padding:14px 16px;}.card-label{font-size:10px;color:" & _txt & ";text-transform:uppercase;letter-spacing:0.07em;margin-bottom:12px;}.chart-wrap{display:flex;gap:6px;}.y-axis{width:36px;flex-shrink:0;display:flex;flex-direction:column;justify-content:space-between;height:200px;padding-top:2px;}.y-lbl{font-size:10px;color:" & _axisColor & ";text-align:right;}.chart-right{flex:1;display:flex;flex-direction:column;}.canvas-wrap{position:relative;height:200px;}.canvas-wrap canvas{position:absolute;top:0;left:0;width:100%;height:100%;}.labels-row{display:flex;margin-top:8px;}.lbl-cell{flex:1;text-align:center;font-size:9px;color:" & _txt & ";white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}</style>" &
			"<div class=""w""><div class=""hdr""><div class=""tabs"">" &
			"<div class=""tab active"" data-i=""0"" style=""--tc:" & IF(_isDark, "#ffffff", "#111111") & ";"">Global</div>" &
			"<div class=""tab"" data-i=""1"" style=""--tc:#00B8E4;"">515</div>" &
			"<div class=""tab"" data-i=""2"" style=""--tc:#FF641C;"">CBL</div>" &
			"<div class=""tab"" data-i=""3"" style=""--tc:#931EE7;"">Trilith</div>" &
			"</div>" &
			"<div class=""avg-pill""><div class=""avg-lbl"">5 Week Avg</div><div class=""avg-val"" id=""avg-val"">—</div></div>" &
			"</div>" &
			"<div class=""cb""><div class=""card-label"">5 week overview</div>" &
			"<div class=""chart-wrap""><div class=""y-axis"" id=""y-axis""></div>" &
			"<div class=""chart-right""><div class=""canvas-wrap"">" &
			"<canvas id=""chart-canvas""></canvas>" &
			"</div><div class=""labels-row"" id=""labels-row""></div>" &
			"</div></div></div></div>" &
			"<script>(function(){" &
			"var RAW=""" & _data & """;" &
			"var IS_DARK=" & IF(_isDark, "true", "false") & ";" &
			"var GRID=""" & _grid & """;" &
			"var AXISCOL=""" & _axisColor & """;" &
			"var TXTCOL=""" & _txt & """;" &
			"var CAMPUS=[" &
			"{color:IS_DARK?""#ffffff"":""#111111""}," &
			"{color:""#00B8E4""}," &
			"{color:""#FF641C""}," &
			"{color:""#931EE7""}" &
			"];" &
			"function getIdx(){var c=""" & SUBSTITUTE(_campus, """", "") & """;if(c===""515"")return 1;if(c===""Cumberland"")return 2;if(c===""Trilith"")return 3;return 0;}" &
			"function parse(s){return s.split("","").map(function(v){return parseInt(v)||0;});}" &
			"var animId=null;" &
			"var bounce=function(t){var n=7.5625,d=2.75;if(t<1/d)return n*t*t;else if(t<2/d)return n*(t-=1.5/d)*t+0.75;else if(t<2.5/d)return n*(t-=2.25/d)*t+0.9375;return n*(t-=2.625/d)*t+0.984375;};" &
			"var eio=function(t){return t<0.5?2*t*t:1-Math.pow(-2*t+2,2)/2;};" &
			"function render(i){" &
			"if(animId)cancelAnimationFrame(animId);" &
			"var c=CAMPUS[i];" &
			"var parts=RAW.split(""|"");" &
			"var labels=parts[0].split("","");" &
			"var vals=parse(parts[i+1]);" &
			"var a=Math.round(vals.reduce(function(s,v){return s+v;},0)/vals.length);" &
			"var avgEl=document.getElementById(""avg-val"");" &
			"avgEl.style.color=c.color;" &
			"(function(){var start=null;var dur=800;var ease=function(t){return 1-Math.pow(1-t,3);};function tick(ts){if(!start)start=ts;var p=Math.min((ts-start)/dur,1);avgEl.textContent=Math.floor(ease(p)*a).toLocaleString();if(p<1)requestAnimationFrame(tick);}requestAnimationFrame(tick);})();" &
			"var max=Math.max.apply(null,vals);var min=Math.min.apply(null,vals);" &
			"var pad=Math.round((max-min)*0.4);var yMax=max+pad;var yMin=Math.max(0,min-pad);" &
			"var steps=4;var raw=(yMax-yMin)/steps;" &
			"var mag=Math.pow(10,Math.floor(Math.log10(raw||1)));var stepVal=Math.ceil(raw/mag)*mag||1000;" &
			"yMax=yMin+stepVal*steps;" &
			"var yHtml="""";for(var s=steps;s>=0;s--){var v=yMin+stepVal*s;yHtml+=""<div class='y-lbl'>""+( v>=1000?(v/1000).toFixed(1)+""K"":v)+""</div>"";}document.getElementById(""y-axis"").innerHTML=yHtml;" &
			"var lHtml="""";var prevYr="""";labels.forEach(function(l){var sp=l.split(""~"");var dateStr=sp[0];var yr=sp[1];var display=dateStr+(yr!==prevYr?"" ""+yr:"""");prevYr=yr;lHtml+=""<div class='lbl-cell'>""+display+""</div>"";});document.getElementById(""labels-row"").innerHTML=lHtml;" &
			"var canvas=document.getElementById(""chart-canvas"");" &
			"var W=canvas.parentNode.offsetWidth||500;var H=canvas.parentNode.offsetHeight||200;" &
			"canvas.width=W*2;canvas.height=H*2;canvas.style.width=W+""px"";canvas.style.height=H+""px"";" &
			"var ctx=canvas.getContext(""2d"");ctx.scale(2,2);" &
			"var PT=20;var PB=4;var PL=30;var PR=30;" &
			"var cW=W-PL-PR;var cH=H-PT-PB;var n=vals.length;" &
			"function xp(idx){return PL+idx*(cW/(n-1));}" &
			"function yp(v){return PT+cH-(((v-yMin)/(yMax-yMin))*cH);}" &
			"var pts=vals.map(function(v,idx){return{x:xp(idx),y:yp(v),v:v};});" &
			"function drawGrid(){for(var g=0;g<=steps;g++){var gy=PT+g*(cH/steps);ctx.strokeStyle=GRID;ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(PL,gy);ctx.lineTo(W-PR,gy);ctx.stroke();}}" &
			"var LINE_DUR=600;var LABEL_DUR=400;var TOTAL=LINE_DUR+LABEL_DUR+200;" &
			"var startT=null;" &
			"function frame(ts){" &
			"if(!startT)startT=ts;" &
			"var elapsed=ts-startT;" &
			"ctx.clearRect(0,0,W,H);drawGrid();" &
			"var lp=Math.min(elapsed/LINE_DUR,1);var lep=eio(lp);var maxIdx=lep*(n-1);" &
			"ctx.beginPath();ctx.strokeStyle=c.color;ctx.lineWidth=2.5;ctx.lineJoin=""round"";ctx.lineCap=""round"";" &
			"pts.forEach(function(p,idx){" &
			"if(idx===0){ctx.moveTo(p.x,p.y);return;}" &
			"if(idx<=maxIdx){ctx.lineTo(p.x,p.y);}" &
			"else if(idx-1<maxIdx){" &
			"var frac=maxIdx-(idx-1);" &
			"ctx.lineTo(pts[idx-1].x+(p.x-pts[idx-1].x)*frac,pts[idx-1].y+(p.y-pts[idx-1].y)*frac);" &
			"}" &
			"});ctx.stroke();" &
			"pts.forEach(function(p,idx){if(idx<=maxIdx){ctx.beginPath();ctx.fillStyle=c.color;ctx.arc(p.x,p.y,3.5,0,Math.PI*2);ctx.fill();}});" &
			"if(elapsed>LINE_DUR){" &
			"var la=(elapsed-LINE_DUR)/LABEL_DUR;" &
			"pts.forEach(function(p,idx){" &
			"var delay=idx/n;" &
			"var pt=Math.max(0,(la-delay)/0.4);" &
			"var ep=bounce(Math.min(pt,1));" &
			"if(ep>0){" &
			"ctx.globalAlpha=Math.min(ep*2,1);" &
			"ctx.fillStyle=c.color;ctx.font=""bold 11px sans-serif"";ctx.textAlign=""center"";" &
			"ctx.fillText(p.v.toLocaleString(),p.x,p.y-10);" &
			"ctx.globalAlpha=1;" &
			"}" &
			"});" &
			"}" &
			"if(elapsed<TOTAL)animId=requestAnimationFrame(frame);else animId=null;" &
			"}" &
			"animId=requestAnimationFrame(frame);" &
			"document.querySelectorAll("".tab"").forEach(function(t){t.classList.remove(""active"");if(Number(t.dataset.i)===i)t.classList.add(""active"");});}" &
			"document.querySelectorAll("".tab"").forEach(function(t){t.addEventListener(""click"",function(){render(Number(t.dataset.i));});});" &
			"setTimeout(function(){render(getIdx());},50);" &
			"})();</script>"
		lineageTag: 371d3651-b6fb-4f6e-aa01-13292d1f464e

	measure HTML_RegularSundayTable =
			
			VAR _theme = [HTML_Theme]
			VAR _isDark = _theme = "Dark"
			
			VAR _bg = IF(_isDark, "#080808", "#f8f8f8")
			VAR _cardBg = IF(_isDark, "#121212", "#ffffff")
			VAR _txt = IF(_isDark, "#f7f7f7", "#222222")
			VAR _muted = IF(_isDark, "#d6d6d6", "#555555")
			VAR _soft = IF(_isDark, "#9f9f9f", "#777777")
			VAR _line = IF(_isDark, "rgba(255,255,255,0.16)", "rgba(0,0,0,0.12)")
			VAR _headBg = IF(_isDark, "rgba(255,255,255,0.05)", "rgba(0,0,0,0.04)")
			
			VAR _calDate =
			    MINX(VALUES('Calendar'[selecteddate]), 'Calendar'[selecteddate])
			
			VAR _rawDate =
			    IF(
			        ISBLANK(_calDate) || YEAR(_calDate) < 2020,
			        MAXX(ALL(AttendanceInPerson_WOW), AttendanceInPerson_WOW[MetricValueDateTime]),
			        _calDate
			    )
			
			VAR _SelectedDate =
			    MAXX(
			        FILTER(
			            ALL(AttendanceInPerson_WOW),
			            AttendanceInPerson_WOW[MetricValueDateTime] <= _rawDate
			                && AttendanceInPerson_WOW[ScheduleName] IN {"9:30am", "11:45am", "5:00pm"}
			        ),
			        AttendanceInPerson_WOW[MetricValueDateTime]
			    )
			
			VAR _PrevDate =
			    MAXX(
			        FILTER(
			            ALL(AttendanceInPerson_WOW),
			            AttendanceInPerson_WOW[MetricValueDateTime] < _SelectedDate
			                && AttendanceInPerson_WOW[ScheduleName] IN {"9:30am", "11:45am", "5:00pm"}
			        ),
			        AttendanceInPerson_WOW[MetricValueDateTime]
			    )
			
			VAR _YoYDate =
			    MAXX(
			        FILTER(
			            ALL(AttendanceInPerson_WOW),
			            AttendanceInPerson_WOW[MetricValueDateTime] <= _SelectedDate - 364
			                && AttendanceInPerson_WOW[ScheduleName] IN {"9:30am", "11:45am", "5:00pm"}
			        ),
			        AttendanceInPerson_WOW[MetricValueDateTime]
			    )
			
			VAR _Literals =
			    DATATABLE(
			        "Literal", STRING,
			        {
			            {"Adults"},
			            {"Door Holder"},
			            {"bloom"},
			            {"PK"},
			            {"MS"},
			            {"HS"}
			        }
			    )
			
			VAR _Campuses =
			    DATATABLE(
			        "Campus", STRING,
			        "CampusShort", STRING,
			        "Color", STRING,
			        {
			            {"515", "515", "#00B8E4"},
			            {"Cumberland", "CBL", "#FF641C"},
			            {"Trilith", "TRL", "#931EE7"}
			        }
			    )
			
			VAR _Services =
			    DATATABLE(
			        "Service", STRING,
			        "Sort", INTEGER,
			        {
			            {"9:30am", 1},
			            {"11:45am", 2},
			            {"5:00pm", 3}
			        }
			    )
			
			VAR _last5Dates =
			    TOPN(
			        5,
			        SELECTCOLUMNS(
			            SUMMARIZE(
			                FILTER(
			                    ALL(AttendanceInPerson_WOW),
			                    AttendanceInPerson_WOW[MetricValueDateTime] <= _SelectedDate
			                        && AttendanceInPerson_WOW[ScheduleName] IN {"9:30am", "11:45am", "5:00pm"}
			                ),
			                AttendanceInPerson_WOW[MetricValueDateTime]
			            ),
			            "D", AttendanceInPerson_WOW[MetricValueDateTime]
			        ),
			        [D],
			        DESC
			    )
			
			VAR _Base =
			    CROSSJOIN(_Literals, _Campuses, _Services)
			
			VAR _Data =
			    CONCATENATEX(
			        ADDCOLUMNS(
			            _Base,
			            "Cur",
			                VAR lit = [Literal]
			                VAR campus = [Campus]
			                VAR svc = [Service]
			                RETURN
			                    CALCULATE(
			                        SUM(AttendanceInPerson_WOW[Count]),
			                        REMOVEFILTERS('Calendar'),
			                        REMOVEFILTERS(AttendanceInPerson_WOW),
			                        AttendanceInPerson_WOW[MetricValueDateTime] = _SelectedDate,
			                        AttendanceInPerson_WOW[CampusName] = campus,
			                        AttendanceInPerson_WOW[Literal] = lit,
			                        AttendanceInPerson_WOW[ScheduleName] = svc
			                    ),
			            "Prev",
			                VAR lit = [Literal]
			                VAR campus = [Campus]
			                VAR svc = [Service]
			                RETURN
			                    CALCULATE(
			                        SUM(AttendanceInPerson_WOW[Count]),
			                        REMOVEFILTERS('Calendar'),
			                        REMOVEFILTERS(AttendanceInPerson_WOW),
			                        AttendanceInPerson_WOW[MetricValueDateTime] = _PrevDate,
			                        AttendanceInPerson_WOW[CampusName] = campus,
			                        AttendanceInPerson_WOW[Literal] = lit,
			                        AttendanceInPerson_WOW[ScheduleName] = svc
			                    ),
			            "YoY",
			                VAR lit = [Literal]
			                VAR campus = [Campus]
			                VAR svc = [Service]
			                RETURN
			                    CALCULATE(
			                        SUM(AttendanceInPerson_WOW[Count]),
			                        REMOVEFILTERS('Calendar'),
			                        REMOVEFILTERS(AttendanceInPerson_WOW),
			                        AttendanceInPerson_WOW[MetricValueDateTime] = _YoYDate,
			                        AttendanceInPerson_WOW[CampusName] = campus,
			                        AttendanceInPerson_WOW[Literal] = lit,
			                        AttendanceInPerson_WOW[ScheduleName] = svc
			                    ),
			            "Avg5",
			                VAR lit = [Literal]
			                VAR campus = [Campus]
			                VAR svc = [Service]
			                RETURN
			                    AVERAGEX(
			                        _last5Dates,
			                        VAR d = [D]
			                        RETURN
			                            CALCULATE(
			                                SUM(AttendanceInPerson_WOW[Count]),
			                                REMOVEFILTERS('Calendar'),
			                                REMOVEFILTERS(AttendanceInPerson_WOW),
			                                AttendanceInPerson_WOW[MetricValueDateTime] = d,
			                                AttendanceInPerson_WOW[CampusName] = campus,
			                                AttendanceInPerson_WOW[Literal] = lit,
			                                AttendanceInPerson_WOW[ScheduleName] = svc
			                            )
			                    )
			        ),
			        [Literal] & "~" &
			        [Campus] & "~" &
			        [CampusShort] & "~" &
			        [Color] & "~" &
			        [Service] & "~" &
			        FORMAT(COALESCE([Cur], 0), "0") & "~" &
			        FORMAT(COALESCE([Prev], 0), "0") & "~" &
			        FORMAT(COALESCE([Avg5], 0), "0") & "~" &
			        FORMAT(COALESCE([YoY], 0), "0"),
			        "|"
			    )
			RETURN
			"
			<style>
			html{-webkit-text-size-adjust:100%;text-size-adjust:100%;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;}
			*{box-sizing:border-box;margin:0;padding:0;}
			.wrap{background:" & _bg & ";padding:14px;font-family:Segoe UI,sans-serif;width:100%;height:100%;overflow:auto;color:" & _txt & ";-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;}
			.tabs{display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap;}
			.tab{padding:6px 18px;border-radius:22px;font-size:12px;font-weight:700;border:1.5px solid " & _line & ";color:" & _muted & ";background:" & _cardBg & ";cursor:pointer;transition:all .25s ease;}
			.tab.act{border-color:#00B8E4;color:#00B8E4;background:rgba(0,184,228,.14);box-shadow:0 0 14px rgba(0,184,228,.18);}
			.grid{display:grid;grid-template-columns:minmax(320px,.88fr) minmax(560px,1.72fr);gap:12px;align-items:start;}
			.card{background:" & _cardBg & ";border-radius:14px;overflow:hidden;border:1px solid " & _line & ";}
			.global-head{padding:18px;background:" & _headBg & ";border-bottom:1px solid " & _line & ";}
			.global-label{color:" & _muted & ";font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;margin-bottom:7px;}
			.global-value{font-size:46px;font-weight:900;color:" & _txt & ";line-height:1;}
			table{width:100%;border-collapse:collapse;font-size:14px;table-layout:fixed;}
			td{padding:10px 13px;border-top:1px solid " & _line & ";vertical-align:middle;}
			.svc{color:" & _muted & ";font-weight:650;white-space:nowrap;}
			.att{color:" & _txt & ";text-align:right;font-weight:900;white-space:nowrap;}
			.num{color:" & _muted & ";text-align:right;font-weight:750;white-space:nowrap;}
			.pos{color:#4ADE80;text-align:right;font-weight:900;white-space:nowrap;}
			.neg{color:#F87171;text-align:right;font-weight:900;white-space:nowrap;}
			.neu{color:" & _soft & ";text-align:right;font-weight:800;white-space:nowrap;}
			.col-hdr{color:" & _muted & ";font-size:10px;font-weight:900;text-align:right;text-transform:uppercase;letter-spacing:.07em;padding-top:9px;padding-bottom:9px;white-space:nowrap;}
			.tot-row td{border-top:1.5px solid " & _line & ";font-weight:900;background:rgba(128,128,128,.06);}
			.campus-stack{display:flex;flex-direction:column;gap:11px;}
			.campus-card{display:grid;grid-template-columns:110px minmax(0,1fr);min-height:120px;}
			.campus-side{padding:15px 13px;display:flex;flex-direction:column;justify-content:center;border-right:1px solid " & _line & ";}
			.campus-name{font-weight:900;font-size:17px;margin-bottom:7px;}
			.campus-total{font-weight:900;font-size:28px;line-height:1;}
			.by-campus{padding:18px 16px 20px 18px;border-top:1px solid " & _line & ";}
			.small-title{color:" & _muted & ";font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.08em;margin-bottom:15px;}
			.metric-table td:first-child{width:45%;}
			.campus-table td:nth-child(1){width:19%;text-align:left;}
			.campus-table td:nth-child(2){width:14%;}
			.campus-table td:nth-child(3){width:14%;}
			.campus-table td:nth-child(4){width:18%;}
			.campus-table td:nth-child(5){width:17%;}
			.campus-table td:nth-child(6){width:18%;}
			.lolli-wrap{display:flex;flex-direction:column;gap:18px;width:100%;}
			.lolli-row{display:grid;grid-template-columns:58px minmax(120px,1fr) 78px;align-items:center;gap:12px;width:100%;}
			.lolli-name{font-size:15px;font-weight:900;white-space:nowrap;}
			.lolli-track{height:7px;border-radius:999px;background:rgba(128,128,128,.18);position:relative;overflow:hidden;min-width:0;}
			.lolli-fill{height:7px;border-radius:999px;position:absolute;left:0;top:0;}
			.lolli-val{font-size:15px;font-weight:900;text-align:right;white-space:nowrap;}
			.anim-num{display:inline-block;min-width:1ch;}
			@keyframes fadeUp{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}
			@media(max-width:920px){.grid{grid-template-columns:1fr;}.lolli-row{grid-template-columns:58px minmax(140px,1fr) 78px;}}
			</style>
			<script>
			(function(){
			  var meta=document.createElement('meta');
			  meta.name='viewport';
			  meta.content='width=device-width,initial-scale=1.0,maximum-scale=1.0';
			  document.head.appendChild(meta);
			})();
			</script>
			<div class='wrap'>
			  <div class='tabs' id='tabs'></div>
			  <div class='grid'>
			    <div class='card' id='globalCard'></div>
			    <div class='campus-stack' id='campusCards'></div>
			  </div>
			</div>
			<script>
			(function(){
			var raw=""" & _Data & """;
			var literals=['Adults','Door Holder','bloom','PK','MS','HS'];
			var campuses=[
			{name:'515',short:'515',color:'#00B8E4'},
			{name:'Cumberland',short:'CBL',color:'#FF641C'},
			{name:'Trilith',short:'TRL',color:'#931EE7'}
			];
			var services=['9:30am','11:45am','5:00pm'];
			var rows=raw.split('|').filter(Boolean).map(function(r){
			 var p=r.split('~');
			 return{literal:p[0],campus:p[1],short:p[2],color:p[3],service:p[4],cur:+p[5]||0,prev:+p[6]||0,avg:+p[7]||0,yoy:+p[8]||0};
			});
			function n(v){return Math.round(v||0).toLocaleString();}
			function pct(cur,base){if(!base||base===0)return '—';var v=((cur-base)/base)*100;return (v>0?'+':'')+v.toFixed(1)+'%';}
			function cls(cur,base){if(!base||base===0)return 'neu';return cur>base?'pos':cur<base?'neg':'neu';}
			function sum(a,f){return a.reduce(function(x,y){return x+(+y[f]||0);},0);}
			function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
			function numSpan(v,zeroDash){
			 if(zeroDash&&(!v||v===0))return '—';
			 return '<span class=\'anim-num\' data-num=\''+Math.round(v||0)+'\'>'+n(v)+'</span>';
			}
			function runCounts(){
			 document.querySelectorAll('.anim-num').forEach(function(el){
			  var target=+el.getAttribute('data-num')||0;
			  var start=null;var dur=700;
			  function step(ts){
			   if(start===null)start=ts;
			   var p=Math.min((ts-start)/dur,1);
			   var e=1-Math.pow(1-p,3);
			   el.textContent=Math.round(e*target).toLocaleString();
			   if(p<1)requestAnimationFrame(step);
			  }
			  requestAnimationFrame(step);
			 });
			}
			function renderTabs(active){
			 var h='';
			 literals.forEach(function(l){h+='<div class=\'tab '+(l===active?'act':'')+'\' data-lit=\''+esc(l)+'\'>'+esc(l)+'</div>';});
			 document.getElementById('tabs').innerHTML=h;
			 document.querySelectorAll('.tab').forEach(function(t){t.addEventListener('click',function(){render(t.getAttribute('data-lit'));});});
			}
			function renderGlobal(literal){
			 var all=rows.filter(function(x){return x.literal===literal;});
			 var cur=sum(all,'cur'),prev=sum(all,'prev'),avg=sum(all,'avg'),yoy=sum(all,'yoy');
			 var maxCampus=1;
			 campuses.forEach(function(c){maxCampus=Math.max(maxCampus,sum(all.filter(function(x){return x.campus===c.name;}),'cur'));});
			 var lolli='';
			 campuses.forEach(function(c){
			  var cr=all.filter(function(x){return x.campus===c.name;});
			  var cv=sum(cr,'cur');
			  var w=Math.max(0,Math.min(100,Math.round((cv/maxCampus)*100)));
			  lolli+=
			   '<div class=\'lolli-row\'>'+
			   '<div class=\'lolli-name\' style=\'color:'+c.color+'\'>'+c.short+'</div>'+
			   '<div class=\'lolli-track\'><div class=\'lolli-fill\' style=\'background:'+c.color+';width:'+w+'%\'></div></div>'+
			   '<div class=\'lolli-val\' style=\'color:'+c.color+'\'>'+n(cv)+'</div>'+
			   '</div>';
			 });
			 document.getElementById('globalCard').innerHTML=
			  '<div class=\'global-head\'><div class=\'global-label\'>Global</div><div class=\'global-value\'>'+n(cur)+'</div></div>'+
			  '<table class=\'metric-table\'>'+
			  '<tr><td class=\'svc\'>Prev WK</td><td class=\'num\'>'+n(prev)+'</td></tr>'+
			  '<tr><td class=\'svc\'>5WK Avg</td><td class=\'num\'>'+n(avg)+'</td></tr>'+
			  '<tr><td class=\'svc\'>WoW%</td><td class=\''+cls(cur,prev)+'\'>'+pct(cur,prev)+'</td></tr>'+
			  '<tr><td class=\'svc\'>YoY%</td><td class=\''+cls(cur,yoy)+'\'>'+pct(cur,yoy)+'</td></tr>'+
			  '</table>'+
			  '<div class=\'by-campus\'><div class=\'small-title\'>By campus</div><div class=\'lolli-wrap\'>'+lolli+'</div></div>';
			}
			function renderCampusCards(literal){
			 var html='';
			 campuses.forEach(function(c){
			  var cr=rows.filter(function(x){return x.literal===literal&&x.campus===c.name;});
			  var visibleServices=services.filter(function(s){
			   var r=cr.filter(function(x){return x.service===s;})[0];
			   return r&&(r.cur||r.prev||r.avg||r.yoy);
			  });
			  var totalCur=sum(cr,'cur'),totalPrev=sum(cr,'prev'),totalAvg=sum(cr,'avg'),totalYoy=sum(cr,'yoy');
			  html+='<div class=\'card\'><div class=\'campus-card\'>';
			  html+='<div class=\'campus-side\' style=\'background:'+c.color+'22;border-right-color:'+c.color+'66\'><div class=\'campus-name\' style=\'color:'+c.color+'\'>'+c.short+'</div><div class=\'campus-total\' style=\'color:'+c.color+'\'>'+numSpan(totalCur,false)+'</div></div>';
			  html+='<table class=\'campus-table\'><tr><td class=\'col-hdr\' style=\'text-align:left;\'>Service</td><td class=\'col-hdr\'>Att</td><td class=\'col-hdr\'>Prev</td><td class=\'col-hdr\'>5WK Avg</td><td class=\'col-hdr\'>WoW%</td><td class=\'col-hdr\'>YoY%</td></tr>';
			  if(visibleServices.length===0){
			   html+='<tr><td class=\'svc\'>No data</td><td class=\'att\'>—</td><td class=\'num\'>—</td><td class=\'num\'>—</td><td class=\'neu\'>—</td><td class=\'neu\'>—</td></tr>';
			  }else{
			   visibleServices.forEach(function(s){
			    var r=cr.filter(function(x){return x.service===s;})[0]||{cur:0,prev:0,avg:0,yoy:0};
			    html+='<tr><td class=\'svc\'>'+s+'</td><td class=\'att\'>'+numSpan(r.cur,true)+'</td><td class=\'num\'>'+numSpan(r.prev,true)+'</td><td class=\'num\'>'+numSpan(r.avg,true)+'</td><td class=\''+cls(r.cur,r.prev)+'\'>'+pct(r.cur,r.prev)+'</td><td class=\''+cls(r.cur,r.yoy)+'\'>'+pct(r.cur,r.yoy)+'</td></tr>';
			   });
			  }
			  html+='<tr class=\'tot-row\'><td class=\'svc\' style=\'color:'+c.color+'\'>Total</td><td class=\'att\' style=\'color:'+c.color+'\'>'+numSpan(totalCur,false)+'</td><td class=\'num\'>'+numSpan(totalPrev,false)+'</td><td class=\'num\'>'+numSpan(totalAvg,false)+'</td><td class=\''+cls(totalCur,totalPrev)+'\'>'+pct(totalCur,totalPrev)+'</td><td class=\''+cls(totalCur,totalYoy)+'\'>'+pct(totalCur,totalYoy)+'</td></tr>';
			  html+='</table></div></div>';
			 });
			 document.getElementById('campusCards').innerHTML=html;
			}
			function render(literal){
			 renderTabs(literal);
			 renderGlobal(literal);
			 renderCampusCards(literal);
			 setTimeout(runCounts,30);
			}
			render('Adults');
			})();
			</script>
			"
		lineageTag: 218993e8-a5e7-4dcc-9d2a-ceb656b31196

	measure HTML_CheckInMapData =
			
			VAR _calDate = MINX(VALUES('Calendar'[selecteddate]), 'Calendar'[selecteddate])
			VAR _maxDate =
			    MAXX(
			        FILTER(ALL(fact_checkin), fact_checkin[AOSundayDate] <= TODAY()),
			        fact_checkin[AOSundayDate]
			    )
			VAR _SelectedDate = IF(YEAR(_calDate) < 2020, _maxDate, _calDate)
			VAR _Sunday = DATEVALUE(_SelectedDate)
			
			VAR _Rows = FILTER(
			    ALL(fact_checkin),
			    DATEVALUE(fact_checkin[AOSundayDate]) = _Sunday
			)
			
			VAR _WithGiving = ADDCOLUMNS(
			    _Rows,
			    "GivingCode", FORMAT( [GivingStage], "0" )
			)
			
			RETURN
			CONCATENATEX(
			    _WithGiving,
			    FORMAT([Lat], "0.0000") & "," &
			    FORMAT([Lng], "0.0000") & "," &
			    [CampusList] & "," &
			    [MinList] & "," &
			    [Headcount] & "," &
			    [GivingCode],
			    ";"
			)
		lineageTag: a170ef00-0103-4e9a-8a69-e7e195d1c5ae

	measure HTML_CheckInHeatmap =
			
			VAR _data = [HTML_CheckInMapData]
			VAR _isDark = [HTML_Theme] = "Dark"
			VAR _style = IF(_isDark, "mapbox://styles/mapbox/dark-v11", "mapbox://styles/mapbox/streets-v12")
			VAR _bg = IF(_isDark, "#111111", "#f8f8f8")
			VAR _tabBg = IF(_isDark, "#181818", "#eeeeee")
			VAR _tabBorder = IF(_isDark, "#333333", "#dddddd")
			VAR _tabColor = IF(_isDark, "#aaaaaa", "#333333")
			VAR _activeColor = IF(_isDark, "#ffffff", "#111111")
			VAR _infoBg = IF(_isDark, "rgba(20,20,20,.95)", "rgba(255,255,255,.95)")
			VAR _infoColor = IF(_isDark, "#dddddd", "#222222")
			VAR _labelColor = IF(_isDark, "#888888", "#777777")
			VAR _pinBg = IF(_isDark, "#111111", "#ffffff")
			VAR _titleColor = IF(_isDark, "#ffffff", "#111111")
			VAR _token = "pk.eyJ1IjoidGVjaC0yNjhnZW5lcmF0aW9uIiwiYSI6ImNtc2c5NGJ1NTAwaTUyd3E5cXQyejgycXkifQ.CaGq4DLkzk-Edh_4TeqG0w"
			
			RETURN
			"
			<script src='https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.js'></script>
			<link href='https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.css' rel='stylesheet'/>
			
			<style>
			html,body{width:100%;height:100%;margin:0;padding:0;overflow:hidden;}
			
			.wrap{
			    width:100%;
			    height:100%;
			    display:flex;
			    flex-direction:column;
			    position:relative;
			    background:" & _bg & ";
			    font-family:sans-serif;
			}
			
			.titlebar{
			    padding:10px 12px 0 12px;
			    display:flex;
			    align-items:baseline;
			    gap:8px;
			    flex-shrink:0;
			    background:" & _bg & ";
			}
			
			.title{
			    font-size:14px;
			    font-weight:700;
			    color:" & _titleColor & ";
			}
			
			.subtitle{
			    font-size:11px;
			    color:" & _labelColor & ";
			}
			
			.info-btn{
			    margin-left:auto;
			    width:18px;
			    height:18px;
			    border-radius:50%;
			    border:1px solid " & _tabBorder & ";
			    color:" & _tabColor & ";
			    background:" & _tabBg & ";
			    font-size:11px;
			    font-weight:700;
			    cursor:pointer;
			    display:flex;
			    align-items:center;
			    justify-content:center;
			    user-select:none;
			    position:relative;
			}
			
			.info-popover{
			    position:absolute;
			    top:26px;
			    right:0;
			    width:280px;
			    background:" & _infoBg & ";
			    border:1px solid " & _tabBorder & ";
			    border-radius:10px;
			    color:" & _infoColor & ";
			    font-size:11px;
			    line-height:1.6;
			    padding:12px 14px;
			    box-shadow:0 4px 16px rgba(0,0,0,.35);
			    z-index:1000;
			    display:none;
			    text-align:left;
			}
			
			.info-popover.show{display:block;}
			
			.info-popover h4{
			    margin:0 0 6px 0;
			    font-size:12px;
			    font-weight:700;
			}
			
			.info-popover .sec{margin-top:8px;}
			
			.info-popover .sw{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:5px;}
			
			.header{
			    padding:8px 12px;
			    display:flex;
			    gap:6px;
			    flex-wrap:wrap;
			    flex-shrink:0;
			    background:" & _bg & ";
			    align-items:center;
			}
			
			.tab{
			    padding:4px 12px;
			    border-radius:20px;
			    border:1px solid " & _tabBorder & ";
			    color:" & _tabColor & ";
			    background:" & _tabBg & ";
			    font-size:11px;
			    font-weight:600;
			    cursor:pointer;
			    user-select:none;
			}
			
			.tab.act{
			    border-color:" & _activeColor & ";
			    color:" & _activeColor & ";
			}
			
			.divider{
			    width:1px;
			    height:18px;
			    background:" & _tabBorder & ";
			    margin:0 4px;
			}
			
			.toggle{
			    padding:4px 12px;
			    border-radius:20px;
			    border:1px solid " & _tabBorder & ";
			    color:" & _tabColor & ";
			    background:" & _tabBg & ";
			    font-size:11px;
			    font-weight:600;
			    cursor:pointer;
			    user-select:none;
			}
			
			.toggle:hover{
			    border-color:#639922;
			    color:#639922;
			}
			
			#map{
			    width:100%;
			    height:500px;
			    background:" & _bg & ";
			}
			
			.info-box,.legend{
			    position:absolute;
			    background:" & _infoBg & ";
			    border:1px solid " & _tabBorder & ";
			    border-radius:10px;
			    color:" & _infoColor & ";
			    font-size:11px;
			    z-index:10;
			    pointer-events:none;
			    box-shadow:0 2px 8px rgba(0,0,0,.25);
			}
			
			.info-box{
			    bottom:10px;
			    left:10px;
			    padding:10px 14px;
			    line-height:1.7;
			    min-width:190px;
			}
			
			.legend{
			    bottom:10px;
			    right:10px;
			    padding:8px 12px;
			    line-height:1.8;
			}
			
			.legend.hidden{display:none;}
			
			.area{font-size:13px;font-weight:700;margin-bottom:4px;}
			.lbl{color:" & _labelColor & ";}
			.sw{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px;border:1px solid rgba(255,255,255,.5);}
			
			.campus-pin{
			    width:38px;
			    height:38px;
			    border-radius:50%;
			    background:" & _pinBg & ";
			    display:flex;
			    align-items:center;
			    justify-content:center;
			    font-size:9px;
			    font-weight:800;
			    font-family:sans-serif;
			    box-shadow:0 0 14px rgba(0,0,0,.55);
			    z-index:9999!important;
			    cursor:pointer;
			    transition:opacity 0.2s ease;
			}
			
			.campus-pin.dimmed{
			    opacity:0.25;
			}
			
			.household-dot{
			    z-index:1!important;
			}
			
			.mapboxgl-marker{
			    z-index:1;
			}
			
			.campus-marker{
			    z-index:9999!important;
			}
			
			.reset-btn{
			    position:absolute;
			    top:60px;
			    right:10px;
			    padding:6px 12px;
			    border-radius:20px;
			    border:1px solid " & _tabBorder & ";
			    background:" & _tabBg & ";
			    color:" & _tabColor & ";
			    font-size:11px;
			    font-weight:600;
			    cursor:pointer;
			    z-index:10;
			    user-select:none;
			}
			
			.reset-btn:hover{
			    border-color:" & _activeColor & ";
			    color:" & _activeColor & ";
			}
			
			.mapboxgl-ctrl-logo,.mapboxgl-ctrl-attrib{display:none!important;}
			</style>
			
			<div class='wrap'>
			    <div class='titlebar'>
			        <div class='title'>Household Engagement Map</div>
			        <div class='subtitle' id='subtitle'>Check-In View</div>
			        <div class='info-btn' id='infoBtn'>
			            i
			            <div class='info-popover' id='infoPopover'>
			                <h4>About this map</h4>
			                <div>Shows households that checked in this week, plotted at their home address.</div>
			
			                <div class='sec'><b>Tabs along the top</b> filter which households you see by which group checked in (Door Holders, bloom, Passion Kids, Middle School, High School), or All for everyone.</div>
			
			                <div class='sec'><b>Campus pins</b> (CBL, 515, TRL)  click one to show only households from that campus. Click it again to show all campuses.</div>
			
			                <div class='sec'><b>Check-In View</b> (default)  dots are colored by campus:</div>
			                <div><span class='sw' style='background:#00B8E4'></span>515</div>
			                <div><span class='sw' style='background:#FF641C'></span>CBL</div>
			                <div><span class='sw' style='background:#931EE7'></span>Trilith</div>
			                <div><span class='sw' style='background:#FFD700'></span>Multi-campus</div>
			
			                <div class='sec'><b>Giving View</b>  each household's giving journey stage from Rock. The letter inside each dot still shows their campus:</div>
			                <div><span class='sw' style='background:#3B82F6'></span>New  first-time giver</div>
			                <div><span class='sw' style='background:#639922'></span>Consistent  gives regularly</div>
			                <div><span class='sw' style='background:#6D5BD0'></span>Occasional  gives now and then</div>
			                <div><span class='sw' style='background:#BA7517'></span>Lapsed  gave before, has paused</div>
			                <div><span class='sw' style='background:#8B2E2E'></span>Former  no recent giving</div>
			                <div><span class='sw' style='background:#9a9890'></span>Non-giver</div>
			            </div>
			        </div>
			    </div>
			
			    <div class='header'>
			        <div class='tab act' data-f='all'>All</div>
			        <div class='tab' data-f='d'>Door Holder</div>
			        <div class='tab' data-f='b'>bloom</div>
			        <div class='tab' data-f='p'>PK</div>
			        <div class='tab' data-f='m'>MS</div>
			        <div class='tab' data-f='h'>HS</div>
			        <div class='divider'></div>
			        <div class='toggle' id='givingToggle'>Giving View</div>
			    </div>
			
			    <div id='map'></div>
			
			    <div class='info-box' id='infoBox'>Hover a dot for details</div>
			
			    <div class='legend' id='legendMinistry'>
			        <div><span class='sw' style='background:#00B8E4'></span>515</div>
			        <div><span class='sw' style='background:#FF641C'></span>CBL</div>
			        <div><span class='sw' style='background:#931EE7'></span>TRL</div>
			        <div><span class='sw' style='background:#FFD700'></span>Multi-campus</div>
			    </div>
			
			    <div class='legend hidden' id='legendGiving'>
			        <div><span class='sw' style='background:#3B82F6'></span>New</div>
			        <div><span class='sw' style='background:#639922'></span>Consistent</div>
			        <div><span class='sw' style='background:#6D5BD0'></span>Occasional</div>
			        <div><span class='sw' style='background:#BA7517'></span>Lapsed</div>
			        <div><span class='sw' style='background:#8B2E2E'></span>Former</div>
			        <div><span class='sw' style='background:#9a9890'></span>Non-giver</div>
			    </div>
			
			    <div class='reset-btn' id='resetBtn'>Reset View</div>
			</div>
			
			<script>
			var RAW='" & _data & "';
			var activeMinistry='all';
			var givingMode=false;
			var activeCampus=null;
			var markers=[];
			var campusMarkers=[];
			var map;
			var STROKE_COLOR = " &
			IF(
			    _isDark,
			    "'rgba(255,255,255,0.45)'",
			    "'rgba(0,0,0,0.30)'"
			) &
			";
			
			var MINISTRY_LABELS={d:'Door Holder',b:'bloom',p:'Passion Kids',m:'Middle School',h:'High School'};
			var CAMPUS_LABELS={'5':'515','C':'Cumberland','T':'Trilith','D':'DC','O':'Online','G':'Global','U':'Unknown'};
			
			var GIVING_LABELS={
			    0:'Non-giver',
			    1:'New giver',
			    2:'Consistent giver',
			    3:'Occasional giver',
			    4:'Lapsed giver',
			    5:'Former giver'
			};
			
			var GIVING_COLORS={
			    0:'#9a9890',
			    1:'#3B82F6',
			    2:'#639922',
			    3:'#6D5BD0',
			    4:'#BA7517',
			    5:'#8B2E2E'
			};
			
			var infoBox=document.getElementById('infoBox');
			var legendMinistry=document.getElementById('legendMinistry');
			var legendGiving=document.getElementById('legendGiving');
			var givingToggle=document.getElementById('givingToggle');
			var subtitle=document.getElementById('subtitle');
			var infoBtn=document.getElementById('infoBtn');
			var infoPopover=document.getElementById('infoPopover');
			
			var CAMPUSES=[
			    {lat:33.818205,lng:-84.370739,label:'515',code:'5',color:'#00B8E4'},
			    {lat:33.872732,lng:-84.475164,label:'CBL',code:'C',color:'#FF641C'},
			    {lat:33.483429,lng:-84.506836,label:'TRL',code:'T',color:'#931EE7'}
			];
			
			function clearMarkers(){
			    markers.forEach(function(m){ m.remove(); });
			    markers=[];
			}
			
			function getColor(campus){
			    var color='#00B8E4';
			    if(campus.indexOf('C') > -1){ color='#FF641C'; }
			    if(campus.indexOf('T') > -1){ color='#931EE7'; }
			    if(campus.length > 1){ color='#FFD700'; }
			    return color;
			}
			
			function addCampusPins(){
			    CAMPUSES.forEach(function(c){
			        var el=document.createElement('div');
			        el.className='campus-pin';
			        el.style.border='2.5px solid '+c.color;
			        el.style.color=c.color;
			        el.style.zIndex='9999';
			        el.textContent=c.label;
			
			        el.addEventListener('click',function(){
			            if(activeCampus === c.code){
			                activeCampus = null;
			            } else {
			                activeCampus = c.code;
			            }
			            updateCampusPinStyles();
			            renderMarkers();
			        });
			
			        var marker=new mapboxgl.Marker({element:el, anchor:'center'})
			            .setLngLat([c.lng,c.lat])
			            .addTo(map);
			
			        marker.getElement().classList.add('campus-marker');
			        marker.getElement().style.zIndex='9999';
			        marker.code=c.code;
			
			        campusMarkers.push(marker);
			    });
			}
			
			function updateCampusPinStyles(){
			    campusMarkers.forEach(function(m){
			        var el=m.getElement();
			        if(activeCampus === null){
			            el.classList.remove('dimmed');
			        } else if(m.code === activeCampus){
			            el.classList.remove('dimmed');
			        } else {
			            el.classList.add('dimmed');
			        }
			    });
			}
			
			function renderStandardDot(p, ministry){
			    var lat=parseFloat(p[0]);
			    var lng=parseFloat(p[1]);
			    var campus=p[2];
			    var headcount=parseInt(p[4]);
			
			    if(isNaN(lat) || isNaN(lng)) return;
			
			    var color=getColor(campus);
			
			    var size=10;
			    if(ministry.length >= 3){ size=16; }
			    else if(ministry.length >= 2){ size=13; }
			
			    var el=document.createElement('div');
			    el.className='household-dot';
			    el.style.width=size+'px';
			    el.style.height=size+'px';
			    el.style.borderRadius='50%';
			    el.style.background=color;
			    el.style.border='1px solid ' + STROKE_COLOR;
			    el.style.cursor='pointer';
			    el.style.zIndex='1';
			
			    el.addEventListener('mouseenter',function(){
			        var mins=ministry.split('').map(function(x){return MINISTRY_LABELS[x] || x;}).join(', ');
			        var camps=campus.split('').map(function(x){return CAMPUS_LABELS[x] || x;}).join(', ');
			        var peopleLabel = headcount+(headcount===1?' person':' people');
			        var minLabel = ministry.length+(ministry.length===1?' ministry':' ministries');
			
			        infoBox.innerHTML =
			            '<div class=""area"" style=""color:'+color+'"">'+camps+'</div>' +
			            '<div><span class=""lbl"">Household:</span> '+peopleLabel+'</div>' +
			            '<div><span class=""lbl"">Ministries:</span> '+mins+' ('+minLabel+')</div>';
			    });
			
			    el.addEventListener('mouseleave',function(){
			        infoBox.innerHTML='Hover a dot for details';
			    });
			
			    var marker=new mapboxgl.Marker({element:el, anchor:'center'})
			        .setLngLat([lng,lat])
			        .addTo(map);
			
			    marker.getElement().style.zIndex='1';
			
			    markers.push(marker);
			}
			
			function renderGivingDot(p, ministry){
			    var lat=parseFloat(p[0]);
			    var lng=parseFloat(p[1]);
			    var campus=p[2];
			    var headcount=parseInt(p[4]);
			    var givingCode=p[5] || '0';
			
			    if(isNaN(lat) || isNaN(lng)) return;
			
			    var fillColor=GIVING_COLORS[givingCode] || GIVING_COLORS[0];
			
			    var size=14;
			
			    var campusLabel = campus.length === 1 ? campus : 'M';
			
			    var el=document.createElement('div');
			    el.style.width=size+'px';
			    el.style.height=size+'px';
			    el.style.borderRadius='50%';
			    el.style.background=fillColor;
			    el.style.color='#ffffff';
			    el.style.display='flex';
			    el.style.alignItems='center';
			    el.style.justifyContent='center';
			    el.style.fontSize='7px';
			    el.style.fontWeight='800';
			    el.style.fontFamily='sans-serif';
			    el.style.cursor='pointer';
			    el.textContent=campusLabel;
			
			    el.addEventListener('mouseenter',function(){
			        var camps=campus.split('').map(function(x){return CAMPUS_LABELS[x] || x;}).join(', ');
			        var peopleLabel = headcount+(headcount===1?' person':' people');
			        var givingLabel = GIVING_LABELS[givingCode] || 'Unknown';
			
			        infoBox.innerHTML =
			            '<div class=""area"" style=""color:'+fillColor+'"">'+camps+'</div>' +
			            '<div><span class=""lbl"">Household:</span> '+peopleLabel+'</div>' +
			            '<div><span class=""lbl"">Giving:</span> '+givingLabel+'</div>';
			    });
			
			    el.addEventListener('mouseleave',function(){
			        infoBox.innerHTML='Hover a dot for details';
			    });
			
			    var marker=new mapboxgl.Marker({element:el, anchor:'center'})
			        .setLngLat([lng,lat])
			        .addTo(map);
			
			    markers.push(marker);
			}
			
			function renderMarkers(){
			    clearMarkers();
			
			    var rows = RAW.split(';');
			    var rendered = 0;
			    var errors = 0;
			
			    rows.forEach(function(r){
			        var p=r.split(',');
			        if(p.length < 5) return;
			
			        var campus=p[2];
			        var ministry=p[3];
			
			        if(activeMinistry !== 'all' && ministry.indexOf(activeMinistry) === -1) return;
			        if(activeCampus !== null && campus.indexOf(activeCampus) === -1) return;
			
			        try {
			            if(givingMode){
			                renderGivingDot(p, ministry);
			            } else {
			                renderStandardDot(p, ministry);
			            }
			            rendered++;
			        } catch(e) {
			            errors++;
			            console.error('Render error:', e, p);
			        }
			    });
			
			    console.log('Total rows:', rows.length, 'Rendered:', rendered, 'Errors:', errors);
			}
			
			function updateLegend(){
			    if(givingMode){
			        legendMinistry.classList.add('hidden');
			        legendGiving.classList.remove('hidden');
			        subtitle.textContent='Giving View';
			        givingToggle.textContent='Check-In View';
			    } else {
			        legendMinistry.classList.remove('hidden');
			        legendGiving.classList.add('hidden');
			        subtitle.textContent='Check-In View';
			        givingToggle.textContent='Giving View';
			    }
			}
			
			setTimeout(function(){
			    mapboxgl.accessToken='" & _token & "';
			
			    map=new mapboxgl.Map({
			        container:'map',
			        style:'" & _style & "',
			        center:[-84.40,33.85],
			        zoom:9,
			        attributionControl:false
			    });
			
			    map.on('load',function(){
			        renderMarkers();
			        addCampusPins();
			    });
			
			    document.querySelectorAll('[data-f]').forEach(function(btn){
			        btn.addEventListener('click',function(){
			            document.querySelectorAll('[data-f]').forEach(function(b){ b.classList.remove('act'); });
			            btn.classList.add('act');
			            activeMinistry=btn.getAttribute('data-f');
			            renderMarkers();
			        });
			    });
			
			    givingToggle.addEventListener('click',function(){
			        givingMode = !givingMode;
			        updateLegend();
			        renderMarkers();
			    });
			
			    infoBtn.addEventListener('click',function(e){
			        e.stopPropagation();
			        infoPopover.classList.toggle('show');
			    });
			
			    document.addEventListener('click',function(e){
			        if(!infoBtn.contains(e.target)){
			            infoPopover.classList.remove('show');
			        }
			    });
			
			    document.getElementById('resetBtn').addEventListener('click',function(){
			        map.flyTo({center:[-84.40,33.85],zoom:9});
			    });
			},500);
			</script>
			"
		lineageTag: e715dba5-3693-4bc5-bd62-7671d6187d35

	measure HTML_CheckInHeatmap2 =
			
			VAR _data = [HTML_CheckInMapData]
			VAR _isDark = [HTML_Theme] = "Dark"
			VAR _style = IF(_isDark, "mapbox://styles/mapbox/dark-v11", "mapbox://styles/mapbox/streets-v12")
			VAR _bg = IF(_isDark, "#111111", "#f8f8f8")
			VAR _tabBg = IF(_isDark, "#181818", "#eeeeee")
			VAR _tabBorder = IF(_isDark, "#333333", "#dddddd")
			VAR _tabColor = IF(_isDark, "#aaaaaa", "#333333")
			VAR _activeColor = IF(_isDark, "#ffffff", "#111111")
			VAR _infoBg = IF(_isDark, "rgba(20,20,20,.95)", "rgba(255,255,255,.95)")
			VAR _infoColor = IF(_isDark, "#dddddd", "#222222")
			VAR _labelColor = IF(_isDark, "#888888", "#777777")
			VAR _pinBg = IF(_isDark, "#111111", "#ffffff")
			VAR _token = "pk.eyJ1IjoidGVjaC0yNjhnZW5lcmF0aW9uIiwiYSI6ImNtcWIxZjNmbzA5bm8ycHByYjhmNnl5N2QifQ.ECNCw7txUuO4aCCQ6IqqMQ"
			
			RETURN
			"
			<script src='https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.js'></script>
			<link href='https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.css' rel='stylesheet'/>
			
			<style>
			html,body{width:100%;height:100%;margin:0;padding:0;overflow:hidden;}
			
			.wrap{
			    width:100%;
			    height:100%;
			    display:flex;
			    flex-direction:column;
			    position:relative;
			    background:" & _bg & ";
			    font-family:sans-serif;
			}
			
			.header{
			    padding:8px 12px;
			    display:flex;
			    gap:6px;
			    flex-wrap:wrap;
			    flex-shrink:0;
			    background:" & _bg & ";
			}
			
			.tab{
			    padding:4px 12px;
			    border-radius:20px;
			    border:1px solid " & _tabBorder & ";
			    color:" & _tabColor & ";
			    background:" & _tabBg & ";
			    font-size:11px;
			    font-weight:600;
			    cursor:pointer;
			    user-select:none;
			}
			
			.tab.act{
			    border-color:" & _activeColor & ";
			    color:" & _activeColor & ";
			}
			
			#map{
			    width:100%;
			    height:500px;
			    background:" & _bg & ";
			}
			
			.info-box,.legend{
			    position:absolute;
			    background:" & _infoBg & ";
			    border:1px solid " & _tabBorder & ";
			    border-radius:10px;
			    color:" & _infoColor & ";
			    font-size:11px;
			    z-index:10;
			    pointer-events:none;
			    box-shadow:0 2px 8px rgba(0,0,0,.25);
			}
			
			.info-box{
			    bottom:10px;
			    left:10px;
			    padding:10px 14px;
			    line-height:1.7;
			    min-width:190px;
			}
			
			.legend{
			    bottom:10px;
			    right:10px;
			    padding:8px 12px;
			    line-height:1.8;
			}
			
			.area{font-size:13px;font-weight:700;margin-bottom:4px;}
			.lbl{color:" & _labelColor & ";}
			.sw{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px;border:1px solid rgba(255,255,255,.5);}
			
			.campus-pin{
			    width:38px;
			    height:38px;
			    border-radius:50%;
			    background:" & _pinBg & ";
			    display:flex;
			    align-items:center;
			    justify-content:center;
			    font-size:9px;
			    font-weight:800;
			    font-family:sans-serif;
			    box-shadow:0 0 14px rgba(0,0,0,.55);
			    z-index:9999!important;
			}
			
			.household-dot{
			    z-index:1!important;
			}
			
			.mapboxgl-marker{
			    z-index:1;
			}
			
			.campus-marker{
			    z-index:9999!important;
			}
			
			.mapboxgl-ctrl-logo,.mapboxgl-ctrl-attrib{display:none!important;}
			</style>
			
			<div class='wrap'>
			    <div class='header'>
			        <div class='tab act' data-f='all'>All</div>
			        <div class='tab' data-f='d'>Door Holder</div>
			        <div class='tab' data-f='b'>bloom</div>
			        <div class='tab' data-f='p'>PK</div>
			        <div class='tab' data-f='m'>MS</div>
			        <div class='tab' data-f='h'>HS</div>
			    </div>
			
			    <div id='map'></div>
			
			    <div class='info-box' id='infoBox'>Hover a dot for details</div>
			
			    <div class='legend'>
			        <div><span class='sw' style='background:#00B8E4'></span>515</div>
			        <div><span class='sw' style='background:#FF641C'></span>CBL</div>
			        <div><span class='sw' style='background:#1EE7B8'></span>TRL</div>
			        <div><span class='sw' style='background:#FFD700'></span>Multi-campus</div>
			    </div>
			</div>
			
			<script>
			var RAW='" & _data & "';
			var activeMinistry='all';
			var markers=[];
			var campusMarkers=[];
			var map;
			var STROKE_COLOR = " &
			IF(
			    _isDark,
			    "'rgba(255,255,255,0.45)'",
			    "'rgba(0,0,0,0.30)'"
			) &
			";
			
			var MINISTRY_LABELS={d:'Door Holder',b:'bloom',p:'Passion Kids',m:'Middle School',h:'High School'};
			var CAMPUS_LABELS={'5':'515','C':'Cumberland','T':'Trilith','D':'DC','O':'Online','G':'Global','U':'Unknown'};
			var infoBox=document.getElementById('infoBox');
			
			var CAMPUSES=[
			    {lat:33.8195,lng:-84.3705,label:'515',color:'#00B8E4'},
			    {lat:33.8855,lng:-84.4655,label:'CBL',color:'#FF641C'},
			    {lat:33.4030,lng:-84.4715,label:'TRL',color:'#1EE7B8'}
			];
			
			function clearMarkers(){
			    markers.forEach(function(m){ m.remove(); });
			    markers=[];
			}
			
			function getColor(campus){
			    var color='#00B8E4';
			    if(campus.indexOf('C') > -1){ color='#FF641C'; }
			    if(campus.indexOf('T') > -1){ color='#1EE7B8'; }
			    if(campus.length > 1){ color='#FFD700'; }
			    return color;
			}
			
			function addCampusPins(){
			    CAMPUSES.forEach(function(c){
			        var el=document.createElement('div');
			        el.className='campus-pin';
			        el.style.border='2.5px solid '+c.color;
			        el.style.color=c.color;
			        el.style.zIndex='9999';
			        el.textContent=c.label;
			
			        var marker=new mapboxgl.Marker({element:el, anchor:'center'})
			            .setLngLat([c.lng,c.lat])
			            .addTo(map);
			
			        marker.getElement().classList.add('campus-marker');
			        marker.getElement().style.zIndex='9999';
			
			        campusMarkers.push(marker);
			    });
			}
			
			function renderMarkers(){
			    clearMarkers();
			
			    RAW.split(';').forEach(function(r){
			        var p=r.split(',');
			        if(p.length < 5) return;
			
			        var lat=parseFloat(p[0]);
			        var lng=parseFloat(p[1]);
			        var campus=p[2];
			        var ministry=p[3];
			        var headcount=parseInt(p[4]);
			
			        if(isNaN(lat) || isNaN(lng)) return;
			        if(activeMinistry !== 'all' && ministry.indexOf(activeMinistry) === -1) return;
			
			        var color=getColor(campus);
			
			        var size=10;
			        if(ministry.length >= 3){ size=16; }
			        else if(ministry.length >= 2){ size=13; }
			
			        var el=document.createElement('div');
			        el.className='household-dot';
			        el.style.width=size+'px';
			        el.style.height=size+'px';
			        el.style.borderRadius='50%';
			        el.style.background=color;
			        el.style.border='1px solid ' + STROKE_COLOR;
			        el.style.cursor='pointer';
			        el.style.zIndex='1';
			
			        el.addEventListener('mouseenter',function(){
			            var mins=ministry.split('').map(function(x){return MINISTRY_LABELS[x] || x;}).join(', ');
			            var camps=campus.split('').map(function(x){return CAMPUS_LABELS[x] || x;}).join(', ');
			
			            infoBox.innerHTML =
			                '<div class=""area"" style=""color:'+color+'"">'+camps+'</div>' +
			                '<div><span class=""lbl"">Household:</span> '+headcount+' people</div>' +
			                '<div><span class=""lbl"">Ministries:</span> '+mins+'</div>';
			        });
			
			        el.addEventListener('mouseleave',function(){
			            infoBox.innerHTML='Hover a dot for details';
			        });
			
			        var marker=new mapboxgl.Marker({element:el, anchor:'center'})
			            .setLngLat([lng,lat])
			            .addTo(map);
			
			        marker.getElement().style.zIndex='1';
			
			        markers.push(marker);
			    });
			
			    campusMarkers.forEach(function(m){
			        m.getElement().style.zIndex='9999';
			    });
			}
			
			setTimeout(function(){
			    mapboxgl.accessToken='" & _token & "';
			
			    map=new mapboxgl.Map({
			        container:'map',
			        style:'" & _style & "',
			        center:[-84.40,33.85],
			        zoom:9,
			        attributionControl:false
			    });
			
			    map.on('load',function(){
			        renderMarkers();
			        addCampusPins();
			    });
			
			    document.querySelectorAll('.tab').forEach(function(btn){
			        btn.addEventListener('click',function(){
			            document.querySelectorAll('.tab').forEach(function(b){ b.classList.remove('act'); });
			            btn.classList.add('act');
			            activeMinistry=btn.getAttribute('data-f');
			            renderMarkers();
			        });
			    });
			},500);
			</script>
			"
		lineageTag: e8c9c2d2-47a9-4e33-afbb-0181bbcd0d54

	measure FirstGiftsThisWeek =
			
			VAR _WeekEnd = [MaxselectedDate]
			VAR _WeekStart = _WeekEnd - 6
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(AnalyticsGivingSignals[PersonId]),
			    AnalyticsGivingSignals[FirstGiftDate] >= _WeekStart,
			    AnalyticsGivingSignals[FirstGiftDate] <= _WeekEnd
			)
		formatString: 0
