	measure HTML_VideoBanner = ```
			
			"
			<div class='pcc-banner'>
			
			  <video class='pcc-video' autoplay muted loop playsinline>
			    <source src='https://passioncitychurch.com/wp-content/uploads/2026/02/GLOBAL-BANNER-WEB-LOOP-2026-UPDATE-V1.mp4' type='video/mp4'>
			  </video>
			
			  <div class='pcc-overlay'></div>
			
			  <div class='pcc-text-wrap'>
			    <div class='pcc-title'>passion city church</div>
			  </div>
			
			</div>
			
			<style>
			.pcc-banner{
			  width:100%;
			  height:260px;
			  position:relative;
			  overflow:hidden;
			  border-radius:10px;
			  background:#000;
			}
			
			.pcc-video{
			  position:absolute;
			  inset:0;
			  width:100%;
			  height:100%;
			  object-fit:cover;
			  object-position:center 20%;
			 
			}
			
			.pcc-overlay{
			  position:absolute;
			  inset:0;
			  background:linear-gradient(
			    to bottom,
			    rgba(0,0,0,0.05) 0%,
			    rgba(0,0,0,0.62) 100%
			  );
			}
			
			.pcc-text-wrap{
			  position:absolute;
			  left:0;
			  bottom:0;
			  width:100%;
			  display:flex;
			  justify-content:center;
			  align-items:center;
			  padding-bottom:28px;
			}
			
			.pcc-title{
			  font-family:'Helvetica Now Display','Helvetica Neue','Arial Black','Inter',sans-serif;
			  font-weight:900;
			  font-size:44px;
			  line-height:1;
			  color:#ffffff;
			  letter-spacing:-0.07em;
			  text-shadow:0 2px 30px rgba(0,0,0,0.45);
			  opacity:0;
			  transform:translateY(50px);
			  animation:pccRiseUp 1.8s cubic-bezier(0.16,1,0.3,1) 0.4s forwards;
			}
			
			@keyframes pccRiseUp{
			  from{
			    opacity:0;
			    transform:translateY(50px);
			  }
			  to{
			    opacity:1;
			    transform:translateY(0);
			  }
			}
			</style>
			"
			```
