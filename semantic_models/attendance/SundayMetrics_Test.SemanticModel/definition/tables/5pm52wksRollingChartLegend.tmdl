			.rb th.grp{text-align:left;color:" & TxtPrimary & ";font-size:10px;border-bottom:1px solid " & SectionLine & ";}
			.rb th.g,.rb td.g{text-align:left;width:12%;}
			.rb th.a,.rb td.a{width:7.5%;}
			.rb th.p,.rb td.p{width:7.5%;}
			.rb th.y,.rb td.y{width:9%;}
			.rb th.sec,.rb td.sec{border-left:1px solid " & SectionLine & ";}
			.rb td{font-size:11px;padding:6px 7px;text-align:right;border-bottom:1px solid " & RowLine & ";color:" & TxtPrimary & ";font-variant-numeric:tabular-nums;font-feature-settings:'tnum';vertical-align:top;}
			.rb td.dim{color:" & TxtSecondary & ";}
			.rb td.y{padding:5px 7px;}
			.rb .yv{font-size:10px;font-weight:800;text-align:right;line-height:1.1;font-variant-numeric:tabular-nums;}
			.rb .yb{height:3px;border-radius:2px;background:" & TrackBg & ";overflow:hidden;margin-top:3px;}
			.rb .yf{height:100%;border-radius:2px;transform:scaleX(0);transform-origin:left center;transition:transform .9s cubic-bezier(.22,.8,.25,1);}
			.rb .gt{font-size:11px;font-weight:800;color:" & TxtPrimary & ";line-height:1.25;}
			.rb .gw{font-size:9px;font-weight:500;color:" & SchedTxt & ";line-height:1.3;margin-top:1px;}
			.rb tr.r-total td{background:" & CityRowBg & ";font-weight:900;border-top:2px solid " & SectionLine & ";border-bottom:none;}
			.rb-empty{min-height:120px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;}
			.rb-empty-h{font-size:12px;font-weight:800;color:" & TxtPrimary & ";}
			.rb-empty-s{font-size:11px;font-weight:500;color:" & TxtSecondary & ";max-width:280px;line-height:1.4;}
			</style>"
			    & "<div class='rb'>"
			    & HeadHTML
			    & "<table><thead><tr>"
			        & "<th class='grp'></th>"
			        & "<th class='grp' colspan='3'>Adults</th>"
			        & "<th class='grp sec' colspan='3'>bloom</th>"
			        & "<th class='grp sec' colspan='3'>Door Holder</th>"
			    & "</tr><tr>"
			        & "<th class='g'>Campus</th>"
			        & "<th class='a'>Att</th><th class='p'>Prev</th><th class='y'>YOY%</th>"
			        & "<th class='a sec'>Att</th><th class='p'>Prev</th><th class='y'>YOY%</th>"
			        & "<th class='a sec'>Att</th><th class='p'>Prev</th><th class='y'>YOY%</th>"
			    & "</tr></thead><tbody>"
			    & RowsHTML
			    & "</tbody></table></div>"
			    & "<script>(function(){function run(){var f=document.querySelectorAll('.rb .yf');requestAnimationFrame(function(){requestAnimationFrame(function(){f.forEach(function(el){el.style.transform='scaleX(1)';});});});}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',run);}else{run();}})();</script>"
			VAR EmptyHTML =
