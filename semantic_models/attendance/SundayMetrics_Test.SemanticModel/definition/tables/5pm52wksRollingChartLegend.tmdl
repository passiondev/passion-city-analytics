	measure HTML_Card_Five = ```
			
			VAR Att = [5pmCurAtt]
			VAR CurYrAvg = [CurYrAvgVarchar]
			VAR PrevYrAvg = [PrevYrAvgVarchar]
			VAR WoWNum = IF(ISNUMBER([5PMWOWMeasure]), [5PMWOWMeasure], 0)
			VAR YoYNum = IF(ISNUMBER([5PMYOYMeasure]), [5PMYOYMeasure], 0)
			VAR IsDark = [SelectedTheme] = "Dark"
			
			-- Theme colors
			VAR Bg = IF(IsDark, "#1E1E1E", "#FFFFFF")
			VAR BorderColor = IF(IsDark, "#2A2A2A", "#E5E7EB")
			VAR TrackColor = IF(IsDark, "#2A2A2A", "#E5E7EB")
			VAR SubCardBg = IF(IsDark, "#252525", "#F9FAFB")
			VAR SubDivider = IF(IsDark, "#3A3A3A", "#E5E7EB")
			VAR TxtPrimary = IF(IsDark, "#FFFFFF", "#111111")
			VAR TxtSecondary = IF(IsDark, "#9CA3AF", "#6B7280")
			VAR BadgeBorder = IF(IsDark, "#3A3A3A", "#E5E7EB")
			VAR GenericPosterURL = "https://www.dropbox.com/scl/fi/mdlvwscu5y2n1uyyocx97/the-five-default.png?rlkey=v8qvg5eme41ke31vlajcz5s54&st=nszcn4ti&raw=1"
			VAR LoaderBg = IF(IsDark, "#252525", "#F3F4F6")
			VAR LoaderWave1 = IF(IsDark, "rgba(255,255,255,0.10)", "rgba(192,192,192,0.35)")
			VAR LoaderWave2 = IF(IsDark, "rgba(255,255,255,0.22)", "rgba(160,160,160,0.50)")
			VAR PosterURL = 
			    COALESCE(
			        LOOKUPVALUE(
			            'dim_five_gatherings'[poster_url],
			            'dim_five_gatherings'[gathering_date], [MaxselectedDate5PM]
			        ),
			        GenericPosterURL
			    )
			VAR PosterBorder = IF(IsDark, "#3A3A3A", "#E5E7EB")
			
			-- Formatted numbers
			VAR AttFmt = FORMAT(Att, "#,0")
			VAR CurAvgFmt = FORMAT(CurYrAvg, "#,0")
			VAR PrevAvgFmt = FORMAT(PrevYrAvg, "#,0")
			
			-- Lollipop widths (capped at 100%)
			VAR MaxAvg = MAX(CurYrAvg, PrevYrAvg)
			VAR CurBarW = FORMAT(MIN(DIVIDE(CurYrAvg, MaxAvg, 0) * 100, 100), "0")
			VAR PrevBarW = FORMAT(MIN(DIVIDE(PrevYrAvg, MaxAvg, 0) * 100, 100), "0")
			VAR CurDotLeft = "calc(" & CurBarW & "% - 5px)"
			VAR PrevDotLeft = "calc(" & PrevBarW & "% - 5px)"
			
			-- YOY
			VAR YoYPct = FORMAT(ABS(YoYNum), "0.0%")
			VAR YoYArrow = IF(YoYNum >= 0, "↑", "↓")
			VAR YoYColor = IF(YoYNum >= 0, "#4ADE80", "#F87171")
			VAR YoYBarW = FORMAT(MIN(ABS(YoYNum) / 0.5, 1) * 100, "0")
			
			-- WOW
			VAR WoWPct = FORMAT(ABS(WoWNum), "0.0%")
			VAR WoWArrow = IF(WoWNum >= 0, "↑", "↓")
			VAR WoWColor = IF(WoWNum >= 0, "#4ADE80", "#F87171")
			VAR WoWBarW = FORMAT(MIN(ABS(WoWNum) / 0.5, 1) * 100, "0")
			
			-- Selected date for display
			VAR SelectedDate = FORMAT([MaxselectedDate5PM], "MMM DD, YYYY")
			
			RETURN
			"<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap');
			.five-card * { box-sizing:border-box; margin:0; padding:10; font-family:Inter,sans-serif; }
			.five-card {
			    background:" & Bg & ";
			    border:1px solid " & BorderColor & ";
			    border-radius:26px;
			    padding:50px;
			    width:100%;
			    display:grid;
			    grid-template-columns:45% 55%;
			    gap:20px;
			}
			.five-left {
			    display:flex;
			    flex-direction:column;
			    transform:translateX(-20px);
			}
			.five-title { font-size:64px; font-weight:900; color:" & TxtPrimary & "; line-height:1; letter-spacing:-2px; }
			.five-meta { display:flex; align-items:center; justify-content:space-between; margin-top:10px; margin-bottom:24px; }
			.five-cal-badge { border:1px solid " & BadgeBorder & "; border-radius:13px; padding:4px 12px; font-size:11px; font-weight:600; color:" & TxtSecondary & "; line-height:1.4; }
			.five-loc { font-size:13px; color:" & TxtSecondary & "; }
			.five-loc strong { color:" & TxtPrimary & "; font-weight:700; }
			.five-att-label {
			    font-size:16px;
			    font-weight:700;
			    color:" & TxtSecondary & ";
			    margin-bottom:8px;
			    margin-top:70px;
			}
			
			.five-att-num {
			    font-size:58px;
			    font-weight:900;
			    color:" & TxtPrimary & ";
			    line-height:1;
			}
			.five-spacer {
			    flex:0 0 105px;
			}
			
			.five-lollipop {
			    display:flex;
			    flex-direction:column;
			    gap:26px;
			    margin-top:25px;
			}
			
			.five-lolly-row {
			    display:flex;
			    flex-direction:column;
			    gap:8px;
			}
			
			.five-lolly-label {
			    font-size:12px;
			    color:" & TxtSecondary & ";
			    font-weight:500;
			}
			
			.five-lolly-wrap {
			    display:flex;
			    align-items:center;
			    gap:12px;
			}
			
			.five-lolly-val {
			    font-size:20px;
			    font-weight:800;
			    color:" & TxtPrimary & ";
			    min-width:44px;
			}
			.five-lolly-track { flex:1; height:2px; background:" & TrackColor & "; border-radius:2px; position:relative; }
			.five-lolly-line { height:2px; border-radius:2px; position:absolute; left:0; top:0; }
			.five-lolly-dot { width:10px; height:10px; border-radius:50%; position:absolute; top:-4px; }
			.five-right { display:flex; flex-direction:column; gap:12px; }
			.five-poster {
			    width:100%;
			    aspect-ratio:3 / 4;
			    flex:none;
			    border-radius:20px;
			    border:1px solid " & PosterBorder & ";
			    overflow:hidden;
			    position:relative;
			    background:" & Bg & ";
			}
			
			.five-poster-loader {
			    position:absolute;
			    inset:0;
			    border-radius:19px;
			    overflow:hidden;
			    background:" & LoaderBg & ";
			    z-index:1;
			}
			
			.five-poster-loader::after {
			    content:'';
			    position:absolute;
			    top:-150%;
			    left:0;
			    width:100%;
			    height:100%;
			    background:linear-gradient(
			        180deg,
			        transparent,
			        " & LoaderWave1 & ",
			        " & LoaderWave2 & ",
			        " & LoaderWave1 & ",
			        transparent
			    );
			    animation:posterShimmer 1.8s ease-in-out infinite;
			}
			
			@keyframes posterShimmer {
			    0% {
			        top:-150%;
			    }
			    100% {
			        top:150%;
			    }
			}
			.five-poster img {
			    position:absolute;
			    inset:0;
			    width:100%;
			    height:100%;
			    object-fit:cover;
			    display:block;
			    border-radius:19px;
			    z-index:2;
			}
			.five-sub { flex:1; background:" & SubCardBg & "; border:1px solid " & BorderColor & "; border-radius:22px; padding:14px 16px; display:grid; grid-template-columns:1fr 1px 1fr; gap:14px; align-items:center; }
			.five-metric-ttl { font-size:13px; font-weight:700; color:" & TxtPrimary & "; margin-bottom:4px; }
			.five-metric-row { display:flex; align-items:center; gap:8px; margin-bottom:8px; }
			.five-metric-num { font-size:24px; font-weight:900; color:" & TxtPrimary & "; }
			.five-prog-track { height:5px; border-radius:3px; background:" & TrackColor & "; overflow:hidden; }
			.five-prog-fill { height:5px; border-radius:3px; }
			.five-sub-div { width:1px; background:" & SubDivider & "; align-self:stretch; }
			</style>
			<div class='five-card'>
			<div class='five-left'>
			    <div class='five-title'>The FIVE</div>
			    <div class='five-meta'>
			        <div class='five-cal-badge'>" & SelectedDate & "</div>
			        <div class='five-loc'>location <strong>515</strong></div>
			    </div>
			    <div class='five-att-label'>Total Attendance</div>
			    <div class='five-att-num'>" & AttFmt & "</div>
			    <div class='five-spacer'></div>
			    <div class='five-lollipop'>
			        <div class='five-lolly-row'>
			            <div class='five-lolly-label'>Current Year Avg</div>
			            <div class='five-lolly-wrap'>
			                <div class='five-lolly-val'>" & CurAvgFmt & "</div>
			                <div class='five-lolly-track'>
			                    <div class='five-lolly-line' style='width:" & CurBarW & "%;background:#00B8E4;'></div>
			                    <div class='five-lolly-dot' style='left:" & CurDotLeft & ";background:#00B8E4;'></div>
			                </div>
			            </div>
			        </div>
			        <div class='five-lolly-row'>
			            <div class='five-lolly-label'>Previous Year Avg</div>
			            <div class='five-lolly-wrap'>
			                <div class='five-lolly-val'>" & PrevAvgFmt & "</div>
			                <div class='five-lolly-track'>
			                    <div class='five-lolly-line' style='width:" & PrevBarW & "%;background:#007A99;'></div>
			                    <div class='five-lolly-dot' style='left:" & PrevDotLeft & ";background:#007A99;'></div>
			                </div>
			            </div>
			        </div>
			    </div>
			</div>
			<div class='five-right'>
			<div class='five-poster'>
			    <div class='five-poster-loader'></div>" &
			    IF(
			        PosterURL <> BLANK(),
			        "<img src='" & PosterURL & "' onload=""this.previousElementSibling.style.display='none';"">",
			        "<div class='five-poster-hint'>Poster image will appear here</div>"
			    ) &
			"</div>
			<div class='five-sub'>
			    <div>
			        <div class='five-metric-ttl'>YOY%</div>
			        <div class='five-metric-row'>
			            <span class='five-metric-num'>" & YoYPct & "</span>
			            <span style='color:" & YoYColor & ";font-size:16px;'>" & YoYArrow & "</span>
			        </div>
			        <div class='five-prog-track'>
			            <div class='five-prog-fill' style='width:" & YoYBarW & "%;background:" & YoYColor & ";'></div>
			        </div>
			    </div>
			
			    <div class='five-sub-div'></div>
			
			    <div>
			        <div class='five-metric-ttl'>WOW%</div>
			        <div class='five-metric-row'>
			            <span class='five-metric-num'>" & WoWPct & "</span>
			            <span style='color:" & WoWColor & ";font-size:16px;'>" & WoWArrow & "</span>
			        </div>
			        <div class='five-prog-track'>
			            <div class='five-prog-fill' style='width:" & WoWBarW & "%;background:" & WoWColor & ";'></div>
			        </div>
			    </div>
			</div>
			</div>
			</div>"
			```
		lineageTag: a9d20652-21d5-4826-ab23-ec9210b23ce0

	measure HTML_Five_Rolling12 =
			
			VAR IsDark = [SelectedTheme] = "Dark"
			VAR Bg = IF(IsDark, "#1E1E1E", "#FFFFFF")
			VAR BorderColor = IF(IsDark, "#2A2A2A", "#E5E7EB")
			VAR TxtPrimary = IF(IsDark, "#FFFFFF", "#111111")
			VAR TxtSecondary = IF(IsDark, "#9CA3AF", "#6B7280")
			VAR TitleColor = IF(IsDark, "#FFFFFF", "#111111")
			
			VAR Today = TODAY()
			VAR StartDate = DATE(YEAR(Today)-1, MONTH(Today), DAY(Today))
			
			VAR GatheringData =
			    ADDCOLUMNS(
			        FILTER(
			            ALL('5pmSundayAttInPerson'[MetricValueDateTime]),
			            '5pmSundayAttInPerson'[MetricValueDateTime] >= StartDate
			            && '5pmSundayAttInPerson'[MetricValueDateTime] <= Today
			        ),
			        "Att", CALCULATE(
			            SUM('5pmSundayAttInPerson'[Count]),
			            '5pmSundayAttInPerson'[CampusName] = "515"
			        ),
			        "Lbl", FORMAT('5pmSundayAttInPerson'[MetricValueDateTime], "MMM YY")
			    )
			
			VAR FilteredData =
			    FILTER(GatheringData, [Att] > 0)
			
			VAR MaxAtt = MAXX(FilteredData, [Att])
			VAR PointCount = COUNTROWS(FilteredData)
			
			VAR XStep = DIVIDE(480, MAX(PointCount - 1, 1))
			VAR YRange = 124
			
			VAR Points =
			    ADDCOLUMNS(
			        ADDCOLUMNS(
			            FilteredData,
			            "RowNum", RANKX(FilteredData, '5pmSundayAttInPerson'[MetricValueDateTime], , ASC)
			        ),
			        "X", 30 + ([RowNum] - 1) * XStep,
			        "Y", 132 - DIVIDE([Att], MaxAtt, 0) * YRange
			    )
			
			VAR PathD =
			    CONCATENATEX(
			        Points,
			        IF([RowNum] = 1, "M", "L") &
			        FORMAT([X], "0") & "," &
			        FORMAT([Y], "0"),
			        " ",
			        '5pmSundayAttInPerson'[MetricValueDateTime], ASC
			    )
			
			VAR LastX = MAXX(Points, [X])
			VAR AreaPath = PathD & " L" & FORMAT(LastX, "0") & ",140 L30,140 Z"
			
			VAR DotsAndLabels =
			    CONCATENATEX(
			        Points,
			        "<circle cx='" & FORMAT([X], "0") & "' cy='" & FORMAT([Y], "0") & "' r='" &
			            IF([RowNum] = MAXX(Points, [RowNum]), "5", "4") &
			        "' fill='#00B8E4'/>" &
			        "<text x='" & FORMAT([X], "0") & "' y='" & FORMAT([Y] - 10, "0") &
			        "' text-anchor='middle' font-size='11' font-weight='700' fill='" & TxtPrimary & "'>" &
			        FORMAT([Att], "#,0") & "</text>" &
			        "<text x='" & FORMAT([X], "0") & "' y='158' text-anchor='middle' font-size='10' fill='" & TxtSecondary & "'>" &
			        [Lbl] & "</text>",
			        "",
			        '5pmSundayAttInPerson'[MetricValueDateTime], ASC
			    )
			
			RETURN
			"<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap');
			.five-chart * { box-sizing:border-box; margin:0; padding:0; font-family:Inter,sans-serif; }
			.five-chart { background:" & Bg & "; border:1px solid " & BorderColor & "; border-radius:14px; padding:20px; width:100%; }
			.five-chart-title { font-size:13px; font-weight:700; color:" & TitleColor & "; margin-bottom:16px; }
			</style>
			<div class='five-chart'>
			<div class='five-chart-title'>Rolling 12 Months</div>
			<svg viewBox='0 0 540 165' style='width:100%;overflow:visible;'>
			    <defs>
			        <linearGradient id='rg12' x1='0' y1='0' x2='0' y2='1'>
			            <stop offset='0%' stop-color='#00B8E4' stop-opacity='0.3'/>
			            <stop offset='100%' stop-color='#00B8E4' stop-opacity='0.02'/>
			        </linearGradient>
			    </defs>
			    <path d='" & AreaPath & "' fill='url(#rg12)'/>
			    <path d='" & PathD & "' fill='none' stroke='#00B8E4' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/>
			    " & DotsAndLabels & "
			</svg>
			</div>"
		lineageTag: 6f5ae830-35bd-45a2-ae88-94d0aee5c34d

	measure HTML_Five_RollingYears =
			
			VAR IsDark = [SelectedTheme] = "Dark"
			VAR Bg = IF(IsDark, "#1E1E1E", "#FFFFFF")
			VAR BorderColor = IF(IsDark, "#2A2A2A", "#E5E7EB")
			VAR TxtPrimary = IF(IsDark, "#FFFFFF", "#111111")
			VAR TxtSecondary = IF(IsDark, "#9CA3AF", "#6B7280")
			VAR TitleColor = IF(IsDark, "#FFFFFF", "#111111")
			
			VAR CurrentYear = YEAR(TODAY())
			VAR StartYear = CurrentYear - 6
			
			VAR YearlyData =
			    ADDCOLUMNS(
			        SUMMARIZE(
			            FILTER(
			                ALL('5pmSundayAttInPerson'),
			                YEAR('5pmSundayAttInPerson'[MetricValueDateTime]) >= StartYear
			                && YEAR('5pmSundayAttInPerson'[MetricValueDateTime]) <= CurrentYear
			                && '5pmSundayAttInPerson'[CampusName] = "515"
			                && '5pmSundayAttInPerson'[Count] > 100
			            ),
			            '5pmSundayAttInPerson'[MetricValueDateTime]
			        ),
			        "Yr", YEAR('5pmSundayAttInPerson'[MetricValueDateTime]),
			        "Att", CALCULATE(
			            SUM('5pmSundayAttInPerson'[Count]),
			            '5pmSundayAttInPerson'[CampusName] = "515"
			        )
			    )
			
			VAR YearSummary =
			    SUMMARIZE(
			        YearlyData,
			        [Yr],
			        "Total", SUMX(FILTER(YearlyData, [Yr] = EARLIER([Yr])), [Att])
			    )
			
			VAR MaxTotal = MAXX(YearSummary, [Total])
			VAR PointCount = COUNTROWS(YearSummary)
			VAR XStep = DIVIDE(480, MAX(PointCount - 1, 1))
			VAR YRange = 120
			
			VAR Points =
			    ADDCOLUMNS(
			        ADDCOLUMNS(
			            YearSummary,
			            "RowNum", RANKX(YearSummary, [Yr], , ASC)
			        ),
			        "X", 30 + ([RowNum] - 1) * XStep,
			        "Y", 128 - DIVIDE([Total], MaxTotal, 0) * YRange
			    )
			
			VAR PathD =
			    CONCATENATEX(
			        Points,
			        IF([RowNum] = 1, "M", "L") &
			        FORMAT([X], "0") & "," & FORMAT([Y], "0"),
			        " ",
			        [Yr], ASC
			    )
			
			VAR LastX = MAXX(Points, [X])
			VAR AreaPath = PathD & " L" & FORMAT(LastX, "0") & ",140 L30,140 Z"
			
			VAR DotsAndLabels =
			    CONCATENATEX(
			        Points,
			        "<circle cx='" & FORMAT([X], "0") & "' cy='" & FORMAT([Y], "0") &
			        "' r='" & IF([RowNum] = MAXX(Points, [RowNum]), "5", "4") &
			        "' fill='#00B8E4'/>" &
			        "<text x='" & FORMAT([X], "0") & "' y='" & FORMAT([Y] - 12, "0") &
			        "' text-anchor='middle' font-size='11' font-weight='700' fill='" & TxtPrimary & "'>" &
			        FORMAT([Total], "#,0") & "</text>" &
			        "<text x='" & FORMAT([X], "0") & "' y='158' text-anchor='middle' font-size='10' fill='" & TxtSecondary & "'>" &
			        FORMAT([Yr], "0") & "</text>",
			        "",
			        [Yr], ASC
			    )
			
			RETURN
			"<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap');
			.five-ryears * { box-sizing:border-box; margin:0; padding:0; font-family:Inter,sans-serif; }
			.five-ryears { background:" & Bg & "; border:1px solid " & BorderColor & "; border-radius:14px; padding:20px; width:100%; }
			.five-ryears-title { font-size:13px; font-weight:700; color:" & TitleColor & "; margin-bottom:16px; }
			</style>
			<div class='five-ryears'>
			<div class='five-ryears-title'>Rolling 7 Years</div>
			<svg viewBox='0 0 540 165' style='width:100%;height:240px;overflow:visible;'>
			    <defs>
			        <linearGradient id='rgy' x1='0' y1='0' x2='0' y2='1'>
			            <stop offset='0%' stop-color='#00B8E4' stop-opacity='0.3'/>
			            <stop offset='100%' stop-color='#00B8E4' stop-opacity='0.02'/>
			        </linearGradient>
			    </defs>
			    <path d='" & AreaPath & "' fill='url(#rgy)'/>
			    <path d='" & PathD & "' fill='none' stroke='#00B8E4' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/>
			    " & DotsAndLabels & "
			</svg>
			</div>"
		lineageTag: 5101a82e-7258-4674-a682-fbcba3e5cd05

	measure HTML_Five_CurrVsPrev =
			
			VAR IsDark = [SelectedTheme] = "Dark"
			VAR Bg = IF(IsDark, "#1E1E1E", "#FFFFFF")
			VAR BorderColor = IF(IsDark, "#2A2A2A", "#E5E7EB")
			VAR TxtPrimary = IF(IsDark, "#FFFFFF", "#111111")
			VAR TxtSecondary = IF(IsDark, "#9CA3AF", "#6B7280")
			VAR PrevBarColor = IF(IsDark, "#3A3A3A", "#D1D5DB")
			
			VAR SelectedDate = [MaxselectedDate5PM]
			
			-- Previous gathering date — same logic as PrevMonth5pm
			VAR PrevDate =
			    MAXX(
			        FILTER(
			            ALL('5pmSundayAttInPerson'[MetricValueDateTime]),
			            '5pmSundayAttInPerson'[MetricValueDateTime] < SelectedDate
			            && CALCULATE(SUM('5pmSundayAttInPerson'[Count])) > 0
			        ),
			        '5pmSundayAttInPerson'[MetricValueDateTime]
			    )
			
			-- Current values by Literal — same logic as CurMonth5pm filtered by Literal
			VAR CurAdults =
			    COALESCE(CALCULATE(
			        SUM('5pmSundayAttInPerson'[Count]),
			        '5pmSundayAttInPerson'[MetricValueDateTime] = SelectedDate,
			        '5pmSundayAttInPerson'[CampusName] = "515",
			        '5pmSundayAttInPerson'[Literal] = "Adults"
			    ), 0)
			VAR CurDH =
			    COALESCE(CALCULATE(
			        SUM('5pmSundayAttInPerson'[Count]),
			        '5pmSundayAttInPerson'[MetricValueDateTime] = SelectedDate,
			        '5pmSundayAttInPerson'[CampusName] = "515",
			        '5pmSundayAttInPerson'[Literal] = "Door Holder"
			    ), 0)
			VAR CurBloom =
			    COALESCE(CALCULATE(
			        SUM('5pmSundayAttInPerson'[Count]),
			        '5pmSundayAttInPerson'[MetricValueDateTime] = SelectedDate,
			        '5pmSundayAttInPerson'[CampusName] = "515",
			        '5pmSundayAttInPerson'[Literal] = "bloom"
			    ), 0)
			
			-- Previous values by Literal — same logic as PrevMonth5pm filtered by Literal
			VAR PrevAdults =
			    COALESCE(CALCULATE(
			        SUM('5pmSundayAttInPerson'[Count]),
			        '5pmSundayAttInPerson'[MetricValueDateTime] = PrevDate,
			        '5pmSundayAttInPerson'[CampusName] = "515",
			        '5pmSundayAttInPerson'[Literal] = "Adults"
			    ), 0)
			VAR PrevDH =
			    COALESCE(CALCULATE(
			        SUM('5pmSundayAttInPerson'[Count]),
			        '5pmSundayAttInPerson'[MetricValueDateTime] = PrevDate,
			        '5pmSundayAttInPerson'[CampusName] = "515",
			        '5pmSundayAttInPerson'[Literal] = "Door Holder"
			    ), 0)
			VAR PrevBloom =
			    COALESCE(CALCULATE(
			        SUM('5pmSundayAttInPerson'[Count]),
			        '5pmSundayAttInPerson'[MetricValueDateTime] = PrevDate,
			        '5pmSundayAttInPerson'[CampusName] = "515",
			        '5pmSundayAttInPerson'[Literal] = "bloom"
			    ), 0)
			
			-- Scale bars relative to max value
			VAR MaxVal = MAXX({CurAdults, PrevAdults, CurDH, PrevDH, CurBloom, PrevBloom}, [Value])
			VAR ChartH = 180
			
			VAR CurAdultsH = FORMAT(DIVIDE(CurAdults, MaxVal, 0) * ChartH, "0")
			VAR PrevAdultsH = FORMAT(DIVIDE(PrevAdults, MaxVal, 0) * ChartH, "0")
			VAR CurDHH = FORMAT(DIVIDE(CurDH, MaxVal, 0) * ChartH, "0")
			VAR PrevDHH = FORMAT(DIVIDE(PrevDH, MaxVal, 0) * ChartH, "0")
			VAR CurBloomH = FORMAT(DIVIDE(CurBloom, MaxVal, 0) * ChartH, "0")
			VAR PrevBloomH = FORMAT(DIVIDE(PrevBloom, MaxVal, 0) * ChartH, "0")
			
			VAR CurAdultsFmt = FORMAT(CurAdults, "#,0")
			VAR PrevAdultsFmt = FORMAT(PrevAdults, "#,0")
			VAR CurDHFmt = FORMAT(CurDH, "#,0")
			VAR PrevDHFmt = FORMAT(PrevDH, "#,0")
			VAR CurBloomFmt = FORMAT(CurBloom, "#,0")
			VAR PrevBloomFmt = FORMAT(PrevBloom, "#,0")
			
			VAR PrevDateFmt = FORMAT(PrevDate, "MMM YY")
			VAR CurDateFmt = FORMAT(SelectedDate, "MMM YY")
			
			RETURN
			"<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap');
			.fwc * { box-sizing:border-box; margin:0; padding:0; font-family:Inter,sans-serif; }
			.fwc { background:" & Bg & "; border:1px solid " & BorderColor & "; border-radius:14px; padding:20px; width:100%; }
			.fwc-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; }
			.fwc-title { font-size:13px; font-weight:700; color:" & TxtPrimary & "; }
			.fwc-legend { display:flex; align-items:center; gap:12px; }
			.fwc-leg-item { display:flex; align-items:center; gap:5px; }
			.fwc-leg-dot { width:8px; height:8px; border-radius:50%; }
			.fwc-leg-txt { font-size:10px; color:" & TxtSecondary & "; font-weight:500; }
			.fwc-chart { display:flex; gap:0; align-items:flex-end; padding-top:44px; }
			.fwc-group { display:flex; flex-direction:column; align-items:center; flex:1; }
			.fwc-bars { display:flex; gap:6px; align-items:flex-end; height:" & FORMAT(ChartH, "0") & "px; justify-content:center; }
			.fwc-bar-wrap { display:flex; flex-direction:column; align-items:center; gap:4px; justify-content:flex-end; }
			.fwc-val { font-size:10px; font-weight:700; color:" & TxtPrimary & "; }
			.fwc-bar { width:28px; border-radius:4px 4px 0 0; }
			.fwc-divider { width:1px; background:" & BorderColor & "; height:" & FORMAT(ChartH + 32, "0") & "px; margin:0 8px; }
			.fwc-group-label { font-size:11px; font-weight:600; color:" & TxtSecondary & "; margin-top:8px; padding-top:8px; border-top:1px solid " & BorderColor & "; width:100%; text-align:center; }
			</style>
			<div class='fwc'>
			    <div class='fwc-header'>
			        <div class='fwc-title'>Current vs Previous</div>
			        <div class='fwc-legend'>
			            <div class='fwc-leg-item'>
			                <div class='fwc-leg-dot' style='background:" & PrevBarColor & ";'></div>
			                <span class='fwc-leg-txt'>" & PrevDateFmt & "</span>
			            </div>
			            <div class='fwc-leg-item'>
			                <div class='fwc-leg-dot' style='background:#00B8E4;'></div>
			                <span class='fwc-leg-txt'>" & CurDateFmt & "</span>
			            </div>
			        </div>
			    </div>
			    <div class='fwc-chart'>
			        <div class='fwc-group'>
			            <div class='fwc-bars'>
			                <div class='fwc-bar-wrap'>
			                    <div class='fwc-val'>" & PrevAdultsFmt & "</div>
			                    <div class='fwc-bar' style='height:" & PrevAdultsH & "px;background:" & PrevBarColor & ";'></div>
			                </div>
			                <div class='fwc-bar-wrap'>
			                    <div class='fwc-val'>" & CurAdultsFmt & "</div>
			                    <div class='fwc-bar' style='height:" & CurAdultsH & "px;background:#00B8E4;'></div>
			                </div>
			            </div>
			            <div class='fwc-group-label'>Adults</div>
			        </div>
			        <div class='fwc-divider'></div>
			        <div class='fwc-group'>
			            <div class='fwc-bars'>
			                <div class='fwc-bar-wrap'>
			                    <div class='fwc-val'>" & PrevDHFmt & "</div>
			                    <div class='fwc-bar' style='height:" & PrevDHH & "px;background:" & PrevBarColor & ";'></div>
			                </div>
			                <div class='fwc-bar-wrap'>
			                    <div class='fwc-val'>" & CurDHFmt & "</div>
			                    <div class='fwc-bar' style='height:" & CurDHH & "px;background:#00B8E4;'></div>
			                </div>
			            </div>
			            <div class='fwc-group-label'>Door Holder</div>
			        </div>
			        <div class='fwc-divider'></div>
			        <div class='fwc-group'>
			            <div class='fwc-bars'>
			                <div class='fwc-bar-wrap'>
			                    <div class='fwc-val'>" & PrevBloomFmt & "</div>
			                    <div class='fwc-bar' style='height:" & PrevBloomH & "px;background:" & PrevBarColor & ";'></div>
			                </div>
			                <div class='fwc-bar-wrap'>
			                    <div class='fwc-val'>" & CurBloomFmt & "</div>
			                    <div class='fwc-bar' style='height:" & CurBloomH & "px;background:#00B8E4;'></div>
			                </div>
			            </div>
			            <div class='fwc-group-label'>Bloom</div>
			        </div>
			    </div>
			</div>"
		lineageTag: 46e63b4e-04bf-42a9-b2f4-d71d39a5c6f9

	measure HTML_Five_Table =
			
			VAR IsDark = [SelectedTheme] = "Dark"
			VAR Bg = IF(IsDark, "#1E1E1E", "#FFFFFF")
			VAR BorderColor = IF(IsDark, "#2A2A2A", "#E5E7EB")
			VAR TxtPrimary = IF(IsDark, "#FFFFFF", "#111111")
			VAR TxtSecondary = IF(IsDark, "#9CA3AF", "#6B7280")
			VAR SectionHeaderBg = IF(IsDark, "#252525", "#F9FAFB")
			VAR SectionBodyBg = IF(IsDark, "#1A1A1A", "#F3F4F6")
			VAR CellBorder = IF(IsDark, "#2A2A2A", "#E5E7EB")
			
			VAR SelectedDate = [MaxselectedDate5PM]
			
			-- Previous gathering date
			VAR PrevDate =
			    MAXX(
			        FILTER(
			            ALL('5pmSundayAttInPerson'[MetricValueDateTime]),
			            '5pmSundayAttInPerson'[MetricValueDateTime] < SelectedDate
			            && CALCULATE(SUM('5pmSundayAttInPerson'[Count])) > 0
			        ),
			        '5pmSundayAttInPerson'[MetricValueDateTime]
			    )
			
			-- Previous year last gathering date
			VAR PrevYearDate =
			    MAXX(
			        FILTER(
			            ALL('5pmSundayAttInPerson'[MetricValueDateTime]),
			            YEAR('5pmSundayAttInPerson'[MetricValueDateTime]) = YEAR(SelectedDate) - 1
			        ),
			        '5pmSundayAttInPerson'[MetricValueDateTime]
			    )
			
			-- Current
			VAR CurAdults = COALESCE(CALCULATE(SUM('5pmSundayAttInPerson'[Count]), '5pmSundayAttInPerson'[MetricValueDateTime] = SelectedDate, '5pmSundayAttInPerson'[CampusName] = "515", '5pmSundayAttInPerson'[Literal] = "Adults"), 0)
			VAR CurDH = COALESCE(CALCULATE(SUM('5pmSundayAttInPerson'[Count]), '5pmSundayAttInPerson'[MetricValueDateTime] = SelectedDate, '5pmSundayAttInPerson'[CampusName] = "515", '5pmSundayAttInPerson'[Literal] = "Door Holder"), 0)
			VAR CurBloom = COALESCE(CALCULATE(SUM('5pmSundayAttInPerson'[Count]), '5pmSundayAttInPerson'[MetricValueDateTime] = SelectedDate, '5pmSundayAttInPerson'[CampusName] = "515", '5pmSundayAttInPerson'[Literal] = "bloom"), 0)
			
			-- Previous gathering
			VAR PrevAdults = COALESCE(CALCULATE(SUM('5pmSundayAttInPerson'[Count]), '5pmSundayAttInPerson'[MetricValueDateTime] = PrevDate, '5pmSundayAttInPerson'[CampusName] = "515", '5pmSundayAttInPerson'[Literal] = "Adults"), 0)
			VAR PrevDH = COALESCE(CALCULATE(SUM('5pmSundayAttInPerson'[Count]), '5pmSundayAttInPerson'[MetricValueDateTime] = PrevDate, '5pmSundayAttInPerson'[CampusName] = "515", '5pmSundayAttInPerson'[Literal] = "Door Holder"), 0)
			VAR PrevBloom = COALESCE(CALCULATE(SUM('5pmSundayAttInPerson'[Count]), '5pmSundayAttInPerson'[MetricValueDateTime] = PrevDate, '5pmSundayAttInPerson'[CampusName] = "515", '5pmSundayAttInPerson'[Literal] = "bloom"), 0)
			
			-- Previous year
			VAR PrevYrAdults = COALESCE(CALCULATE(SUM('5pmSundayAttInPerson'[Count]), '5pmSundayAttInPerson'[MetricValueDateTime] = PrevYearDate, '5pmSundayAttInPerson'[CampusName] = "515", '5pmSundayAttInPerson'[Literal] = "Adults"), 0)
			VAR PrevYrDH = COALESCE(CALCULATE(SUM('5pmSundayAttInPerson'[Count]), '5pmSundayAttInPerson'[MetricValueDateTime] = PrevYearDate, '5pmSundayAttInPerson'[CampusName] = "515", '5pmSundayAttInPerson'[Literal] = "Door Holder"), 0)
			VAR PrevYrBloom = COALESCE(CALCULATE(SUM('5pmSundayAttInPerson'[Count]), '5pmSundayAttInPerson'[MetricValueDateTime] = PrevYearDate, '5pmSundayAttInPerson'[CampusName] = "515", '5pmSundayAttInPerson'[Literal] = "bloom"), 0)
			
			-- MOM %
			VAR MOMAdults = FORMAT(DIVIDE(CurAdults - PrevAdults, PrevAdults, 0), "+0.0%;-0.0%;0.0%")
			VAR MOMDH = FORMAT(DIVIDE(CurDH - PrevDH, PrevDH, 0), "+0.0%;-0.0%;0.0%")
			VAR MOMBloom = FORMAT(DIVIDE(CurBloom - PrevBloom, PrevBloom, 0), "+0.0%;-0.0%;0.0%")
			
			-- YOY %
			VAR YOYAdults = FORMAT(DIVIDE(CurAdults - PrevYrAdults, PrevYrAdults, 0), "+0.0%;-0.0%;0.0%")
			VAR YOYDH = FORMAT(DIVIDE(CurDH - PrevYrDH, PrevYrDH, 0), "+0.0%;-0.0%;0.0%")
			VAR YOYBloom = FORMAT(DIVIDE(CurBloom - PrevYrBloom, PrevYrBloom, 0), "+0.0%;-0.0%;0.0%")
			
			-- Colors
			VAR MOMAdultsC = IF(CurAdults >= PrevAdults, IF(IsDark, "#4ADE80", "#166534"), IF(IsDark, "#F87171", "#991B1B"))
			VAR MOMADHColor = IF(CurDH >= PrevDH, IF(IsDark, "#4ADE80", "#166534"), IF(IsDark, "#F87171", "#991B1B"))
			VAR MOMBloomC = IF(CurBloom >= PrevBloom, IF(IsDark, "#4ADE80", "#166534"), IF(IsDark, "#F87171", "#991B1B"))
			VAR YOYAdultsC = IF(CurAdults >= PrevYrAdults, IF(IsDark, "#4ADE80", "#166534"), IF(IsDark, "#F87171", "#991B1B"))
			VAR YOYDHColor = IF(CurDH >= PrevYrDH, IF(IsDark, "#4ADE80", "#166534"), IF(IsDark, "#F87171", "#991B1B"))
			VAR YOYBloomC = IF(CurBloom >= PrevYrBloom, IF(IsDark, "#4ADE80", "#166634"), IF(IsDark, "#F87171", "#991B1B"))
			
			RETURN
			"<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap');
			.ftbl * { box-sizing:border-box; margin:0; padding:0; font-family:Inter,sans-serif; }
			.ftbl { background:" & Bg & "; border:1px solid " & BorderColor & "; border-radius:14px; padding:20px; width:100%; }
			.ftbl-title { font-size:13px; font-weight:700; color:" & TxtPrimary & "; margin-bottom:16px; }
			.section { margin-bottom:6px; }
			.section:last-child { margin-bottom:0; }
			.sec-header { display:flex; align-items:center; padding:5px 14px; background:" & SectionHeaderBg & "; border-radius:5px 8px 0 0; border-bottom:2px solid #00B8E4; }
			.sec-title { font-size:12px; font-weight:700; color:" & TxtPrimary & "; }
			.sec-body { display:grid; grid-template-columns:1fr 1fr 1fr 1fr; background:" & SectionBodyBg & "; border-radius:0 0 8px 8px; overflow:hidden; }
			.cell { padding:7px 16px; display:flex; flex-direction:column; gap:7px; border-right:1px solid " & CellBorder & "; }
			.cell:last-child { border-right:none; }
			.cell-lbl { font-size:10px; font-weight:600; color:" & TxtSecondary & "; text-transform:uppercase; letter-spacing:0.5px; }
			.cell-val { font-size:16px; font-weight:700; color:" & TxtPrimary & "; }
			.cell-val.muted { color:" & TxtSecondary & "; font-weight:500; font-size:18px; }
			.cell-val.pos { color:#4ADE80; }
			.cell-val.neg { color:#F87171; }
			</style>
			<div class='ftbl'>
			<div class='ftbl-title'>Detailed Breakdown · 515</div>
			
			<div class='section'>
			    <div class='sec-header'><div class='sec-title'>Adults</div></div>
			    <div class='sec-body'>
			        <div class='cell'><div class='cell-lbl'>Current</div><div class='cell-val'>" & FORMAT(CurAdults, "#,0") & "</div></div>
			        <div class='cell'><div class='cell-lbl'>Previous</div><div class='cell-val muted'>" & FORMAT(PrevAdults, "#,0") & "</div></div>
			        <div class='cell'><div class='cell-lbl'>MOM</div><div class='cell-val " & IF(CurAdults >= PrevAdults, "pos", "neg") & "'>" & MOMAdults & "</div></div>
			        <div class='cell'><div class='cell-lbl'>YOY</div><div class='cell-val " & IF(CurAdults >= PrevYrAdults, "pos", "neg") & "'>" & YOYAdults & "</div></div>
			    </div>
			</div>
			
			<div class='section'>
			    <div class='sec-header'><div class='sec-title'>Door Holder</div></div>
			    <div class='sec-body'>
			        <div class='cell'><div class='cell-lbl'>Current</div><div class='cell-val'>" & FORMAT(CurDH, "#,0") & "</div></div>
			        <div class='cell'><div class='cell-lbl'>Previous</div><div class='cell-val muted'>" & FORMAT(PrevDH, "#,0") & "</div></div>
			        <div class='cell'><div class='cell-lbl'>MOM</div><div class='cell-val " & IF(CurDH >= PrevDH, "pos", "neg") & "'>" & MOMDH & "</div></div>
			        <div class='cell'><div class='cell-lbl'>YOY</div><div class='cell-val " & IF(CurDH >= PrevYrDH, "pos", "neg") & "'>" & YOYDH & "</div></div>
			    </div>
			</div>
			
			<div class='section'>
			    <div class='sec-header'><div class='sec-title'>Bloom</div></div>
			    <div class='sec-body'>
			        <div class='cell'><div class='cell-lbl'>Current</div><div class='cell-val'>" & FORMAT(CurBloom, "#,0") & "</div></div>
			        <div class='cell'><div class='cell-lbl'>Previous</div><div class='cell-val muted'>" & FORMAT(PrevBloom, "#,0") & "</div></div>
			        <div class='cell'><div class='cell-lbl'>MOM</div><div class='cell-val " & IF(CurBloom >= PrevBloom, "pos", "neg") & "'>" & MOMBloom & "</div></div>
			        <div class='cell'><div class='cell-lbl'>YOY</div><div class='cell-val " & IF(CurBloom >= PrevYrBloom, "pos", "neg") & "'>" & YOYBloom & "</div></div>
			    </div>
			</div>
			
			</div>"
		lineageTag: 66dd8669-2fdf-41c6-9337-e6412935d1a0

	measure HTML_Christmas_MainCard =
			
			
			// -------------------------------------------------------------
			// 1. VALUES
			// -------------------------------------------------------------
			VAR _Total =
			    COALESCE ( [CurrentYearChristmas], 0 )
			
			VAR _515 =
			    COALESCE (
			        CALCULATE (
			            [CurrentYearChristmas],
			            KEEPFILTERS (
			                SplSundayAttInPerson_WOW[CampusName] = "515"
			            )
			        ),
			        0
			    )
			
			VAR _CBL =
			    COALESCE (
			        CALCULATE (
			            [CurrentYearChristmas],
			            KEEPFILTERS (
			                SplSundayAttInPerson_WOW[CampusName] = "Cumberland"
			            )
			        ),
			        0
			    )
			
			VAR _TRL =
			    COALESCE (
			        CALCULATE (
			            [CurrentYearChristmas],
			            KEEPFILTERS (
			                SplSundayAttInPerson_WOW[CampusName] = "Trilith"
			            )
			        ),
			        0
			    )
			
			VAR _Online =
			    COALESCE ( [CurrChristmasAttOnl], 0 )
			
			
			// -------------------------------------------------------------
			// 2. YOY
			// -------------------------------------------------------------
			VAR _TotalYOY =
			    COALESCE ( [YOYMeasureChristmas], 0 )
			
			VAR _515YOY =
			    COALESCE ( [Christmas_515_YOY], 0 )
			
			VAR _CBLYOY =
			    COALESCE ( [Christmas_CBL_YOY], 0 )
			
			VAR _TRLYOY =
			    COALESCE ( [Christmas_TRL_YOY], 0 )
			
			VAR _OnlYOY =
			    COALESCE ( [Christmas_Online_YOY], 0 )
			
			
			// -------------------------------------------------------------
			// 3. POSTER
			// -------------------------------------------------------------
			VAR PosterURL =
			    LOOKUPVALUE (
			        'dim_holiday_posters'[poster_url],
			        'dim_holiday_posters'[event_name], "Christmas",
			        'dim_holiday_posters'[event_year], [ChristmasYear]
			    )
			
			VAR DefaultPoster =
			    "https://www.dropbox.com/scl/fi/sy8fqa8wtzrix6t198xxd/Christmas-_-General.jpeg?rlkey=fcvtfz9rz8ks0nmg0tqxl9pbv&st=ywtu0er6&raw=1"
			
			VAR FinalPoster =
			    COALESCE (
			        PosterURL,
			        DefaultPoster
			    )
			
			
			// -------------------------------------------------------------
			// 4. THEME
			// -------------------------------------------------------------
			VAR _IsDark =
			    [SelectedTheme] = "Dark"
			
			VAR _Bg =
			    IF (
			        _IsDark,
			        "#1E1E1E",
			        "#FFFFFF"
			    )
			
			VAR _CardBorder =
			    IF (
			        _IsDark,
			        "#2A2A2A",
			        "#E5E7EB"
			    )
			
			VAR _SubBg =
			    IF (
			        _IsDark,
			        "#252525",
			        "#F9FAFB"
			    )
			
			VAR _SubBorder =
			    IF (
			        _IsDark,
			        "#353535",
			        "#E5E7EB"
			    )
			
			VAR _TxtPrimary =
			    IF (
			        _IsDark,
			        "#FFFFFF",
			        "#111111"
			    )
			
			VAR _TxtSecondary =
			    IF (
			        _IsDark,
			        "#AFAFAF",
			        "#6B7280"
			    )
			
			VAR _YoyLabel =
			    IF (
			        _IsDark,
			        "#A0A0A0",
			        "#6B7280"
			    )
			
			VAR _TrackBg =
			    IF (
			        _IsDark,
			        "#323232",
			        "#E5E7EB"
			    )
			
			VAR _TrackBorder =
			    IF (
			        _IsDark,
			        "#474747",
			        "#D1D5DB"
			    )
			
			VAR _PosterBg =
			    IF (
			        _IsDark,
			        "#1E1E1E",
			        "#FFFFFF"
			    )
			
			VAR _PosterBorder =
			    IF (
			        _IsDark,
			        "#3A3A3A",
			        "#E5E7EB"
			    )
			
			
			// -------------------------------------------------------------
			// POSTER LOADER THEME
			// -------------------------------------------------------------
			VAR _LoaderBg =
			    IF (
			        _IsDark,
			        "#252525",
			        "#F3F4F6"
			    )
			
			VAR _LoaderWave1 =
			    IF (
			        _IsDark,
			        "rgba(255,255,255,0.10)",
			        "rgba(192,192,192,0.35)"
			    )
			
			VAR _LoaderWave2 =
			    IF (
			        _IsDark,
			        "rgba(255,255,255,0.22)",
			        "rgba(160,160,160,0.50)"
			    )
			
			VAR _TotalBarCol =
			    IF (
			        _IsDark,
			        "#555555",
			        "#9CA3AF"
			    )
			
			
			// -------------------------------------------------------------
			// 5. CONSTANTS
			// -------------------------------------------------------------
			VAR _BarCap = 0.25
			VAR _MinBar = 8
			
			VAR _Green = "#62E68D"
			VAR _Red = "#FF7E84"
			
			VAR _FillGreen = "#62E68D"
			VAR _FillRed = "#FF8C91"
			
			VAR _PathUp =
			    "M3 18 L9 12 L13 15 L21 6 M15 6 L21 6 L21 12"
			
			VAR _PathDown =
			    "M3 6 L9 12 L13 9 L21 18 M15 18 L21 18 L21 12"
			
			
			// -------------------------------------------------------------
			// 6. DERIVED YOY VALUES
			// -------------------------------------------------------------
			VAR _TotUp =
			    _TotalYOY >= 0
			
			VAR _TotCol =
			    IF ( _TotUp, _Green, _Red )
			
			VAR _TotCls =
			    IF ( _TotUp, "positive", "negative" )
			
			VAR _TotFill =
			    IF ( _TotUp, "fill-positive", "fill-negative" )
			
			VAR _TotPath =
			    IF ( _TotUp, _PathUp, _PathDown )
			
			VAR _TotTxt =
			    IF ( _TotUp, "+", "" )
			        & FORMAT ( _TotalYOY, "0%" )
			
			VAR _TotBar =
			    MAX (
			        _MinBar,
			        MIN (
			            100,
			            ROUND (
			                DIVIDE (
			                    ABS ( _TotalYOY ),
			                    _BarCap
			                ) * 100,
			                0
			            )
			        )
			    )
			
			
			VAR _F15Up =
			    _515YOY >= 0
			
			VAR _F15Col =
			    IF ( _F15Up, _Green, _Red )
			
			VAR _F15Cls =
			    IF ( _F15Up, "positive", "negative" )
			
			VAR _F15Fill =
			    IF ( _F15Up, "fill-positive", "fill-negative" )
			
			VAR _F15Path =
			    IF ( _F15Up, _PathUp, _PathDown )
			
			VAR _F15Txt =
			    IF ( _F15Up, "+", "" )
			        & FORMAT ( _515YOY, "0%" )
			
			VAR _F15Bar =
			    MAX (
			        _MinBar,
			        MIN (
			            100,
			            ROUND (
			                DIVIDE (
			                    ABS ( _515YOY ),
			                    _BarCap
			                ) * 100,
			                0
			            )
			        )
			    )
			
			
			VAR _CBUp =
			    _CBLYOY >= 0
			
			VAR _CBCol =
			    IF ( _CBUp, _Green, _Red )
			
			VAR _CBCls =
			    IF ( _CBUp, "positive", "negative" )
			
			VAR _CBFill =
			    IF ( _CBUp, "fill-positive", "fill-negative" )
			
			VAR _CBPath =
			    IF ( _CBUp, _PathUp, _PathDown )
			
			VAR _CBTxt =
			    IF ( _CBUp, "+", "" )
			        & FORMAT ( _CBLYOY, "0%" )
			
			VAR _CBBar =
			    MAX (
			        _MinBar,
			        MIN (
			            100,
			            ROUND (
			                DIVIDE (
			                    ABS ( _CBLYOY ),
			                    _BarCap
			                ) * 100,
			                0
			            )
			        )
			    )
			
			
			VAR _TRUp =
			    _TRLYOY >= 0
			
			VAR _TRCol =
			    IF ( _TRUp, _Green, _Red )
			
			VAR _TRCls =
			    IF ( _TRUp, "positive", "negative" )
			
			VAR _TRFill =
			    IF ( _TRUp, "fill-positive", "fill-negative" )
			
			VAR _TRPath =
			    IF ( _TRUp, _PathUp, _PathDown )
			
			VAR _TRTxt =
			    IF ( _TRUp, "+", "" )
			        & FORMAT ( _TRLYOY, "0%" )
			
			VAR _TRBar =
			    MAX (
			        _MinBar,
			        MIN (
			            100,
			            ROUND (
			                DIVIDE (
			                    ABS ( _TRLYOY ),
			                    _BarCap
			                ) * 100,
			                0
			            )
			        )
			    )
			
			
			VAR _OnUp =
			    _OnlYOY >= 0
			
			VAR _OnCol =
			    IF ( _OnUp, _Green, _Red )
			
			VAR _OnCls =
			    IF ( _OnUp, "positive", "negative" )
			
			VAR _OnFill =
			    IF ( _OnUp, "fill-positive", "fill-negative" )
			
			VAR _OnPath =
			    IF ( _OnUp, _PathUp, _PathDown )
			
			VAR _OnTxt =
			    IF ( _OnUp, "+", "" )
			        & FORMAT ( _OnlYOY, "0%" )
			
			VAR _OnBar =
			    MAX (
			        _MinBar,
			        MIN (
			            100,
			            ROUND (
			                DIVIDE (
			                    ABS ( _OnlYOY ),
			                    _BarCap
			                ) * 100,
			                0
			            )
			        )
			    )
			
			
			// -------------------------------------------------------------
			// 7. CSS
			// -------------------------------------------------------------
			VAR _CSS =
			"
			<style>
			
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
			
			.christmas-card *{
			    box-sizing:border-box;
			    margin:0;
			    padding:0;
			    font-family:Inter,sans-serif;
			}
			
			.christmas-card{
			    width:100%;
			    background:" & _Bg & ";
			    border:1px solid " & _CardBorder & ";
			    border-radius:26px;
			    padding:26px;
			    contain:layout paint;
			}
			
			.christmas-grid{
			    display:grid;
			    grid-template-columns:
			        minmax(0,1.56fr)
			        minmax(0,1fr)
			        minmax(0,3.1fr);
			    grid-template-rows:repeat(4,96px);
			    column-gap:16px;
			    row-gap:12px;
			    align-items:center;
			}
			
			
			/* ATTENDANCE CARDS */
			
			.christmas-card .att-card{
			    width:100%;
			    height:96px;
			    background:" & _SubBg & ";
			    border:1px solid " & _SubBorder & ";
			    border-radius:18px;
			    display:flex;
			    flex-direction:column;
			    align-items:center;
			    justify-content:center;
			    position:relative;
			    overflow:hidden;
			}
			
			.christmas-card .top-bar{
			    position:absolute;
			    top:0;
			    left:0;
			    right:0;
			    height:4px;
			    border-radius:18px 18px 0 0;
			}
			
			.christmas-card .att-label{
			    font-size:13px;
			    font-weight:700;
			    color:" & _TxtSecondary & ";
			    margin-bottom:9px;
			    margin-top:4px;
			}
			
			.christmas-card .campus-tag{
			    font-size:13px;
			    font-weight:700;
			    margin-bottom:9px;
			    margin-top:4px;
			}
			
			.christmas-card .att-value{
			    width:120px;
			    text-align:center;
			    font-size:24px;
			    line-height:1;
			    font-weight:900;
			    color:" & _TxtPrimary & ";
			    font-variant-numeric:tabular-nums;
			    font-feature-settings:'tnum';
			    white-space:nowrap;
			    transform:translateZ(0);
			    backface-visibility:hidden;
			}
			
			
			/* YOY */
			
			.christmas-card .yoy{
			    width:100%;
			    align-self:center;
			    contain:layout paint;
			}
			
			.christmas-card .yoy-label{
			    color:" & _YoyLabel & ";
			    font-size:9px;
			    font-weight:700;
			    letter-spacing:1px;
			    margin-bottom:3px;
			}
			
			.christmas-card .yoy-number-row{
			    display:flex;
			    align-items:center;
			    gap:4px;
			    margin-bottom:6px;
			    height:14px;
			}
			
			.christmas-card .yoy-number{
			    min-width:30px;
			    font-size:12px;
			    font-weight:900;
			    line-height:1;
			    font-variant-numeric:tabular-nums;
			    font-feature-settings:'tnum';
			}
			
			.christmas-card .positive{
			    color:" & _Green & ";
			}
			
			.christmas-card .negative{
			    color:" & _Red & ";
			}
			
			.christmas-card .yoy-icon{
			    width:12px;
			    height:12px;
			    overflow:visible;
			    flex-shrink:0;
			    transform:translateZ(0);
			}
			
			.christmas-card .draw-arrow path{
			    fill:none;
			    stroke-dashoffset:100;
			    will-change:stroke-dashoffset;
			}
			
			
			/* PROGRESS */
			
			.christmas-card .progress{
			    width:100%;
			    height:6px;
			    background:" & _TrackBg & ";
			    border:1px solid " & _TrackBorder & ";
			    border-radius:4px;
			    overflow:hidden;
			    contain:paint;
			}
			
			.christmas-card .progress-fill{
			    width:100%;
			    height:100%;
			    border-radius:4px;
			    transform:scaleX(0);
			    transform-origin:left center;
			    will-change:transform;
			    transition:
			        transform
			        1.35s
			        cubic-bezier(.22,.8,.25,1);
			}
			
			.christmas-card .fill-positive{
			    background:" & _FillGreen & ";
			}
			
			.christmas-card .fill-negative{
			    background:" & _FillRed & ";
			}
			
			
			/* -------------------------------------------------------------
			   POSTER WRAPPER
			   ------------------------------------------------------------- */
			
			.christmas-card .poster{
			    grid-column:3;
			    grid-row:1 / 4;
			
			    width:100%;
			    height:100%;
			
			    display:flex;
			    align-items:center;
			    justify-content:center;
			
			    position:relative;
			    overflow:hidden;
			
			    background:transparent;
			}
			
			
			/* -------------------------------------------------------------
			   POSTER LOADER
			   ------------------------------------------------------------- */
			
			.christmas-card .poster-loader{
			    position:absolute;
			    inset:0;
			
			    border-radius:20px;
			    overflow:hidden;
			
			    background:" & _LoaderBg & ";
			
			    z-index:5;
			
			    opacity:0;
			
			    transition:
			        opacity
			        .35s
			        ease;
			}
			
			
			/* SHIMMER */
			
			.christmas-card .poster-loader::after{
			    content:'';
			
			    position:absolute;
			
			    top:-150%;
			    left:0;
			
			    width:100%;
			    height:100%;
			
			    background:
			        linear-gradient(
			            180deg,
			            transparent,
			            " & _LoaderWave1 & ",
			            " & _LoaderWave2 & ",
			            " & _LoaderWave1 & ",
			            transparent
			        );
			
			    animation:
			        christmasPosterShimmer
			        1.8s
			        ease-in-out
			        infinite;
			}
			
			
			@keyframes christmasPosterShimmer{
			
			    0%{
			        top:-150%;
			    }
			
			    100%{
			        top:150%;
			    }
			
			}
			
			
			/* -------------------------------------------------------------
			   POSTER IMAGE
			   TRUE ORIGINAL PROPORTIONS
			   ------------------------------------------------------------- */
			
			.christmas-card .poster img{
			    width:auto;
			    height:auto;
			
			    max-width:100%;
			    max-height:100%;
			
			    object-fit:contain;
			    object-position:center;
			
			    display:block;
			
			    border:1px solid " & _PosterBorder & ";
			    border-radius:20px;
			
			    position:relative;
			    z-index:2;
			
			    opacity:0;
			
			    transition:
			        opacity
			        .40s
			        ease;
			}
			
			
			/* ONLINE */
			
			.christmas-card .online-card{
			    grid-column:3;
			    grid-row:4;
			
			    width:100%;
			    height:96px;
			
			    background:" & _SubBg & ";
			    border:1px solid " & _SubBorder & ";
			    border-radius:18px;
			
			    display:grid;
			    grid-template-columns:1fr 1.25fr;
			
			    gap:22px;
			    align-items:center;
			
			    padding:16px 20px;
			}
			
			.christmas-card .online-left{
			    display:flex;
			    align-items:center;
			    gap:20px;
			}
			
			.christmas-card .online-label{
			    font-size:14px;
			    font-weight:700;
			    color:" & _TxtSecondary & ";
			    flex-shrink:0;
			}
			
			.christmas-card .online-value{
			    width:100px;
			    font-size:23px;
			    font-weight:900;
			    color:" & _TxtPrimary & ";
			    text-align:left;
			    font-variant-numeric:tabular-nums;
			    font-feature-settings:'tnum';
			    white-space:nowrap;
			    transform:translateZ(0);
			}
			
			
			/* GRID POSITIONS */
			
			.christmas-card .total-card{
			    grid-column:1;
			    grid-row:1;
			}
			
			.christmas-card .total-yoy{
			    grid-column:2;
			    grid-row:1;
			}
			
			.christmas-card .five15-card{
			    grid-column:1;
			    grid-row:2;
			}
			
			.christmas-card .five15-yoy{
			    grid-column:2;
			    grid-row:2;
			}
			
			.christmas-card .cbl-card{
			    grid-column:1;
			    grid-row:3;
			}
			
			.christmas-card .cbl-yoy{
			    grid-column:2;
			    grid-row:3;
			}
			
			.christmas-card .trl-card{
			    grid-column:1;
			    grid-row:4;
			}
			
			.christmas-card .trl-yoy{
			    grid-column:2;
			    grid-row:4;
			}
			
			</style>
			"
			
			
			// -------------------------------------------------------------
			// 8. JS
			// -------------------------------------------------------------
			VAR _JS =
			"
			<script>
			
			(function(){
			
			function run(){
			
			    // COUNT UP
			    document
			        .querySelectorAll('.christmas-card .count-up')
			        .forEach(function(el){
			
			            var target =
			                Number(el.dataset.target);
			
			            var duration =
			                1500;
			
			            var startTime =
			                null;
			
			            function step(ts){
			
			                if(startTime===null){
			                    startTime=ts;
			                }
			
			                var p =
			                    Math.min(
			                        (ts-startTime)/duration,
			                        1
			                    );
			
			                var eased =
			                    1-Math.pow(1-p,3);
			
			                el.textContent =
			                    Math
			                    .round(
			                        target*eased
			                    )
			                    .toLocaleString('en-US');
			
			                if(p<1){
			
			                    requestAnimationFrame(step);
			
			                }else{
			
			                    el.textContent =
			                        target.toLocaleString('en-US');
			
			                }
			
			            }
			
			            requestAnimationFrame(step);
			
			        });
			
			
			    // PROGRESS BARS
			    var bars =
			        document.querySelectorAll(
			            '.christmas-card .progress-fill'
			        );
			
			    requestAnimationFrame(function(){
			
			        requestAnimationFrame(function(){
			
			            bars.forEach(function(b){
			
			                b.style.transform =
			                    'scaleX('
			                    +
			                    (
			                        Number(b.dataset.width)
			                        /
			                        100
			                    )
			                    +
			                    ')';
			
			            });
			
			        });
			
			    });
			
			
			    // ARROW DRAW
			    document
			        .querySelectorAll(
			            '.christmas-card .draw-arrow path'
			        )
			        .forEach(function(path,i){
			
			            var len =
			                path.getTotalLength();
			
			            path.style.strokeDasharray =
			                len+' '+len;
			
			            path.style.strokeDashoffset =
			                len;
			
			            path.getBoundingClientRect();
			
			            setTimeout(function(){
			
			                path.style.transition =
			                    'stroke-dashoffset 900ms cubic-bezier(.4,0,.2,1)';
			
			                path.style.strokeDashoffset =
			                    '0';
			
			            },220+(i*80));
			
			        });
			
			
			    // -------------------------------------------------------------
			    // POSTER LOAD / REVEAL
			    // -------------------------------------------------------------
			    var posterBox =
			        document.querySelector(
			            '.christmas-card .poster'
			        );
			
			    var posterLoader =
			        document.querySelector(
			            '.christmas-card .poster-loader'
			        );
			
			    if(posterBox && posterLoader){
			
			        var posterUrl =
			            posterBox.getAttribute(
			                'data-poster-src'
			            );
			
			        var LOADER_DELAY =
			            200;
			
			        var loaderTimer =
			            setTimeout(function(){
			
			                posterLoader.style.opacity =
			                    '1';
			
			            },LOADER_DELAY);
			
			
			        function hideLoader(){
			
			            clearTimeout(loaderTimer);
			
			            posterLoader.style.opacity =
			                '0';
			
			            setTimeout(function(){
			
			                posterLoader.style.display =
			                    'none';
			
			            },350);
			
			        }
			
			
			        function revealPoster(loadedImg){
			
			            clearTimeout(loaderTimer);
			
			            loadedImg.alt =
			                '';
			
			            posterBox.appendChild(
			                loadedImg
			            );
			
			            requestAnimationFrame(function(){
			
			                requestAnimationFrame(function(){
			
			                    hideLoader();
			
			                    loadedImg.style.opacity =
			                        '1';
			
			                });
			
			            });
			
			        }
			
			
			        if(posterUrl){
			
			            var preload =
			                new Image();
			
			            preload.src =
			                posterUrl;
			
			
			            function whenReady(){
			
			                revealPoster(
			                    preload
			                );
			
			            }
			
			
			            if(preload.decode){
			
			                preload
			                    .decode()
			                    .then(
			                        whenReady
			                    )
			                    .catch(
			                        hideLoader
			                    );
			
			            }else{
			
			                preload.onload =
			                    whenReady;
			
			                preload.onerror =
			                    hideLoader;
			
			            }
			
			        }else{
			
			            hideLoader();
			
			        }
			
			    }
			
			}
			
			
			if(document.readyState==='loading'){
			
			    document.addEventListener(
			        'DOMContentLoaded',
			        run
			    );
			
			}else{
			
			    run();
			
			}
			
			})();
			
			</script>
			"
			
			
			// -------------------------------------------------------------
			// 9. BODY
			// -------------------------------------------------------------
			VAR _Body =
			
			"<div class='christmas-card'>
			<div class='christmas-grid'>"
			
			
			// TOTAL
			& "<div class='att-card total-card'>"
			
			& "<div
			     class='top-bar'
			     style='background:"
			     & _TotalBarCol &
			     ";'>
			   </div>"
			
			& "<div class='att-label'>
			     Total Attendance
			   </div>"
			
			& "<div
			     class='att-value count-up'
			     data-target='"
			     & FORMAT ( _Total, "0" )
			     &
			     "'>
			     0
			   </div>"
			
			& "</div>"
			
			
			// TOTAL YOY
			& "<div class='yoy total-yoy'>"
			
			& "<div class='yoy-label'>
			     YOY
			   </div>"
			
			& "<div class='yoy-number-row'>"
			
			& "<span class='yoy-number "
			    & _TotCls &
			    "'>"
			    & _TotTxt &
			    "</span>"
			
			& "<svg
			     class='yoy-icon draw-arrow'
			     viewBox='0 0 24 24'>"
			
			& "<path
			     d='"
			     & _TotPath &
			     "'
			     stroke='"
			     & _TotCol &
			     "'
			     stroke-width='2.7'
			     stroke-linecap='round'
			     stroke-linejoin='round'
			   />"
			
			& "</svg>"
			
			& "</div>"
			
			& "<div class='progress'>"
			
			& "<div
			     class='progress-fill "
			     & _TotFill &
			     "'
			     data-width='"
			     & FORMAT ( _TotBar, "0" )
			     &
			     "'>
			   </div>"
			
			& "</div>"
			
			& "</div>"
			
			
			// POSTER
			& "<div
			     class='poster'
			     data-poster-src='"
			     & FinalPoster &
			     "'>"
			
			& "<div class='poster-loader'></div>"
			
			& "</div>"
			
			
			// 515
			& "<div class='att-card five15-card'>"
			
			& "<div
			     class='top-bar'
			     style='background:#00B8E4;'>
			   </div>"
			
			& "<div
			     class='campus-tag'
			     style='color:#00B8E4;'>
			     515
			   </div>"
			
			& "<div
			     class='att-value count-up'
			     data-target='"
			     & FORMAT ( _515, "0" )
			     &
			     "'>
			     0
			   </div>"
			
			& "</div>"
			
			
			// 515 YOY
			& "<div class='yoy five15-yoy'>"
			
			& "<div class='yoy-label'>
			     YOY
			   </div>"
			
			& "<div class='yoy-number-row'>"
			
			& "<span class='yoy-number "
			    & _F15Cls &
			    "'>"
			    & _F15Txt &
			    "</span>"
			
			& "<svg
			     class='yoy-icon draw-arrow'
			     viewBox='0 0 24 24'>"
			
			& "<path
			     d='"
			     & _F15Path &
			     "'
			     stroke='"
			     & _F15Col &
			     "'
			     stroke-width='2.7'
			     stroke-linecap='round'
			     stroke-linejoin='round'
			   />"
			
			& "</svg>"
			
			& "</div>"
			
			& "<div class='progress'>"
			
			& "<div
			     class='progress-fill "
			     & _F15Fill &
			     "'
			     data-width='"
			     & FORMAT ( _F15Bar, "0" )
			     &
			     "'>
			   </div>"
			
			& "</div>"
			
			& "</div>"
			
			
			// CBL
			& "<div class='att-card cbl-card'>"
			
			& "<div
			     class='top-bar'
			     style='background:#FF641C;'>
			   </div>"
			
			& "<div
			     class='campus-tag'
			     style='color:#FF641C;'>
			     CBL
			   </div>"
			
			& "<div
			     class='att-value count-up'
			     data-target='"
			     & FORMAT ( _CBL, "0" )
			     &
			     "'>
			     0
			   </div>"
			
			& "</div>"
			
			
			// CBL YOY
			& "<div class='yoy cbl-yoy'>"
			
			& "<div class='yoy-label'>
			     YOY
			   </div>"
			
			& "<div class='yoy-number-row'>"
			
			& "<span class='yoy-number "
			    & _CBCls &
			    "'>"
			    & _CBTxt &
			    "</span>"
			
			& "<svg
			     class='yoy-icon draw-arrow'
			     viewBox='0 0 24 24'>"
			
			& "<path
			     d='"
			     & _CBPath &
			     "'
			     stroke='"
			     & _CBCol &
			     "'
			     stroke-width='2.7'
			     stroke-linecap='round'
			     stroke-linejoin='round'
			   />"
			
			& "</svg>"
			
			& "</div>"
			
			& "<div class='progress'>"
			
			& "<div
			     class='progress-fill "
			     & _CBFill &
			     "'
			     data-width='"
			     & FORMAT ( _CBBar, "0" )
			     &
			     "'>
			   </div>"
			
			& "</div>"
			
			& "</div>"
			
			
			// TRL
			& "<div class='att-card trl-card'>"
			
			& "<div
			     class='top-bar'
			     style='background:#931EE7;'>
			   </div>"
			
			& "<div
			     class='campus-tag'
			     style='color:#931EE7;'>
			     TRL
			   </div>"
			
			& "<div
			     class='att-value count-up'
			     data-target='"
			     & FORMAT ( _TRL, "0" )
			     &
			     "'>
			     0
			   </div>"
			
			& "</div>"
			
			
			// TRL YOY
			& "<div class='yoy trl-yoy'>"
			
			& "<div class='yoy-label'>
			     YOY
			   </div>"
			
			& "<div class='yoy-number-row'>"
			
			& "<span class='yoy-number "
			    & _TRCls &
			    "'>"
			    & _TRTxt &
			    "</span>"
			
			& "<svg
			     class='yoy-icon draw-arrow'
			     viewBox='0 0 24 24'>"
			
			& "<path
			     d='"
			     & _TRPath &
			     "'
			     stroke='"
			     & _TRCol &
			     "'
			     stroke-width='2.7'
			     stroke-linecap='round'
			     stroke-linejoin='round'
			   />"
			
			& "</svg>"
			
			& "</div>"
			
			& "<div class='progress'>"
			
			& "<div
			     class='progress-fill "
			     & _TRFill &
			     "'
			     data-width='"
			     & FORMAT ( _TRBar, "0" )
			     &
			     "'>
			   </div>"
			
			& "</div>"
			
			& "</div>"
			
			
			// ONLINE
			& "<div class='online-card'>"
			
			& "<div class='online-left'>"
			
			& "<div class='online-label'>
			     Online
			   </div>"
			
			& "<div
			     class='online-value count-up'
			     data-target='"
			     & FORMAT ( _Online, "0" )
			     &
			     "'>
			     0
			   </div>"
			
			& "</div>"
			
			& "<div class='yoy'>"
			
			& "<div class='yoy-label'>
			     YOY
			   </div>"
			
			& "<div class='yoy-number-row'>"
			
			& "<span class='yoy-number "
			    & _OnCls &
			    "'>"
			    & _OnTxt &
			    "</span>"
			
			& "<svg
			     class='yoy-icon draw-arrow'
			     viewBox='0 0 24 24'>"
			
			& "<path
			     d='"
			     & _OnPath &
			     "'
			     stroke='"
			     & _OnCol &
			     "'
			     stroke-width='2.7'
			     stroke-linecap='round'
			     stroke-linejoin='round'
			   />"
			
			& "</svg>"
			
			& "</div>"
			
			& "<div class='progress'>"
			
			& "<div
			     class='progress-fill "
			     & _OnFill &
			     "'
			     data-width='"
			     & FORMAT ( _OnBar, "0" )
			     &
			     "'>
			   </div>"
			
			& "</div>"
			
			& "</div>"
			
			& "</div>"
			
			& "</div>"
			& "</div>"
			
			
			// -------------------------------------------------------------
			// 10. RETURN
			// -------------------------------------------------------------
			RETURN
			    _CSS
			        & _Body
			        & _JS
		lineageTag: 87d38c80-b467-4aa4-8cd9-8b3ca22d3fce

	measure HTML_Christmas_RB_515 =
			
			VAR IsDark =
			    [SelectedTheme] = "Dark"
			VAR Bg =
			    IF ( IsDark, "#1E1E1E", "#FFFFFF" )
			VAR BorderColor =
			    IF ( IsDark, "#2A2A2A", "#E5E7EB" )
			VAR TxtPrimary =
			    IF ( IsDark, "#FFFFFF", "#111111" )
			VAR TxtSecondary =
			    IF ( IsDark, "#9CA3AF", "#6B7280" )
			VAR HeadBg =
			    IF ( IsDark, "#252525", "#F9FAFB" )
			VAR RowLine =
			    IF ( IsDark, "rgba(255,255,255,0.06)", "rgba(0,0,0,0.06)" )
			VAR SectionLine =
			    IF ( IsDark, "#3A3A3A", "#D1D5DB" )
			VAR CityRowBg =
			    IF ( IsDark, "#2A2A2A", "#F3F4F6" )
			VAR SchedTxt =
			    IF ( IsDark, "#8A8A8A", "#6B7280" )
			VAR TrackBg =
			    IF ( IsDark, "#323232", "#E5E7EB" )
			VAR Green =
			    "#62E68D"
			VAR Red =
			    "#FF7E84"
			VAR BarCap =
			    0.5
			VAR Accent =
			    "#00B8E4"
			VAR SelYr =
			    [ChristmasYear]
			VAR PrevYr =
			    SelYr - 1
			VAR Src =
			    FILTER (
			        ALL ( 'SplSundayAttInPerson_WOW' ),
			        'SplSundayAttInPerson_WOW'[EventName] = "Christmas"
			            &&
			        'SplSundayAttInPerson_WOW'[CampusName] = "515"
			            &&
			        (
			            VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                ||
			            VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			        )
			    )
			VAR Base =
			    SUMMARIZE (
			        Src,
			        'SplSundayAttInPerson_WOW'[Literal],
			        'SplSundayAttInPerson_WOW'[FormattedDateSplSun],
			        'SplSundayAttInPerson_WOW'[ScheduleName],
			        'SplSundayAttInPerson_WOW'[ScheduleSort],
			        "V", SUM ( 'SplSundayAttInPerson_WOW'[Count] )
			    )
			VAR Ranked =
			    ADDCOLUMNS (
			        Base,
			        "Rnk",
			            VAR thisLit = 'SplSundayAttInPerson_WOW'[Literal]
			            VAR thisYr = 'SplSundayAttInPerson_WOW'[FormattedDateSplSun]
			            VAR thisSort = 'SplSundayAttInPerson_WOW'[ScheduleSort]
			            RETURN
			                COUNTROWS (
			                    FILTER (
			                        Base,
			                        'SplSundayAttInPerson_WOW'[Literal] = thisLit
			                            &&
			                        'SplSundayAttInPerson_WOW'[FormattedDateSplSun] = thisYr
			                            &&
			                        'SplSundayAttInPerson_WOW'[ScheduleSort] <= thisSort
			                    )
			                )
			    )
			VAR MaxRank =
			    COALESCE ( MAXX ( Ranked, [Rnk] ), 0 )
			VAR MinYrAvail =
			    MINX (
			        FILTER ( ALL ( 'SplSundayAttInPerson_WOW' ), 'SplSundayAttInPerson_WOW'[EventName] = "Christmas" ),
			        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] )
			    )
			VAR MaxYrAvail =
			    MAXX (
			        FILTER ( ALL ( 'SplSundayAttInPerson_WOW' ), 'SplSundayAttInPerson_WOW'[EventName] = "Christmas" ),
			        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] )
			    )
			VAR CurYearTotal =
			    SUMX (
			        FILTER ( Ranked, VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr ),
			        [V]
			    )
			VAR HasData =
			    NOT ISBLANK ( SelYr )
			        &&
			    MaxRank > 0
			        &&
			    COALESCE ( CurYearTotal, 0 ) > 0
			VAR EmptyHeadline =
			    IF (
			        ISBLANK ( SelYr ),
			        "No data available",
			        "No Christmas data for " & FORMAT ( SelYr, "0" )
			    )
			VAR EmptySubline =
			    "Available from "
			        & FORMAT ( MinYrAvail, "0" )
			        & " to "
			        & FORMAT ( MaxYrAvail, "0" )
			VAR RankKeys =
			    UNION (
			        SELECTCOLUMNS ( GENERATESERIES ( 1, MAX ( MaxRank, 1 ) ), "Rnk", [Value] ),
			        ROW ( "Rnk", 0 )
			    )
			VAR RowData =
			    ADDCOLUMNS (
			        RankKeys,
			        "AdCur",
			            VAR r = [Rnk]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Ranked,
			                        'SplSundayAttInPerson_WOW'[Literal] = "Adults"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                            &&
			                        ( r = 0 || [Rnk] = r )
			                    ),
			                    [V]
			                ),
			        "AdPrev",
			            VAR r = [Rnk]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Ranked,
			                        'SplSundayAttInPerson_WOW'[Literal] = "Adults"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                            &&
			                        ( r = 0 || [Rnk] = r )
			                    ),
			                    [V]
			                ),
			        "AdName",
			            VAR r = [Rnk]
			            RETURN
			                IF (
			                    r = 0,
			                    "",
			                    CONCATENATEX (
			                        SUMMARIZE (
			                            FILTER (
			                                Ranked,
			                                'SplSundayAttInPerson_WOW'[Literal] = "Adults"
			                                    &&
			                                VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                                    &&
			                                [Rnk] = r
			                            ),
			                            'SplSundayAttInPerson_WOW'[ScheduleName],
			                            'SplSundayAttInPerson_WOW'[ScheduleSort]
			                        ),
			                        'SplSundayAttInPerson_WOW'[ScheduleName],
			                        " / ",
			                        'SplSundayAttInPerson_WOW'[ScheduleSort],
			                        ASC
			                    )
			                ),
			        "AdWas",
			            VAR r = [Rnk]
			            RETURN
			                IF (
			                    r = 0,
			                    "",
			                    CONCATENATEX (
			                        SUMMARIZE (
			                            FILTER (
			                                Ranked,
			                                'SplSundayAttInPerson_WOW'[Literal] = "Adults"
			                                    &&
			                                VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                                    &&
			                                [Rnk] = r
			                            ),
			                            'SplSundayAttInPerson_WOW'[ScheduleName],
			                            'SplSundayAttInPerson_WOW'[ScheduleSort]
			                        ),
			                        'SplSundayAttInPerson_WOW'[ScheduleName],
			                        " / ",
			                        'SplSundayAttInPerson_WOW'[ScheduleSort],
			                        ASC
			                    )
			                ),
			        "BlCur",
			            VAR r = [Rnk]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Ranked,
			                        'SplSundayAttInPerson_WOW'[Literal] = "bloom"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                            &&
			                        ( r = 0 || [Rnk] = r )
			                    ),
			                    [V]
			                ),
			        "BlPrev",
			            VAR r = [Rnk]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Ranked,
			                        'SplSundayAttInPerson_WOW'[Literal] = "bloom"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                            &&
			                        ( r = 0 || [Rnk] = r )
			                    ),
			                    [V]
			                ),
			        "BlName",
			            VAR r = [Rnk]
			            RETURN
			                IF (
			                    r = 0,
			                    "",
			                    CONCATENATEX (
			                        SUMMARIZE (
			                            FILTER (
			                                Ranked,
			                                'SplSundayAttInPerson_WOW'[Literal] = "bloom"
			                                    &&
			                                VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                                    &&
			                                [Rnk] = r
			                            ),
			                            'SplSundayAttInPerson_WOW'[ScheduleName],
			                            'SplSundayAttInPerson_WOW'[ScheduleSort]
			                        ),
			                        'SplSundayAttInPerson_WOW'[ScheduleName],
			                        " / ",
			                        'SplSundayAttInPerson_WOW'[ScheduleSort],
			                        ASC
			                    )
			                ),
			        "BlWas",
			            VAR r = [Rnk]
			            RETURN
			                IF (
			                    r = 0,
			                    "",
			                    CONCATENATEX (
			                        SUMMARIZE (
			                            FILTER (
			                                Ranked,
			                                'SplSundayAttInPerson_WOW'[Literal] = "bloom"
			                                    &&
			                                VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                                    &&
			                                [Rnk] = r
			                            ),
			                            'SplSundayAttInPerson_WOW'[ScheduleName],
			                            'SplSundayAttInPerson_WOW'[ScheduleSort]
			                        ),
			                        'SplSundayAttInPerson_WOW'[ScheduleName],
			                        " / ",
			                        'SplSundayAttInPerson_WOW'[ScheduleSort],
			                        ASC
			                    )
			                ),
			        "DhCur",
			            VAR r = [Rnk]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Ranked,
			                        'SplSundayAttInPerson_WOW'[Literal] = "Door Holder"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                            &&
			                        ( r = 0 || [Rnk] = r )
			                    ),
			                    [V]
			                ),
			        "DhPrev",
			            VAR r = [Rnk]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Ranked,
			                        'SplSundayAttInPerson_WOW'[Literal] = "Door Holder"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                            &&
			                        ( r = 0 || [Rnk] = r )
			                    ),
			                    [V]
			                ),
			        "DhName",
			            VAR r = [Rnk]
			            RETURN
			                IF (
			                    r = 0,
			                    "",
			                    CONCATENATEX (
			                        SUMMARIZE (
			                            FILTER (
			                                Ranked,
			                                'SplSundayAttInPerson_WOW'[Literal] = "Door Holder"
			                                    &&
			                                VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                                    &&
			                                [Rnk] = r
			                            ),
			                            'SplSundayAttInPerson_WOW'[ScheduleName],
			                            'SplSundayAttInPerson_WOW'[ScheduleSort]
			                        ),
			                        'SplSundayAttInPerson_WOW'[ScheduleName],
			                        " / ",
			                        'SplSundayAttInPerson_WOW'[ScheduleSort],
			                        ASC
			                    )
			                ),
			        "DhWas",
			            VAR r = [Rnk]
			            RETURN
			                IF (
			                    r = 0,
			                    "",
			                    CONCATENATEX (
			                        SUMMARIZE (
			                            FILTER (
			                                Ranked,
			                                'SplSundayAttInPerson_WOW'[Literal] = "Door Holder"
			                                    &&
			                                VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                                    &&
			                                [Rnk] = r
			                            ),
			                            'SplSundayAttInPerson_WOW'[ScheduleName],
			                            'SplSundayAttInPerson_WOW'[ScheduleSort]
			                        ),
			                        'SplSundayAttInPerson_WOW'[ScheduleName],
			                        " / ",
			                        'SplSundayAttInPerson_WOW'[ScheduleSort],
			                        ASC
			                    )
			                )
			    )
			VAR RowsHTML =
			    CONCATENATEX (
			        RowData,
			        VAR r = [Rnk]
			        VAR rowCls =
			            IF ( r = 0, "r-total", "r-gath" )
			        VAR aCur =
			            [AdCur]
			        VAR aPrev =
			            [AdPrev]
			        VAR aState =
			            SWITCH (
			                TRUE (),
			                COALESCE ( aCur, 0 ) = 0
			                    &&
			                COALESCE ( aPrev, 0 ) = 0, "empty",
			                COALESCE ( aPrev, 0 ) = 0, "new",
			                COALESCE ( aCur, 0 ) = 0, "gone",
			                "ok"
			            )
			        VAR aYOY =
			            IF (
			                aState = "ok",
			                DIVIDE ( aCur - aPrev, aPrev )
			            )
			        VAR aTxt =
			            SWITCH (
			                aState,
			                "empty", "",
			                "new", "NEW",
			                "gone", "N/A",
			                IF (
			                    aYOY >= 0,
			                    "+" & FORMAT ( aYOY, "0.00%" ),
			                    FORMAT ( aYOY, "0.00%" )
			                )
			            )
			        VAR aCol =
			            SWITCH (
			                aState,
			                "empty", TxtSecondary,
			                "new", "#00B8E4",
			                "gone", TxtSecondary,
			                IF ( aYOY >= 0, Green, Red )
			            )
			        VAR aBar =
			            IF (
			                aState = "ok",
			                MIN (
			                    100,
			                    ROUND ( DIVIDE ( ABS ( aYOY ), BarCap ) * 100, 0 )
			                ),
			                0
			            )
			        VAR aShowBar =
			            aState = "ok"
			        VAR aF1 =
			            IF (
			                COALESCE ( aCur, 0 ) = 0,
			                "",
			                FORMAT ( aCur, "#,0" )
			            )
			        VAR aF2 =
			            IF (
			                COALESCE ( aPrev, 0 ) = 0,
			                "",
			                FORMAT ( aPrev, "#,0" )
			            )
			        VAR aNm =
			            [AdName]
			        VAR aWs =
			            [AdWas]
			        VAR aCell =
			            IF (
			                r = 0,
			                "<div class='gt'>Total</div>",
			                "<div class='gt'>" & IF ( aNm = "", "--", aNm ) & "</div>"
			                    & IF ( aWs = "", "", "<div class='gw'>was " & aWs & "</div>" )
			            )
			        VAR bCur =
			            [BlCur]
			        VAR bPrev =
			            [BlPrev]
			        VAR bState =
			            SWITCH (
			                TRUE (),
			                COALESCE ( bCur, 0 ) = 0
			                    &&
			                COALESCE ( bPrev, 0 ) = 0, "empty",
			                COALESCE ( bPrev, 0 ) = 0, "new",
			                COALESCE ( bCur, 0 ) = 0, "gone",
			                "ok"
			            )
			        VAR bYOY =
			            IF (
			                bState = "ok",
			                DIVIDE ( bCur - bPrev, bPrev )
			            )
			        VAR bTxt =
			            SWITCH (
			                bState,
			                "empty", "",
			                "new", "NEW",
			                "gone", "N/A",
			                IF (
			                    bYOY >= 0,
			                    "+" & FORMAT ( bYOY, "0.00%" ),
			                    FORMAT ( bYOY, "0.00%" )
			                )
			            )
			        VAR bCol =
			            SWITCH (
			                bState,
			                "empty", TxtSecondary,
			                "new", "#00B8E4",
			                "gone", TxtSecondary,
			                IF ( bYOY >= 0, Green, Red )
			            )
			        VAR bBar =
			            IF (
			                bState = "ok",
			                MIN (
			                    100,
			                    ROUND ( DIVIDE ( ABS ( bYOY ), BarCap ) * 100, 0 )
			                ),
			                0
			            )
			        VAR bShowBar =
			            bState = "ok"
			        VAR bF1 =
			            IF (
			                COALESCE ( bCur, 0 ) = 0,
			                "",
			                FORMAT ( bCur, "#,0" )
			            )
			        VAR bF2 =
			            IF (
			                COALESCE ( bPrev, 0 ) = 0,
			                "",
			                FORMAT ( bPrev, "#,0" )
			            )
			        VAR bNm =
			            [BlName]
			        VAR bWs =
			            [BlWas]
			        VAR bCell =
			            IF (
			                r = 0,
			                "",
			                "<div class='gt'>" & IF ( bNm = "", "--", bNm ) & "</div>"
			                    & IF ( bWs = "", "", "<div class='gw'>was " & bWs & "</div>" )
			            )
			        VAR dCur =
			            [DhCur]
			        VAR dPrev =
			            [DhPrev]
			        VAR dState =
			            SWITCH (
			                TRUE (),
			                COALESCE ( dCur, 0 ) = 0
			                    &&
			                COALESCE ( dPrev, 0 ) = 0, "empty",
			                COALESCE ( dPrev, 0 ) = 0, "new",
			                COALESCE ( dCur, 0 ) = 0, "gone",
			                "ok"
			            )
			        VAR dYOY =
			            IF (
			                dState = "ok",
			                DIVIDE ( dCur - dPrev, dPrev )
			            )
			        VAR dTxt =
			            SWITCH (
			                dState,
			                "empty", "",
			                "new", "NEW",
			                "gone", "N/A",
			                IF (
			                    dYOY >= 0,
			                    "+" & FORMAT ( dYOY, "0.00%" ),
			                    FORMAT ( dYOY, "0.00%" )
			                )
			            )
			        VAR dCol =
			            SWITCH (
			                dState,
			                "empty", TxtSecondary,
			                "new", "#00B8E4",
			                "gone", TxtSecondary,
			                IF ( dYOY >= 0, Green, Red )
			            )
			        VAR dBar =
			            IF (
			                dState = "ok",
			                MIN (
			                    100,
			                    ROUND ( DIVIDE ( ABS ( dYOY ), BarCap ) * 100, 0 )
			                ),
			                0
			            )
			        VAR dShowBar =
			            dState = "ok"
			        VAR dF1 =
			            IF (
			                COALESCE ( dCur, 0 ) = 0,
			                "",
			                FORMAT ( dCur, "#,0" )
			            )
			        VAR dF2 =
			            IF (
			                COALESCE ( dPrev, 0 ) = 0,
			                "",
			                FORMAT ( dPrev, "#,0" )
			            )
			        VAR dNm =
			            [DhName]
			        VAR dWs =
			            [DhWas]
			        VAR dCell =
			            IF (
			                r = 0,
			                "",
			                "<div class='gt'>" & IF ( dNm = "", "--", dNm ) & "</div>"
			                    & IF ( dWs = "", "", "<div class='gw'>was " & dWs & "</div>" )
			            )
			        RETURN
			            "<tr class='" & rowCls & "'>"
			                & "<td class='g'>" & aCell & "</td>"
			                & "<td class='a'>" & aF1 & "</td>"
			                & "<td class='p dim'>" & aF2 & "</td>"
			                & "<td class='y'>"
			                    & "<div class='yv' style='color:" & aCol & "'>"
			                        & aTxt
			                    & "</div>"
			                    & IF (
			                        aShowBar,
			                        "<div class='yb'><div class='yf' style='width:"
			                            & FORMAT ( aBar, "0" )
			                            & "%;background:"
			                            & aCol
			                            & "'></div></div>",
			                        ""
			                    )
			                & "</td>"
			                & "<td class='g sec'>" & bCell & "</td>"
			                & "<td class='a'>" & bF1 & "</td>"
			                & "<td class='p dim'>" & bF2 & "</td>"
			                & "<td class='y'>"
			                    & "<div class='yv' style='color:" & bCol & "'>"
			                        & bTxt
			                    & "</div>"
			                    & IF (
			                        bShowBar,
			                        "<div class='yb'><div class='yf' style='width:"
			                            & FORMAT ( bBar, "0" )
			                            & "%;background:"
			                            & bCol
			                            & "'></div></div>",
			                        ""
			                    )
			                & "</td>"
			                & "<td class='g sec'>" & dCell & "</td>"
			                & "<td class='a'>" & dF1 & "</td>"
			                & "<td class='p dim'>" & dF2 & "</td>"
			                & "<td class='y'>"
			                    & "<div class='yv' style='color:" & dCol & "'>"
			                        & dTxt
			                    & "</div>"
			                    & IF (
			                        dShowBar,
			                        "<div class='yb'><div class='yf' style='width:"
			                            & FORMAT ( dBar, "0" )
			                            & "%;background:"
			                            & dCol
			                            & "'></div></div>",
			                        ""
			                    )
			                & "</td>"
			            & "</tr>",
			        "",
			        IF ( [Rnk] = 0, 999999, [Rnk] ), ASC
			    )
			VAR HeadHTML =
			    "<div class='rb-head'>"
			        & "<span class='rb-name'>515</span>"
			        & "<span class='rb-title'>Christmas " & FORMAT ( SelYr, "0" ) & "</span>"
			        & "<span class='rb-sub'>vs " & FORMAT ( PrevYr, "0" ) & "</span>"
			    & "</div>"
			VAR TableHTML =
			"<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
			.rb *{box-sizing:border-box;margin:0;padding:0;font-family:Inter,sans-serif;}
			.rb{width:100%;background:" & Bg & ";border:1px solid " & BorderColor & ";border-radius:18px;padding:16px 18px;overflow:hidden;}
			.rb-head{display:flex;align-items:baseline;gap:8px;margin-bottom:12px;}
			.rb-name{font-size:16px;font-weight:900;color:" & Accent & ";letter-spacing:-.2px;}
			.rb-title{font-size:16px;font-weight:900;color:" & TxtPrimary & ";letter-spacing:-.2px;}
			.rb-sub{font-size:11px;font-weight:500;color:" & TxtSecondary & ";margin-left:auto;}
			.rb table{width:100%;border-collapse:collapse;table-layout:fixed;}
			.rb th{font-size:9px;font-weight:800;letter-spacing:.4px;text-transform:uppercase;color:" & TxtSecondary & ";background:" & HeadBg & ";padding:6px 6px;text-align:right;white-space:nowrap;}
			.rb th.grp{text-align:left;color:" & TxtPrimary & ";font-size:10px;border-bottom:1px solid " & SectionLine & ";}
			.rb th.g,.rb td.g{text-align:left;width:11%;}
			.rb th.a,.rb td.a{width:6.5%;}
			.rb th.p,.rb td.p{width:6.5%;}
			.rb th.y,.rb td.y{width:9.3%;}
			.rb th.sec,.rb td.sec{border-left:1px solid " & SectionLine & ";}
			.rb td{font-size:11px;padding:6px 6px;text-align:right;border-bottom:1px solid " & RowLine & ";color:" & TxtPrimary & ";font-variant-numeric:tabular-nums;font-feature-settings:'tnum';vertical-align:top;}
			.rb td.dim{color:" & TxtSecondary & ";}
			.rb td.y{padding:5px 6px;}
			.rb .yv{font-size:10px;font-weight:800;text-align:right;line-height:1.1;font-variant-numeric:tabular-nums;}
			.rb .yb{height:3px;border-radius:2px;background:" & TrackBg & ";overflow:hidden;margin-top:3px;}
			.rb .yf{height:100%;border-radius:2px;transform:scaleX(0);transform-origin:left center;transition:transform .9s cubic-bezier(.22,.8,.25,1);}
			.rb .gt{font-size:10px;font-weight:800;color:" & TxtPrimary & ";line-height:1.25;}
			.rb .gw{font-size:9px;font-weight:500;color:" & SchedTxt & ";line-height:1.3;margin-top:1px;}
			.rb tr.r-total td{background:" & CityRowBg & ";font-weight:900;border-top:2px solid " & SectionLine & ";border-bottom:none;}
			.rb-empty{min-height:120px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;}
			.rb-empty-h{font-size:12px;font-weight:800;color:" & TxtPrimary & ";}
			.rb-empty-s{font-size:11px;font-weight:500;color:" & TxtSecondary & ";max-width:280px;line-height:1.4;}
			</style>"
			    & "<div class='rb'>"
			    & HeadHTML
			    & "<table><thead><tr>"
			        & "<th class='grp' colspan='4'>Adults</th>"
			        & "<th class='grp sec' colspan='4'>bloom</th>"
			        & "<th class='grp sec' colspan='4'>Door Holder</th>"
			    & "</tr><tr>"
			        & "<th class='g'>Gathering</th><th class='a'>Att</th><th class='p'>Prev</th><th class='y'>YOY%</th>"
			        & "<th class='g sec'>Gathering</th><th class='a'>Att</th><th class='p'>Prev</th><th class='y'>YOY%</th>"
			        & "<th class='g sec'>Gathering</th><th class='a'>Att</th><th class='p'>Prev</th><th class='y'>YOY%</th>"
			    & "</tr></thead><tbody>"
			    & RowsHTML
			    & "</tbody></table></div>"
			    & "<script>(function(){function run(){var f=document.querySelectorAll('.rb .yf');requestAnimationFrame(function(){requestAnimationFrame(function(){f.forEach(function(el){el.style.transform='scaleX(1)';});});});}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',run);}else{run();}})();</script>"
			VAR EmptyHTML =
			"<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
			.rb *{box-sizing:border-box;margin:0;padding:0;font-family:Inter,sans-serif;}
			.rb{width:100%;background:" & Bg & ";border:1px solid " & BorderColor & ";border-radius:18px;padding:16px 18px;overflow:hidden;}
			.rb-head{display:flex;align-items:baseline;gap:8px;margin-bottom:12px;}
			.rb-name{font-size:16px;font-weight:900;color:" & Accent & ";letter-spacing:-.2px;}
			.rb-title{font-size:16px;font-weight:900;color:" & TxtPrimary & ";letter-spacing:-.2px;}
			.rb-sub{font-size:11px;font-weight:500;color:" & TxtSecondary & ";margin-left:auto;}
			.rb table{width:100%;border-collapse:collapse;table-layout:fixed;}
			.rb th{font-size:9px;font-weight:800;letter-spacing:.4px;text-transform:uppercase;color:" & TxtSecondary & ";background:" & HeadBg & ";padding:6px 6px;text-align:right;white-space:nowrap;}
			.rb th.grp{text-align:left;color:" & TxtPrimary & ";font-size:10px;border-bottom:1px solid " & SectionLine & ";}
			.rb th.g,.rb td.g{text-align:left;width:11%;}
			.rb th.a,.rb td.a{width:6.5%;}
			.rb th.p,.rb td.p{width:6.5%;}
			.rb th.y,.rb td.y{width:9.3%;}
			.rb th.sec,.rb td.sec{border-left:1px solid " & SectionLine & ";}
			.rb td{font-size:11px;padding:6px 6px;text-align:right;border-bottom:1px solid " & RowLine & ";color:" & TxtPrimary & ";font-variant-numeric:tabular-nums;font-feature-settings:'tnum';vertical-align:top;}
			.rb td.dim{color:" & TxtSecondary & ";}
			.rb td.y{padding:5px 6px;}
			.rb .yv{font-size:10px;font-weight:800;text-align:right;line-height:1.1;font-variant-numeric:tabular-nums;}
			.rb .yb{height:3px;border-radius:2px;background:" & TrackBg & ";overflow:hidden;margin-top:3px;}
			.rb .yf{height:100%;border-radius:2px;transform:scaleX(0);transform-origin:left center;transition:transform .9s cubic-bezier(.22,.8,.25,1);}
			.rb .gt{font-size:10px;font-weight:800;color:" & TxtPrimary & ";line-height:1.25;}
			.rb .gw{font-size:9px;font-weight:500;color:" & SchedTxt & ";line-height:1.3;margin-top:1px;}
			.rb tr.r-total td{background:" & CityRowBg & ";font-weight:900;border-top:2px solid " & SectionLine & ";border-bottom:none;}
			.rb-empty{min-height:120px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;}
			.rb-empty-h{font-size:12px;font-weight:800;color:" & TxtPrimary & ";}
			.rb-empty-s{font-size:11px;font-weight:500;color:" & TxtSecondary & ";max-width:280px;line-height:1.4;}
			</style>"
			    & "<div class='rb'>"
			    & HeadHTML
			    & "<div class='rb-empty'>"
			        & "<div class='rb-empty-h'>" & EmptyHeadline & "</div>"
			        & "<div class='rb-empty-s'>" & EmptySubline & "</div>"
			    & "</div></div>"
			RETURN
			    IF ( HasData, TableHTML, EmptyHTML )
		lineageTag: e3c80caa-b62e-4baf-8604-c3250b07ae00

	measure HTML_Christmas_RB_CBL =
			
			VAR IsDark =
			    [SelectedTheme] = "Dark"
			VAR Bg =
			    IF ( IsDark, "#1E1E1E", "#FFFFFF" )
			VAR BorderColor =
			    IF ( IsDark, "#2A2A2A", "#E5E7EB" )
			VAR TxtPrimary =
			    IF ( IsDark, "#FFFFFF", "#111111" )
			VAR TxtSecondary =
			    IF ( IsDark, "#9CA3AF", "#6B7280" )
			VAR HeadBg =
			    IF ( IsDark, "#252525", "#F9FAFB" )
			VAR RowLine =
			    IF ( IsDark, "rgba(255,255,255,0.06)", "rgba(0,0,0,0.06)" )
			VAR SectionLine =
			    IF ( IsDark, "#3A3A3A", "#D1D5DB" )
			VAR CityRowBg =
			    IF ( IsDark, "#2A2A2A", "#F3F4F6" )
			VAR SchedTxt =
			    IF ( IsDark, "#8A8A8A", "#6B7280" )
			VAR TrackBg =
			    IF ( IsDark, "#323232", "#E5E7EB" )
			VAR Green =
			    "#62E68D"
			VAR Red =
			    "#FF7E84"
			VAR BarCap =
			    0.5
			VAR Accent =
			    "#FF641C"
			VAR SelYr =
			    [ChristmasYear]
			VAR PrevYr =
			    SelYr - 1
			VAR Src =
			    FILTER (
			        ALL ( 'SplSundayAttInPerson_WOW' ),
			        'SplSundayAttInPerson_WOW'[EventName] = "Christmas"
			            &&
			        'SplSundayAttInPerson_WOW'[CampusName] = "Cumberland"
			            &&
			        (
			            VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                ||
			            VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			        )
			    )
			VAR Base =
			    SUMMARIZE (
			        Src,
			        'SplSundayAttInPerson_WOW'[Literal],
			        'SplSundayAttInPerson_WOW'[FormattedDateSplSun],
			        'SplSundayAttInPerson_WOW'[ScheduleName],
			        'SplSundayAttInPerson_WOW'[ScheduleSort],
			        "V", SUM ( 'SplSundayAttInPerson_WOW'[Count] )
			    )
			VAR Ranked =
			    ADDCOLUMNS (
			        Base,
			        "Rnk",
			            VAR thisLit = 'SplSundayAttInPerson_WOW'[Literal]
			            VAR thisYr = 'SplSundayAttInPerson_WOW'[FormattedDateSplSun]
			            VAR thisSort = 'SplSundayAttInPerson_WOW'[ScheduleSort]
			            RETURN
			                COUNTROWS (
			                    FILTER (
			                        Base,
			                        'SplSundayAttInPerson_WOW'[Literal] = thisLit
			                            &&
			                        'SplSundayAttInPerson_WOW'[FormattedDateSplSun] = thisYr
			                            &&
			                        'SplSundayAttInPerson_WOW'[ScheduleSort] <= thisSort
			                    )
			                )
			    )
			VAR MaxRank =
			    COALESCE ( MAXX ( Ranked, [Rnk] ), 0 )
			VAR MinYrAvail =
			    MINX (
			        FILTER ( ALL ( 'SplSundayAttInPerson_WOW' ), 'SplSundayAttInPerson_WOW'[EventName] = "Christmas" ),
			        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] )
			    )
			VAR MaxYrAvail =
			    MAXX (
			        FILTER ( ALL ( 'SplSundayAttInPerson_WOW' ), 'SplSundayAttInPerson_WOW'[EventName] = "Christmas" ),
			        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] )
			    )
			VAR CurYearTotal =
			    SUMX (
			        FILTER ( Ranked, VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr ),
			        [V]
			    )
			VAR HasData =
			    NOT ISBLANK ( SelYr )
			        &&
			    MaxRank > 0
			        &&
			    COALESCE ( CurYearTotal, 0 ) > 0
			VAR EmptyHeadline =
			    IF (
			        ISBLANK ( SelYr ),
			        "No data available",
			        "No Christmas data for " & FORMAT ( SelYr, "0" )
			    )
			VAR EmptySubline =
			    "Available from "
			        & FORMAT ( MinYrAvail, "0" )
			        & " to "
			        & FORMAT ( MaxYrAvail, "0" )
			VAR RankKeys =
			    UNION (
			        SELECTCOLUMNS ( GENERATESERIES ( 1, MAX ( MaxRank, 1 ) ), "Rnk", [Value] ),
			        ROW ( "Rnk", 0 )
			    )
			VAR RowData =
			    ADDCOLUMNS (
			        RankKeys,
			        "AdCur",
			            VAR r = [Rnk]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Ranked,
			                        'SplSundayAttInPerson_WOW'[Literal] = "Adults"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                            &&
			                        ( r = 0 || [Rnk] = r )
			                    ),
			                    [V]
			                ),
			        "AdPrev",
			            VAR r = [Rnk]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Ranked,
			                        'SplSundayAttInPerson_WOW'[Literal] = "Adults"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                            &&
			                        ( r = 0 || [Rnk] = r )
			                    ),
			                    [V]
			                ),
			        "AdName",
			            VAR r = [Rnk]
			            RETURN
			                IF (
			                    r = 0,
			                    "",
			                    CONCATENATEX (
			                        SUMMARIZE (
			                            FILTER (
			                                Ranked,
			                                'SplSundayAttInPerson_WOW'[Literal] = "Adults"
			                                    &&
			                                VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                                    &&
			                                [Rnk] = r
			                            ),
			                            'SplSundayAttInPerson_WOW'[ScheduleName],
			                            'SplSundayAttInPerson_WOW'[ScheduleSort]
			                        ),
			                        'SplSundayAttInPerson_WOW'[ScheduleName],
			                        " / ",
			                        'SplSundayAttInPerson_WOW'[ScheduleSort],
			                        ASC
			                    )
			                ),
			        "AdWas",
			            VAR r = [Rnk]
			            RETURN
			                IF (
			                    r = 0,
			                    "",
			                    CONCATENATEX (
			                        SUMMARIZE (
			                            FILTER (
			                                Ranked,
			                                'SplSundayAttInPerson_WOW'[Literal] = "Adults"
			                                    &&
			                                VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                                    &&
			                                [Rnk] = r
			                            ),
			                            'SplSundayAttInPerson_WOW'[ScheduleName],
			                            'SplSundayAttInPerson_WOW'[ScheduleSort]
			                        ),
			                        'SplSundayAttInPerson_WOW'[ScheduleName],
			                        " / ",
			                        'SplSundayAttInPerson_WOW'[ScheduleSort],
			                        ASC
			                    )
			                ),
			        "BlCur",
			            VAR r = [Rnk]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Ranked,
			                        'SplSundayAttInPerson_WOW'[Literal] = "bloom"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                            &&
			                        ( r = 0 || [Rnk] = r )
			                    ),
			                    [V]
			                ),
			        "BlPrev",
			            VAR r = [Rnk]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Ranked,
			                        'SplSundayAttInPerson_WOW'[Literal] = "bloom"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                            &&
			                        ( r = 0 || [Rnk] = r )
			                    ),
			                    [V]
			                ),
			        "BlName",
			            VAR r = [Rnk]
			            RETURN
			                IF (
			                    r = 0,
			                    "",
			                    CONCATENATEX (
			                        SUMMARIZE (
			                            FILTER (
			                                Ranked,
			                                'SplSundayAttInPerson_WOW'[Literal] = "bloom"
			                                    &&
			                                VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                                    &&
			                                [Rnk] = r
			                            ),
			                            'SplSundayAttInPerson_WOW'[ScheduleName],
			                            'SplSundayAttInPerson_WOW'[ScheduleSort]
			                        ),
			                        'SplSundayAttInPerson_WOW'[ScheduleName],
			                        " / ",
			                        'SplSundayAttInPerson_WOW'[ScheduleSort],
			                        ASC
			                    )
			                ),
			        "BlWas",
			            VAR r = [Rnk]
			            RETURN
			                IF (
			                    r = 0,
			                    "",
			                    CONCATENATEX (
			                        SUMMARIZE (
			                            FILTER (
			                                Ranked,
			                                'SplSundayAttInPerson_WOW'[Literal] = "bloom"
			                                    &&
			                                VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                                    &&
			                                [Rnk] = r
			                            ),
			                            'SplSundayAttInPerson_WOW'[ScheduleName],
			                            'SplSundayAttInPerson_WOW'[ScheduleSort]
			                        ),
			                        'SplSundayAttInPerson_WOW'[ScheduleName],
			                        " / ",
			                        'SplSundayAttInPerson_WOW'[ScheduleSort],
			                        ASC
			                    )
			                ),
			        "DhCur",
			            VAR r = [Rnk]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Ranked,
			                        'SplSundayAttInPerson_WOW'[Literal] = "Door Holder"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                            &&
			                        ( r = 0 || [Rnk] = r )
			                    ),
			                    [V]
			                ),
			        "DhPrev",
			            VAR r = [Rnk]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Ranked,
			                        'SplSundayAttInPerson_WOW'[Literal] = "Door Holder"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                            &&
			                        ( r = 0 || [Rnk] = r )
			                    ),
			                    [V]
			                ),
			        "DhName",
			            VAR r = [Rnk]
			            RETURN
			                IF (
			                    r = 0,
			                    "",
			                    CONCATENATEX (
			                        SUMMARIZE (
			                            FILTER (
			                                Ranked,
			                                'SplSundayAttInPerson_WOW'[Literal] = "Door Holder"
			                                    &&
			                                VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                                    &&
			                                [Rnk] = r
			                            ),
			                            'SplSundayAttInPerson_WOW'[ScheduleName],
			                            'SplSundayAttInPerson_WOW'[ScheduleSort]
			                        ),
			                        'SplSundayAttInPerson_WOW'[ScheduleName],
			                        " / ",
			                        'SplSundayAttInPerson_WOW'[ScheduleSort],
			                        ASC
			                    )
			                ),
			        "DhWas",
			            VAR r = [Rnk]
			            RETURN
			                IF (
			                    r = 0,
			                    "",
			                    CONCATENATEX (
			                        SUMMARIZE (
			                            FILTER (
			                                Ranked,
			                                'SplSundayAttInPerson_WOW'[Literal] = "Door Holder"
			                                    &&
			                                VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                                    &&
			                                [Rnk] = r
			                            ),
			                            'SplSundayAttInPerson_WOW'[ScheduleName],
			                            'SplSundayAttInPerson_WOW'[ScheduleSort]
			                        ),
			                        'SplSundayAttInPerson_WOW'[ScheduleName],
			                        " / ",
			                        'SplSundayAttInPerson_WOW'[ScheduleSort],
			                        ASC
			                    )
			                )
			    )
			VAR RowsHTML =
			    CONCATENATEX (
			        RowData,
			        VAR r = [Rnk]
			        VAR rowCls =
			            IF ( r = 0, "r-total", "r-gath" )
			        VAR aCur =
			            [AdCur]
			        VAR aPrev =
			            [AdPrev]
			        VAR aState =
			            SWITCH (
			                TRUE (),
			                COALESCE ( aCur, 0 ) = 0
			                    &&
			                COALESCE ( aPrev, 0 ) = 0, "empty",
			                COALESCE ( aPrev, 0 ) = 0, "new",
			                COALESCE ( aCur, 0 ) = 0, "gone",
			                "ok"
			            )
			        VAR aYOY =
			            IF (
			                aState = "ok",
			                DIVIDE ( aCur - aPrev, aPrev )
			            )
			        VAR aTxt =
			            SWITCH (
			                aState,
			                "empty", "",
			                "new", "NEW",
			                "gone", "N/A",
			                IF (
			                    aYOY >= 0,
			                    "+" & FORMAT ( aYOY, "0.00%" ),
			                    FORMAT ( aYOY, "0.00%" )
			                )
			            )
			        VAR aCol =
			            SWITCH (
			                aState,
			                "empty", TxtSecondary,
			                "new", "#00B8E4",
			                "gone", TxtSecondary,
			                IF ( aYOY >= 0, Green, Red )
			            )
			        VAR aBar =
			            IF (
			                aState = "ok",
			                MIN (
			                    100,
			                    ROUND ( DIVIDE ( ABS ( aYOY ), BarCap ) * 100, 0 )
			                ),
			                0
			            )
			        VAR aShowBar =
			            aState = "ok"
			        VAR aF1 =
			            IF (
			                COALESCE ( aCur, 0 ) = 0,
			                "",
			                FORMAT ( aCur, "#,0" )
			            )
			        VAR aF2 =
			            IF (
			                COALESCE ( aPrev, 0 ) = 0,
			                "",
			                FORMAT ( aPrev, "#,0" )
			            )
			        VAR aNm =
			            [AdName]
			        VAR aWs =
			            [AdWas]
			        VAR aCell =
			            IF (
			                r = 0,
			                "<div class='gt'>Total</div>",
			                "<div class='gt'>" & IF ( aNm = "", "--", aNm ) & "</div>"
			                    & IF ( aWs = "", "", "<div class='gw'>was " & aWs & "</div>" )
			            )
			        VAR bCur =
			            [BlCur]
			        VAR bPrev =
			            [BlPrev]
			        VAR bState =
			            SWITCH (
			                TRUE (),
			                COALESCE ( bCur, 0 ) = 0
			                    &&
			                COALESCE ( bPrev, 0 ) = 0, "empty",
			                COALESCE ( bPrev, 0 ) = 0, "new",
			                COALESCE ( bCur, 0 ) = 0, "gone",
			                "ok"
			            )
			        VAR bYOY =
			            IF (
			                bState = "ok",
			                DIVIDE ( bCur - bPrev, bPrev )
			            )
			        VAR bTxt =
			            SWITCH (
			                bState,
			                "empty", "",
			                "new", "NEW",
			                "gone", "N/A",
			                IF (
			                    bYOY >= 0,
			                    "+" & FORMAT ( bYOY, "0.00%" ),
			                    FORMAT ( bYOY, "0.00%" )
			                )
			            )
			        VAR bCol =
			            SWITCH (
			                bState,
			                "empty", TxtSecondary,
			                "new", "#00B8E4",
			                "gone", TxtSecondary,
			                IF ( bYOY >= 0, Green, Red )
			            )
			        VAR bBar =
			            IF (
			                bState = "ok",
			                MIN (
			                    100,
			                    ROUND ( DIVIDE ( ABS ( bYOY ), BarCap ) * 100, 0 )
			                ),
			                0
			            )
			        VAR bShowBar =
			            bState = "ok"
			        VAR bF1 =
			            IF (
			                COALESCE ( bCur, 0 ) = 0,
			                "",
			                FORMAT ( bCur, "#,0" )
			            )
			        VAR bF2 =
			            IF (
			                COALESCE ( bPrev, 0 ) = 0,
			                "",
			                FORMAT ( bPrev, "#,0" )
			            )
			        VAR bNm =
			            [BlName]
			        VAR bWs =
			            [BlWas]
			        VAR bCell =
			            IF (
			                r = 0,
			                "",
			                "<div class='gt'>" & IF ( bNm = "", "--", bNm ) & "</div>"
			                    & IF ( bWs = "", "", "<div class='gw'>was " & bWs & "</div>" )
			            )
			        VAR dCur =
			            [DhCur]
			        VAR dPrev =
			            [DhPrev]
			        VAR dState =
			            SWITCH (
			                TRUE (),
			                COALESCE ( dCur, 0 ) = 0
			                    &&
			                COALESCE ( dPrev, 0 ) = 0, "empty",
			                COALESCE ( dPrev, 0 ) = 0, "new",
			                COALESCE ( dCur, 0 ) = 0, "gone",
			                "ok"
			            )
			        VAR dYOY =
			            IF (
			                dState = "ok",
			                DIVIDE ( dCur - dPrev, dPrev )
			            )
			        VAR dTxt =
			            SWITCH (
			                dState,
			                "empty", "",
			                "new", "NEW",
			                "gone", "N/A",
			                IF (
			                    dYOY >= 0,
			                    "+" & FORMAT ( dYOY, "0.00%" ),
			                    FORMAT ( dYOY, "0.00%" )
			                )
			            )
			        VAR dCol =
			            SWITCH (
			                dState,
			                "empty", TxtSecondary,
			                "new", "#00B8E4",
			                "gone", TxtSecondary,
			                IF ( dYOY >= 0, Green, Red )
			            )
			        VAR dBar =
			            IF (
			                dState = "ok",
			                MIN (
			                    100,
			                    ROUND ( DIVIDE ( ABS ( dYOY ), BarCap ) * 100, 0 )
			                ),
			                0
			            )
			        VAR dShowBar =
			            dState = "ok"
			        VAR dF1 =
			            IF (
			                COALESCE ( dCur, 0 ) = 0,
			                "",
			                FORMAT ( dCur, "#,0" )
			            )
			        VAR dF2 =
			            IF (
			                COALESCE ( dPrev, 0 ) = 0,
			                "",
			                FORMAT ( dPrev, "#,0" )
			            )
			        VAR dNm =
			            [DhName]
			        VAR dWs =
			            [DhWas]
			        VAR dCell =
			            IF (
			                r = 0,
			                "",
			                "<div class='gt'>" & IF ( dNm = "", "--", dNm ) & "</div>"
			                    & IF ( dWs = "", "", "<div class='gw'>was " & dWs & "</div>" )
			            )
			        RETURN
			            "<tr class='" & rowCls & "'>"
			                & "<td class='g'>" & aCell & "</td>"
			                & "<td class='a'>" & aF1 & "</td>"
			                & "<td class='p dim'>" & aF2 & "</td>"
			                & "<td class='y'>"
			                    & "<div class='yv' style='color:" & aCol & "'>"
			                        & aTxt
			                    & "</div>"
			                    & IF (
			                        aShowBar,
			                        "<div class='yb'><div class='yf' style='width:"
			                            & FORMAT ( aBar, "0" )
			                            & "%;background:"
			                            & aCol
			                            & "'></div></div>",
			                        ""
			                    )
			                & "</td>"
			                & "<td class='g sec'>" & bCell & "</td>"
			                & "<td class='a'>" & bF1 & "</td>"
			                & "<td class='p dim'>" & bF2 & "</td>"
			                & "<td class='y'>"
			                    & "<div class='yv' style='color:" & bCol & "'>"
			                        & bTxt
			                    & "</div>"
			                    & IF (
			                        bShowBar,
			                        "<div class='yb'><div class='yf' style='width:"
			                            & FORMAT ( bBar, "0" )
			                            & "%;background:"
			                            & bCol
			                            & "'></div></div>",
			                        ""
			                    )
			                & "</td>"
			                & "<td class='g sec'>" & dCell & "</td>"
			                & "<td class='a'>" & dF1 & "</td>"
			                & "<td class='p dim'>" & dF2 & "</td>"
			                & "<td class='y'>"
			                    & "<div class='yv' style='color:" & dCol & "'>"
			                        & dTxt
			                    & "</div>"
			                    & IF (
			                        dShowBar,
			                        "<div class='yb'><div class='yf' style='width:"
			                            & FORMAT ( dBar, "0" )
			                            & "%;background:"
			                            & dCol
			                            & "'></div></div>",
			                        ""
			                    )
			                & "</td>"
			            & "</tr>",
			        "",
			        IF ( [Rnk] = 0, 999999, [Rnk] ), ASC
			    )
			VAR HeadHTML =
			    "<div class='rb-head'>"
			        & "<span class='rb-name'>Cumberland</span>"
			        & "<span class='rb-title'>Christmas " & FORMAT ( SelYr, "0" ) & "</span>"
			        & "<span class='rb-sub'>vs " & FORMAT ( PrevYr, "0" ) & "</span>"
			    & "</div>"
			VAR TableHTML =
			"<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
			.rb *{box-sizing:border-box;margin:0;padding:0;font-family:Inter,sans-serif;}
			.rb{width:100%;background:" & Bg & ";border:1px solid " & BorderColor & ";border-radius:18px;padding:16px 18px;overflow:hidden;}
			.rb-head{display:flex;align-items:baseline;gap:8px;margin-bottom:12px;}
			.rb-name{font-size:16px;font-weight:900;color:" & Accent & ";letter-spacing:-.2px;}
			.rb-title{font-size:16px;font-weight:900;color:" & TxtPrimary & ";letter-spacing:-.2px;}
			.rb-sub{font-size:11px;font-weight:500;color:" & TxtSecondary & ";margin-left:auto;}
			.rb table{width:100%;border-collapse:collapse;table-layout:fixed;}
			.rb th{font-size:9px;font-weight:800;letter-spacing:.4px;text-transform:uppercase;color:" & TxtSecondary & ";background:" & HeadBg & ";padding:6px 6px;text-align:right;white-space:nowrap;}
			.rb th.grp{text-align:left;color:" & TxtPrimary & ";font-size:10px;border-bottom:1px solid " & SectionLine & ";}
			.rb th.g,.rb td.g{text-align:left;width:11%;}
			.rb th.a,.rb td.a{width:6.5%;}
			.rb th.p,.rb td.p{width:6.5%;}
			.rb th.y,.rb td.y{width:9.3%;}
			.rb th.sec,.rb td.sec{border-left:1px solid " & SectionLine & ";}
			.rb td{font-size:11px;padding:6px 6px;text-align:right;border-bottom:1px solid " & RowLine & ";color:" & TxtPrimary & ";font-variant-numeric:tabular-nums;font-feature-settings:'tnum';vertical-align:top;}
			.rb td.dim{color:" & TxtSecondary & ";}
			.rb td.y{padding:5px 6px;}
			.rb .yv{font-size:10px;font-weight:800;text-align:right;line-height:1.1;font-variant-numeric:tabular-nums;}
			.rb .yb{height:3px;border-radius:2px;background:" & TrackBg & ";overflow:hidden;margin-top:3px;}
			.rb .yf{height:100%;border-radius:2px;transform:scaleX(0);transform-origin:left center;transition:transform .9s cubic-bezier(.22,.8,.25,1);}
			.rb .gt{font-size:10px;font-weight:800;color:" & TxtPrimary & ";line-height:1.25;}
			.rb .gw{font-size:9px;font-weight:500;color:" & SchedTxt & ";line-height:1.3;margin-top:1px;}
			.rb tr.r-total td{background:" & CityRowBg & ";font-weight:900;border-top:2px solid " & SectionLine & ";border-bottom:none;}
			.rb-empty{min-height:120px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;}
			.rb-empty-h{font-size:12px;font-weight:800;color:" & TxtPrimary & ";}
			.rb-empty-s{font-size:11px;font-weight:500;color:" & TxtSecondary & ";max-width:280px;line-height:1.4;}
			</style>"
			    & "<div class='rb'>"
			    & HeadHTML
			    & "<table><thead><tr>"
			        & "<th class='grp' colspan='4'>Adults</th>"
			        & "<th class='grp sec' colspan='4'>bloom</th>"
			        & "<th class='grp sec' colspan='4'>Door Holder</th>"
			    & "</tr><tr>"
			        & "<th class='g'>Gathering</th><th class='a'>Att</th><th class='p'>Prev</th><th class='y'>YOY%</th>"
			        & "<th class='g sec'>Gathering</th><th class='a'>Att</th><th class='p'>Prev</th><th class='y'>YOY%</th>"
			        & "<th class='g sec'>Gathering</th><th class='a'>Att</th><th class='p'>Prev</th><th class='y'>YOY%</th>"
			    & "</tr></thead><tbody>"
			    & RowsHTML
			    & "</tbody></table></div>"
			    & "<script>(function(){function run(){var f=document.querySelectorAll('.rb .yf');requestAnimationFrame(function(){requestAnimationFrame(function(){f.forEach(function(el){el.style.transform='scaleX(1)';});});});}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',run);}else{run();}})();</script>"
			VAR EmptyHTML =
			"<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
			.rb *{box-sizing:border-box;margin:0;padding:0;font-family:Inter,sans-serif;}
			.rb{width:100%;background:" & Bg & ";border:1px solid " & BorderColor & ";border-radius:18px;padding:16px 18px;overflow:hidden;}
			.rb-head{display:flex;align-items:baseline;gap:8px;margin-bottom:12px;}
			.rb-name{font-size:16px;font-weight:900;color:" & Accent & ";letter-spacing:-.2px;}
			.rb-title{font-size:16px;font-weight:900;color:" & TxtPrimary & ";letter-spacing:-.2px;}
			.rb-sub{font-size:11px;font-weight:500;color:" & TxtSecondary & ";margin-left:auto;}
			.rb table{width:100%;border-collapse:collapse;table-layout:fixed;}
			.rb th{font-size:9px;font-weight:800;letter-spacing:.4px;text-transform:uppercase;color:" & TxtSecondary & ";background:" & HeadBg & ";padding:6px 6px;text-align:right;white-space:nowrap;}
			.rb th.grp{text-align:left;color:" & TxtPrimary & ";font-size:10px;border-bottom:1px solid " & SectionLine & ";}
			.rb th.g,.rb td.g{text-align:left;width:11%;}
			.rb th.a,.rb td.a{width:6.5%;}
			.rb th.p,.rb td.p{width:6.5%;}
			.rb th.y,.rb td.y{width:9.3%;}
			.rb th.sec,.rb td.sec{border-left:1px solid " & SectionLine & ";}
			.rb td{font-size:11px;padding:6px 6px;text-align:right;border-bottom:1px solid " & RowLine & ";color:" & TxtPrimary & ";font-variant-numeric:tabular-nums;font-feature-settings:'tnum';vertical-align:top;}
			.rb td.dim{color:" & TxtSecondary & ";}
			.rb td.y{padding:5px 6px;}
			.rb .yv{font-size:10px;font-weight:800;text-align:right;line-height:1.1;font-variant-numeric:tabular-nums;}
			.rb .yb{height:3px;border-radius:2px;background:" & TrackBg & ";overflow:hidden;margin-top:3px;}
			.rb .yf{height:100%;border-radius:2px;transform:scaleX(0);transform-origin:left center;transition:transform .9s cubic-bezier(.22,.8,.25,1);}
			.rb .gt{font-size:10px;font-weight:800;color:" & TxtPrimary & ";line-height:1.25;}
			.rb .gw{font-size:9px;font-weight:500;color:" & SchedTxt & ";line-height:1.3;margin-top:1px;}
			.rb tr.r-total td{background:" & CityRowBg & ";font-weight:900;border-top:2px solid " & SectionLine & ";border-bottom:none;}
			.rb-empty{min-height:120px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;}
			.rb-empty-h{font-size:12px;font-weight:800;color:" & TxtPrimary & ";}
			.rb-empty-s{font-size:11px;font-weight:500;color:" & TxtSecondary & ";max-width:280px;line-height:1.4;}
			</style>"
			    & "<div class='rb'>"
			    & HeadHTML
			    & "<div class='rb-empty'>"
			        & "<div class='rb-empty-h'>" & EmptyHeadline & "</div>"
			        & "<div class='rb-empty-s'>" & EmptySubline & "</div>"
			    & "</div></div>"
			RETURN
			    IF ( HasData, TableHTML, EmptyHTML )
		lineageTag: ba476411-bff5-41a3-b90f-ee4a0b77407f

	measure HTML_Christmas_RB_TRL =
			
			VAR IsDark =
			    [SelectedTheme] = "Dark"
			VAR Bg =
			    IF ( IsDark, "#1E1E1E", "#FFFFFF" )
			VAR BorderColor =
			    IF ( IsDark, "#2A2A2A", "#E5E7EB" )
			VAR TxtPrimary =
			    IF ( IsDark, "#FFFFFF", "#111111" )
			VAR TxtSecondary =
			    IF ( IsDark, "#9CA3AF", "#6B7280" )
			VAR HeadBg =
			    IF ( IsDark, "#252525", "#F9FAFB" )
			VAR RowLine =
			    IF ( IsDark, "rgba(255,255,255,0.06)", "rgba(0,0,0,0.06)" )
			VAR SectionLine =
			    IF ( IsDark, "#3A3A3A", "#D1D5DB" )
			VAR CityRowBg =
			    IF ( IsDark, "#2A2A2A", "#F3F4F6" )
			VAR SchedTxt =
			    IF ( IsDark, "#8A8A8A", "#6B7280" )
			VAR TrackBg =
			    IF ( IsDark, "#323232", "#E5E7EB" )
			VAR Green =
			    "#62E68D"
			VAR Red =
			    "#FF7E84"
			VAR BarCap =
			    0.5
			VAR Accent =
			    "#931EE7"
			VAR SelYr =
			    [ChristmasYear]
			VAR PrevYr =
			    SelYr - 1
			VAR Src =
			    FILTER (
			        ALL ( 'SplSundayAttInPerson_WOW' ),
			        'SplSundayAttInPerson_WOW'[EventName] = "Christmas"
			            &&
			        'SplSundayAttInPerson_WOW'[CampusName] = "Trilith"
			            &&
			        (
			            VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                ||
			            VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			        )
			    )
			VAR Base =
			    SUMMARIZE (
			        Src,
			        'SplSundayAttInPerson_WOW'[Literal],
			        'SplSundayAttInPerson_WOW'[FormattedDateSplSun],
			        'SplSundayAttInPerson_WOW'[ScheduleName],
			        'SplSundayAttInPerson_WOW'[ScheduleSort],
			        "V", SUM ( 'SplSundayAttInPerson_WOW'[Count] )
			    )
			VAR Ranked =
			    ADDCOLUMNS (
			        Base,
			        "Rnk",
			            VAR thisLit = 'SplSundayAttInPerson_WOW'[Literal]
			            VAR thisYr = 'SplSundayAttInPerson_WOW'[FormattedDateSplSun]
			            VAR thisSort = 'SplSundayAttInPerson_WOW'[ScheduleSort]
			            RETURN
			                COUNTROWS (
			                    FILTER (
			                        Base,
			                        'SplSundayAttInPerson_WOW'[Literal] = thisLit
			                            &&
			                        'SplSundayAttInPerson_WOW'[FormattedDateSplSun] = thisYr
			                            &&
			                        'SplSundayAttInPerson_WOW'[ScheduleSort] <= thisSort
			                    )
			                )
			    )
			VAR MaxRank =
			    COALESCE ( MAXX ( Ranked, [Rnk] ), 0 )
			VAR MinYrAvail =
			    MINX (
			        FILTER ( ALL ( 'SplSundayAttInPerson_WOW' ), 'SplSundayAttInPerson_WOW'[EventName] = "Christmas" ),
			        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] )
			    )
			VAR MaxYrAvail =
			    MAXX (
			        FILTER ( ALL ( 'SplSundayAttInPerson_WOW' ), 'SplSundayAttInPerson_WOW'[EventName] = "Christmas" ),
			        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] )
			    )
			VAR CurYearTotal =
			    SUMX (
			        FILTER ( Ranked, VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr ),
			        [V]
			    )
			VAR HasData =
			    NOT ISBLANK ( SelYr )
			        &&
			    MaxRank > 0
			        &&
			    COALESCE ( CurYearTotal, 0 ) > 0
			VAR EmptyHeadline =
			    IF (
			        ISBLANK ( SelYr ),
			        "No data available",
			        "No Christmas data for " & FORMAT ( SelYr, "0" )
			    )
			VAR EmptySubline =
			    "Available from "
			        & FORMAT ( MinYrAvail, "0" )
			        & " to "
			        & FORMAT ( MaxYrAvail, "0" )
			VAR RankKeys =
			    UNION (
			        SELECTCOLUMNS ( GENERATESERIES ( 1, MAX ( MaxRank, 1 ) ), "Rnk", [Value] ),
			        ROW ( "Rnk", 0 )
			    )
			VAR RowData =
			    ADDCOLUMNS (
			        RankKeys,
			        "AdCur",
			            VAR r = [Rnk]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Ranked,
			                        'SplSundayAttInPerson_WOW'[Literal] = "Adults"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                            &&
			                        ( r = 0 || [Rnk] = r )
			                    ),
			                    [V]
			                ),
			        "AdPrev",
			            VAR r = [Rnk]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Ranked,
			                        'SplSundayAttInPerson_WOW'[Literal] = "Adults"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                            &&
			                        ( r = 0 || [Rnk] = r )
			                    ),
			                    [V]
			                ),
			        "AdName",
			            VAR r = [Rnk]
			            RETURN
			                IF (
			                    r = 0,
			                    "",
			                    CONCATENATEX (
			                        SUMMARIZE (
			                            FILTER (
			                                Ranked,
			                                'SplSundayAttInPerson_WOW'[Literal] = "Adults"
			                                    &&
			                                VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                                    &&
			                                [Rnk] = r
			                            ),
			                            'SplSundayAttInPerson_WOW'[ScheduleName],
			                            'SplSundayAttInPerson_WOW'[ScheduleSort]
			                        ),
			                        'SplSundayAttInPerson_WOW'[ScheduleName],
			                        " / ",
			                        'SplSundayAttInPerson_WOW'[ScheduleSort],
			                        ASC
			                    )
			                ),
			        "AdWas",
			            VAR r = [Rnk]
			            RETURN
			                IF (
			                    r = 0,
			                    "",
			                    CONCATENATEX (
			                        SUMMARIZE (
			                            FILTER (
			                                Ranked,
			                                'SplSundayAttInPerson_WOW'[Literal] = "Adults"
			                                    &&
			                                VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                                    &&
			                                [Rnk] = r
			                            ),
			                            'SplSundayAttInPerson_WOW'[ScheduleName],
			                            'SplSundayAttInPerson_WOW'[ScheduleSort]
			                        ),
			                        'SplSundayAttInPerson_WOW'[ScheduleName],
			                        " / ",
			                        'SplSundayAttInPerson_WOW'[ScheduleSort],
			                        ASC
			                    )
			                ),
			        "BlCur",
			            VAR r = [Rnk]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Ranked,
			                        'SplSundayAttInPerson_WOW'[Literal] = "bloom"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                            &&
			                        ( r = 0 || [Rnk] = r )
			                    ),
			                    [V]
			                ),
			        "BlPrev",
			            VAR r = [Rnk]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Ranked,
			                        'SplSundayAttInPerson_WOW'[Literal] = "bloom"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                            &&
			                        ( r = 0 || [Rnk] = r )
			                    ),
			                    [V]
			                ),
			        "BlName",
			            VAR r = [Rnk]
			            RETURN
			                IF (
			                    r = 0,
			                    "",
			                    CONCATENATEX (
			                        SUMMARIZE (
			                            FILTER (
			                                Ranked,
			                                'SplSundayAttInPerson_WOW'[Literal] = "bloom"
			                                    &&
			                                VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                                    &&
			                                [Rnk] = r
			                            ),
			                            'SplSundayAttInPerson_WOW'[ScheduleName],
			                            'SplSundayAttInPerson_WOW'[ScheduleSort]
			                        ),
			                        'SplSundayAttInPerson_WOW'[ScheduleName],
			                        " / ",
			                        'SplSundayAttInPerson_WOW'[ScheduleSort],
			                        ASC
			                    )
			                ),
			        "BlWas",
			            VAR r = [Rnk]
			            RETURN
			                IF (
			                    r = 0,
			                    "",
			                    CONCATENATEX (
			                        SUMMARIZE (
			                            FILTER (
			                                Ranked,
			                                'SplSundayAttInPerson_WOW'[Literal] = "bloom"
			                                    &&
			                                VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                                    &&
			                                [Rnk] = r
			                            ),
			                            'SplSundayAttInPerson_WOW'[ScheduleName],
			                            'SplSundayAttInPerson_WOW'[ScheduleSort]
			                        ),
			                        'SplSundayAttInPerson_WOW'[ScheduleName],
			                        " / ",
			                        'SplSundayAttInPerson_WOW'[ScheduleSort],
			                        ASC
			                    )
			                ),
			        "DhCur",
			            VAR r = [Rnk]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Ranked,
			                        'SplSundayAttInPerson_WOW'[Literal] = "Door Holder"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                            &&
			                        ( r = 0 || [Rnk] = r )
			                    ),
			                    [V]
			                ),
			        "DhPrev",
			            VAR r = [Rnk]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Ranked,
			                        'SplSundayAttInPerson_WOW'[Literal] = "Door Holder"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                            &&
			                        ( r = 0 || [Rnk] = r )
			                    ),
			                    [V]
			                ),
			        "DhName",
			            VAR r = [Rnk]
			            RETURN
			                IF (
			                    r = 0,
			                    "",
			                    CONCATENATEX (
			                        SUMMARIZE (
			                            FILTER (
			                                Ranked,
			                                'SplSundayAttInPerson_WOW'[Literal] = "Door Holder"
			                                    &&
			                                VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                                    &&
			                                [Rnk] = r
			                            ),
			                            'SplSundayAttInPerson_WOW'[ScheduleName],
			                            'SplSundayAttInPerson_WOW'[ScheduleSort]
			                        ),
			                        'SplSundayAttInPerson_WOW'[ScheduleName],
			                        " / ",
			                        'SplSundayAttInPerson_WOW'[ScheduleSort],
			                        ASC
			                    )
			                ),
			        "DhWas",
			            VAR r = [Rnk]
			            RETURN
			                IF (
			                    r = 0,
			                    "",
			                    CONCATENATEX (
			                        SUMMARIZE (
			                            FILTER (
			                                Ranked,
			                                'SplSundayAttInPerson_WOW'[Literal] = "Door Holder"
			                                    &&
			                                VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                                    &&
			                                [Rnk] = r
			                            ),
			                            'SplSundayAttInPerson_WOW'[ScheduleName],
			                            'SplSundayAttInPerson_WOW'[ScheduleSort]
			                        ),
			                        'SplSundayAttInPerson_WOW'[ScheduleName],
			                        " / ",
			                        'SplSundayAttInPerson_WOW'[ScheduleSort],
			                        ASC
			                    )
			                )
			    )
			VAR RowsHTML =
			    CONCATENATEX (
			        RowData,
			        VAR r = [Rnk]
			        VAR rowCls =
			            IF ( r = 0, "r-total", "r-gath" )
			        VAR aCur =
			            [AdCur]
			        VAR aPrev =
			            [AdPrev]
			        VAR aState =
			            SWITCH (
			                TRUE (),
			                COALESCE ( aCur, 0 ) = 0
			                    &&
			                COALESCE ( aPrev, 0 ) = 0, "empty",
			                COALESCE ( aPrev, 0 ) = 0, "new",
			                COALESCE ( aCur, 0 ) = 0, "gone",
			                "ok"
			            )
			        VAR aYOY =
			            IF (
			                aState = "ok",
			                DIVIDE ( aCur - aPrev, aPrev )
			            )
			        VAR aTxt =
			            SWITCH (
			                aState,
			                "empty", "",
			                "new", "NEW",
			                "gone", "N/A",
			                IF (
			                    aYOY >= 0,
			                    "+" & FORMAT ( aYOY, "0.00%" ),
			                    FORMAT ( aYOY, "0.00%" )
			                )
			            )
			        VAR aCol =
			            SWITCH (
			                aState,
			                "empty", TxtSecondary,
			                "new", "#00B8E4",
			                "gone", TxtSecondary,
			                IF ( aYOY >= 0, Green, Red )
			            )
			        VAR aBar =
			            IF (
			                aState = "ok",
			                MIN (
			                    100,
			                    ROUND ( DIVIDE ( ABS ( aYOY ), BarCap ) * 100, 0 )
			                ),
			                0
			            )
			        VAR aShowBar =
			            aState = "ok"
			        VAR aF1 =
			            IF (
			                COALESCE ( aCur, 0 ) = 0,
			                "",
			                FORMAT ( aCur, "#,0" )
			            )
			        VAR aF2 =
			            IF (
			                COALESCE ( aPrev, 0 ) = 0,
			                "",
			                FORMAT ( aPrev, "#,0" )
			            )
			        VAR aNm =
			            [AdName]
			        VAR aWs =
			            [AdWas]
			        VAR aCell =
			            IF (
			                r = 0,
			                "<div class='gt'>Total</div>",
			                "<div class='gt'>" & IF ( aNm = "", "--", aNm ) & "</div>"
			                    & IF ( aWs = "", "", "<div class='gw'>was " & aWs & "</div>" )
			            )
			        VAR bCur =
			            [BlCur]
			        VAR bPrev =
			            [BlPrev]
			        VAR bState =
			            SWITCH (
			                TRUE (),
			                COALESCE ( bCur, 0 ) = 0
			                    &&
			                COALESCE ( bPrev, 0 ) = 0, "empty",
			                COALESCE ( bPrev, 0 ) = 0, "new",
			                COALESCE ( bCur, 0 ) = 0, "gone",
			                "ok"
			            )
			        VAR bYOY =
			            IF (
			                bState = "ok",
			                DIVIDE ( bCur - bPrev, bPrev )
			            )
			        VAR bTxt =
			            SWITCH (
			                bState,
			                "empty", "",
			                "new", "NEW",
			                "gone", "N/A",
			                IF (
			                    bYOY >= 0,
			                    "+" & FORMAT ( bYOY, "0.00%" ),
			                    FORMAT ( bYOY, "0.00%" )
			                )
			            )
			        VAR bCol =
			            SWITCH (
			                bState,
			                "empty", TxtSecondary,
			                "new", "#00B8E4",
			                "gone", TxtSecondary,
			                IF ( bYOY >= 0, Green, Red )
			            )
			        VAR bBar =
			            IF (
			                bState = "ok",
			                MIN (
			                    100,
			                    ROUND ( DIVIDE ( ABS ( bYOY ), BarCap ) * 100, 0 )
			                ),
			                0
			            )
			        VAR bShowBar =
			            bState = "ok"
			        VAR bF1 =
			            IF (
			                COALESCE ( bCur, 0 ) = 0,
			                "",
			                FORMAT ( bCur, "#,0" )
			            )
			        VAR bF2 =
			            IF (
			                COALESCE ( bPrev, 0 ) = 0,
			                "",
			                FORMAT ( bPrev, "#,0" )
			            )
			        VAR bNm =
			            [BlName]
			        VAR bWs =
			            [BlWas]
			        VAR bCell =
			            IF (
			                r = 0,
			                "",
			                "<div class='gt'>" & IF ( bNm = "", "--", bNm ) & "</div>"
			                    & IF ( bWs = "", "", "<div class='gw'>was " & bWs & "</div>" )
			            )
			        VAR dCur =
			            [DhCur]
			        VAR dPrev =
			            [DhPrev]
			        VAR dState =
			            SWITCH (
			                TRUE (),
			                COALESCE ( dCur, 0 ) = 0
			                    &&
			                COALESCE ( dPrev, 0 ) = 0, "empty",
			                COALESCE ( dPrev, 0 ) = 0, "new",
			                COALESCE ( dCur, 0 ) = 0, "gone",
			                "ok"
			            )
			        VAR dYOY =
			            IF (
			                dState = "ok",
			                DIVIDE ( dCur - dPrev, dPrev )
			            )
			        VAR dTxt =
			            SWITCH (
			                dState,
			                "empty", "",
			                "new", "NEW",
			                "gone", "N/A",
			                IF (
			                    dYOY >= 0,
			                    "+" & FORMAT ( dYOY, "0.00%" ),
			                    FORMAT ( dYOY, "0.00%" )
			                )
			            )
			        VAR dCol =
			            SWITCH (
			                dState,
			                "empty", TxtSecondary,
			                "new", "#00B8E4",
			                "gone", TxtSecondary,
			                IF ( dYOY >= 0, Green, Red )
			            )
			        VAR dBar =
			            IF (
			                dState = "ok",
			                MIN (
			                    100,
			                    ROUND ( DIVIDE ( ABS ( dYOY ), BarCap ) * 100, 0 )
			                ),
			                0
			            )
			        VAR dShowBar =
			            dState = "ok"
			        VAR dF1 =
			            IF (
			                COALESCE ( dCur, 0 ) = 0,
			                "",
			                FORMAT ( dCur, "#,0" )
			            )
			        VAR dF2 =
			            IF (
			                COALESCE ( dPrev, 0 ) = 0,
			                "",
			                FORMAT ( dPrev, "#,0" )
			            )
			        VAR dNm =
			            [DhName]
			        VAR dWs =
			            [DhWas]
			        VAR dCell =
			            IF (
			                r = 0,
			                "",
			                "<div class='gt'>" & IF ( dNm = "", "--", dNm ) & "</div>"
			                    & IF ( dWs = "", "", "<div class='gw'>was " & dWs & "</div>" )
			            )
			        RETURN
			            "<tr class='" & rowCls & "'>"
			                & "<td class='g'>" & aCell & "</td>"
			                & "<td class='a'>" & aF1 & "</td>"
			                & "<td class='p dim'>" & aF2 & "</td>"
			                & "<td class='y'>"
			                    & "<div class='yv' style='color:" & aCol & "'>"
			                        & aTxt
			                    & "</div>"
			                    & IF (
			                        aShowBar,
			                        "<div class='yb'><div class='yf' style='width:"
			                            & FORMAT ( aBar, "0" )
			                            & "%;background:"
			                            & aCol
			                            & "'></div></div>",
			                        ""
			                    )
			                & "</td>"
			                & "<td class='g sec'>" & bCell & "</td>"
			                & "<td class='a'>" & bF1 & "</td>"
			                & "<td class='p dim'>" & bF2 & "</td>"
			                & "<td class='y'>"
			                    & "<div class='yv' style='color:" & bCol & "'>"
			                        & bTxt
			                    & "</div>"
			                    & IF (
			                        bShowBar,
			                        "<div class='yb'><div class='yf' style='width:"
			                            & FORMAT ( bBar, "0" )
			                            & "%;background:"
			                            & bCol
			                            & "'></div></div>",
			                        ""
			                    )
			                & "</td>"
			                & "<td class='g sec'>" & dCell & "</td>"
			                & "<td class='a'>" & dF1 & "</td>"
			                & "<td class='p dim'>" & dF2 & "</td>"
			                & "<td class='y'>"
			                    & "<div class='yv' style='color:" & dCol & "'>"
			                        & dTxt
			                    & "</div>"
			                    & IF (
			                        dShowBar,
			                        "<div class='yb'><div class='yf' style='width:"
			                            & FORMAT ( dBar, "0" )
			                            & "%;background:"
			                            & dCol
			                            & "'></div></div>",
			                        ""
			                    )
			                & "</td>"
			            & "</tr>",
			        "",
			        IF ( [Rnk] = 0, 999999, [Rnk] ), ASC
			    )
			VAR HeadHTML =
			    "<div class='rb-head'>"
			        & "<span class='rb-name'>Trilith</span>"
			        & "<span class='rb-title'>Christmas " & FORMAT ( SelYr, "0" ) & "</span>"
			        & "<span class='rb-sub'>vs " & FORMAT ( PrevYr, "0" ) & "</span>"
			    & "</div>"
			VAR TableHTML =
			"<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
			.rb *{box-sizing:border-box;margin:0;padding:0;font-family:Inter,sans-serif;}
			.rb{width:100%;background:" & Bg & ";border:1px solid " & BorderColor & ";border-radius:18px;padding:16px 18px;overflow:hidden;}
			.rb-head{display:flex;align-items:baseline;gap:8px;margin-bottom:12px;}
			.rb-name{font-size:16px;font-weight:900;color:" & Accent & ";letter-spacing:-.2px;}
			.rb-title{font-size:16px;font-weight:900;color:" & TxtPrimary & ";letter-spacing:-.2px;}
			.rb-sub{font-size:11px;font-weight:500;color:" & TxtSecondary & ";margin-left:auto;}
			.rb table{width:100%;border-collapse:collapse;table-layout:fixed;}
			.rb th{font-size:9px;font-weight:800;letter-spacing:.4px;text-transform:uppercase;color:" & TxtSecondary & ";background:" & HeadBg & ";padding:6px 6px;text-align:right;white-space:nowrap;}
			.rb th.grp{text-align:left;color:" & TxtPrimary & ";font-size:10px;border-bottom:1px solid " & SectionLine & ";}
			.rb th.g,.rb td.g{text-align:left;width:11%;}
			.rb th.a,.rb td.a{width:6.5%;}
			.rb th.p,.rb td.p{width:6.5%;}
			.rb th.y,.rb td.y{width:9.3%;}
			.rb th.sec,.rb td.sec{border-left:1px solid " & SectionLine & ";}
			.rb td{font-size:11px;padding:6px 6px;text-align:right;border-bottom:1px solid " & RowLine & ";color:" & TxtPrimary & ";font-variant-numeric:tabular-nums;font-feature-settings:'tnum';vertical-align:top;}
			.rb td.dim{color:" & TxtSecondary & ";}
			.rb td.y{padding:5px 6px;}
			.rb .yv{font-size:10px;font-weight:800;text-align:right;line-height:1.1;font-variant-numeric:tabular-nums;}
			.rb .yb{height:3px;border-radius:2px;background:" & TrackBg & ";overflow:hidden;margin-top:3px;}
			.rb .yf{height:100%;border-radius:2px;transform:scaleX(0);transform-origin:left center;transition:transform .9s cubic-bezier(.22,.8,.25,1);}
			.rb .gt{font-size:10px;font-weight:800;color:" & TxtPrimary & ";line-height:1.25;}
			.rb .gw{font-size:9px;font-weight:500;color:" & SchedTxt & ";line-height:1.3;margin-top:1px;}
			.rb tr.r-total td{background:" & CityRowBg & ";font-weight:900;border-top:2px solid " & SectionLine & ";border-bottom:none;}
			.rb-empty{min-height:120px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;}
			.rb-empty-h{font-size:12px;font-weight:800;color:" & TxtPrimary & ";}
			.rb-empty-s{font-size:11px;font-weight:500;color:" & TxtSecondary & ";max-width:280px;line-height:1.4;}
			</style>"
			    & "<div class='rb'>"
			    & HeadHTML
			    & "<table><thead><tr>"
			        & "<th class='grp' colspan='4'>Adults</th>"
			        & "<th class='grp sec' colspan='4'>bloom</th>"
			        & "<th class='grp sec' colspan='4'>Door Holder</th>"
			    & "</tr><tr>"
			        & "<th class='g'>Gathering</th><th class='a'>Att</th><th class='p'>Prev</th><th class='y'>YOY%</th>"
			        & "<th class='g sec'>Gathering</th><th class='a'>Att</th><th class='p'>Prev</th><th class='y'>YOY%</th>"
			        & "<th class='g sec'>Gathering</th><th class='a'>Att</th><th class='p'>Prev</th><th class='y'>YOY%</th>"
			    & "</tr></thead><tbody>"
			    & RowsHTML
			    & "</tbody></table></div>"
			    & "<script>(function(){function run(){var f=document.querySelectorAll('.rb .yf');requestAnimationFrame(function(){requestAnimationFrame(function(){f.forEach(function(el){el.style.transform='scaleX(1)';});});});}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',run);}else{run();}})();</script>"
			VAR EmptyHTML =
			"<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
			.rb *{box-sizing:border-box;margin:0;padding:0;font-family:Inter,sans-serif;}
			.rb{width:100%;background:" & Bg & ";border:1px solid " & BorderColor & ";border-radius:18px;padding:16px 18px;overflow:hidden;}
			.rb-head{display:flex;align-items:baseline;gap:8px;margin-bottom:12px;}
			.rb-name{font-size:16px;font-weight:900;color:" & Accent & ";letter-spacing:-.2px;}
			.rb-title{font-size:16px;font-weight:900;color:" & TxtPrimary & ";letter-spacing:-.2px;}
			.rb-sub{font-size:11px;font-weight:500;color:" & TxtSecondary & ";margin-left:auto;}
			.rb table{width:100%;border-collapse:collapse;table-layout:fixed;}
			.rb th{font-size:9px;font-weight:800;letter-spacing:.4px;text-transform:uppercase;color:" & TxtSecondary & ";background:" & HeadBg & ";padding:6px 6px;text-align:right;white-space:nowrap;}
			.rb th.grp{text-align:left;color:" & TxtPrimary & ";font-size:10px;border-bottom:1px solid " & SectionLine & ";}
			.rb th.g,.rb td.g{text-align:left;width:11%;}
			.rb th.a,.rb td.a{width:6.5%;}
			.rb th.p,.rb td.p{width:6.5%;}
			.rb th.y,.rb td.y{width:9.3%;}
			.rb th.sec,.rb td.sec{border-left:1px solid " & SectionLine & ";}
			.rb td{font-size:11px;padding:6px 6px;text-align:right;border-bottom:1px solid " & RowLine & ";color:" & TxtPrimary & ";font-variant-numeric:tabular-nums;font-feature-settings:'tnum';vertical-align:top;}
			.rb td.dim{color:" & TxtSecondary & ";}
			.rb td.y{padding:5px 6px;}
			.rb .yv{font-size:10px;font-weight:800;text-align:right;line-height:1.1;font-variant-numeric:tabular-nums;}
			.rb .yb{height:3px;border-radius:2px;background:" & TrackBg & ";overflow:hidden;margin-top:3px;}
			.rb .yf{height:100%;border-radius:2px;transform:scaleX(0);transform-origin:left center;transition:transform .9s cubic-bezier(.22,.8,.25,1);}
			.rb .gt{font-size:10px;font-weight:800;color:" & TxtPrimary & ";line-height:1.25;}
			.rb .gw{font-size:9px;font-weight:500;color:" & SchedTxt & ";line-height:1.3;margin-top:1px;}
			.rb tr.r-total td{background:" & CityRowBg & ";font-weight:900;border-top:2px solid " & SectionLine & ";border-bottom:none;}
			.rb-empty{min-height:120px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;}
			.rb-empty-h{font-size:12px;font-weight:800;color:" & TxtPrimary & ";}
			.rb-empty-s{font-size:11px;font-weight:500;color:" & TxtSecondary & ";max-width:280px;line-height:1.4;}
			</style>"
			    & "<div class='rb'>"
			    & HeadHTML
			    & "<div class='rb-empty'>"
			        & "<div class='rb-empty-h'>" & EmptyHeadline & "</div>"
			        & "<div class='rb-empty-s'>" & EmptySubline & "</div>"
			    & "</div></div>"
			RETURN
			    IF ( HasData, TableHTML, EmptyHTML )
		lineageTag: 941576a6-7427-4ca0-88c3-c1a0e570c4f4

	measure HTML_Christmas_RB_Total =
			
			VAR IsDark =
			    [SelectedTheme] = "Dark"
			VAR Bg =
			    IF ( IsDark, "#1E1E1E", "#FFFFFF" )
			VAR BorderColor =
			    IF ( IsDark, "#2A2A2A", "#E5E7EB" )
			VAR TxtPrimary =
			    IF ( IsDark, "#FFFFFF", "#111111" )
			VAR TxtSecondary =
			    IF ( IsDark, "#9CA3AF", "#6B7280" )
			VAR HeadBg =
			    IF ( IsDark, "#252525", "#F9FAFB" )
			VAR RowLine =
			    IF ( IsDark, "rgba(255,255,255,0.06)", "rgba(0,0,0,0.06)" )
			VAR SectionLine =
			    IF ( IsDark, "#3A3A3A", "#D1D5DB" )
			VAR CityRowBg =
			    IF ( IsDark, "#2A2A2A", "#F3F4F6" )
			VAR SchedTxt =
			    IF ( IsDark, "#8A8A8A", "#6B7280" )
			VAR TrackBg =
			    IF ( IsDark, "#323232", "#E5E7EB" )
			VAR Green =
			    "#62E68D"
			VAR Red =
			    "#FF7E84"
			VAR BarCap =
			    0.5
			VAR Accent =
			    "#FFFFFF"
			VAR SelYr =
			    [ChristmasYear]
			VAR PrevYr =
			    SelYr - 1
			VAR Src =
			    FILTER (
			        ALL ( 'SplSundayAttInPerson_WOW' ),
			        'SplSundayAttInPerson_WOW'[EventName] = "Christmas"
			            &&
			        'SplSundayAttInPerson_WOW'[CampusName] <> "DC"
			            &&
			        (
			            VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                ||
			            VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			        )
			    )
			VAR MinYrAvail =
			    MINX (
			        FILTER ( ALL ( 'SplSundayAttInPerson_WOW' ), 'SplSundayAttInPerson_WOW'[EventName] = "Christmas" ),
			        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] )
			    )
			VAR MaxYrAvail =
			    MAXX (
			        FILTER ( ALL ( 'SplSundayAttInPerson_WOW' ), 'SplSundayAttInPerson_WOW'[EventName] = "Christmas" ),
			        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] )
			    )
			VAR CurYearTotal =
			    SUMX (
			        FILTER ( Src, VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr ),
			        'SplSundayAttInPerson_WOW'[Count]
			    )
			VAR HasData =
			    NOT ISBLANK ( SelYr )
			        &&
			    COALESCE ( COUNTROWS ( Src ), 0 ) > 0
			        &&
			    COALESCE ( CurYearTotal, 0 ) > 0
			VAR EmptyHeadline =
			    IF (
			        ISBLANK ( SelYr ),
			        "No data available",
			        "No Christmas data for " & FORMAT ( SelYr, "0" )
			    )
			VAR EmptySubline =
			    "Available from "
			        & FORMAT ( MinYrAvail, "0" )
			        & " to "
			        & FORMAT ( MaxYrAvail, "0" )
			VAR KeysDetail =
			    SELECTCOLUMNS (
			        SUMMARIZE (
			            Src,
			            'SplSundayAttInPerson_WOW'[CampusName],
			            'SplSundayAttInPerson_WOW'[CampusSortOrder]
			        ),
			        "SortA", COALESCE ( VALUE ( 'SplSundayAttInPerson_WOW'[CampusSortOrder] ), 0 ),
			        "Label", 'SplSundayAttInPerson_WOW'[CampusName],
			        "Lvl", "detail",
			        "K", 'SplSundayAttInPerson_WOW'[CampusName]
			    )
			VAR KeysTotal =
			    ROW (
			        "SortA", 999999,
			        "Label", "Total",
			        "Lvl", "total",
			        "K", ""
			    )
			VAR AllKeys =
			    UNION ( KeysDetail, KeysTotal )
			VAR RowData =
			    ADDCOLUMNS (
			        AllKeys,
			        "AdCur",
			            VAR k = [K]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Src,
			                        ( k = "" || 'SplSundayAttInPerson_WOW'[CampusName] = k )
			                            &&
			                        'SplSundayAttInPerson_WOW'[Literal] = "Adults"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                    ),
			                    'SplSundayAttInPerson_WOW'[Count]
			                ),
			        "AdPrev",
			            VAR k = [K]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Src,
			                        ( k = "" || 'SplSundayAttInPerson_WOW'[CampusName] = k )
			                            &&
			                        'SplSundayAttInPerson_WOW'[Literal] = "Adults"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                    ),
			                    'SplSundayAttInPerson_WOW'[Count]
			                ),
			        "BlCur",
			            VAR k = [K]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Src,
			                        ( k = "" || 'SplSundayAttInPerson_WOW'[CampusName] = k )
			                            &&
			                        'SplSundayAttInPerson_WOW'[Literal] = "bloom"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                    ),
			                    'SplSundayAttInPerson_WOW'[Count]
			                ),
			        "BlPrev",
			            VAR k = [K]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Src,
			                        ( k = "" || 'SplSundayAttInPerson_WOW'[CampusName] = k )
			                            &&
			                        'SplSundayAttInPerson_WOW'[Literal] = "bloom"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                    ),
			                    'SplSundayAttInPerson_WOW'[Count]
			                ),
			        "DhCur",
			            VAR k = [K]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Src,
			                        ( k = "" || 'SplSundayAttInPerson_WOW'[CampusName] = k )
			                            &&
			                        'SplSundayAttInPerson_WOW'[Literal] = "Door Holder"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                    ),
			                    'SplSundayAttInPerson_WOW'[Count]
			                ),
			        "DhPrev",
			            VAR k = [K]
			            RETURN
			                SUMX (
			                    FILTER (
			                        Src,
			                        ( k = "" || 'SplSundayAttInPerson_WOW'[CampusName] = k )
			                            &&
			                        'SplSundayAttInPerson_WOW'[Literal] = "Door Holder"
			                            &&
			                        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			                    ),
			                    'SplSundayAttInPerson_WOW'[Count]
			                )
			    )
			VAR RowsHTML =
			    CONCATENATEX (
			        RowData,
			        VAR rowCls =
			            IF ( [Lvl] = "total", "r-total", "r-campus" )
			        VAR LabelCell =
			            "<div class='gt'>" & [Label] & "</div>"
			        VAR aCur =
			            [AdCur]
			        VAR aPrev =
			            [AdPrev]
			        VAR aState =
			            SWITCH (
			                TRUE (),
			                COALESCE ( aCur, 0 ) = 0
			                    &&
			                COALESCE ( aPrev, 0 ) = 0, "empty",
			                COALESCE ( aPrev, 0 ) = 0, "new",
			                COALESCE ( aCur, 0 ) = 0, "gone",
			                "ok"
			            )
			        VAR aYOY =
			            IF (
			                aState = "ok",
			                DIVIDE ( aCur - aPrev, aPrev )
			            )
			        VAR aTxt =
			            SWITCH (
			                aState,
			                "empty", "",
			                "new", "NEW",
			                "gone", "N/A",
			                IF (
			                    aYOY >= 0,
			                    "+" & FORMAT ( aYOY, "0.00%" ),
			                    FORMAT ( aYOY, "0.00%" )
			                )
			            )
			        VAR aCol =
			            SWITCH (
			                aState,
			                "empty", TxtSecondary,
			                "new", "#00B8E4",
			                "gone", TxtSecondary,
			                IF ( aYOY >= 0, Green, Red )
			            )
			        VAR aBar =
			            IF (
			                aState = "ok",
			                MIN (
			                    100,
			                    ROUND (
			                        DIVIDE ( ABS ( aYOY ), BarCap ) * 100,
			                        0
			                    )
			                ),
			                0
			            )
			        VAR aShowBar =
			            aState = "ok"
			        VAR aF1 =
			            IF (
			                COALESCE ( aCur, 0 ) = 0,
			                "",
			                FORMAT ( aCur, "#,0" )
			            )
			        VAR aF2 =
			            IF (
			                COALESCE ( aPrev, 0 ) = 0,
			                "",
			                FORMAT ( aPrev, "#,0" )
			            )
			        VAR bCur =
			            [BlCur]
			        VAR bPrev =
			            [BlPrev]
			        VAR bState =
			            SWITCH (
			                TRUE (),
			                COALESCE ( bCur, 0 ) = 0
			                    &&
			                COALESCE ( bPrev, 0 ) = 0, "empty",
			                COALESCE ( bPrev, 0 ) = 0, "new",
			                COALESCE ( bCur, 0 ) = 0, "gone",
			                "ok"
			            )
			        VAR bYOY =
			            IF (
			                bState = "ok",
			                DIVIDE ( bCur - bPrev, bPrev )
			            )
			        VAR bTxt =
			            SWITCH (
			                bState,
			                "empty", "",
			                "new", "NEW",
			                "gone", "N/A",
			                IF (
			                    bYOY >= 0,
			                    "+" & FORMAT ( bYOY, "0.00%" ),
			                    FORMAT ( bYOY, "0.00%" )
			                )
			            )
			        VAR bCol =
			            SWITCH (
			                bState,
			                "empty", TxtSecondary,
			                "new", "#00B8E4",
			                "gone", TxtSecondary,
			                IF ( bYOY >= 0, Green, Red )
			            )
			        VAR bBar =
			            IF (
			                bState = "ok",
			                MIN (
			                    100,
			                    ROUND (
			                        DIVIDE ( ABS ( bYOY ), BarCap ) * 100,
			                        0
			                    )
			                ),
			                0
			            )
			        VAR bShowBar =
			            bState = "ok"
			        VAR bF1 =
			            IF (
			                COALESCE ( bCur, 0 ) = 0,
			                "",
			                FORMAT ( bCur, "#,0" )
			            )
			        VAR bF2 =
			            IF (
			                COALESCE ( bPrev, 0 ) = 0,
			                "",
			                FORMAT ( bPrev, "#,0" )
			            )
			        VAR dCur =
			            [DhCur]
			        VAR dPrev =
			            [DhPrev]
			        VAR dState =
			            SWITCH (
			                TRUE (),
			                COALESCE ( dCur, 0 ) = 0
			                    &&
			                COALESCE ( dPrev, 0 ) = 0, "empty",
			                COALESCE ( dPrev, 0 ) = 0, "new",
			                COALESCE ( dCur, 0 ) = 0, "gone",
			                "ok"
			            )
			        VAR dYOY =
			            IF (
			                dState = "ok",
			                DIVIDE ( dCur - dPrev, dPrev )
			            )
			        VAR dTxt =
			            SWITCH (
			                dState,
			                "empty", "",
			                "new", "NEW",
			                "gone", "N/A",
			                IF (
			                    dYOY >= 0,
			                    "+" & FORMAT ( dYOY, "0.00%" ),
			                    FORMAT ( dYOY, "0.00%" )
			                )
			            )
			        VAR dCol =
			            SWITCH (
			                dState,
			                "empty", TxtSecondary,
			                "new", "#00B8E4",
			                "gone", TxtSecondary,
			                IF ( dYOY >= 0, Green, Red )
			            )
			        VAR dBar =
			            IF (
			                dState = "ok",
			                MIN (
			                    100,
			                    ROUND (
			                        DIVIDE ( ABS ( dYOY ), BarCap ) * 100,
			                        0
			                    )
			                ),
			                0
			            )
			        VAR dShowBar =
			            dState = "ok"
			        VAR dF1 =
			            IF (
			                COALESCE ( dCur, 0 ) = 0,
			                "",
			                FORMAT ( dCur, "#,0" )
			            )
			        VAR dF2 =
			            IF (
			                COALESCE ( dPrev, 0 ) = 0,
			                "",
			                FORMAT ( dPrev, "#,0" )
			            )
			        RETURN
			            "<tr class='" & rowCls & "'>"
			                & "<td class='g'>" & LabelCell & "</td>"
			                & "<td class='a'>" & aF1 & "</td>"
			                & "<td class='p dim'>" & aF2 & "</td>"
			                & "<td class='y'>"
			                    & "<div class='yv' style='color:" & aCol & "'>"
			                        & aTxt
			                    & "</div>"
			                    & IF (
			                        aShowBar,
			                        "<div class='yb'><div class='yf' style='width:"
			                            & FORMAT ( aBar, "0" )
			                            & "%;background:"
			                            & aCol
			                            & "'></div></div>",
			                        ""
			                    )
			                & "</td>"
			                & "<td class='a sec'>" & bF1 & "</td>"
			                & "<td class='p dim'>" & bF2 & "</td>"
			                & "<td class='y'>"
			                    & "<div class='yv' style='color:" & bCol & "'>"
			                        & bTxt
			                    & "</div>"
			                    & IF (
			                        bShowBar,
			                        "<div class='yb'><div class='yf' style='width:"
			                            & FORMAT ( bBar, "0" )
			                            & "%;background:"
			                            & bCol
			                            & "'></div></div>",
			                        ""
			                    )
			                & "</td>"
			                & "<td class='a sec'>" & dF1 & "</td>"
			                & "<td class='p dim'>" & dF2 & "</td>"
			                & "<td class='y'>"
			                    & "<div class='yv' style='color:" & dCol & "'>"
			                        & dTxt
			                    & "</div>"
			                    & IF (
			                        dShowBar,
			                        "<div class='yb'><div class='yf' style='width:"
			                            & FORMAT ( dBar, "0" )
			                            & "%;background:"
			                            & dCol
			                            & "'></div></div>",
			                        ""
			                    )
			                & "</td>"
			            & "</tr>",
			        "",
			        [SortA], ASC
			    )
			VAR HeadHTML =
			    "<div class='rb-head'>"
			        & "<span class='rb-name'>Atlanta</span>"
			        & "<span class='rb-title'>Christmas " & FORMAT ( SelYr, "0" ) & "</span>"
