	column PrevWeekDate = ```
			VAR SelectedDate =
			    MIN ( 'Calendar'[selecteddate] )
			
			VAR LastSundayWithAttendance =
			    MAXX (
			        FILTER (
			            ALL ( 'Calendar'[Date] ),
			            VAR SundayDate = 'Calendar'[Date]
			            RETURN
			                SundayDate < SelectedDate
			                    && WEEKDAY ( SundayDate, 2 ) = 7
			                    && CALCULATE (
			                        [CountNew],
			                        AttendanceInPerson_WOW[MetricValueDateTime] = SundayDate
			                    ) <> 0
			        ),
			        'Calendar'[Date]
			    )
			
			RETURN 
			// LastSundayWithAttendance
			int(LastSundayWithAttendance)
			// FORMAT(LastSundayWithAttendance, "MM/DD/YYYY")
			```
		lineageTag: 195ce145-56d8-4859-88c0-94a0a1c2e8a8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Year-Default = Year(today())
		formatString: 0
		lineageTag: 9da90358-95e6-41b2-b5c0-61c0de20f5eb
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column selecteddate = FIRSTDATE('Calendar'[Date])
		formatString: General Date
		lineageTag: d20d5345-9d6f-4cc4-8f24-eeece9f865bd
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 4ab2401b-78cf-4e53-84bb-f4e560ad10f8
			defaultHierarchy: LocalDateTable_ef8ff5c0-f0f9-4a81-a630-79b50f37644f.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column AutoDate =
			
			IF(
			    'Calendar'[Date] = CALCULATE(
			        MAX(AttendanceInPerson_WOW[MetricValueDateTime]),
			        ALL('Calendar')
			    ),
			    'Calendar'[Date],
			    BLANK()
			)
		formatString: General Date
		lineageTag: 0ed64455-1c3a-439c-9f9c-79f7cc81d072
		summarizeBy: none

		variation Variation
			isDefault
			relationship: d6e54f76-7777-4dd9-8b8a-eea573673bd0
			defaultHierarchy: LocalDateTable_f0b0c640-d4c8-4bab-8164-de5dbf7205e4.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	partition Calendar-da4b6cfa-5b98-4655-9dc0-aa46185ff415 = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR (DATE(2011,1,1), MAX(AttendanceInPerson_WOW[MetricValueDateTime])),
				    "Year", YEAR([Date]),
				    "MonthNumber", MONTH([Date]),
				    "MonthName", FORMAT([Date], "MMMM"),
				    "WeekNumber", WEEKNUM([Date]),
				    "DayOfWeekNumber", WEEKDAY([Date]),
				    "DayOfWeekName", FORMAT([Date], "DDDD"),
				    "Quarter", QUARTER([Date]),
				    "YearMonth", FORMAT([Date], "YYYY-MM"),
				    "YearQuarter", FORMAT([Date], "YYYY") & "-Q" & QUARTER([Date])
				)

	annotation PBI_Id = 8f5995d6b2f24915997e414f6636b662

