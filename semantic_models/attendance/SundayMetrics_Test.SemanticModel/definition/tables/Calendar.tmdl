table Calendar
	lineageTag: cf6ff02a-8d97-4ccc-9826-a34e259da2b3

	measure MaxselectedDate = MINX(VALUES('Calendar'[selecteddate]),'Calendar'[selecteddate])
		formatString: Short Date
		lineageTag: 445766a1-0133-4369-9362-92e708bcaffc

	measure Last5weeks = [MaxselectedDate]-35
		formatString: Short Date
		lineageTag: 8b0ef5b4-a03c-40d5-929c-5d51ce1f37df

	measure PrevWeekDateUSE =
			VAR SelectedDate =
			    MIN ( 'Calendar'[selecteddate] )
			
			VAR LastSundayWithAttendance =
			    MAXX (
			        FILTER (
			            ALL ( 'Calendar'[Date] ),
			            VAR SundayDate = 'Calendar'[Date]
			            RETURN
			                SundayDate < SelectedDate
			                    && WEEKDAY ( SundayDate, 2 ) = 7
			                    && CALCULATE (
			                        [CountNew],
			                        AttendanceInPerson_WOW[MetricValueDateTime] = SundayDate
			                    ) <> 0
			        ),
			        'Calendar'[Date]
			    )
			
			RETURN FORMAT(LastSundayWithAttendance, "MM/DD/YYYY")
		lineageTag: c28633a3-1359-44d2-a14b-4e73ed896387

	measure 'Latest Data Date' =
			
			" " & FORMAT(
			    MAX(AttendanceInPerson_WOW[MetricValueDateTime]),
			    "M/D/YYYY"
			)
		lineageTag: e34e4a5e-6a85-4bbd-ae85-8c894fb06711

