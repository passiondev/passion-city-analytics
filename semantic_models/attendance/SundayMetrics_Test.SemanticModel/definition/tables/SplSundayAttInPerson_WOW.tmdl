	measure YOYMeasureEaster = Divide([CurrentYearEaster]-[PrevYearEaster],[PrevYearEaster],0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 6ec820e1-7848-49f4-bcd7-4ea71ed3a90b

	measure YOYMeasureChristmas = Divide([CurrentYearChristmas]-[PrevYearChristmas],[PrevYearChristmas],0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 9f4a4d41-f31a-4d68-abcb-e7e0975027e6

	measure EasterArrowsconditionsYOY = ```
			SWITCH(
			    TRUE(),
			    SplSundayAttInPerson_WOW[YOYMeasureEaster]>=0,UNICHAR(9650),
			    SplSundayAttInPerson_WOW[YOYMeasureEaster]<0,UNICHAR(9660),
			    BLANK()
			    )
			
			```
		lineageTag: e3c6e4e1-04e5-47ed-adb0-ed84210e1f31

	measure ChristmasArrowsconditionsYOY = ```
			SWITCH(
			    TRUE(),
			    SplSundayAttInPerson_WOW[YOYMeasureChristmas]>=0,UNICHAR(9650),
			    SplSundayAttInPerson_WOW[YOYMeasureChristmas]<0,UNICHAR(9660),
			    BLANK()
			    )
			
			```
		lineageTag: f2083df3-e974-4501-883b-9b18bdd3eea8

