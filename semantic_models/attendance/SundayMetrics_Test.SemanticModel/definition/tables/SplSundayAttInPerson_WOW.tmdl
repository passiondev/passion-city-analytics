			    vertical-align:middle;
			    white-space:nowrap;
			}
			
			.rb th.grp{
			    text-align:left;
			    color:" & TxtPrimary & ";
			    font-size:10px;
			    border-bottom:1px solid " & SectionLine & ";
			}
			
			.rb th.c-lbl,
			.rb td.c-lbl{
			    text-align:left;
			    width:10%;
			    white-space:nowrap;
			}
			
			.rb .c-lbl-main{
			    line-height:1.2;
			}
			
			.rb .c-lbl-sub{
			    font-size:9px;
			    font-weight:500;
			    color:" & TxtSecondary & ";
			    line-height:1.1;
			    margin-top:1px;
			}
			
			.rb th:not(.c-lbl),
			.rb td:not(.c-lbl){
			    width:10%;
			}
			
			.rb th.sec,
