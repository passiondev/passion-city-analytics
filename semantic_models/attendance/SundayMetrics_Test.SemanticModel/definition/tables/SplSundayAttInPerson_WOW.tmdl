			.rb td{
			    font-size:11px;
			    padding:2px 5px;
			    text-align:right;
			    vertical-align:middle;
			    border-bottom:1px solid " & RowLine & ";
			    color:" & TxtPrimary & ";
			    font-variant-numeric:tabular-nums;
			    font-feature-settings:'tnum';
			}
			
			.rb td.dim{
			    color:" & TxtSecondary & ";
			}
			
			.rb td.yc{
			    padding:2px 5px;
			    vertical-align:middle;
			}
			
			.rb .yv{
			    width:100%;
			    font-size:10px;
			    font-weight:800;
			    text-align:right;
			    line-height:1.1;
			    font-variant-numeric:tabular-nums;
			}
			
			.rb .yb{
			    width:100%;
			    height:3px;
			    border-radius:2px;
			    background:" & TrackBg & ";
			    overflow:hidden;
			    margin-top:3px;
			}
			
			.rb .yf{
			    height:100%;
			    border-radius:2px;
			    transform:scaleX(0);
			    transform-origin:left center;
			    transition:transform .9s cubic-bezier(.22,.8,.25,1);
			}
			
			.rb tr.r-sched td{
			    font-weight:500;
			    color:" & SchedTxt & ";
			}
			
			.rb tr.r-sched td.c-lbl{
			    padding-left:6px;
			    padding-right:2px;
			    font-size:10px;
			}
			
			.rb tr.r-campus td{
			    font-weight:800;
			}
			
			.rb tr.r-campus td.c-lbl{
			    padding-left:6px;
			}
			
			.rb tr.r-total td{
			    background:" & CityRowBg & ";
			    font-weight:900;
			    border-top:2px solid " & SectionLine & ";
			    border-bottom:none;
			}
			
			.rb-empty{
			    flex:1 1 0;
			    min-height:0;
			    display:flex;
			    flex-direction:column;
			    align-items:center;
			    justify-content:center;
			    gap:8px;
			    text-align:center;
			}
			
			.rb-empty-h{
			    font-size:12px;
			    font-weight:800;
			    color:" & TxtPrimary & ";
			}
			
			.rb-empty-s{
			    font-size:11px;
			    font-weight:500;
			    color:" & TxtSecondary & ";
			    max-width:280px;
			    line-height:1.4;
			}
			</style>"
			
