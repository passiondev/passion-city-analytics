	measure PrevYearEaster = ```
			
			VAR prevyear=( Year('Calendar'[MaxselectedDate])-1)
			Return 
			CALCULATE(sum(SplSundayAttInPerson_WOW[Count]),YEAR(SplSundayAttInPerson_WOW[MetricValueDateTime])=prevyear,SplSundayAttInPerson_WOW[EventName]="Easter")
