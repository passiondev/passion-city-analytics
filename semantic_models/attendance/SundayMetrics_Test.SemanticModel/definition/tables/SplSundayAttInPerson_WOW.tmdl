		lineageTag: 7a2033fe-29a9-4721-88b9-1bf4e3728ab5

	measure HTML_Easter_RB_TRL = ```
			
			VAR IsDark =
			    [SelectedTheme] = "Dark"
			
			VAR Bg =
			    IF ( IsDark, "#1E1E1E", "#FFFFFF" )
			
			VAR BorderColor =
			    IF ( IsDark, "#2A2A2A", "#E5E7EB" )
			
			VAR TxtPrimary =
			    IF ( IsDark, "#FFFFFF", "#111111" )
			
			VAR TxtSecondary =
			    IF ( IsDark, "#9CA3AF", "#6B7280" )
			
			VAR HeadBg =
			    IF ( IsDark, "#252525", "#F9FAFB" )
			
			VAR RowLine =
			    IF ( IsDark, "rgba(255,255,255,0.06)", "rgba(0,0,0,0.06)" )
			
			VAR SectionLine =
			    IF ( IsDark, "#3A3A3A", "#D1D5DB" )
			
			VAR CityRowBg =
			    IF ( IsDark, "#2A2A2A", "#F3F4F6" )
			
			VAR SchedTxt =
			    IF ( IsDark, "#8A8A8A", "#6B7280" )
			
			VAR TrackBg =
			    IF ( IsDark, "#323232", "#E5E7EB" )
			
			VAR Green =
			    "#62E68D"
			
			VAR Red =
			    "#FF7E84"
			
			VAR BarCap =
			    0.5
			
			VAR Accent =
			    "#931EE7"
			
			VAR SelYr =
			    [EasterYear]
			
			VAR PrevYr =
			    SelYr - 1
			
			VAR Src =
			    FILTER (
			        ALL ( 'SplSundayAttInPerson_WOW' ),
			        'SplSundayAttInPerson_WOW'[EventName] = "Easter"
			            &&
			        'SplSundayAttInPerson_WOW'[CampusName] = "Trilith"
			            &&
			        (
			            VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr
			                ||
			            VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr
			        )
			    )
			
			VAR MinYrAvail =
			    MINX (
			        FILTER (
			            ALL ( 'SplSundayAttInPerson_WOW' ),
			            'SplSundayAttInPerson_WOW'[EventName] = "Easter"
			                &&
			            'SplSundayAttInPerson_WOW'[CampusName] = "Trilith"
			                &&
			            COALESCE ( 'SplSundayAttInPerson_WOW'[Count], 0 ) > 0
			        ),
			        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] )
			    )
			
			VAR MaxYrAvail =
			    MAXX (
			        FILTER (
			            ALL ( 'SplSundayAttInPerson_WOW' ),
			            'SplSundayAttInPerson_WOW'[EventName] = "Easter"
			                &&
			            'SplSundayAttInPerson_WOW'[CampusName] = "Trilith"
			                &&
			            COALESCE ( 'SplSundayAttInPerson_WOW'[Count], 0 ) > 0
			        ),
			        VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] )
			    )
			
			VAR CurYearTotal =
			    SUMX (
			        FILTER ( Src, VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr ),
			        'SplSundayAttInPerson_WOW'[Count]
			    )
			
			VAR HasData =
			    NOT ISBLANK ( SelYr )
			        &&
			    COALESCE ( COUNTROWS ( Src ), 0 ) > 0
			        &&
			    COALESCE ( CurYearTotal, 0 ) > 0
			
			VAR EmptyHeadline =
			    IF ( ISBLANK ( SelYr ), "No data available", "No Easter data for " & FORMAT ( SelYr, "0" ) )
			
			VAR EmptySubline =
			    IF (
			        NOT ISBLANK ( MinYrAvail )
			            &&
			        NOT ISBLANK ( MaxYrAvail ),
			        "Data available in select years from "
			            & FORMAT ( MinYrAvail, "0" )
			            & " to "
			            & FORMAT ( MaxYrAvail, "0" ),
			        "No historical Easter data available"
			    )
			
			/* ================================================================
			   FIXED YOY MATCH LOGIC
			   Saturday (ScheduleSort = 22) always matches Saturday.
			   Sunday services are ranked by ScheduleSort within EACH year
			   independently, then matched rank-to-rank (1st Sunday <-> 1st
			   Sunday, 2nd <-> 2nd, etc.) instead of matching by ScheduleName,
			   so a service time shifting year over year no longer breaks YOY.
			   ================================================================ */
			
			VAR CurSrcOnly =
			    FILTER ( Src, VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = SelYr )
			VAR PrevSrcOnly =
			    FILTER ( Src, VALUE ( 'SplSundayAttInPerson_WOW'[FormattedDateSplSun] ) = PrevYr )
			
			VAR CurSchedRaw =
			    SUMMARIZE (
			        CurSrcOnly,
			        'SplSundayAttInPerson_WOW'[ScheduleName],
			        'SplSundayAttInPerson_WOW'[ScheduleSort]
			    )
			VAR PrevSchedRaw =
			    SUMMARIZE (
			        PrevSrcOnly,
			        'SplSundayAttInPerson_WOW'[ScheduleName],
			        'SplSundayAttInPerson_WOW'[ScheduleSort]
			    )
			
			VAR CurSunOnly =
			    FILTER ( CurSchedRaw, 'SplSundayAttInPerson_WOW'[ScheduleSort] <> 22 )
			VAR PrevSunOnly =
			    FILTER ( PrevSchedRaw, 'SplSundayAttInPerson_WOW'[ScheduleSort] <> 22 )
			
			VAR CurSchedKeyed =
			    ADDCOLUMNS (
			        CurSchedRaw,
			        "MatchKey",
			            IF (
			                'SplSundayAttInPerson_WOW'[ScheduleSort] = 22,
			                "SAT",
			                "SUN" & RANKX ( CurSunOnly, 'SplSundayAttInPerson_WOW'[ScheduleSort], , ASC, DENSE )
			            )
			    )
			VAR PrevSchedKeyed =
			    ADDCOLUMNS (
			        PrevSchedRaw,
			        "MatchKey",
			            IF (
			                'SplSundayAttInPerson_WOW'[ScheduleSort] = 22,
			                "SAT",
			                "SUN" & RANKX ( PrevSunOnly, 'SplSundayAttInPerson_WOW'[ScheduleSort], , ASC, DENSE )
			            )
			    )
			
			VAR KeysDetail =
			    SELECTCOLUMNS (
			        CurSchedKeyed,
			        "SortA", COALESCE ( 'SplSundayAttInPerson_WOW'[ScheduleSort] + 0, 0 ),
			        "Label", 'SplSundayAttInPerson_WOW'[ScheduleName],
			        "Lvl", "detail",
			        "K", 'SplSundayAttInPerson_WOW'[ScheduleName],
			        "MK", [MatchKey]
			    )
			
			VAR KeysTotal =
			    ROW ( "SortA", 999999, "Label", "Total", "Lvl", "total", "K", "", "MK", "" )
			
			VAR AllKeys =
			    UNION ( KeysDetail, KeysTotal )
			
			VAR KeysWithMatch =
			    ADDCOLUMNS (
			        AllKeys,
			        "PrevName",
			            VAR mk = [MK]
			            RETURN
			                IF (
			                    [Lvl] = "total",
			                    BLANK (),
			                    MAXX ( FILTER ( PrevSchedKeyed, [MatchKey] = mk ), 'SplSundayAttInPerson_WOW'[ScheduleName] )
			                ),
			        "HasMatch",
			            VAR mk = [MK]
			            RETURN
			                [Lvl] = "total"
			                    || COUNTROWS ( FILTER ( PrevSchedKeyed, [MatchKey] = mk ) ) > 0
			    )
			
			VAR RowData =
			    ADDCOLUMNS (
			        KeysWithMatch,
			
			        "AdCur",
			            VAR k = [K]
			            RETURN
			                SUMX (
			                    FILTER (
			                        CurSrcOnly,
			                        ( k = "" || 'SplSundayAttInPerson_WOW'[ScheduleName] = k )
			                            && 'SplSundayAttInPerson_WOW'[Literal] = "Adults"
			                    ),
			                    'SplSundayAttInPerson_WOW'[Count]
			                ),
			
			        "AdPrev",
			            VAR pn = [PrevName]
			            RETURN
			                IF (
			                    [Lvl] = "total",
			                    SUMX ( FILTER ( PrevSrcOnly, 'SplSundayAttInPerson_WOW'[Literal] = "Adults" ), 'SplSundayAttInPerson_WOW'[Count] ),
			                    IF (
			                        ISBLANK ( pn ),
			                        0,
			                        SUMX (
			                            FILTER ( PrevSrcOnly, 'SplSundayAttInPerson_WOW'[ScheduleName] = pn && 'SplSundayAttInPerson_WOW'[Literal] = "Adults" ),
			                            'SplSundayAttInPerson_WOW'[Count]
			                        )
			                    )
			                ),
			
			        "BlCur",
			            VAR k = [K]
			            RETURN
			                SUMX (
			                    FILTER (
			                        CurSrcOnly,
			                        ( k = "" || 'SplSundayAttInPerson_WOW'[ScheduleName] = k )
			                            && 'SplSundayAttInPerson_WOW'[Literal] = "bloom"
			                    ),
			                    'SplSundayAttInPerson_WOW'[Count]
			                ),
			
			        "BlPrev",
			            VAR pn = [PrevName]
			            RETURN
			                IF (
			                    [Lvl] = "total",
			                    SUMX ( FILTER ( PrevSrcOnly, 'SplSundayAttInPerson_WOW'[Literal] = "bloom" ), 'SplSundayAttInPerson_WOW'[Count] ),
			                    IF (
			                        ISBLANK ( pn ),
			                        0,
			                        SUMX (
			                            FILTER ( PrevSrcOnly, 'SplSundayAttInPerson_WOW'[ScheduleName] = pn && 'SplSundayAttInPerson_WOW'[Literal] = "bloom" ),
			                            'SplSundayAttInPerson_WOW'[Count]
			                        )
			                    )
			                ),
			
			        "DhCur",
			            VAR k = [K]
			            RETURN
			                SUMX (
			                    FILTER (
			                        CurSrcOnly,
			                        ( k = "" || 'SplSundayAttInPerson_WOW'[ScheduleName] = k )
			                            && 'SplSundayAttInPerson_WOW'[Literal] = "Door Holder"
			                    ),
			                    'SplSundayAttInPerson_WOW'[Count]
			                ),
			
			        "DhPrev",
			            VAR pn = [PrevName]
			            RETURN
			                IF (
			                    [Lvl] = "total",
			                    SUMX ( FILTER ( PrevSrcOnly, 'SplSundayAttInPerson_WOW'[Literal] = "Door Holder" ), 'SplSundayAttInPerson_WOW'[Count] ),
			                    IF (
			                        ISBLANK ( pn ),
			                        0,
			                        SUMX (
			                            FILTER ( PrevSrcOnly, 'SplSundayAttInPerson_WOW'[ScheduleName] = pn && 'SplSundayAttInPerson_WOW'[Literal] = "Door Holder" ),
			                            'SplSundayAttInPerson_WOW'[Count]
			                        )
			                    )
			                )
			    )
			
			VAR RowsHTML =
			    CONCATENATEX (
			        RowData,
			
			        VAR rowCls =
			            IF ( [Lvl] = "total", "r-total", "r-sched" )
			
			        VAR hasMatch = [HasMatch]
			
			        VAR aCur =
			            [AdCur]
			
			        VAR aPrev =
			            [AdPrev]
			
			        VAR aState =
			            IF (
			                NOT hasMatch,
			                "gone",
			                SWITCH (
			                    TRUE (),
			                    COALESCE ( aCur, 0 ) = 0
			                        &&
			                    COALESCE ( aPrev, 0 ) = 0, "empty",
			
			                    COALESCE ( aPrev, 0 ) = 0, "new",
			
			                    COALESCE ( aCur, 0 ) = 0, "gone",
			
			                    "ok"
			                )
			            )
			
			        VAR aYOY =
			            IF (
			                aState = "ok",
			                DIVIDE ( aCur - aPrev, aPrev )
			            )
			
			        VAR aTxt =
			            SWITCH (
			                aState,
			                "empty", "",
			                "new", "NEW",
			                "gone", "N/A",
			                IF (
			                    aYOY >= 0,
			                    "+" & FORMAT ( aYOY, "0.00%" ),
			                    FORMAT ( aYOY, "0.00%" )
			                )
			            )
			
			        VAR aCol =
			            SWITCH (
			                aState,
			                "empty", TxtSecondary,
			                "new", "#00B8E4",
			                "gone", TxtSecondary,
			                IF ( aYOY >= 0, Green, Red )
			            )
			
			        VAR aBar =
			            IF (
			                aState = "ok",
			                MIN ( 100, ROUND ( DIVIDE ( ABS ( aYOY ), BarCap ) * 100, 0 ) ),
			                0
			            )
			
			        VAR aShowBar =
			            aState = "ok"
			
			        VAR aF1 =
			            IF ( COALESCE ( aCur, 0 ) = 0, "", FORMAT ( aCur, "#,0" ) )
			
			        VAR aF2 =
			            IF ( COALESCE ( aPrev, 0 ) = 0, "", FORMAT ( aPrev, "#,0" ) )
			
			        VAR bCur =
			            [BlCur]
			
			        VAR bPrev =
			            [BlPrev]
			
			        VAR bState =
			            IF (
			                NOT hasMatch,
			                "gone",
			                SWITCH (
			                    TRUE (),
			                    COALESCE ( bCur, 0 ) = 0
			                        &&
			                    COALESCE ( bPrev, 0 ) = 0, "empty",
			
			                    COALESCE ( bPrev, 0 ) = 0, "new",
			
			                    COALESCE ( bCur, 0 ) = 0, "gone",
			
			                    "ok"
			                )
			            )
			
			        VAR bYOY =
			            IF (
			                bState = "ok",
			                DIVIDE ( bCur - bPrev, bPrev )
			            )
			
			        VAR bTxt =
			            SWITCH (
			                bState,
			                "empty", "",
			                "new", "NEW",
			                "gone", "N/A",
			                IF (
			                    bYOY >= 0,
			                    "+" & FORMAT ( bYOY, "0.00%" ),
			                    FORMAT ( bYOY, "0.00%" )
			                )
			            )
			
			        VAR bCol =
			            SWITCH (
			                bState,
			                "empty", TxtSecondary,
			                "new", "#00B8E4",
			                "gone", TxtSecondary,
			                IF ( bYOY >= 0, Green, Red )
			            )
			
			        VAR bBar =
			            IF (
			                bState = "ok",
			                MIN ( 100, ROUND ( DIVIDE ( ABS ( bYOY ), BarCap ) * 100, 0 ) ),
			                0
			            )
			
			        VAR bShowBar =
			            bState = "ok"
			
			        VAR bF1 =
			            IF ( COALESCE ( bCur, 0 ) = 0, "", FORMAT ( bCur, "#,0" ) )
			
			        VAR bF2 =
			            IF ( COALESCE ( bPrev, 0 ) = 0, "", FORMAT ( bPrev, "#,0" ) )
			
			        VAR dCur =
			            [DhCur]
			
			        VAR dPrev =
			            [DhPrev]
			
			        VAR dState =
			            IF (
			                NOT hasMatch,
			                "gone",
			                SWITCH (
			                    TRUE (),
			                    COALESCE ( dCur, 0 ) = 0
			                        &&
			                    COALESCE ( dPrev, 0 ) = 0, "empty",
			
			                    COALESCE ( dPrev, 0 ) = 0, "new",
			
			                    COALESCE ( dCur, 0 ) = 0, "gone",
			
			                    "ok"
			                )
			            )
			
			        VAR dYOY =
			            IF (
			                dState = "ok",
			                DIVIDE ( dCur - dPrev, dPrev )
			            )
			
			        VAR dTxt =
			            SWITCH (
			                dState,
			                "empty", "",
			                "new", "NEW",
			                "gone", "N/A",
			                IF (
			                    dYOY >= 0,
			                    "+" & FORMAT ( dYOY, "0.00%" ),
			                    FORMAT ( dYOY, "0.00%" )
			                )
			            )
			
			        VAR dCol =
			            SWITCH (
			                dState,
			                "empty", TxtSecondary,
			                "new", "#00B8E4",
			                "gone", TxtSecondary,
			                IF ( dYOY >= 0, Green, Red )
			            )
			
			        VAR dBar =
			            IF (
			                dState = "ok",
			                MIN ( 100, ROUND ( DIVIDE ( ABS ( dYOY ), BarCap ) * 100, 0 ) ),
			                0
			            )
			
			        VAR dShowBar =
			            dState = "ok"
			
			        VAR dF1 =
			            IF ( COALESCE ( dCur, 0 ) = 0, "", FORMAT ( dCur, "#,0" ) )
			
			        VAR dF2 =
			            IF ( COALESCE ( dPrev, 0 ) = 0, "", FORMAT ( dPrev, "#,0" ) )
			
			        VAR dispLabelSub =
			            IF (
			                [Lvl] = "total",
			                "",
			                IF (
			                    hasMatch && NOT ISBLANK ( [PrevName] ) && [PrevName] <> [Label],
			                    "was " & [PrevName],
			                    ""
			                )
			            )
			
			        RETURN
			            "<tr class='" & rowCls & "'>"
			                & "<td class='c-lbl'>"
			                    & "<div class='c-lbl-main'>" & [Label] & "</div>"
			                    & IF ( dispLabelSub <> "", "<div class='c-lbl-sub'>" & dispLabelSub & "</div>", "" )
			                & "</td>"
			
			                & "<td class='num'>" & aF1 & "</td>"
			                & "<td class='num dim'>" & aF2 & "</td>"
			                & "<td class='yc'>"
			                    & "<div class='yv' style='color:" & aCol & "'>"
			                        & aTxt
			                    & "</div>"
			                    & IF (
			                        aShowBar,
			                        "<div class='yb'><div class='yf' style='width:"
			                            & FORMAT ( aBar, "0" )
			                            & "%;background:"
			                            & aCol
			                            & "'></div></div>",
			                        ""
			                    )
			                & "</td>"
			
			                & "<td class='num sec'>" & bF1 & "</td>"
			                & "<td class='num dim'>" & bF2 & "</td>"
			                & "<td class='yc'>"
			                    & "<div class='yv' style='color:" & bCol & "'>"
			                        & bTxt
			                    & "</div>"
			                    & IF (
			                        bShowBar,
			                        "<div class='yb'><div class='yf' style='width:"
			                            & FORMAT ( bBar, "0" )
			                            & "%;background:"
			                            & bCol
			                            & "'></div></div>",
			                        ""
			                    )
			                & "</td>"
			
			                & "<td class='num sec'>" & dF1 & "</td>"
			                & "<td class='num dim'>" & dF2 & "</td>"
			                & "<td class='yc'>"
			                    & "<div class='yv' style='color:" & dCol & "'>"
			                        & dTxt
			                    & "</div>"
			                    & IF (
			                        dShowBar,
			                        "<div class='yb'><div class='yf' style='width:"
			                            & FORMAT ( dBar, "0" )
			                            & "%;background:"
			                            & dCol
			                            & "'></div></div>",
			                        ""
			                    )
			                & "</td>"
			
			            & "</tr>",
			
			        "",
			        [SortA], ASC
			    )
			
			VAR HeadHTML =
			    "<div class='rb-head'>"
			        & "<span class='rb-name'>Trilith</span>"
			        & "<span class='rb-title'>Easter "
			        & FORMAT ( SelYr, "0" )
			        & "</span>"
			        & "<span class='rb-sub'>vs "
			        & FORMAT ( PrevYr, "0" )
			        & "</span>"
			    & "</div>"
			
			VAR TableHTML =
			"<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
			
			html,
			body{
			    width:100%;
			    height:100%;
			    margin:0;
			    padding:0;
			    overflow:hidden;
			}
			
			.rb *{
			    box-sizing:border-box;
			    margin:0;
			    padding:0;
			    font-family:Inter,sans-serif;
			}
			
			.rb{
			    width:100%;
			    height:280px;
			    min-height:0;
			    background:" & Bg & ";
			    border:1px solid " & BorderColor & ";
			    border-radius:18px;
			    padding:16px 18px;
			    overflow:hidden;
			    display:flex;
			    flex-direction:column;
			}
			
			.rb-head{
			    display:flex;
			    align-items:baseline;
			    gap:8px;
			    margin-bottom:12px;
			    flex:0 0 auto;
			}
			
			.rb-name{
			    font-size:16px;
			    font-weight:900;
			    color:" & Accent & ";
			    letter-spacing:-.2px;
			}
			
			.rb-title{
			    font-size:16px;
			    font-weight:900;
			    color:" & TxtPrimary & ";
			    letter-spacing:-.2px;
			}
			
			.rb-sub{
			    font-size:11px;
			    font-weight:500;
			    color:" & TxtSecondary & ";
			    margin-left:auto;
			}
			
			.rb table{
			    width:100%;
			    height:100%;
			    flex:1 1 0;
			    min-height:0;
			    border-collapse:collapse;
			    table-layout:fixed;
			}
			
			.rb thead{
			    height:auto;
			}
			
			.rb tbody{
			    height:100%;
			}
			
			.rb tbody tr{
			    height:1%;
			}
			
			.rb th{
