	measure CurrentYearChristmas = ```
			
			VAR curyear=( Year('Calendar'[MaxselectedDate]))
			VAR prevyear=Year('Calendar'[MaxselectedDate])-1
			Return 
			if(ISBLANK(CALCULATE(sum(SplSundayAttInPerson_WOW[Count]),YEAR(SplSundayAttInPerson_WOW[MetricValueDateTime])=curyear,SplSundayAttInPerson_WOW[EventName]="Christmas")),CALCULATE(sum(SplSundayAttInPerson_WOW[Count]),YEAR(SplSundayAttInPerson_WOW[MetricValueDateTime])=prevyear,SplSundayAttInPerson_WOW[EventName]="Christmas"),CALCULATE(sum(SplSundayAttInPerson_WOW[Count]),YEAR(SplSundayAttInPerson_WOW[MetricValueDateTime])=curyear,SplSundayAttInPerson_WOW[EventName]="Christmas"))
			
			```
		formatString: 0
