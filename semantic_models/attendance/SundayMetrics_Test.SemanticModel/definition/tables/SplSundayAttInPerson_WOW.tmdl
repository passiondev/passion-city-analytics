	measure HTML_Christmas = ```
			
			VAR IsDark = [SelectedTheme] = "Dark"
			VAR Bg = IF(IsDark, "#111111", "#FFFFFF")
			VAR TxtColor = IF(IsDark, "#FFFFFF", "#111111")
			VAR YearColor = IF(IsDark, "#777777", "#6B7280")
			VAR SelYr = [ChristmasYear]
			
			RETURN
			"<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@900&display=swap');
			
			* { 
			    box-sizing:border-box; 
			    margin:0; 
			    padding:0; 
			}
			
			.holiday-outer { 
			    background:" & Bg & "; 
			    display:flex; 
			    justify-content:center; 
			    align-items:center; 
			    width:100%; 
			    height:100%; 
			    min-height:200px; 
			}
			
			.holiday-title {
			    display:flex;
			    align-items:baseline;
			    justify-content:center;
			    gap:18px;
			}
			
			.holiday-word { 
			    font-family:'Inter',sans-serif; 
			    font-size:110px; 
			    font-weight:900; 
			    color:" & TxtColor & "; 
			    line-height:1; 
			    letter-spacing:4px; 
			}
			
			.holiday-year {
			    font-family:'Inter',sans-serif;
			    font-size:55px;
			    font-weight:900;
			    color:" & YearColor & ";
			    line-height:1;
			    letter-spacing:2px;
			}
			
			</style>
			
			<div class='holiday-outer'>
			    <div class='holiday-title'>
			        <span class='holiday-word'>CHRISTMAS</span>
			        <span class='holiday-year'>" & FORMAT(SelYr, "0") & "</span>
			    </div>
			</div>"
			```
