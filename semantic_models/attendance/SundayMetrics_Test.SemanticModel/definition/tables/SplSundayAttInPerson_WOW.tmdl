	measure PrevYearChristmas = ```
			
			VAR curyear=( Year('Calendar'[MaxselectedDate]))
			Return 
			if(ISBLANK(CALCULATE(sum(SplSundayAttInPerson_WOW[Count]),YEAR(SplSundayAttInPerson_WOW[MetricValueDateTime])=curyear,SplSundayAttInPerson_WOW[EventName]="Christmas")),CALCULATE(sum(SplSundayAttInPerson_WOW[Count]),YEAR(SplSundayAttInPerson_WOW[MetricValueDateTime])=curyear-2,SplSundayAttInPerson_WOW[EventName]="Christmas"),CALCULATE(sum(SplSundayAttInPerson_WOW[Count]),YEAR(SplSundayAttInPerson_WOW[MetricValueDateTime])=curyear-1,SplSundayAttInPerson_WOW[EventName]="Christmas"))
			
