	measure CurrYrAvg =
			
			VAR MINDATE=STARTOFYEAR(Calendar5pm[selecteddate5PM])
			var Total = CALCULATE(SUM( '5pmSundayAttInPerson'[Count]),filter('5pmSundayAttInPerson',year('5pmSundayAttInPerson'[MetricValueDateTime])=year(Calendar5pm[MaxselectedDate5PM]) && '5pmSundayAttInPerson'[MetricValueDateTime]>=MINDATE && '5pmSundayAttInPerson'[MetricValueDateTime]<=Calendar5pm[MaxselectedDate5PM]
			))
			VAR SelectedDate = [MaxselectedDate5PM]
			VAR DataPoints = CALCULATE(DISTINCTCOUNT(Calendar5pm[Date]),ALL(Calendar5pm),Calendar5pm[selecteddate5PM]<=SelectedDate && YEAR(Calendar5pm[selecteddate5PM]) = YEAR(SelectedDate))
			RETURN
			    DIVIDE(Total,DataPoints)
		lineageTag: 3dfc4222-8462-4f54-b2ce-dbee808da07a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PrevYrTotal =
			
			VAR PrevYrDATE=DATE(year(Calendar5pm[MaxselectedDate5PM])-1,month(Calendar5pm[MaxselectedDate5PM]),EOMONTH(Calendar5pm[MaxselectedDate5PM],0))
			VAR STARTOFPREVYR=DATE(year(Calendar5pm[MaxselectedDate5PM])-1,1,1)
			
			RETURN
			CALCULATE(SUM( '5pmSundayAttInPerson'[Count]),filter('5pmSundayAttInPerson',year('5pmSundayAttInPerson'[MetricValueDateTime])=year(Calendar5pm[MaxselectedDate5PM])-1 && '5pmSundayAttInPerson'[MetricValueDateTime]>=STARTOFPREVYR && '5pmSundayAttInPerson'[MetricValueDateTime]<=PrevYrDATE
			))
		lineageTag: 08956ab8-1f27-4cce-8959-be00ea76072b

