	measure 5pmCurrentYearYOY = ```
			
			VAR curyear=( Year(Calendar5pm[MaxselectedDate5PM]))
			VAR monthnum=( MONTH(Calendar5pm[MaxselectedDate5PM]))
			Return 
			CALCULATE(average('5pmSundayAttInPerson'[Count]),
			YEAR('5pmSundayAttInPerson'[MetricValueDateTime])=curyear,MONTH('5pmSundayAttInPerson'[MetricValueDateTime])>=0 && MONTH('5pmSundayAttInPerson'[MetricValueDateTime])<=monthnum
			)
			```
		lineageTag: 3578a184-1f8b-4720-bb5f-7fa88fb22391

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 5pmPrevAVG =
			
			VAR MINDATE=STARTOFYEAR(Calendar5pm[selecteddate5PM])
			VAR SelectedDate = [MaxselectedDate5PM]
			VAR LastYearDate = DATE(YEAR(SelectedDate)-1,MONTH(SelectedDate),Day(SelectedDate))
			var Total = CALCULATE(SUM( '5pmSundayAttInPerson'[Count]),filter('5pmSundayAttInPerson',year('5pmSundayAttInPerson'[MetricValueDateTime])=year(LastYearDate) && '5pmSundayAttInPerson'[MetricValueDateTime]>=DATE(YEAR(MINDATE)-1,1,1) && '5pmSundayAttInPerson'[MetricValueDateTime]<=LastYearDate
			))
			
			VAR DataPoints = CALCULATE(DISTINCTCOUNT(Calendar5pm[Date]),ALL(Calendar5pm),Calendar5pm[selecteddate5PM]<=LastYearDate && YEAR(Calendar5pm[selecteddate5PM]) = YEAR(LastYearDate))
			RETURN
			    DIVIDE(Total,DataPoints)
		lineageTag: 92c97459-348d-4e7b-a145-0ab33444d252

		annotation PBI_FormatHint = {"isGeneralNumber":true}

