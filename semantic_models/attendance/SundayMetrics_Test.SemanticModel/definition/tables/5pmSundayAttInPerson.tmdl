		lineageTag: 582ac96a-a357-403d-9670-4a17002fcad3

	measure 5pmArrowsconditionsMOM =
			SWITCH(
			    TRUE(),
			    '5pmSundayAttInPerson'[5PMWOWMeasure]>=0,UNICHAR(9650),
			    '5pmSundayAttInPerson'[5PMWOWMeasure]<0,UNICHAR(9660),
			    BLANK()
			    )
		lineageTag: 7f7f26bb-f660-48b3-892f-023501f802c7

	measure 5pmTrilithCurYrPlaceHolder = ```
			
			VAR curyear=( Year(Calendar5pm[MaxselectedDate5PM]))
			
			Return 
			if(ISBLANK(CALCULATE(sum('5pmSundayAttInPerson'[Count]),YEAR('5pmSundayAttInPerson'[MetricValueDateTime])=curyear,'5pmSundayAttInPerson'[CampusName]="Trilith")),"-")
			```
