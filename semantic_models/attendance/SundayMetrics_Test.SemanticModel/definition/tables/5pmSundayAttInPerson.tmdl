	column 5pmYearMonthNumber = ```
			
			CONVERT (
			CONCATENATE (
			RIGHT ( YEAR ( '5pmSundayAttInPerson'[MetricValueDateTime].[Date] ), 2 ),
			IF (
			MONTH ('5pmSundayAttInPerson'[MetricValueDateTime].[Date]  ) < 10,
			CONCATENATE ( 0, MONTH ( '5pmSundayAttInPerson'[MetricValueDateTime].[Date] ) ),
			MONTH ( '5pmSundayAttInPerson'[MetricValueDateTime].[Date] )
			)
			),
			INTEGER
			)
			
			```
