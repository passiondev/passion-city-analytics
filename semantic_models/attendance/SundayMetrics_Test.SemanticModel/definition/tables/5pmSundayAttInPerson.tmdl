	measure Latest5pm =
			
			VAR SelectedDate =  [MaxselectedDate5PM]
			RETURN
			CALCULATE(sum('5pmSundayAttInPerson'[Count]),'5pmSundayAttInPerson'[MetricValueDateTime] = SelectedDate)
		lineageTag: 74a0ace4-cd50-41c1-b3f7-b84752cbfcf1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PrevMonth5pm = ```
			
			VAR prevmon=PREVIOUSDAY(Calendar5pm[selecteddate5PM].[Date])
			var prevmonlatest='5pmSundayAttInPerson'[Previous1]
			Return 
			Coalesce(CALCULATE(sum('5pmSundayAttInPerson'[Count]), '5pmSundayAttInPerson'[MetricValueDateTime]=prevmonlatest),0)
			
			```
		lineageTag: 83cf01ae-1dbd-4205-811e-b16648a7a610

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 5PMWOWMeasure = Coalesce(Divide([Latest5pm]-[PrevMonth5pm],[PrevMonth5pm],0),"-")
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 37b20838-fbea-48d6-a217-0dfa68347628

	measure 5pmMonthAtt = Calculate([5pmCountNew],'5pmSundayAttInPerson'[MetricValueDateTime]= MINX(VALUES(Calendar5pm[Date]),Calendar5pm[Date]))+0
		lineageTag: 3168180c-08bb-494b-b3d0-dc523a85c70a

