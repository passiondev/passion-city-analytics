table Theme
	lineageTag: 122a1abe-5d73-4b56-bce2-df5b31fd8e3e

	measure SelectedTheme =
			
			SELECTEDVALUE(
			    Theme[Theme],
			    "Dark"
			)
		lineageTag: b372cbf6-578b-4c9c-973e-8d6cf6defeef

	measure CardBackground =
			
			IF(
			    [SelectedTheme] = "Dark",
			    "#111111",
			    "#FFFFFF"
			)
		lineageTag: ff9c4ec2-f699-4ad2-85fa-69efd3e99ff1

	measure CardTextColor =
			
			IF(
			    [SelectedTheme] = "Dark",
			    "#FFFFFF",
			    "#111827"
			)
		lineageTag: c750f6bb-807d-4508-a3ce-7327a573dc88

	measure CardSecondaryText =
			
			IF(
			    [SelectedTheme] = "Dark",
			    "#A1A1AA",
			    "#6B7280"
			)
		lineageTag: 87ff5703-533d-4652-abcf-16c52ff78247

	measure NeoBackground = ```
			IF( [SelectedTheme] = "Dark", "#26292F", "#E4E7EC" )
			
			```
		lineageTag: 4fdb9abe-d5c1-499f-8dd4-c15f76077f77

	measure NeoShadow = ```
			IF( [SelectedTheme] = "Dark", "#15171B", "#C2C8D2" )
			
			```
		lineageTag: 3c0c467f-867b-4423-a12e-14c5e5957adb

	measure NeoText = IF( [SelectedTheme] = "Dark", "#9AA1B0", "#5B6270" )
		lineageTag: 4084263f-2734-486b-8c76-f584832aa74d

	column Theme
		lineageTag: 8a40d685-0349-4ee4-af98-ab0752df891f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Theme]

		annotation SummarizationSetBy = Automatic

	partition Theme = calculated
		mode: import
		source =
				
				DATATABLE(
				    "Theme", STRING,
				    {
				        {"Dark"},
				        {"Light"}
				    }
				)

	annotation PBI_Id = 3ff9d502b9ae49daae3abb80ba03cfbd

