			<script>
			
			(function () {
			
			    function initEasterOnlineChart() {
			
			        if (typeof Chart === 'undefined') {
			
			            setTimeout(
			                initEasterOnlineChart,
			                100
			            );
			
			            return;
			        }
			
			        var canvas =
			            document.getElementById(
			                'easterOnlineTrendChart'
			            );
			
			        if (!canvas) {
			            return;
			        }
			
			        var labels = [
			            " & LabelsJS & "
			        ];
			
			        var onlineData = [
			            " & OnlDataJS & "
			        ];
			
			        new Chart(
			            canvas,
			            {
			
			                type:'line',
			
			                data: {
			
			                    labels:labels,
			
			                    datasets:[
			
			                        {
			                            label:'Online',
			                            data:onlineData,
			                            borderColor:'" & OnlineColor & "',
			                            borderWidth:2.3,
			                            pointRadius:3,
			                            pointHoverRadius:6,
			                            pointBackgroundColor:'" & OnlineColor & "',
			                            pointBorderColor:'" & OnlineColor & "',
			                            tension:0.1,
			                            fill:false
			                        }
			
			                    ]
			
			                },
			
			                options: {
			
			                    responsive:true,
			                    maintainAspectRatio:false,
			                    devicePixelRatio:2,
			
			                    interaction: {
			                        mode:'index',
			                        intersect:false
			                    },
			
			                    plugins: {
			
			                        legend: {
			                            display:false
			                        },
			
			                        tooltip: {
			
			                            enabled:true,
			
			                            mode:'index',
			
			                            intersect:false,
			
			                            backgroundColor:
			                                '" & TooltipBg & "',
			
			                            borderColor:
			                                '" & TooltipBorder & "',
			
			                            borderWidth:1,
			
			                            titleColor:
			                                '" & TooltipTitle & "',
			
			                            bodyColor:
			                                '" & TooltipBody & "',
			
			                            padding:12,
			
			                            cornerRadius:8,
			
			                            displayColors:true,
			
			                            boxWidth:8,
			
			                            boxHeight:8,
			
			                            boxPadding:5,
			
			                            usePointStyle:true,
			
			                            titleFont: {
			                                family:'Inter',
			                                size:11,
			                                weight:'600'
			                            },
			
			                            bodyFont: {
			                                family:'Inter',
			                                size:12,
			                                weight:'700'
			                            },
			
			                            callbacks: {
			
			                                title:function(items) {
			
			                                    if (!items.length) {
			                                        return '';
			                                    }
			
			                                    return 'Easter ' +
			                                        items[0].label;
			                                },
			
			                                label:function(context) {
			
			                                    var value =
			                                        context.parsed.y;
			
			                                    return ' ' +
			                                        context.dataset.label +
			                                        ': ' +
			                                        Math.round(value)
			                                            .toLocaleString(
			                                                'en-US'
			                                            );
			
			                                }
			
			                            }
			
			                        }
			
			                    },
			
			                    scales: {
			
			                        x: {
			
			                            offset:false,
			
			                            grid: {
			                                display:false
			                            },
			
			                            border: {
			                                display:false
			                            },
			
			                            ticks: {
			
			                                color:
			                                    '" & TxtSecondary & "',
			
			                                padding:10,
			
			                                autoSkip:false,
			
			                                maxRotation:0,
			
			                                font: {
			                                    family:'Inter',
			                                    size:10,
			                                    weight:'500'
			                                }
			
			                            }
			
			                        },
			
			                        y: {
			
			                            beginAtZero:true,
			
			                            grace:'8%',
			
			                            grid: {
			                                color:
			                                    '" & GridColor & "',
			
			                                drawTicks:false,
			
			                                lineWidth:1
			                            },
			
			                            border: {
			                                display:false
			                            },
			
			                            ticks: {
			
			                                color:
			                                    '" & TxtSecondary & "',
			
			                                padding:10,
			
			                                maxTicksLimit:5,
			
			                                font: {
			                                    family:'Inter',
			                                    size:10,
			                                    weight:'500'
			                                },
			
			                                callback:function(value) {
			
			                                    if (value >= 1000) {
			
			                                        var k =
			                                            value / 1000;
			
			                                        return (
			                                            Number.isInteger(k)
			                                                ? k
			                                                : k.toFixed(1)
			                                        ) + 'K';
			
			                                    }
			
			                                    return value;
			
			                                }
			
			                            }
			
			                        }
			
			                    },
			
			                    layout: {
			
			                        padding: {
			                            top:8,
			                            right:8,
			                            bottom:2,
			                            left:2
			                        }
			
			                    },
			
			                    animation: {
			                        duration:850,
			                        easing:'easeOutQuart'
			                    }
			
			                }
			
			            }
			        );
			
			    }
			
			    setTimeout(
			        initEasterOnlineChart,
			        100
			    );
			
			})();
			
			</script>
