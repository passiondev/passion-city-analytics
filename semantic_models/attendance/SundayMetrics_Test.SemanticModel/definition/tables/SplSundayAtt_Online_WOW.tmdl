	measure HTML_Christmas_InPerson_Chart = ```
			
			VAR IsDark = [SelectedTheme] = "Dark"
			
			VAR Bg =
			    IF(IsDark, "#1E1E1E", "#FFFFFF")
			
			VAR BorderColor =
			    IF(IsDark, "#2A2A2A", "#E5E7EB")
			
			VAR TxtPrimary =
			    IF(IsDark, "#FFFFFF", "#111111")
			
			VAR TxtSecondary =
			    IF(IsDark, "#9CA3AF", "#6B7280")
			
			VAR GridColor =
			    IF(IsDark, "rgba(255,255,255,0.06)", "rgba(0,0,0,0.07)")
			
			VAR TooltipBg =
			    IF(IsDark, "#1A1A1A", "#FFFFFF")
			
			VAR TooltipBorder =
			    IF(IsDark, "#2A2A2A", "#DDDDDD")
			
			VAR TooltipTitle =
			    IF(IsDark, "#888888", "#999999")
			
			VAR TooltipBody =
			    IF(IsDark, "#FFFFFF", "#111111")
			
			VAR ATLColor =
			    IF(IsDark, "#FFFFFF", "#111111")
			
			--------------------------------------------------
			-- ROLLING 5 YEARS
			--------------------------------------------------
			
			VAR SelYr =
			    [ChristmasYear]
			
			VAR StartYr =
			    SelYr - 4
			
			VAR YearData =
			    ADDCOLUMNS(
			        FILTER(
			            VALUES(
			                'SplSundayAttInPerson_WOW'[FormattedDateSplSun]
			            ),
			            VALUE(
			                'SplSundayAttInPerson_WOW'[FormattedDateSplSun]
			            ) >= StartYr
			                &&
			            VALUE(
			                'SplSundayAttInPerson_WOW'[FormattedDateSplSun]
			            ) <= SelYr
			        ),
			
			        "Yr",
			            VALUE(
			                'SplSundayAttInPerson_WOW'[FormattedDateSplSun]
			            ),
			
			        "ATL",
			            CALCULATE(
			                SUM(
			                    'SplSundayAttInPerson_WOW'[Count]
			                ),
			                'SplSundayAttInPerson_WOW'[EventName] = "Christmas",
			                'SplSundayAttInPerson_WOW'[CampusName] <> "DC"
			            ),
			
			        "C515",
			            CALCULATE(
			                SUM(
			                    'SplSundayAttInPerson_WOW'[Count]
			                ),
			                'SplSundayAttInPerson_WOW'[EventName] = "Christmas",
			                'SplSundayAttInPerson_WOW'[CampusName] = "515"
			            ),
			
			        "CBL",
			            CALCULATE(
			                SUM(
			                    'SplSundayAttInPerson_WOW'[Count]
			                ),
			                'SplSundayAttInPerson_WOW'[EventName] = "Christmas",
			                'SplSundayAttInPerson_WOW'[CampusName] = "Cumberland"
			            ),
			
			        "TRL",
			            CALCULATE(
			                SUM(
			                    'SplSundayAttInPerson_WOW'[Count]
			                ),
			                'SplSundayAttInPerson_WOW'[EventName] = "Christmas",
			                'SplSundayAttInPerson_WOW'[CampusName] = "Trilith"
			            )
			    )
			
			--------------------------------------------------
			-- BUILD JAVASCRIPT DATA
			--------------------------------------------------
			
			VAR LabelsJS =
			    CONCATENATEX(
			        YearData,
			        """" & FORMAT([Yr], "0") & """",
			        ",",
			        [Yr],
			        ASC
			    )
			
			VAR ATLDataJS =
			    CONCATENATEX(
			        YearData,
			        FORMAT(
			            COALESCE([ATL], 0),
			            "0"
			        ),
			        ",",
			        [Yr],
			        ASC
			    )
			
			VAR Data515JS =
			    CONCATENATEX(
			        YearData,
			        FORMAT(
			            COALESCE([C515], 0),
			            "0"
			        ),
			        ",",
			        [Yr],
			        ASC
			    )
			
			VAR CBLDataJS =
			    CONCATENATEX(
			        YearData,
			        FORMAT(
			            COALESCE([CBL], 0),
			            "0"
			        ),
			        ",",
			        [Yr],
			        ASC
			    )
			
			VAR TRLDataJS =
			    CONCATENATEX(
			        YearData,
			        FORMAT(
			            COALESCE([TRL], 0),
			            "0"
			        ),
			        ",",
			        [Yr],
			        ASC
			    )
			
			--------------------------------------------------
			-- RETURN
			--------------------------------------------------
			
			RETURN
			
