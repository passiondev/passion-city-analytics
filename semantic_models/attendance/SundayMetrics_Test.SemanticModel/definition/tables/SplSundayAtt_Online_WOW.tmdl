	partition SplSundayAtt_Online_WOW = m
		mode: import
		source =
				let
				    Source = Table.Combine({AnalyticsFactMetricSplSundaybloomMetrics, AnalyticsFactMetricSplSundayDHMetrics, AnalyticsFactMetricSplSundayGatheringAttMetrics}),
				    #"Filtered Rows1" = Table.SelectRows(Source, each ([CampusName] = "Online")),
				    #"Grouped Rows" = Table.Group(#"Filtered Rows1", {"MetricValueDateTime", "CampusName", "ScheduleName", "Literal", "CityName","EventName"}, {{"Count", each List.Sum([Count]), type nullable number}}),
				    #"Sorted Rows" = Table.Sort(#"Grouped Rows",{{"Literal", Order.Ascending}}),
				    #"Added Conditional Column" = Table.AddColumn(#"Sorted Rows", "Custom", each if [CampusName] = "DC" then "D.C." else if [CampusName] <> "DC" then "Atlanta" else null),
				    #"Added Index" = Table.AddIndexColumn(#"Added Conditional Column", "Index", 0, 1, Int64.Type),
				    #"Added Custom" = Table.AddColumn(#"Added Index", "Custom.1", each try #"Added Index" { [Index] - 7 } [Count] otherwise null),
				    #"Renamed Columns" = Table.RenameColumns(#"Added Custom",{{"Custom.1", "Prev Week"}}),
				    #"Added Custom1" = Table.AddColumn(#"Renamed Columns", "Custom.1", each Value.Divide([Count]-([Prev Week]),[Prev Week])),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Custom1",{{"Custom.1", Percentage.Type}}),
				    #"Reordered Columns" = Table.ReorderColumns(#"Changed Type",{"MetricValueDateTime", "CampusName", "ScheduleName", "Custom", "Index", "Prev Week", "Count", "Custom.1"}),
				    #"Renamed Columns1" = Table.RenameColumns(#"Reordered Columns",{{"Custom.1", "WOW"}}),
				    #"Inserted Week of Year" = Table.AddColumn(#"Renamed Columns1", "Week of Year", each Date.WeekOfYear([MetricValueDateTime]), Int64.Type),
				    #"Filtered Rows" = Table.SelectRows(#"Inserted Week of Year", each ([CityName] = "Atlanta"))
				in
				    #"Filtered Rows"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

