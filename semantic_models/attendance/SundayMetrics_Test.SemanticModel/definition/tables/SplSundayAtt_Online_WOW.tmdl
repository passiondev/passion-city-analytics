	measure HTML_Christmas_Online_Chart = ```
			
			VAR IsDark = [SelectedTheme] = "Dark"
			
			VAR Bg =
			    IF(IsDark, "#1E1E1E", "#FFFFFF")
			
			VAR BorderColor =
			    IF(IsDark, "#2A2A2A", "#E5E7EB")
			
			VAR TxtPrimary =
			    IF(IsDark, "#FFFFFF", "#111111")
			
			VAR TxtSecondary =
			    IF(IsDark, "#9CA3AF", "#6B7280")
			
			VAR GridColor =
			    IF(IsDark, "rgba(255,255,255,0.06)", "rgba(0,0,0,0.07)")
			
			VAR TooltipBg =
			    IF(IsDark, "#1A1A1A", "#FFFFFF")
			
			VAR TooltipBorder =
			    IF(IsDark, "#2A2A2A", "#DDDDDD")
			
			VAR TooltipTitle =
			    IF(IsDark, "#888888", "#999999")
			
			VAR TooltipBody =
			    IF(IsDark, "#FFFFFF", "#111111")
			
			VAR OnlineColor =
			    IF(IsDark, "#FFFFFF", "#111111")
			
			--------------------------------------------------
			-- ROLLING 5 YEARS
			--------------------------------------------------
			
			VAR SelYr =
			    [ChristmasYear]
			
			VAR StartYr =
			    SelYr - 4
			
			VAR YearData =
			    ADDCOLUMNS(
			        FILTER(
			            VALUES(
			                'SplSundayAtt_Online_WOW'[FormattedDateSplSunOnl]
			            ),
			            VALUE(
			                'SplSundayAtt_Online_WOW'[FormattedDateSplSunOnl]
			            ) >= StartYr
			                &&
			            VALUE(
			                'SplSundayAtt_Online_WOW'[FormattedDateSplSunOnl]
			            ) <= SelYr
			        ),
			
			        "Yr",
			            VALUE(
			                'SplSundayAtt_Online_WOW'[FormattedDateSplSunOnl]
			            ),
			
			        "Onl",
			            CALCULATE(
			                SUM(
			                    'SplSundayAtt_Online_WOW'[Count]
			                ),
			                'SplSundayAtt_Online_WOW'[EventName] = "Christmas"
			            )
			    )
			
			--------------------------------------------------
			-- DATA AVAILABILITY
			--------------------------------------------------
			
			-- Earliest / latest year that actually has Christmas online rows.
			-- ALL() strips the year slicer so these stay fixed no matter
			-- what the user picks.
			VAR MinYrAvail =
			    MINX(
			        FILTER(
			            ALL( 'SplSundayAtt_Online_WOW' ),
			            'SplSundayAtt_Online_WOW'[EventName] = "Christmas"
			        ),
			        VALUE(
			            'SplSundayAtt_Online_WOW'[FormattedDateSplSunOnl]
			        )
			    )
			
			VAR MaxYrAvail =
			    MAXX(
			        FILTER(
			            ALL( 'SplSundayAtt_Online_WOW' ),
			            'SplSundayAtt_Online_WOW'[EventName] = "Christmas"
			        ),
			        VALUE(
			            'SplSundayAtt_Online_WOW'[FormattedDateSplSunOnl]
			        )
			    )
			
			VAR RowsFound =
			    COUNTROWS( YearData )
			
			VAR TotalFound =
			    SUMX( YearData, COALESCE( [Onl], 0 ) )
			
			-- Blank SelYr happens when the chosen year has no Christmas at
			-- all, so [ChristmasYear] returns nothing. Treat that as "no data".
			VAR HasData =
			    NOT ISBLANK( SelYr )
			        && COALESCE( RowsFound, 0 ) > 0
			        && TotalFound > 0
			
			-- Message wording. If SelYr is blank we can't name the year,
			-- so fall back to neutral phrasing.
			VAR EmptyHeadline =
			    IF(
			        ISBLANK( SelYr ),
			        "No data available",
			        "No data available for " & FORMAT( SelYr, "0" )
			    )
			
			VAR EmptySubline =
			    "Christmas online attendance is available from "
			        & FORMAT( MinYrAvail, "0" )
			        & " to "
			        & FORMAT( MaxYrAvail, "0" )
			
			--------------------------------------------------
			-- BUILD JAVASCRIPT DATA
			--------------------------------------------------
			
			VAR LabelsJS =
			    CONCATENATEX(
			        YearData,
			        """" & FORMAT([Yr], "0") & """",
			        ",",
			        [Yr],
			        ASC
			    )
			
			VAR OnlDataJS =
			    CONCATENATEX(
			        YearData,
			        FORMAT(
			            COALESCE([Onl], 0),
			            "0"
			        ),
			        ",",
			        [Yr],
			        ASC
			    )
			
			--------------------------------------------------
			-- EMPTY STATE
			--------------------------------------------------
			
			VAR EmptyHTML =
			"
			<style>
			
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
			
			* { box-sizing:border-box; margin:0; padding:0; }
			
			html, body {
			    width:100%;
			    height:100%;
			    margin:0;
			    padding:0;
			    overflow:hidden;
			}
			
			.christmas-chart {
			    width:100%;
			    height:calc(100vh - 2px);
			
			    background:" & Bg & ";
			
			    border:1px solid " & BorderColor & ";
			    border-radius:14px;
			
			    padding:20px;
			
			    display:flex;
			    flex-direction:column;
			
			    overflow:hidden;
			
			    font-family:Inter,sans-serif;
			}
			
			.christmas-chart-header {
			    flex:0 0 auto;
			    margin-bottom:12px;
			}
			
			.christmas-chart-title {
			    font-size:15px;
			    font-weight:900;
			    line-height:1;
			    color:" & TxtPrimary & ";
			}
			
			.christmas-chart-subtitle {
			    margin-top:4px;
			    font-size:11px;
			    font-weight:500;
			    color:" & TxtSecondary & ";
			}
			
			.christmas-empty {
			    flex:1 1 auto;
			    min-height:0;
			
			    display:flex;
			    flex-direction:column;
			    align-items:center;
			    justify-content:center;
			
			    gap:10px;
			
			    text-align:center;
			
			    padding:12px;
			
			    opacity:0;
			    animation:emptyFade .5s ease-out .1s forwards;
			}
			
			@keyframes emptyFade {
			    from { opacity:0; transform:translateY(6px); }
			    to   { opacity:1; transform:translateY(0); }
			}
			
			.christmas-empty-icon {
			    width:34px;
			    height:34px;
			    opacity:.45;
			    color:" & TxtSecondary & ";
			}
			
			.christmas-empty-title {
			    font-size:13px;
			    font-weight:800;
			    color:" & TxtPrimary & ";
			    line-height:1.2;
			}
			
			.christmas-empty-sub {
			    font-size:11px;
			    font-weight:500;
			    color:" & TxtSecondary & ";
			    line-height:1.4;
			    max-width:260px;
			}
			
			</style>
			
			
			<div class='christmas-chart'>
			
			    <div class='christmas-chart-header'>
			
			        <div class='christmas-chart-title'>
			            Christmas Online
			        </div>
			
			        <div class='christmas-chart-subtitle'>
			            Rolling 5 Years
			        </div>
			
			    </div>
			
			
			    <div class='christmas-empty'>
			
			        <svg
			            class='christmas-empty-icon'
			            viewBox='0 0 24 24'
			            fill='none'
			            stroke='currentColor'
			            stroke-width='1.6'
			            stroke-linecap='round'
			            stroke-linejoin='round'>
			
			            <path d='M3 3v16a2 2 0 0 0 2 2h16' />
			            <path d='M7 15l3-3 3 2 4-5' />
			            <line x1='3' y1='3' x2='21' y2='21' opacity='.35' />
			
			        </svg>
			
			        <div class='christmas-empty-title'>
			            " & EmptyHeadline & "
			        </div>
			
			        <div class='christmas-empty-sub'>
			            " & EmptySubline & "
			        </div>
			
			    </div>
			
			</div>
			"
			
			--------------------------------------------------
			-- CHART
			--------------------------------------------------
			
			VAR ChartHTML =
			"
			<style>
			
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
			
			* {
			    box-sizing:border-box;
			    margin:0;
			    padding:0;
			}
			
			html,
			body {
			    width:100%;
			    height:100%;
			    margin:0;
			    padding:0;
			    overflow:hidden;
			}
			
			.christmas-chart {
			    width:100%;
			    height:calc(100vh - 2px);
			
			    background:" & Bg & ";
			
			    border:1px solid " & BorderColor & ";
			    border-radius:14px;
			
			    padding:20px;
			
			    display:flex;
			    flex-direction:column;
			
			    overflow:hidden;
			
			    font-family:Inter,sans-serif;
			}
			
			.christmas-chart-header {
			    flex:0 0 auto;
			    margin-bottom:12px;
			}
			
			.christmas-chart-title {
			    font-size:15px;
			    font-weight:900;
			    line-height:1;
			    color:" & TxtPrimary & ";
			}
			
			.christmas-chart-subtitle {
			    margin-top:4px;
			    font-size:11px;
			    font-weight:500;
			    color:" & TxtSecondary & ";
			}
			
			.christmas-legend {
			    flex:0 0 auto;
			
			    display:flex;
			    align-items:center;
			    flex-wrap:wrap;
			
			    gap:16px;
			
			    margin-bottom:12px;
			}
			
			.christmas-legend-item {
			    display:flex;
			    align-items:center;
			    gap:6px;
			
			    font-size:10px;
			    font-weight:600;
			
			    color:" & TxtSecondary & ";
			}
			
			.christmas-legend-line {
			    width:12px;
			    height:3px;
			    border-radius:4px;
			    flex-shrink:0;
			}
			
			.christmas-canvas-wrap {
			    position:relative;
			
			    width:100%;
			
			    flex:1 1 auto;
			
			    min-height:0;
			}
			
			#christmasOnlineTrendChart {
			    width:100% !important;
			    height:100% !important;
			    display:block;
			}
			
			</style>
			
			
			<div class='christmas-chart'>
			
			    <div class='christmas-chart-header'>
			
			        <div class='christmas-chart-title'>
			            Christmas Online
			        </div>
			
			        <div class='christmas-chart-subtitle'>
			            Rolling 5 Years
			        </div>
			
			    </div>
			
			
			    <div class='christmas-legend'>
			
			        <div class='christmas-legend-item'>
			            <span
			                class='christmas-legend-line'
			                style='background:" & OnlineColor & ";'>
			            </span>
			            Online
			        </div>
			
			    </div>
			
			
			    <div class='christmas-canvas-wrap'>
			
			        <canvas id='christmasOnlineTrendChart'></canvas>
			
			    </div>
			
			</div>
			
			
			<script src='https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js'></script>
			
			
			<script>
			
			(function () {
			
			    function initChristmasOnlineChart() {
			
			        if (typeof Chart === 'undefined') {
			
			            setTimeout(
			                initChristmasOnlineChart,
			                100
			            );
			
			            return;
			        }
			
			        var canvas =
			            document.getElementById(
			                'christmasOnlineTrendChart'
			            );
			
			        if (!canvas) {
			            return;
			        }
			
			        var labels = [
			            " & LabelsJS & "
			        ];
			
			        var onlineData = [
			            " & OnlDataJS & "
			        ];
			
			        new Chart(
			            canvas,
			            {
			
			                type:'line',
			
			                data: {
			
			                    labels:labels,
			
			                    datasets:[
			
			                        {
			                            label:'Online',
			                            data:onlineData,
			                            borderColor:'" & OnlineColor & "',
			                            borderWidth:2.3,
			                            pointRadius:3,
			                            pointHoverRadius:6,
			                            pointBackgroundColor:'" & OnlineColor & "',
			                            pointBorderColor:'" & OnlineColor & "',
			                            tension:0.1,
			                            fill:false
			                        }
			
			                    ]
			
			                },
			
			                options: {
			
			                    responsive:true,
			                    maintainAspectRatio:false,
			                    devicePixelRatio:2,
			
			                    interaction: {
			                        mode:'index',
			                        intersect:false
			                    },
			
			                    plugins: {
			
			                        legend: {
			                            display:false
			                        },
			
			                        tooltip: {
			
			                            enabled:true,
			
			                            mode:'index',
			
			                            intersect:false,
			
			                            backgroundColor:
			                                '" & TooltipBg & "',
			
			                            borderColor:
			                                '" & TooltipBorder & "',
			
			                            borderWidth:1,
			
			                            titleColor:
			                                '" & TooltipTitle & "',
			
			                            bodyColor:
			                                '" & TooltipBody & "',
			
			                            padding:12,
			
			                            cornerRadius:8,
			
			                            displayColors:true,
			
			                            boxWidth:8,
			
			                            boxHeight:8,
			
			                            boxPadding:5,
			
			                            usePointStyle:true,
			
			                            titleFont: {
			                                family:'Inter',
			                                size:11,
			                                weight:'600'
			                            },
			
			                            bodyFont: {
			                                family:'Inter',
			                                size:12,
			                                weight:'700'
			                            },
			
			                            callbacks: {
			
			                                title:function(items) {
			
			                                    if (!items.length) {
			                                        return '';
			                                    }
			
			                                    return 'Christmas ' +
			                                        items[0].label;
			                                },
			
			                                label:function(context) {
			
			                                    var value =
			                                        context.parsed.y;
			
			                                    return ' ' +
			                                        context.dataset.label +
			                                        ': ' +
			                                        Math.round(value)
			                                            .toLocaleString(
			                                                'en-US'
			                                            );
			
			                                }
			
			                            }
			
			                        }
			
			                    },
			
			                    scales: {
			
			                        x: {
			
			                            offset:false,
			
			                            grid: {
			                                display:false
			                            },
			
			                            border: {
			                                display:false
			                            },
			
			                            ticks: {
			
			                                color:
			                                    '" & TxtSecondary & "',
			
			                                padding:10,
			
			                                autoSkip:false,
			
			                                maxRotation:0,
			
			                                font: {
			                                    family:'Inter',
			                                    size:10,
			                                    weight:'500'
			                                }
			
			                            }
			
			                        },
			
			                        y: {
			
			                            beginAtZero:true,
			
			                            grace:'8%',
			
			                            grid: {
			                                color:
			                                    '" & GridColor & "',
			
			                                drawTicks:false,
			
			                                lineWidth:1
			                            },
			
			                            border: {
			                                display:false
			                            },
			
			                            ticks: {
			
			                                color:
			                                    '" & TxtSecondary & "',
			
			                                padding:10,
			
			                                maxTicksLimit:5,
			
			                                font: {
			                                    family:'Inter',
			                                    size:10,
			                                    weight:'500'
			                                },
			
			                                callback:function(value) {
			
			                                    if (value >= 1000) {
			
			                                        var k =
			                                            value / 1000;
			
			                                        return (
			                                            Number.isInteger(k)
			                                                ? k
			                                                : k.toFixed(1)
			                                        ) + 'K';
			
			                                    }
			
			                                    return value;
			
			                                }
			
			                            }
			
			                        }
			
			                    },
			
			                    layout: {
			
			                        padding: {
			                            top:8,
			                            right:8,
			                            bottom:2,
			                            left:2
			                        }
			
			                    },
			
			                    animation: {
			                        duration:850,
			                        easing:'easeOutQuart'
			                    }
			
			                }
			
			            }
			        );
			
			    }
			
			    setTimeout(
			        initChristmasOnlineChart,
			        100
			    );
			
			})();
			
			</script>
			"
			
			--------------------------------------------------
			-- RETURN
			--------------------------------------------------
			
			RETURN
			    IF ( HasData, ChartHTML, EmptyHTML )
			
			```
		lineageTag: 54dd3f24-e094-4ce5-a550-37d085fc4a66

	column MetricValueDateTime
		dataType: dateTime
