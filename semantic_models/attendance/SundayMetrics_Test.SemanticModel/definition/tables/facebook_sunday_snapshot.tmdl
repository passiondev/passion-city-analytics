table facebook_sunday_snapshot
	lineageTag: a345b3f0-a8a5-4e25-949d-1b592e223354

	measure OnlinePrevYearAttendance =
			
			VAR _calDate = MINX(VALUES('Calendar'[Date]), 'Calendar'[Date])
			VAR _maxDate = MAXX(ALL(v_gathering_views), DATEVALUE(v_gathering_views[sunday_date]))
			VAR _Sel = IF(YEAR(_calDate) < 2020, _maxDate, _calDate)
			RETURN
			CALCULATE(
			    [OnlineAttendance],
			    REMOVEFILTERS('Calendar'),
			    'Calendar'[Date] = _Sel - 364
			)
		lineageTag: cd13f704-4d18-4506-bb1f-302dc4cc543c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure OnlineYoY =
			
			VAR _Cur = [OnlineAttendance]
			VAR _Prev = [OnlinePrevYearAttendance]
			RETURN
			IF(_Cur > 0 && _Prev > 0, DIVIDE(_Cur - _Prev, _Prev))
		lineageTag: d16a2fbf-9dc3-4269-8835-cf033f4fbc91

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure OnlineYoYArrow =
			
			VAR _YoY = [OnlineYoY]
			RETURN
			SWITCH(TRUE(), ISBLANK(_YoY), BLANK(), _YoY >= 0, UNICHAR(9650), UNICHAR(9660))
		lineageTag: af371580-9bcb-45d1-bfd7-5cb7e56fa345

	measure Online5WkAvg =
			
			VAR _calDate = MINX(VALUES('Calendar'[Date]), 'Calendar'[Date])
			VAR _maxDate = MAXX(ALL(v_gathering_views), DATEVALUE(v_gathering_views[sunday_date]))
			VAR _Sel = IF(YEAR(_calDate) < 2020, _maxDate, _calDate)
			VAR _Weeks =
			    ADDCOLUMNS(
			        GENERATESERIES(0, 9, 1),
			        "@Date", _Sel - 7 * [Value],
			        "@Att",
			            VAR _d = _Sel - 7 * [Value]
			            RETURN
			                CALCULATE(
			                    [OnlineAttendance],
			                    REMOVEFILTERS('Calendar'),
			                    'Calendar'[Date] = _d
			                )
			    )
			VAR _Last5 = TOPN(5, FILTER(_Weeks, [@Att] > 0), [@Date], DESC)
			RETURN
			ROUND(AVERAGEX(_Last5, [@Att]), 0)
		lineageTag: a8465017-eb81-405c-bd4b-ccb7b30567a2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Online5WkAvgVsCurrent =
			
			VAR _Avg = [Online5WkAvg]
			RETURN
			IF(_Avg > 0, DIVIDE([OnlineAttendance] - _Avg, _Avg))
		lineageTag: 7a7f46dd-2f21-4801-b452-8470011c51ef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

