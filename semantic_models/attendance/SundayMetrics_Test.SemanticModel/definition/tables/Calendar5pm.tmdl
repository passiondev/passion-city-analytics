	partition Calendar5pm = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    //CALENDAR (DATE(2011,1,1), MAX('5pmSundayAttInPerson'[MetricValueDateTime])),
				    SELECTCOLUMNS(VALUES('5pmSundayAttInPerson'[MetricValueDateTime]),"Date",'5pmSundayAttInPerson'[MetricValueDateTime]),
				    "Year", YEAR([Date]),
				    "MonthNumber", MONTH([Date]),
				    "MonthName", FORMAT([Date], "MMMM"),
				    "WeekNumber", WEEKNUM([Date]),
				    "DayOfWeekNumber", WEEKDAY([Date]),
				    "DayOfWeekName", FORMAT([Date], "DDDD"),
				    "Quarter", QUARTER([Date]),
				    "YearMonth", FORMAT([Date], "YYYY-MM"),
				    "YearQuarter", FORMAT([Date], "YYYY") & "-Q" & QUARTER([Date])
				)

	annotation PBI_Id = 3e08146fd0954aa7a3b4b787c690737f

